feature: Login
title: Login
uc_id: ''
backlog:
- 2
participants:
- name: User / Admin
  kind: actor
  w: 30
- name: :Login UI
  kind: box
  w: 160
- name: ':AuthController

    (WebClient)'
  kind: box
  w: 160
- name: ':AuthService

    (WebClient)'
  kind: box
  w: 160
- name: :API Gateway
  kind: box
  w: 140
- name: ':AuthController

    (AuthAPI)'
  kind: box
  w: 160
- name: ':AuthService

    (AuthAPI)'
  kind: box
  w: 160
- name: :BCryptPasswordHasher
  kind: box
  w: 170
- name: :TokenService
  kind: box
  w: 140
- name: :AccountRepository
  kind: box
  w: 160
- name: :RefreshTokenRepository
  kind: box
  w: 180
- name: :LoginAuditRepository
  kind: box
  w: 180
- name: SQL Server
  kind: db
  w: 70
flow:
- d: 0
  t: 1
  k: call
  l: 1. Enter email and password, submit
- d: 1
  t: 2
  k: call
  l: 2. POST /Auth/Login (LoginViewModel)
- frame: opt
  sections:
  - guard: '[ModelState invalid]'
    body:
    - d: 2
      t: 1
      k: ret
      l: 2.1. Return View(model) with validation errors
    - d: 1
      t: 0
      k: ret
      l: 2.2. Display validation errors
- d: 2
  t: 3
  k: call
  l: 3. LoginAsync(model)
- d: 3
  t: 4
  k: call
  l: 4. POST api/auth/login
- d: 4
  t: 5
  k: call
  l: 5. Forward request to AuthAPI
- d: 5
  t: 6
  k: call
  l: 6. LoginAsync(request)
- d: 6
  t: 9
  k: call
  l: 7. GetByEmailAsync(email)
- d: 9
  t: 12
  k: call
  l: 8. SELECT Account by Email
- d: 12
  t: 9
  k: ret
  l: 9. Return account row / empty
- d: 9
  t: 6
  k: ret
  l: 10. Return existing account / null
- frame: alt
  sections:
  - guard: '[account is null (email not registered)]'
    body:
    - d: 6
      t: 11
      k: call
      l: '11.1. AddAsync(LoginAudit: fail)'
    - d: 11
      t: 6
      k: ret
      l: 11.2. Return
    - d: 6
      t: 9
      k: call
      l: 11.3. SaveChangesAsync()
    - d: 9
      t: 12
      k: call
      l: 11.4. INSERT LoginAudit
    - d: 12
      t: 9
      k: ret
      l: 11.5. Return saved
    - d: 9
      t: 6
      k: ret
      l: 11.6. Return
    - d: 6
      t: 5
      k: ret
      l: 11.7. throw UnauthorizedException (Invalid email or password)
    - d: 5
      t: 4
      k: ret
      l: 11.8. Return 401 Unauthorized (ApiResponse)
    - d: 4
      t: 3
      k: ret
      l: 11.9. Return error response
    - d: 3
      t: 2
      k: ret
      l: 11.10. Return LoginResult(Success=false, message)
    - d: 2
      t: 1
      k: ret
      l: 11.11. Return View(model) with error message
    - d: 1
      t: 0
      k: ret
      l: 11.12. Display error message
  - guard: '[account.Status == "Blocked"]'
    body:
    - d: 6
      t: 11
      k: call
      l: '12.1. AddAsync(LoginAudit: fail)'
    - d: 11
      t: 6
      k: ret
      l: 12.2. Return
    - d: 6
      t: 9
      k: call
      l: 12.3. SaveChangesAsync()
    - d: 9
      t: 12
      k: call
      l: 12.4. INSERT LoginAudit
    - d: 12
      t: 9
      k: ret
      l: 12.5. Return saved
    - d: 9
      t: 6
      k: ret
      l: 12.6. Return
    - d: 6
      t: 5
      k: ret
      l: 12.7. throw ForbiddenException (This account has been blocked. + Reason)
    - d: 5
      t: 4
      k: ret
      l: 12.8. Return 403 Forbidden (ApiResponse)
    - d: 4
      t: 3
      k: ret
      l: 12.9. Return error response
    - d: 3
      t: 2
      k: ret
      l: 12.10. Return LoginResult(Success=false, message)
    - d: 2
      t: 1
      k: ret
      l: 12.11. Return View(model) with error message
    - d: 1
      t: 0
      k: ret
      l: 12.12. Display blocked message
  - guard: '[account temporarily locked (LockedUntil > now)]'
    body:
    - d: 6
      t: 11
      k: call
      l: '13.1. AddAsync(LoginAudit: fail)'
    - d: 11
      t: 6
      k: ret
      l: 13.2. Return
    - d: 6
      t: 9
      k: call
      l: 13.3. SaveChangesAsync()
    - d: 9
      t: 12
      k: call
      l: 13.4. INSERT LoginAudit
    - d: 12
      t: 9
      k: ret
      l: 13.5. Return saved
    - d: 9
      t: 6
      k: ret
      l: 13.6. Return
    - d: 6
      t: 5
      k: ret
      l: 13.7. throw UnauthorizedException (Account temporarily locked, try again in N minutes)
    - d: 5
      t: 4
      k: ret
      l: 13.8. Return 401 Unauthorized (ApiResponse)
    - d: 4
      t: 3
      k: ret
      l: 13.9. Return error response
    - d: 3
      t: 2
      k: ret
      l: 13.10. Return LoginResult(Success=false, message)
    - d: 2
      t: 1
      k: ret
      l: 13.11. Return View(model) with error message
    - d: 1
      t: 0
      k: ret
      l: 13.12. Display locked message
  - guard: '[password incorrect]'
    body:
    - d: 6
      t: 7
      k: call
      l: 14.1. Verify(request.Password, account.PasswordHash)
    - d: 7
      t: 6
      k: ret
      l: 14.2. Return false
    - frame: opt
      sections:
      - guard: '[FailedLoginCount >= 5]'
        body: []
    - d: 6
      t: 11
      k: call
      l: '14.5. AddAsync(LoginAudit: fail)'
    - d: 11
      t: 6
      k: ret
      l: 14.6. Return
    - d: 6
      t: 9
      k: call
      l: 14.7. SaveChangesAsync()
    - d: 9
      t: 12
      k: call
      l: 14.8. UPDATE Account + INSERT LoginAudit
    - d: 12
      t: 9
      k: ret
      l: 14.9. Return saved
    - d: 9
      t: 6
      k: ret
      l: 14.10. Return
    - d: 6
      t: 5
      k: ret
      l: 14.11. throw UnauthorizedException (Invalid email or password)
    - d: 5
      t: 4
      k: ret
      l: 14.12. Return 401 Unauthorized (ApiResponse)
    - d: 4
      t: 3
      k: ret
      l: 14.13. Return error response
    - d: 3
      t: 2
      k: ret
      l: 14.14. Return LoginResult(Success=false, message)
    - d: 2
      t: 1
      k: ret
      l: 14.15. Return View(model) with error message
    - d: 1
      t: 0
      k: ret
      l: 14.16. Display error message
  - guard: '[password correct BUT email not verified]'
    body:
    - d: 6
      t: 11
      k: call
      l: '15.1. AddAsync(LoginAudit: fail)'
    - d: 11
      t: 6
      k: ret
      l: 15.2. Return
    - d: 6
      t: 9
      k: call
      l: 15.3. SaveChangesAsync()
    - d: 9
      t: 12
      k: call
      l: 15.4. INSERT LoginAudit
    - d: 12
      t: 9
      k: ret
      l: 15.5. Return saved
    - d: 9
      t: 6
      k: ret
      l: 15.6. Return
    - d: 6
      t: 5
      k: ret
      l: 15.7. throw ForbiddenException (Please verify your email before logging in)
    - d: 5
      t: 4
      k: ret
      l: 15.8. Return 403 Forbidden (ApiResponse)
    - d: 4
      t: 3
      k: ret
      l: 15.9. Return error response
    - d: 3
      t: 2
      k: ret
      l: 15.10. Return LoginResult(Success=false, message)
    - d: 2
      t: 1
      k: ret
      l: 15.11. Return View(model) with error message
    - d: 1
      t: 0
      k: ret
      l: 15.12. Display verify-email message
  - guard: '[login valid (password correct AND email verified)]'
    body:
    - d: 6
      t: 7
      k: call
      l: 16.1. Verify(request.Password, account.PasswordHash)
    - d: 7
      t: 6
      k: ret
      l: 16.2. Return true
    - d: 6
      t: 8
      k: call
      l: 16.4. GenerateAccessToken(account)
    - d: 8
      t: 6
      k: ret
      l: 16.5. Return (accessToken JWT, expiresIn)
    - d: 6
      t: 8
      k: call
      l: 16.6. GenerateRefreshToken()
    - d: 8
      t: 6
      k: ret
      l: 16.7. Return refreshToken (random 64 bytes)
    - d: 6
      t: 10
      k: call
      l: '16.8. AddAsync(RefreshToken: expires in 7 days)'
    - d: 10
      t: 6
      k: ret
      l: 16.9. Return
    - d: 6
      t: 11
      k: call
      l: '16.10. AddAsync(LoginAudit: success)'
    - d: 11
      t: 6
      k: ret
      l: 16.11. Return
    - d: 6
      t: 9
      k: call
      l: 16.12. SaveChangesAsync()
    - d: 9
      t: 12
      k: call
      l: 16.13. UPDATE Account + INSERT RefreshToken + INSERT LoginAudit
    - d: 12
      t: 9
      k: ret
      l: 16.14. Return saved
    - d: 9
      t: 6
      k: ret
      l: 16.15. Return
    - d: 6
      t: 5
      k: ret
      l: 16.16. Return LoginResponse
    - d: 5
      t: 4
      k: ret
      l: 16.17. Return 200 OK ApiResponse<LoginResponse>
    - d: 4
      t: 3
      k: ret
      l: 16.18. Return response data
    - d: 3
      t: 2
      k: ret
      l: 16.19. Return LoginResult(Success=true, data)
    - frame: alt
      sections:
      - guard: '[Data.Role == "Admin"]'
        body:
        - d: 2
          t: 1
          k: ret
          l: 16.21. Redirect to /Admin
        - d: 1
          t: 0
          k: ret
          l: 16.22. Display Admin Dashboard
      - guard: '[Data.Role == "Manager"]'
        body:
        - d: 2
          t: 1
          k: ret
          l: 16.23. Redirect to /Manager
        - d: 1
          t: 0
          k: ret
          l: 16.24. Display Manager Dashboard
      - guard: '[else]'
        body:
        - d: 2
          t: 1
          k: ret
          l: 16.25. Redirect to Home
        - d: 1
          t: 0
          k: ret
          l: 16.26. Display Homepage
  - guard: '[Data.Role == "Admin"]'
    body: []
  - guard: '[Data.Role == "Manager"]'
    body: []
  - guard: '[else]'
    body: []
