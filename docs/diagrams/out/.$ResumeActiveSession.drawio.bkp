        <mxCell id="s-m66" value="16. GetActiveSessionAsync(userId, ct)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1285" y="808" as="sourcePoint" /><mxPoint x="1490" y="808" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s-m67" value="17. SELECT InterviewSession WHERE Status IN (&quot;InProgress&quot;,&quot;Paused&quot;)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="838" as="sourcePoint" /><mxPoint x="1645" y="838" as="targetPoint" /></mxGeometry></mxCell>
