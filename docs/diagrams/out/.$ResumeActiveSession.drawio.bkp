        <mxCell id="s-m56" value="6. Guid.Parse(User.FindFirstValue(NameIdentifier))" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1045.0" y="308" as="sourcePoint" /><mxPoint x="1045.0" y="338" as="targetPoint" /><Array as="points"><mxPoint x="1085.0" y="308" /><mxPoint x="1085.0" y="338" /></Array></mxGeometry></mxCell>
        <mxCell id="s-m57" value="7. GetActiveSessionAsync(userId, ct)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1045" y="368" as="sourcePoint" /><mxPoint x="1275" y="368" as="targetPoint" /></mxGeometry></mxCell>
