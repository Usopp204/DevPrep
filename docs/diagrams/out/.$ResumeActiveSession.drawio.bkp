        <mxCell id="s-m51" value="1. Open the interview dashboard" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="158" as="sourcePoint" /><mxPoint x="195" y="158" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s-m52" value="2. GET /Interview" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="205" y="188" as="sourcePoint" /><mxPoint x="420" y="188" as="targetPoint" /></mxGeometry></mxCell>
