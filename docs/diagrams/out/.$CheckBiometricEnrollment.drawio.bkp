        <mxCell id="s-g54" value="[!statusOk - the lookup failed, the gate fails open]" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="1676" width="273" height="20" as="geometry" /></mxCell>
        <mxCell id="s-m55" value="1. Open Profile &amp;gt; Identity verification" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="110" as="sourcePoint" /><mxPoint x="185" y="110" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s-m56" value="2. GET /Profile/Identity" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="195" y="140" as="sourcePoint" /><mxPoint x="630" y="140" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s-m57" value="3. GetStatusAsync(ct)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="170" as="sourcePoint" /><mxPoint x="1065" y="170" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s-m58" value="4. GET api/profiles/me/biometrics" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1075" y="200" as="sourcePoint" /><mxPoint x="1250" y="200" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s-m59" value="5. Forward (route profiles-biometrics-root-route)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="230" as="sourcePoint" /><mxPoint x="1470" y="230" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s-m60" value="6. Guid.Parse(User.FindFirstValue(NameIdentifier))" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1480.0" y="260" as="sourcePoint" /><mxPoint x="1480.0" y="290" as="targetPoint" /><Array as="points"><mxPoint x="1520.0" y="260" /><mxPoint x="1520.0" y="290" /></Array></mxGeometry></mxCell>
        <mxCell id="s-m61" value="7. GetStatusAsync(userId, ct)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1480" y="320" as="sourcePoint" /><mxPoint x="1740" y="320" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s-m62" value="8. ListByUserAsync(userId, ct)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1750" y="350" as="sourcePoint" /><mxPoint x="2005" y="350" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s-m63" value="9. SELECT ProfileBiometrics WHERE UserId" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2015" y="380" as="sourcePoint" /><mxPoint x="2185" y="380" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s-m64" value="10. Return rows" style="html=1;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#000000;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2185" y="410" as="sourcePoint" /><mxPoint x="2015" y="410" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s-m65" value="11. Return List&amp;lt;ProfileBiometric&amp;gt;" style="html=1;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#000000;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2005" y="440" as="sourcePoint" /><mxPoint x="1750" y="440" as="targetPoint" /></mxGeometry></mxCell>
