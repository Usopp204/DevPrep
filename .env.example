# ============================================================
#  DevPrep - Bien moi truong dung chung cho cac microservice
#  ------------------------------------------------------------
#  File nay LA file config that (repo private, da chap nhan rui ro).
#  Code cac service nap truc tiep file nay (Env.TraversePath().Load(".env.example")).
#  Neu lo secret -> tu rotate: Gmail App Password + GitHub OAuth secret.
# ============================================================

# =========================
# GLOBAL_
# =========================
GLOBAL_ASPNETCORE_ENVIRONMENT=Development
GLOBAL_API_GATEWAY_PORT=7000
# Giao tiep lien service qua HTTP (da bo RabbitMQ/Kafka).
# Khoa noi bo cho cac endpoint /internal/*: AuthAPI gui header X-Internal-Api-Key,
# Notification/User doi chieu voi gia tri nay (de trong = bo qua kiem tra, tien chay dev).
INTERNAL_API_KEY=devprep-internal-2026
# Base URL noi bo de cac service goi truc tiep (khong qua gateway).
AUTH_API_BASEURL=http://localhost:7001
NOTIFICATION_API_BASEURL=http://localhost:7010
USER_API_BASEURL=http://localhost:7002

# =========================
# AI_
# =========================
AI_APP_NAME=DevPrep AI Service
AI_HOST=0.0.0.0
AI_PORT=8000

