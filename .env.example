# Copy this file to ".env" (same folder) and replace the placeholders with
# your real local values. ".env" is gitignored — never commit real secrets.

# --- SQL Server connection strings (per-service DB, adjust Server/Password to your machine) ---
PAYMENT_DB_CONNECTION_STRING=Server=localhost\SQLEXPRESS;Database=DevPrep_Payment;User Id=sa;Password=your-sql-password-here;TrustServerCertificate=True;
AUTH_DB_CONNECTION_STRING=Server=localhost\SQLEXPRESS;Database=DevPrep_Auth;User Id=sa;Password=your-sql-password-here;TrustServerCertificate=True;

# --- ai-service: CV/JD parser model (Hugging Face) ---
AI_MODEL_ID=your-huggingface-model-id-here
HF_TOKEN=your-huggingface-token-here
# Optional: point the Hugging Face model cache at a drive with >=6GB free.
# HF_HOME=D:\hf-cache

# --- ai-service: Evaluator judge (Gemini) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_JUDGE_MODEL=gemini-3.1-pro

# --- ai-service: Voice STT (Deepgram) ---
DEEPGRAM_API_KEY=your-deepgram-api-key-here
DEEPGRAM_STT_MODEL=nova-3

# --- ai-service: Voice TTS (ElevenLabs) ---
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# --- ai-service: internal service-to-service auth ---
# The .NET services call ai-service with header X-Internal-Api-Key matching this value.
INTERNAL_API_KEY=your-internal-service-api-key-here

# --- ai-service: local Gemma interviewer ---
# Host path of the LoRA adapter dir (Docker overrides this via infra/.env).
# The base model google/gemma-2b-it (~5GB) downloads into HF_HOME on first load.
GEMMA_MODEL_DIR=path-to-repo\ai-service\models\gemma-2b-devprep-sft

# --- ai-service: evaluator self-consistency (grades per answer; median wins) ---
SELF_CONSISTENCY_RUNS=3

# --- ai-service: CORS ---
ALLOWED_ORIGINS=*

# --- UserAPI hotfix: AdminUserRepository still reads ConnectionStrings:DefaultConnection ---
# Point it at the same DB as USER_DB_CONNECTION_STRING.
# TODO: remove once UserAPI code reads USER_DB_CONNECTION_STRING everywhere.
ConnectionStrings__DefaultConnection=Server=localhost\SQLEXPRESS;Database=DevPrep_User;User Id=sa;Password=your-sql-password-here;TrustServerCertificate=True;

# --- JWT (shared: AuthAPI signs tokens, other services verify them) ---
# Double underscore maps to ":" in .NET configuration (Jwt__Key -> Jwt:Key).
#
# BẮT BUỘC ĐỔI. AuthAPI TỪ CHỐI KHỞI ĐỘNG nếu khoá vẫn là chuỗi mẫu này, hoặc ngắn hơn 32 ký tự
# — token ký bằng khoá ai cũng biết thì ai cũng giả mạo được. Sinh khoá riêng bằng PowerShell:
#
#     $b = New-Object byte[] 48
#     [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#     [Convert]::ToBase64String($b)
#
# Mọi service phải dùng CHUNG một khoá thì mới verify được token do AuthAPI phát ra.
Jwt__Key=change-me-32-chars-min-random-secret-here
Jwt__Issuer=DevPrep.AuthAPI
Jwt__Audience=DevPrep.Client
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=7
# ==============================================================================
# Voice biometrics — speech-presence gate (ai-service/biometrics)
# ==============================================================================
# Chặn mẫu ghi âm không có tiếng nói (im lặng, hoặc chỉ tiếng ồn đều như quạt máy).
# Sửa được KHÔNG cần rebuild image: đổi giá trị rồi chạy
#     cd infra && docker compose up -d ai-service        (không cần --build)
# Đọc dòng log "Voice sample quality:" của ai-service để lấy số thật mà hiệu chỉnh.
#
# Tín hiệu phân biệt chính: độ chênh lệch giữa đoạn to và đoạn nhỏ trong cùng bản ghi
# (p95-p10 của dB từng khung). Tiếng nói thật ~15-30 dB, quạt máy ~1-3 dB. Ngưỡng tuyệt
# đối KHÔNG dùng được ở đây: quạt to vẫn to hơn người nói nhỏ.
VOICE_MIN_DYNAMIC_RANGE_DB=6.0

# Một khung phải vượt sàn ồn của chính bản ghi bao nhiêu dB thì mới tính là tiếng nói.
VOICE_SPEECH_FLOOR_MARGIN_DB=6.0

# Cần tối thiểu bao nhiêu giây tiếng nói, trên tổng ~4s mà UI đã bắt buộc ghi.
VOICE_MIN_SPEECH_SEC=1.0

# Chốt chặn mic chết / im lặng số, áp lên khung to nhất. Cố ý để rất thấp — việc phân biệt
# tiếng nói với tiếng ồn là nhiệm vụ của VOICE_MIN_DYNAMIC_RANGE_DB, không phải biến này.
VOICE_SPEECH_ENERGY_THRESHOLD=0.003

# ==============================================================================
# ai-service logging
# ==============================================================================
# Mức log cho logger của chính dự án ("app" và "biometrics"); thư viện ngoài (torch,
# speechbrain, transformers, httpx) giữ mức mặc định riêng nên không làm nhiễu log.
# Trước đây ai-service KHÔNG cấu hình logging, nên mọi logger.info đều bị nuốt im lặng.
LOG_LEVEL=INFO
