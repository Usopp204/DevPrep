{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "BodySizeLimitMb": 10,
    "RequestTimeoutSeconds": 30
  },
  "ReverseProxy": {
    "Routes": {
        "auth-route": {
            "ClusterId": "auth-cluster",
            "Match": {
                "Path": "/api/auth/{**catch-all}"
            }
        },
        "users-route": {
            "ClusterId": "users-cluster",
            "Match": {
                "Path": "/api/users/{**catch-all}"
            }
        },
        "document-route": {
            "ClusterId": "document-cluster",
            "Match": {
                "Path": "/api/document/{**catch-all}"
            },
            "Transforms": [
                {
                    "PathRemovePrefix": "/api/document"
                }
            ]
        },
        "questions-route": {
            "ClusterId": "questions-cluster",
            "Match": {
                "Path": "/api/questions/{**catch-all}"
            },
            "Transforms": [
                {
                    "PathRemovePrefix": "/api/questions"
                }
            ]
        },
