@*
    Firebase SSO (Google + GitHub) — dùng chung cho Login và Register.
    Nút bấm cần có id="btn-google" / id="btn-github".
    Config Firebase (apiKey là khóa public phía client, không phải secret).

    Xử lý auth/account-exists-with-different-credential mà KHÔNG tự mở popup thứ 2
    (tránh auth/popup-blocked): lưu tạm credential đang chờ, báo user tự bấm nút
    provider gốc; khi đăng nhập provider đó xong thì tự liên kết credential đã lưu.
*@
<form asp-controller="Auth" asp-action="SsoFirebase" method="post" id="sso-form" class="d-none">
    <input type="hidden" name="idToken" id="sso-idtoken" />
</form>

<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
    import {
        getAuth, GoogleAuthProvider, GithubAuthProvider, signInWithPopup,
        fetchSignInMethodsForEmail, linkWithCredential
    } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";

    const app = initializeApp({
        apiKey: "AIzaSyDMBq3gBut_une3SM88aILCHy_P-b2yRaY",
        authDomain: "devprep-6872e.firebaseapp.com",
        projectId: "devprep-6872e",
        appId: "1:5087839335:web:3c52a527f1fe746643c0c2"
    });
    const auth = getAuth(app);
    const providers = { google: new GoogleAuthProvider(), github: new GithubAuthProvider() };
    const providerByMethod = { "google.com": providers.google, "github.com": providers.github };
    const niceName = { "google.com": "Google", "github.com": "GitHub" };

    // Credential đang chờ liên kết (được set khi gặp lỗi account-exists), persist giữa 2 lần bấm.
    let pendingCred = null;

    function submitToken(idToken) {
        document.getElementById('sso-idtoken').value = idToken;
        document.getElementById('sso-form').submit();
    }

    function pendingCredentialFromError(error) {
        return GithubAuthProvider.credentialFromError(error) || GoogleAuthProvider.credentialFromError(error);
    }

    // KHÔNG mở popup ở đây — chỉ lưu credential + hướng dẫn user bấm nút provider gốc.
    async function handleAccountExists(error) {
        const email = error.customData && error.customData.email;
        pendingCred = pendingCredentialFromError(error);

        let methods = [];
        try { methods = await fetchSignInMethodsForEmail(auth, email); } catch (_) { }
        const existingMethod = methods.find(m => providerByMethod[m]) || "google.com";
        const nice = niceName[existingMethod] || existingMethod;

        alert(
            'Email "' + (email || '') + '" đã được đăng ký bằng ' + nice + '.\n\n' +
            'Hãy bấm nút ' + nice + ' để đăng nhập — GitHub sẽ tự được liên kết vào tài khoản này.'
        );
    }

    async function ssoLogin(key, button) {
        const original = button ? button.innerHTML : null;
        try {
            if (button) button.disabled = true;
            const result = await signInWithPopup(auth, providers[key]);

            // Nếu vừa đăng nhập bằng provider gốc và có credential GitHub đang chờ -> liên kết.
            if (pendingCred) {
                try { await linkWithCredential(result.user, pendingCred); } catch (_) { }
                pendingCred = null;
            }

            submitToken(await result.user.getIdToken());
        } catch (e) {
            if (button) { button.disabled = false; if (original) button.innerHTML = original; }
            if (e && e.code === 'auth/popup-closed-by-user') return;
            if (e && e.code === 'auth/account-exists-with-different-credential') {
                await handleAccountExists(e);
                return;
            }
            console.error('SSO error', e);
            alert('Sign-in failed: ' + ((e && (e.message || e.code)) || e));
        }
    }

    const g = document.getElementById('btn-google');
    const h = document.getElementById('btn-github');
    if (g) g.addEventListener('click', () => ssoLogin('google', g));
    if (h) h.addEventListener('click', () => ssoLogin('github', h));
</script>
