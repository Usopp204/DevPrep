@model WebClient.Models.Auth.ResetPasswordViewModel
@{
    Layout = null;
    var modelError = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
}
<!DOCTYPE html>
<html data-bs-theme="dark" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Set New Password | DevPrep AI</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@@100..900&family=Hanken+Grotesk:wght@@100..900&family=JetBrains+Mono:ital,wght@@0,100..800;1,100..800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200&display=block" rel="stylesheet">
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-page d-flex flex-column min-vh-100 position-relative">
    <main class="flex-grow-1 d-flex align-items-center justify-content-center px-3 px-md-5 py-5 overflow-hidden position-relative">
        <div class="ambient-glow glow-purple"></div>
        <div class="ambient-glow glow-blue"></div>

        <div class="w-100 glass-panel p-4 p-md-5" style="max-width: 440px;">
            <header class="mb-4 text-center">
                <h1 class="hanken-font text-on-surface fw-bold mb-2" style="font-size: 24px; line-height: 32px;">Set New Password</h1>
                <p class="text-on-surface-variant m-0" style="font-size: 14px;">Create a strong password for your account.</p>
            </header>

            @if (!string.IsNullOrEmpty(modelError))
            {
                <div class="auth-alert mb-3"><span class="material-symbols-outlined">warning</span><span>@modelError</span></div>
            }

            <form asp-controller="Auth" asp-action="ResetPassword" method="post" class="d-flex flex-column gap-3" id="passwordForm" novalidate>
                <input type="hidden" asp-for="Token" />

                <!-- New Password -->
                <div class="d-flex flex-column gap-1">
                    <label class="custom-label text-on-surface-variant mb-1" asp-for="NewPassword">New Password</label>
                    <div class="position-relative">
                        <input asp-for="NewPassword" class="form-control custom-input py-2 px-3 pe-5" placeholder="••••••••" type="password" autocomplete="new-password">
                        <button class="icon-btn position-absolute top-50 end-0 translate-middle-y me-3" onclick="toggleVisibility('NewPassword', this)" type="button">
                            <span class="material-symbols-outlined">visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="auth-field-error"></span>
                    <!-- Strength Indicator (ẩn khi chưa nhập gì) -->
                    <div class="pt-2" id="strengthWrap" style="display: none;">
                        <div class="w-100 bg-surface-container-highest rounded-pill overflow-hidden" style="height: 4px;">
                            <div class="strength-bar bg-error" id="strengthIndicator"></div>
                        </div>
                        <div class="custom-label mt-2 text-on-surface-variant text-capitalize" id="strengthLabel" style="letter-spacing: normal;">Strength: <span class="text-error">Weak</span></div>
                    </div>
                    <!-- Password requirements checklist (hiện khi focus ô New Password) -->
                    <div class="pw-reqs" id="pw-reqs">
                        <p class="pw-reqs-title">Password must contain:</p>
                        <ul class="pw-reqs-list">
                            <li class="pw-req" data-rule="len"><span class="material-symbols-outlined pw-req-icon">radio_button_unchecked</span><span>At least 8 characters</span></li>
                            <li class="pw-req" data-rule="upper"><span class="material-symbols-outlined pw-req-icon">radio_button_unchecked</span><span>One uppercase letter (A-Z)</span></li>
                            <li class="pw-req" data-rule="lower"><span class="material-symbols-outlined pw-req-icon">radio_button_unchecked</span><span>One lowercase letter (a-z)</span></li>
                            <li class="pw-req" data-rule="digit"><span class="material-symbols-outlined pw-req-icon">radio_button_unchecked</span><span>One number (0-9)</span></li>
                        </ul>
                    </div>
                </div>

                <!-- Confirm Password -->
                <div class="d-flex flex-column gap-1 pt-2">
                    <label class="custom-label text-on-surface-variant mb-1" asp-for="ConfirmPassword">Confirm Password</label>
                    <div class="position-relative">
                        <input asp-for="ConfirmPassword" class="form-control custom-input py-2 px-3 pe-5" placeholder="••••••••" type="password" autocomplete="new-password">
                        <button class="icon-btn position-absolute top-50 end-0 translate-middle-y me-3" onclick="toggleVisibility('ConfirmPassword', this)" type="button">
                            <span class="material-symbols-outlined">visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="auth-field-error"></span>
                </div>

                <div class="pt-3">
                    <button class="w-100 btn btn-primary fw-bold rounded-3 py-2 px-3 d-flex align-items-center justify-content-center gap-2" type="submit" style="min-height: 48px;">Update Password</button>
                </div>

                <footer class="text-center" style="border-top: 1px solid rgba(255, 255, 255, 0.1); margin-top: 24px; padding-top: 24px;">
                    <a class="back-link d-flex justify-content-center align-items-center gap-2 text-decoration-none" asp-controller="Auth" asp-action="Login" style="font-family: 'JetBrains Mono', monospace; font-size: 11px; line-height: 16px; letter-spacing: 0.05em; font-weight: 500;">
                        <span class="material-symbols-outlined" style="font-size: 16px;">arrow_back</span>
                        <span>BACK TO LOGIN</span>
                    </a>
                </footer>
            </form>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script>
        function toggleVisibility(inputId, button) {
            const input = document.getElementById(inputId);
            const icon = button.querySelector('.material-symbols-outlined');
            if (input.type === 'password') {
                input.type = 'text';
                icon.innerText = 'visibility_off';
            } else {
                input.type = 'password';
                icon.innerText = 'visibility';
            }
        }

        const passwordInput = document.getElementById('NewPassword');
        const strengthBar = document.getElementById('strengthIndicator');
        const strengthLabel = document.getElementById('strengthLabel').querySelector('span');
        const strengthWrap = document.getElementById('strengthWrap');

        passwordInput.addEventListener('input', function () {
            const val = passwordInput.value;

            // Ẩn phần Strength khi ô trống, hiện khi có ít nhất 1 ký tự.
            strengthWrap.style.display = val.length > 0 ? 'block' : 'none';

            let strength = 0;
            if (val.length > 5) strength++;
            if (val.length > 8) strength++;
            if (/[A-Z]/.test(val)) strength++;
            if (/[0-9]/.test(val)) strength++;
            if (/[^A-Za-z0-9]/.test(val)) strength++;

            // 3 mức, bỏ trạng thái None: Weak / Medium / Strong.
            if (strength < 3) {
                strengthBar.className = 'strength-bar bg-error';
                strengthBar.style.width = '33%';
                strengthLabel.innerText = 'Weak';
                strengthLabel.className = 'text-error';
            } else if (strength < 5) {
                strengthBar.className = 'strength-bar bg-tertiary';
                strengthBar.style.width = '66%';
                strengthLabel.innerText = 'Medium';
                strengthLabel.className = 'text-tertiary';
            } else {
                strengthBar.className = 'strength-bar bg-secondary-custom';
                strengthBar.style.width = '100%';
                strengthLabel.innerText = 'Strong';
                strengthLabel.className = 'text-secondary-custom';
            }
        });

        // Password requirements checklist
        const pwReqPanel = document.getElementById('pw-reqs');
        const pwRules = {
            len: v => v.length >= 8,
            upper: v => /[A-Z]/.test(v),
            lower: v => /[a-z]/.test(v),
            digit: v => /[0-9]/.test(v)
        };
        function updatePwReqs() {
            const v = passwordInput.value;
            pwReqPanel.querySelectorAll('.pw-req').forEach(function (li) {
                const ok = pwRules[li.getAttribute('data-rule')](v);
                li.classList.toggle('met', ok);
                li.querySelector('.pw-req-icon').textContent = ok ? 'check_circle' : 'radio_button_unchecked';
            });
        }
        passwordInput.addEventListener('focus', function () { pwReqPanel.classList.add('show'); });
        passwordInput.addEventListener('input', updatePwReqs);
        passwordInput.addEventListener('blur', function () { if (!passwordInput.value) pwReqPanel.classList.remove('show'); });
        updatePwReqs();
    </script>
</body>
</html>
