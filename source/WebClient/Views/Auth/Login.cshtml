@model WebClient.Models.Auth.LoginViewModel
@{
    Layout = null;
    var modelError = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
    var successMessage = TempData["Message"] as string;
    var ssoError = TempData["Error"] as string;
    var errorMessage = modelError ?? ssoError;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | DevPrep AI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@100..900&family=JetBrains+Mono:wght@@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="login-page">
    <!-- Ambient Background Elements -->
    <div class="ambient-blob blob-primary"></div>
    <div class="ambient-blob blob-secondary"></div>

    <!-- Main Content Shell -->
    <main class="login-shell">
        <div class="glass-card">
            <!-- Header -->
            <header class="login-header">
                <div class="login-title-group">
                    <h2 class="login-welcome">Welcome Back</h2>
                    <p class="login-title">Login</p>
                </div>
            </header>

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="login-alert login-success">
                    <span class="material-symbols-outlined">check_circle</span>
                    <span>@successMessage</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="login-alert" id="error-alert">
                    <span class="material-symbols-outlined">warning</span>
                    <span>@errorMessage</span>
                </div>
            }

            <!-- Login Form -->
            <form asp-controller="Auth" asp-action="Login" method="post" class="login-form" novalidate>
                <!-- Email -->
                <div class="login-field">
                    <label class="login-label" asp-for="Email">Email Address</label>
                    <div class="login-input-group">
                        <span class="material-symbols-outlined login-input-icon">mail</span>
                        <input asp-for="Email" class="login-input" placeholder="name@@company.com" type="email" autocomplete="email">
                    </div>
                    <span asp-validation-for="Email" class="login-field-error"></span>
                </div>

                <!-- Password -->
                <div class="login-field">
                    <label class="login-label" asp-for="Password">Password</label>
                    <div class="login-input-group">
                        <span class="material-symbols-outlined login-input-icon">lock</span>
                        <input asp-for="Password" class="login-input has-eye" id="password-input" placeholder="••••••••" type="password" autocomplete="current-password">
                        <button class="login-eye-btn" onclick="togglePassword()" type="button">
                            <span class="material-symbols-outlined" id="password-toggle-icon">visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="login-field-error"></span>
                    <div class="login-forgot">
                        <a asp-controller="Auth" asp-action="ForgotPassword">Forgot Password?</a>
                    </div>
                </div>

                <!-- Submit -->
                <button class="login-btn inner-light" type="submit">Login</button>
            </form>

            <!-- SSO Divider -->
            <div class="login-divider">
                <div class="line"></div>
                <span class="txt">or continue with</span>
                <div class="line"></div>
            </div>

            <!-- SSO Buttons (Google / GitHub via Firebase) -->
            <div class="login-sso-grid">
                <button type="button" class="login-sso-btn" id="btn-google">
                    <svg viewBox="0 0 24 24">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="currentColor"></path>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="currentColor"></path>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="currentColor"></path>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="currentColor"></path>
                    </svg>
                    <span>Google</span>
                </button>
                <button type="button" class="login-sso-btn" id="btn-github">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 1.27a11 11 0 00-3.48 21.46c.55.1.75-.24.75-.53v-1.87c-3.06.66-3.7-1.47-3.7-1.47-.5-1.27-1.23-1.6-1.23-1.6-1-1.68.08-1.65.08-1.65 1.1.08 1.68 1.13 1.68 1.13.98 1.68 2.58 1.2 3.21.92.1-.72.39-1.2.71-1.48-2.44-.27-5-1.22-5-5.43 0-1.2.43-2.18 1.13-2.95-.11-.28-.49-1.4.11-2.9 0 0 .92-.3 3.03 1.13a10.53 10.53 0 015.5 0c2.1-1.43 3.03-1.13 3.03-1.13.6 1.5.22 2.62.11 2.9.71.77 1.13 1.75 1.13 2.95 0 4.22-2.56 5.15-5 5.42.39.34.75 1 .75 2.03v3c0 .29.19.64.76.53A11 11 0 0012 1.27z" fill="currentColor"></path>
                    </svg>
                    <span>GitHub</span>
                </button>
            </div>

            <!-- Footer -->
            <div class="login-footer">
                <p>
                    Don't have an account?
                    <a asp-controller="Auth" asp-action="Register">Register</a>
                </p>
            </div>
        </div>
    </main>

    <script>
        function togglePassword() {
            const passwordInput = document.getElementById('password-input');
            const toggleIcon = document.getElementById('password-toggle-icon');
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.textContent = 'visibility_off';
            } else {
                passwordInput.type = 'password';
                toggleIcon.textContent = 'visibility';
            }
        }

        document.addEventListener('mousemove', (e) => {
            const x = e.clientX / window.innerWidth;
            const y = e.clientY / window.innerHeight;
            const primaryBlob = document.querySelector('.blob-primary');
            const secondaryBlob = document.querySelector('.blob-secondary');
            primaryBlob.style.transform = `translate(${x * 30}px, ${y * 30}px)`;
            secondaryBlob.style.transform = `translate(${-(x * 30)}px, ${-(y * 30)}px)`;
        });
    </script>

    @await Html.PartialAsync("_FirebaseSso")
</body>
</html>
