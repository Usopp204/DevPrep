@model WebClient.Models.Auth.RegisterViewModel
@{
    Layout = null;
    var confirmError = ViewData.ModelState[nameof(Model.ConfirmPassword)]?.Errors.FirstOrDefault()?.ErrorMessage;
    var hasConfirmError = !string.IsNullOrEmpty(confirmError);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register | DevPrep AI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@100..900&family=JetBrains+Mono:wght@@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
</head>
<body class="register-page d-flex align-items-center justify-content-center min-vh-100 p-3">
    <!-- Ambient Background Decorations -->
    <div class="ambient-blob blob-purple"></div>
    <div class="ambient-blob blob-cyan"></div>

    <!-- Registration Card -->
    <main class="glass-card">
        <!-- Logo & Header -->
        <header class="reg-header text-center">
            <h2 class="reg-title">Create Your Account</h2>
            <p class="reg-subtitle">Start your journey to landing your dream engineering role.</p>
        </header>

        <!-- Form -->
        <form asp-controller="Auth" asp-action="Register" method="post" class="reg-form" novalidate>
            <!-- Server / model-level errors (e.g. email already registered, gateway down) -->
            <div asp-validation-summary="ModelOnly" class="reg-alert"></div>

            <!-- Full Name -->
            <div class="reg-field">
                <label class="reg-label" asp-for="FullName">Full Name</label>
                <div class="reg-input-group">
                    <span class="material-symbols-outlined reg-input-icon">person</span>
                    <input asp-for="FullName" class="form-control reg-input" placeholder="Linus Torvalds" type="text" autocomplete="name">
                </div>
                <span asp-validation-for="FullName" class="reg-field-error"></span>
            </div>

            <!-- Email -->
            <div class="reg-field">
                <label class="reg-label" asp-for="Email">Email Address</label>
                <div class="reg-input-group">
                    <span class="material-symbols-outlined reg-input-icon">mail</span>
                    <input asp-for="Email" class="form-control reg-input" placeholder="dev@@example.com" type="email" autocomplete="email">
                </div>
                <span asp-validation-for="Email" class="reg-field-error"></span>
            </div>

            <!-- Password -->
            <div class="reg-field">
                <label class="reg-label" asp-for="Password">Password</label>
                <div class="reg-input-group">
                    <span class="material-symbols-outlined reg-input-icon">lock</span>
                    <input asp-for="Password" class="form-control reg-input has-eye" placeholder="••••••••" type="password" autocomplete="new-password">
                    <button class="reg-eye-btn" onclick="togglePassword('Password')" type="button">
                        <span class="material-symbols-outlined" id="eye-Password">visibility_off</span>
                    </button>
                </div>
                <span asp-validation-for="Password" class="reg-field-error"></span>
                <!-- Password requirements checklist (hiện khi focus ô Password) -->
                <div class="pw-reqs" id="pw-reqs">
                    <p class="pw-reqs-title">Password must contain:</p>
                    <ul class="pw-reqs-list">
                        <li class="pw-req" data-rule="len"><span class="material-symbols-outlined pw-req-icon">radio_button_unchecked</span><span>At least 8 characters</span></li>
                        <li class="pw-req" data-rule="upper"><span class="material-symbols-outlined pw-req-icon">radio_button_unchecked</span><span>One uppercase letter (A-Z)</span></li>
                        <li class="pw-req" data-rule="lower"><span class="material-symbols-outlined pw-req-icon">radio_button_unchecked</span><span>One lowercase letter (a-z)</span></li>
                        <li class="pw-req" data-rule="digit"><span class="material-symbols-outlined pw-req-icon">radio_button_unchecked</span><span>One number (0-9)</span></li>
                    </ul>
                </div>
            </div>

            <!-- Confirm Password -->
            <div class="reg-field">
                <label class="reg-label" asp-for="ConfirmPassword">Confirm Password</label>
                <div class="reg-input-group">
                    <span class="material-symbols-outlined reg-input-icon @(hasConfirmError ? "is-error" : "")">lock_reset</span>
                    <input asp-for="ConfirmPassword" class="form-control reg-input has-eye @(hasConfirmError ? "is-error" : "")" type="password" autocomplete="new-password">
                    <button class="reg-eye-btn" onclick="togglePassword('ConfirmPassword')" type="button">
                        <span class="material-symbols-outlined">visibility_off</span>
                    </button>
                </div>
                @if (hasConfirmError)
                {
                    <div class="reg-error-msg">
                        <span class="material-symbols-outlined">error</span>
                        <span>@confirmError</span>
                    </div>
                }
            </div>

            <!-- Primary Action -->
            <button type="submit" class="reg-btn-primary">Create Account</button>

            <!-- Divider -->
            <div class="reg-divider">
                <div class="line"></div>
                <span class="txt">or continue with</span>
                <div class="line"></div>
            </div>

            <!-- SSO Buttons -->
            <div class="reg-sso-grid">
                <button type="button" class="reg-sso-btn" id="btn-google">
                    <svg viewBox="0 0 24 24">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="currentColor"></path>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="currentColor"></path>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="currentColor"></path>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="currentColor"></path>
                    </svg>
                    <span>Google</span>
                </button>
                <button type="button" class="reg-sso-btn" id="btn-github">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 1.27a11 11 0 00-3.48 21.46c.55.09.73-.24.73-.53v-1.84c-3.03.66-3.67-1.46-3.67-1.46-.5-1.24-1.21-1.58-1.21-1.58-1-.67.08-.65.08-.65 1.1.08 1.68 1.13 1.68 1.13.98 1.68 2.58 1.2 3.2 0.9.1-.7.38-1.2.69-1.48-2.42-.27-4.97-1.2-4.97-5.38 0-1.19.43-2.17 1.14-2.94-.12-.27-.5-1.38.1-2.9 0 0 .92-.29 3 1.12a10.4 10.4 0 015.5 0c2.1-1.4 3.02-1.12 3.02-1.12.6 1.52.22 2.63.1 2.9.71.77 1.14 1.75 1.14 2.94 0 4.19-2.55 5.1-4.98 5.37.4.34.75 1.02.75 2.06v3.06c0 .3.18.63.74.52a11 11 0 00-3.5-21.46z" fill="currentColor"></path>
                    </svg>
                    <span>GitHub</span>
                </button>
            </div>
        </form>

        <!-- Footer -->
        <footer class="reg-footer text-center">
            <p>
                Already have an account?
                <a asp-controller="Auth" asp-action="Login">Sign In</a>
            </p>
        </footer>
    </main>

    <script>
        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const icon = input.nextElementSibling.querySelector('.material-symbols-outlined');
            if (input.type === "password") {
                input.type = "text";
                icon.innerText = "visibility";
            } else {
                input.type = "password";
                icon.innerText = "visibility_off";
            }
        }

        // Subtle parallax on ambient blobs following the cursor.
        document.addEventListener('mousemove', (e) => {
            const blobs = document.querySelectorAll('.ambient-blob');
            const x = (e.clientX / window.innerWidth - 0.5) * 50;
            const y = (e.clientY / window.innerHeight - 0.5) * 50;
            blobs[0].style.transform = `translate(${x}px, ${y}px)`;
            blobs[1].style.transform = `translate(${-x}px, ${-y}px)`;
        });

        // Password requirements checklist
        (function () {
            const pw = document.getElementById('Password');
            const panel = document.getElementById('pw-reqs');
            if (!pw || !panel) return;
            const rules = {
                len: v => v.length >= 8,
                upper: v => /[A-Z]/.test(v),
                lower: v => /[a-z]/.test(v),
                digit: v => /[0-9]/.test(v)
            };
            function update() {
                const v = pw.value;
                panel.querySelectorAll('.pw-req').forEach(function (li) {
                    const ok = rules[li.getAttribute('data-rule')](v);
                    li.classList.toggle('met', ok);
                    li.querySelector('.pw-req-icon').textContent = ok ? 'check_circle' : 'radio_button_unchecked';
                });
            }
            pw.addEventListener('focus', function () { panel.classList.add('show'); });
            pw.addEventListener('input', update);
            pw.addEventListener('blur', function () { if (!pw.value) panel.classList.remove('show'); });
            update();
        })();
    </script>

    @await Html.PartialAsync("_FirebaseSso")
</body>
</html>
