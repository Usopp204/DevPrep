@model WebClient.Models.Auth.ConfirmEmailViewModel
@{
    Layout = null;
    var modelError = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
    var hasToken = !string.IsNullOrEmpty(Model.Token);
}
<!DOCTYPE html>
<html data-bs-theme="dark" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Confirm Email | DevPrep AI</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@@100..900&family=Hanken+Grotesk:wght@@100..900&family=JetBrains+Mono:wght@@100..800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200&display=block" rel="stylesheet">
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-page">
    <div class="ambient-blob blob-purple"></div>
    <div class="ambient-blob blob-cyan"></div>

    <main class="d-flex flex-column align-items-center justify-content-center min-vh-100 p-3 w-100">
        <div class="glass-card rounded-4 p-4 p-md-5 d-flex flex-column align-items-center text-center" style="max-width: 420px;">
            <div class="icon-circle rounded-circle d-flex align-items-center justify-content-center mb-4">
                <span class="material-symbols-outlined fs-1">mark_email_read</span>
            </div>

            <h1 class="h3 fw-bold mb-2">Confirm Your Email</h1>
            <p class="text-surface-variant small mb-4" style="max-width: 280px;">
                Click the button below to verify your email address and activate your DevPrep account.
            </p>

            @if (!string.IsNullOrEmpty(modelError))
            {
                <div class="auth-alert w-100 mb-3"><span class="material-symbols-outlined">warning</span><span>@modelError</span></div>
            }

            @if (hasToken)
            {
                <form asp-controller="Auth" asp-action="ConfirmEmail" method="post" class="w-100">
                    <input type="hidden" asp-for="Token" />
                    <button class="primary-btn w-100 py-3 fw-bold" type="submit">Confirm Email</button>
                </form>
            }
            else
            {
                <p class="text-surface-variant small mb-0" style="max-width: 280px;">
                    Please open the verification link from your email again, or register once more to receive a new email.
                </p>
            }

            <div class="w-100 d-flex justify-content-center" style="border-top: 1px solid rgba(255, 255, 255, 0.1); margin-top: 32px; padding-top: 32px;">
                <a class="back-link text-decoration-none d-flex align-items-center justify-content-center gap-2" asp-controller="Auth" asp-action="Login" style="font-family: 'JetBrains Mono', monospace; font-size: 11px; line-height: 16px; letter-spacing: 0.05em; font-weight: 500;">
                    <span class="material-symbols-outlined" style="font-size: 14px;">arrow_back</span>BACK TO LOGIN
                </a>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>
