@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DevPrep AI - Chinh phục phỏng vấn kỹ thuật cùng AI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@100..900&family=JetBrains+Mono:wght@@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
</head>
<body class="home-page">
    <!-- Ambient Background -->
    <div class="hm-ambient">
        <div class="hm-blob hm-blob-1"></div>
        <div class="hm-blob hm-blob-2"></div>
    </div>

    @await Html.PartialAsync("_Navbar")

    <main class="hm-main">
        <!-- Hero -->
        <section class="hm-hero">
            <span class="hm-badge">BETA v2.0</span>
            <h1>Chinh phục phỏng vấn kỹ thuật cùng AI</h1>
            <p class="hm-hero-sub">
                Luyện tập các bài phỏng vấn System Design, Coding và Behavior với AI chuyên gia dành riêng cho Software Engineer tại Việt Nam.
            </p>
            <div class="hm-hero-actions">
                <a class="hm-btn-lg primary-btn-gradient" asp-controller="Auth" asp-action="Register">Bắt đầu ngay</a>
                <a class="hm-btn-outline" href="#">
                    <span class="material-symbols-outlined">play_circle</span>
                    Xem demo
                </a>
            </div>
        </section>

        <!-- Product Interface Preview (Bento) -->
        <div class="hm-section">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="glass-card hm-preview">
                        <div class="hm-preview-overlay"></div>
                        <div class="hm-preview-body">
                            <div class="hm-terminal">
                                <span class="hm-dot hm-dot-r"></span>
                                <span class="hm-dot hm-dot-y"></span>
                                <span class="hm-dot hm-dot-g"></span>
                                <span class="hm-terminal-name">INTERVIEW_SIMULATOR.EXE</span>
                            </div>
                            <div class="hm-preview-img">
                                <img alt="Technical dashboard interface" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDggTDREcniv6IT3zo0PxsiH7QN4HUO7Dxf6eq1sPTNDGptdiAYBiZMkHXAKE3E9BuK-HEH2sk4PnIx5QmfhXER0LYZrcgZpRUJz7j15ra_s7rhT5ca1ykV7Ve2P-69N4SHdVGBcBkvJ2AOQxJXwFAW-s7xBdHGS8HoEcwJUq6-EHFw5SRYQ-miH7zd60x_o_t55Ic6ST3uRcjUPd9ZDVLJGF1lEoILAjt0IC58-UCGc3-DuclpLe84LWH4NbGnuuznLw9147fF6hk">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="d-flex flex-column gap-4 h-100">
                        <div class="glass-card hm-side-card flex-grow-1">
                            <span class="hm-code-label" style="color:#4cd7f6;">AI POWERED</span>
                            <h3>Phân tích tư duy &amp; kỹ năng</h3>
                            <p>Đánh giá khả năng giải quyết vấn đề, tư duy logic và cách bạn trình bày giải pháp trong các tình huống thực tế.</p>
                        </div>
                        <div class="glass-card hm-side-card flex-grow-1">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="material-symbols-outlined" style="color:#F9D949; font-variation-settings:'FILL' 1;">star</span>
                                <span class="hm-code-label" style="color:#F9D949; text-transform:uppercase;">Premium AI</span>
                            </div>
                            <h3>Hệ thống Llama 3.1</h3>
                            <p>Mô hình ngôn ngữ lớn được tối ưu cho hội thoại tự nhiên và đánh giá chuyên môn sâu sắc.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Features -->
        <div class="hm-section">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="glass-card hm-feature">
                        <div class="hm-feature-icon" style="background:rgba(79,70,229,.2);">
                            <span class="material-symbols-outlined" style="color:#e2dfff;">psychology</span>
                        </div>
                        <h3>AI Interviewer</h3>
                        <p>Phỏng vấn giả lập qua giọng nói và chat với phản hồi tự nhiên, giúp bạn rèn luyện tâm lý phòng phỏng vấn.</p>
                        <a class="hm-link" href="#">Tìm hiểu thêm <span class="material-symbols-outlined">arrow_forward</span></a>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="glass-card hm-feature">
                        <div class="hm-feature-icon" style="background:rgba(76,215,246,.2);">
                            <span class="material-symbols-outlined" style="color:#4cd7f6;">forum</span>
                        </div>
                        <h3>Tình huống thực tế</h3>
                        <p>Tập trung vào thiết kế hệ thống, xử lý xung đột và kỹ năng giao tiếp chuyên môn thay vì chỉ giải thuật toán.</p>
                        <a class="hm-link" href="#">Tìm hiểu thêm <span class="material-symbols-outlined">arrow_forward</span></a>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="glass-card hm-feature">
                        <div class="hm-feature-icon" style="background:rgba(208,188,255,.2);">
                            <span class="material-symbols-outlined" style="color:#d0bcff;">insights</span>
                        </div>
                        <h3>Đánh giá sau buổi tập</h3>
                        <p>Nhận báo cáo chi tiết ngay sau khi kết thúc: từ kỹ năng trình bày, tư duy logic đến mức độ phù hợp văn hóa.</p>
                        <a class="hm-link" href="#">Tìm hiểu thêm <span class="material-symbols-outlined">arrow_forward</span></a>
                    </div>
                </div>
            </div>
        </div>

        <!-- CTA -->
        <div class="hm-section">
            <div class="glass-card hm-cta">
                <h2>Sẵn sàng để đột phá sự nghiệp?</h2>
                <p>Tham gia cùng hơn 5,000 kỹ sư phần mềm Việt Nam đang luyện tập mỗi ngày để đạt được mức lương mong ước.</p>
                <a class="hm-btn-lg primary-btn-gradient" asp-controller="Auth" asp-action="Register">Bắt đầu ngay hôm nay</a>
            </div>
        </div>
    </main>

    @await Html.PartialAsync("_Footer")
</body>
</html>
