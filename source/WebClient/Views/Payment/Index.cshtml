@model WebClient.Models.Payment.BuyCreditsViewModel

@{
    ViewData["Title"] = "Buy Credits";
    Layout = "~/Views/Shared/_LayoutPayment.cshtml";
    var errorMessage = Model.ErrorMessage ?? TempData["PaymentError"]?.ToString();
}

@section Styles {
    <link rel="stylesheet" href="~/css/payment-vnpay.css" asp-append-version="true" />
}

<div class="payment-vnpay-shell">
    <div class="ambient ambient-a"></div>
    <div class="ambient ambient-b"></div>

    <div class="page-header">
        <div class="eyebrow">DevPrep AI</div>
        <h1>Fuel your prep with credits</h1>
    </div>

    <div class="content-grid">
        <section class="package-list panel">
            <div class="section-copy">
                <p class="eyebrow">Credit Wallet</p>
                <h2>Choose a package</h2>
                <p>Buy credits through VNPay to unlock mock interviews, feedback, and AI analysis.</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-banner">@errorMessage</div>
            }
            else if (Model.Packages.Count == 0)
            {
                <div class="empty-state">No credit packages are available right now.</div>
            }

            <div class="package-grid">
                @for (var i = 0; i < Model.Packages.Count; i++)
                {
                    var pkg = Model.Packages[i];
                    var pricePerCredit = pkg.TotalCredits > 0 ? pkg.Price / pkg.TotalCredits : 0;
                    <article class="package-card @(i == 0 ? "selected" : "")"
                             style="animation-delay: @(i * 90)ms"
                             data-package-id="@pkg.PackageId"
                             onclick="selectPackage(this)">
                        <div class="package-card__header">
                            <div>
                                <span class="tag">@pkg.Name</span>
                                <h3>@pkg.TotalCredits credits</h3>
                            </div>
                            <div class="price">@pkg.Price.ToString("N0") @pkg.Currency</div>
                        </div>

                        <p class="package-desc">
                            @(pkg.Description ?? "Premium credits for DevPrep learning flows.")
                        </p>

                        <ul class="feature-list">
                            <li>@pkg.Credits base credits</li>
                            <li>@pkg.BonusCredits bonus credits</li>
                            <li>@pricePerCredit.ToString("N2") @pkg.Currency / credit</li>
                        </ul>

                        <form method="post" asp-action="CreateOrder">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="packageId" value="@pkg.PackageId" />
                            <button type="submit" class="primary-button secondary" onclick="event.stopPropagation();">
                                Buy now
                            </button>
                        </form>
                    </article>
                }
            </div>
        </section>

        <aside class="summary panel sticky-panel" id="orderSummary">
            <p class="eyebrow">Order Summary</p>
            <h2>Review selection</h2>

            @if (Model.Packages.Count > 0)
            {
                var first = Model.Packages[0];
                <div class="summary-block" id="summaryBlock">
                    <div>
                        <span>Selected package</span>
                        <strong id="summaryName">@first.Name</strong>
                    </div>
                    <div>
                        <span>Total credits</span>
                        <strong id="summaryCredits">@first.TotalCredits</strong>
                    </div>
                    <div>
                        <span>Amount</span>
                        <strong id="summaryPrice">@first.Price.ToString("N0") @first.Currency</strong>
                    </div>
                </div>

                <form method="post" asp-action="CreateOrder" id="summaryForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="packageId" value="@first.PackageId" id="summaryPackageId" />
                    <button type="submit" class="primary-button">Buy now</button>
                </form>
            }
            else
            {
                <div class="empty-state compact">Select a package to continue.</div>
            }

            <div class="trust-box">
                <strong>VNPay Sandbox</strong>
                <span>Secure payment flow with signed callbacks and server-side credit delivery.</span>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        function selectPackage(card) {
            document.querySelectorAll('.package-card').forEach(c => c.classList.remove('selected'));
            card.classList.add('selected');

            const name = card.querySelector('.tag')?.textContent ?? '';
            const credits = card.querySelector('h3')?.textContent ?? '';
            const price = card.querySelector('.price')?.textContent ?? '';
            const pkgId = card.dataset.packageId;

            const summaryName = document.getElementById('summaryName');
            const summaryCredits = document.getElementById('summaryCredits');
            const summaryPrice = document.getElementById('summaryPrice');
            const summaryPackageId = document.getElementById('summaryPackageId');

            if (summaryName) summaryName.textContent = name;
            if (summaryCredits) summaryCredits.textContent = credits;
            if (summaryPrice) summaryPrice.textContent = price;
            if (summaryPackageId) summaryPackageId.value = pkgId;
        }
    </script>
}
