@model WebClient.Models.Payment.BuyCreditsViewModel

@{
    Layout = null;
    ViewData["Title"] = "Buy Credits";
    var errorMessage = Model.ErrorMessage ?? TempData["PaymentError"]?.ToString();
    // Trang giá luôn thiết kế cho đúng 3 gói (Starter / Professional / Enterprise) — nếu admin
    // cấu hình nhiều hơn, chỉ lấy 3 gói đầu để giữ layout 3 cột cố định.
    var packages = Model.Packages.Take(3).ToList();
    var featuredIndex = packages.Count == 3 ? 1 : -1;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment &amp; Plans | DevPrep AI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@100..900&family=JetBrains+Mono:wght@@500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/payment-vnpay.css" asp-append-version="true" />
</head>
<body class="pv-page">
    @await Html.PartialAsync("_Navbar")

    <main class="pp-shell">
        <div class="pp-ambient">
            <div class="pp-blob pp-blob-a"></div>
            <div class="pp-blob pp-blob-b"></div>
        </div>
        <div class="container">
            <section class="pp-hero">
                <div class="pp-eyebrow">
                    <span class="material-symbols-outlined" style="font-size:16px;">bolt</span>
                    DevPrep AI Credits
                </div>
                <h1>Choose Your Plan</h1>
                <p>Pick the credit package that fits your interview prep goals.</p>
            </section>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="pp-error">@errorMessage</div>
            }
            else if (packages.Count == 0)
            {
                <div class="pp-empty">No credit packages are available right now.</div>
            }

            <div class="row row-cols-1 row-cols-md-3 g-5 mb-5 align-items-center">
                @for (var i = 0; i < packages.Count; i++)
                {
                    var pkg = packages[i];
                    var pricePerCredit = pkg.TotalCredits > 0 ? pkg.Price / pkg.TotalCredits : 0;
                    var isFeatured = i == featuredIndex;
                    <div class="col">
                        <div class="pp-card @(isFeatured ? "pp-featured" : "")" style="animation-delay: @(i * 110)ms">
                            @if (isFeatured)
                            {
                                <div class="pp-ribbon">
                                    <span class="material-symbols-outlined">star</span>
                                    Most Popular
                                </div>
                            }

                            <span class="pp-tag">@pkg.Name</span>
                            <div class="pp-credits">@pkg.TotalCredits credits</div>
                            <div class="pp-price-row">
                                <span class="pp-price">@pkg.Price.ToString("N0")</span>
                                <span class="pp-price-unit">@pkg.Currency</span>
                            </div>
                            <p class="pp-per-credit">@pricePerCredit.ToString("N2") @pkg.Currency / credit</p>

                            @if (!string.IsNullOrEmpty(pkg.Description))
                            {
                                <p class="pp-desc">@pkg.Description</p>
                            }

                            <div class="pp-divider"></div>

                            <ul class="pp-feature-list">
                                <li>
                                    <span class="material-symbols-outlined">check_circle</span>
                                    @pkg.Credits base credits
                                </li>
                                @if (pkg.BonusCredits > 0)
                                {
                                    <li>
                                        <span class="material-symbols-outlined">check_circle</span>
                                        @pkg.BonusCredits bonus credits
                                    </li>
                                }
                                <li>
                                    <span class="material-symbols-outlined">check_circle</span>
                                    Credits never expire
                                </li>
                                <li>
                                    <span class="material-symbols-outlined">check_circle</span>
                                    Secure VNPay checkout
                                </li>
                            </ul>

                            <form method="post" asp-action="CreateOrder">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="packageId" value="@pkg.PackageId" />
                                <button type="submit" class="pp-select-btn @(isFeatured ? "pp-select-btn--primary" : "")">
                                    Select Plan
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </main>

    @await Html.PartialAsync("_Footer")
</body>
</html>
