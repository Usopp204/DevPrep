@model WebClient.Models.Payment.PaymentSuccessViewModel

@{
    ViewData["Title"] = "Payment Successful";
    Layout = "~/Views/Shared/_LayoutPayment.cshtml";
}

@section Styles {
<style>
/* ── Payment Success Page ────────────────────────────────── */
.psc-bg {
    position: fixed; inset: 0; pointer-events: none; z-index: 0;
    display: flex; align-items: center; justify-content: center;
}
.psc-bg::after {
    content: '';
    width: 800px; height: 800px;
    background: radial-gradient(circle, rgba(16,185,129,.05) 0%, transparent 70%);
}
.psc-wrap {
    max-width: 560px; margin: 40px auto 64px; padding: 0 24px;
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    position: relative; z-index: 1;
}

/* Icon */
.psc-icon-wrap { position: relative; margin-bottom: 32px; }
.psc-ring {
    position: absolute; inset: 0; border-radius: 9999px;
    background: rgba(16,185,129,.2);
    animation: psc-ping 3s cubic-bezier(0,0,.2,1) infinite;
}
@@keyframes psc-ping { 75%, 100% { transform: scale(1.6); opacity: 0; } }
.psc-icon {
    width: 96px; height: 96px; border-radius: 9999px;
    background: rgba(16,185,129,.1); border: 2px solid rgba(16,185,129,.2);
    display: flex; align-items: center; justify-content: center; position: relative; z-index: 1;
}
.psc-icon .material-symbols-outlined {
    font-size: 48px; color: #10B981;
    font-variation-settings: 'FILL' 1, 'wght' 700, 'GRAD' 0, 'opsz' 48;
}

/* Card */
.psc-card {
    width: 100%;
    background: rgba(17,24,39,.6); backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,.08); border-radius: 16px; padding: 32px;
    box-shadow: 0 0 40px rgba(16,185,129,.2);
    display: flex; flex-direction: column; align-items: center; text-align: center;
}
.psc-title { font-size: 32px; font-weight: 700; color: #e5e1e7; line-height: 40px; margin-bottom: 8px; }
.psc-sub  { font-size: 16px; color: #c8c5d0; margin-bottom: 32px; max-width: 340px; }

/* Receipt */
.psc-receipt {
    width: 100%; background: rgba(28,27,31,.4);
    border: 1px solid rgba(255,255,255,.08); border-radius: 12px; padding: 24px; text-align: left;
}
.psc-lbl {
    font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: .05em;
    text-transform: uppercase; color: rgba(200,197,208,.6);
}
.psc-receipt-hd {
    display: flex; justify-content: space-between; align-items: center; margin: 8px 0 16px;
    flex-wrap: wrap; gap: 8px;
}
.psc-order { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #e5e1e7; }
.psc-order span { color: #4cd7f6; word-break: break-all; }
.psc-badge {
    display: flex; align-items: center; gap: 6px;
    background: rgba(16,185,129,.1); border: 1px solid rgba(16,185,129,.2);
    padding: 2px 10px; border-radius: 999px; white-space: nowrap;
}
.psc-dot { width: 8px; height: 8px; border-radius: 50%; background: #10B981; animation: psc-pulse 2s infinite; }
@@keyframes psc-pulse { 0%,100%{opacity:1} 50%{opacity:.4} }
.psc-badge-txt { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #10B981; }
.psc-div { height: 1px; background: rgba(255,255,255,.08); margin: 16px 0; }

/* Grid */
.psc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
.psc-col  { display: flex; flex-direction: column; gap: 4px; }
.psc-col-r { text-align: right; }
.psc-credit {
    display: flex; align-items: center; gap: 6px; color: #4cd7f6; font-weight: 700;
}
.psc-credit .material-symbols-outlined {
    font-size: 20px; font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
}
.psc-credit-num { font-size: 22px; font-weight: 600; }
.psc-amount { font-size: 24px; font-weight: 700; color: #e5e1e7; line-height: 1.3; word-break: break-all; }

/* Detail rows */
.psc-details {
    display: flex; flex-direction: column; gap: 12px;
    border-top: 1px solid rgba(255,255,255,.08); padding-top: 16px; color: #c8c5d0;
}
.psc-drow  { display: flex; justify-content: space-between; align-items: center; font-size: 14px; }
.psc-dkey  { display: flex; align-items: center; gap: 8px; }
.psc-dkey .material-symbols-outlined { font-size: 18px; }
.psc-dval  { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #e5e1e7; }

/* Actions */
.psc-actions { width: 100%; margin-top: 32px; display: flex; flex-direction: column; gap: 16px; }
.psc-btn-p {
    width: 100%; background: linear-gradient(135deg, #4f46e5, #7c3aed);
    color: #fff; font-weight: 700; font-size: 14px; padding: 16px; border-radius: 12px;
    border: none; cursor: pointer; display: flex; align-items: center; justify-content: center;
    gap: 12px; text-decoration: none; transition: opacity .2s;
    box-shadow: 0 4px 16px rgba(79,70,229,.3);
}
.psc-btn-p:hover { opacity: .9; color: #fff; }
.psc-btn-p .material-symbols-outlined { font-size: 20px; }
.psc-btn-s {
    width: 100%; background: none; border: 1px solid rgba(255,255,255,.08);
    color: #e5e1e7; font-weight: 600; font-size: 14px; padding: 16px; border-radius: 12px;
    text-decoration: none; text-align: center; transition: background .2s; display: block;
}
.psc-btn-s:hover { background: rgba(255,255,255,.06); color: #e5e1e7; }

/* Verification footer card */
.psc-verify {
    width: 100%; background: rgba(17,24,39,.6); backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,.08); border-radius: 16px; padding: 16px;
    display: flex; align-items: center; justify-content: space-between;
}
.psc-verify-left { display: flex; align-items: center; gap: 16px; }
.psc-vbadge {
    width: 40px; height: 40px; border-radius: 50%;
    background: rgba(16,185,129,.1); border: 1px solid rgba(16,185,129,.2);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.psc-vbadge .material-symbols-outlined {
    font-size: 20px; color: #10B981;
    font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
}
.psc-vname { font-weight: 700; color: #e5e1e7; font-size: 14px; }
.psc-vsub {
    font-family: 'JetBrains Mono', monospace; font-size: 11px;
    text-transform: uppercase; letter-spacing: .15em; color: #c8c5d0; margin-top: 2px;
}
.psc-vdim { opacity: .3; }
.psc-vdim .material-symbols-outlined { font-size: 32px; color: #e5e1e7; }
</style>
}

<div class="psc-bg"></div>

<div class="psc-wrap">
    <!-- Animated success icon -->
    <div class="psc-icon-wrap">
        <div class="psc-ring"></div>
        <div class="psc-icon">
            <span class="material-symbols-outlined">check</span>
        </div>
    </div>

    <!-- Main card -->
    <section class="psc-card">
        <h1 class="psc-title">Payment Successful</h1>
        <p class="psc-sub">Your credits have been added to your account instantly. High-performance prep awaits.</p>

        <div class="psc-receipt">
            <div class="psc-lbl">Order Details</div>
            <div class="psc-receipt-hd">
                <span class="psc-order">ID: <span>@Model.OrderCode</span></span>
                <div class="psc-badge">
                    <span class="psc-dot"></span>
                    <span class="psc-badge-txt">@Model.Credits Credits</span>
                </div>
            </div>

            <div class="psc-div"></div>
            <div class="psc-grid">
                <div class="psc-col">
                    <span class="psc-lbl">Credits Added</span>
                    <div class="psc-credit">
                        <span class="material-symbols-outlined">bolt</span>
                        <span class="psc-credit-num">@Model.Credits Credits</span>
                    </div>
                </div>
                <div class="psc-col psc-col-r">
                    <span class="psc-lbl">Amount Paid</span>
                    <span class="psc-amount">@Model.Amount</span>
                </div>
            </div>

            <div class="psc-div"></div>
            <div class="psc-details">
                <div class="psc-drow">
                    <span class="psc-dkey">
                        <span class="material-symbols-outlined">schedule</span>
                        Timestamp
                    </span>
                    <span class="psc-dval">@DateTime.Now.ToString("MMM dd, yyyy, HH:mm") GMT+7</span>
                </div>
                <div class="psc-drow">
                    <span class="psc-dkey">
                        <span class="material-symbols-outlined">payments</span>
                        Payment Method
                    </span>
                    <span class="psc-dval">VNPay</span>
                </div>
            </div>
        </div>

        <div class="psc-actions">
            <a class="psc-btn-p" asp-controller="Payment" asp-action="Index">
                <span class="material-symbols-outlined">shopping_cart</span>
                Purchase More Credits
            </a>
            <a class="psc-btn-s" asp-controller="Home" asp-action="Index">Go To Homepage</a>
        </div>
    </section>

    <!-- Verification footer -->
    <div class="psc-verify">
        <div class="psc-verify-left">
            <div class="psc-vbadge">
                <span class="material-symbols-outlined">verified</span>
            </div>
            <div>
                <div class="psc-vname">Secure Payment Verified</div>
                <div class="psc-vsub">Encrypted via VNPay Gateway</div>
            </div>
        </div>
        <div class="psc-vdim">
            <span class="material-symbols-outlined">receipt_long</span>
        </div>
    </div>
</div>
