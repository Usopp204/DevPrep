@model WebClient.Models.Shared.PagedResult<WebClient.Models.Manager.QuestionBankListItemViewModel>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Question Bank - DevPrep AI Manager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        /* Custom styles for Question Bank based on admin.css variables */
        .qb-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }
        
        .qb-filter-bar {
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 24px;
        }

        .qb-filter-row {
            display: flex;
            gap: 16px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }
        
        .qb-filter-row:last-child {
            margin-bottom: 0;
        }

        .qb-search-wrapper {
            position: relative;
            flex: 1;
            min-width: 300px;
        }

        .qb-search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--ad-on-surface-variant);
        }

        .qb-input, .qb-select {
            background-color: var(--ad-surface-container);
            border: 1px solid var(--ad-border);
            color: var(--ad-on-surface);
            border-radius: 6px;
            padding: 8px 12px;
            outline: none;
            width: 100%;
        }
        
        .qb-input {
            padding-left: 40px;
        }
        
        .qb-select {
            width: auto;
            min-width: 150px;
            cursor: pointer;
        }
        
        .qb-input:focus, .qb-select:focus {
            border-color: var(--ad-primary);
        }

        .qb-status-toggles {
            display: flex;
            gap: 8px;
        }
        
        .qb-toggle {
            background-color: var(--ad-surface-container);
            color: var(--ad-on-surface-variant);
            border: 1px solid var(--ad-border);
            padding: 6px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s;
        }
        
        .qb-toggle.active {
            background-color: var(--ad-primary-container);
            color: var(--ad-on-primary-container);
            border-color: var(--ad-primary-container);
        }

        .qb-table-wrapper {
            border-radius: 8px;
            overflow: hidden;
            margin-bottom: 24px;
        }

        .qb-table {
            width: 100%;
            border-collapse: collapse;
        }

        .qb-table th {
            background-color: var(--ad-surface-container-high);
            color: var(--ad-on-surface-variant);
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 16px;
            text-align: left;
            border-bottom: 1px solid var(--ad-border);
        }

        .qb-table td {
            padding: 16px;
            border-bottom: 1px solid var(--ad-border);
            color: var(--ad-on-surface);
            vertical-align: middle;
        }

        .qb-table tr:hover {
            background-color: rgba(255, 255, 255, 0.02);
        }

        .qb-pill {
            background-color: var(--ad-surface-container);
            color: var(--ad-on-surface-variant);
            padding: 4px 12px;
            border-radius: 9999px;
            font-size: 13px;
            font-weight: 500;
            display: inline-block;
        }

        .qb-status {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 14px;
        }

        .qb-status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }
        
        .qb-status-active { color: var(--ad-success); }
        .qb-status-active .qb-status-dot { background-color: var(--ad-success); }
        
        .qb-status-inactive { color: var(--ad-warning); }
        .qb-status-inactive .qb-status-dot { background-color: var(--ad-warning); }

        .qb-actions {
            display: flex;
            gap: 12px;
            justify-content: flex-end;
        }

        .qb-action-btn {
            color: var(--ad-on-surface-variant);
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s, background-color 0.2s;
            text-decoration: none;
        }

        .qb-action-btn:hover {
            color: var(--ad-on-surface);
            background-color: var(--ad-surface-container-high);
        }

        .qb-pagination {
            display: flex;
            justify-content: center;
            gap: 8px;
            padding: 16px 0;
        }
        
        .qb-page-btn {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background-color: transparent;
            color: var(--ad-on-surface-variant);
            border: none;
            cursor: pointer;
            text-decoration: none;
            font-weight: 500;
        }
        
        .qb-page-btn:hover {
            background-color: var(--ad-surface-container-high);
            color: var(--ad-on-surface);
        }
        
        .qb-page-btn.active {
            background-color: #4f46e5 !important;
            color: #e5e1e7 !important;
        }

        .primary-gradient {
            background: linear-gradient(135deg, #4f46e5 0%, #312e81 100%) !important;
            box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.2) !important;
            border: none !important;
            color: #e5e1e7 !important;
        }

        .qb-toggle.active {
            background-color: #4f46e5 !important;
            color: #e5e1e7 !important;
            border-color: #4f46e5 !important;
        }

        .qb-action-btn.qb-action-view:hover {
            color: #e9ddff !important;
            background-color: transparent !important;
        }

    </style>
</head>
<body class="admin-page">
    @await Html.PartialAsync("_ManagerTopbar")
    @await Html.PartialAsync("_ManagerSidebar")

    <main class="ad-main">
        <div class="qb-header">
            <h1 class="ad-page-title">Question Bank</h1>
        </div>

        <form method="get" action="/Manager/QuestionBank" class="glass-card qb-filter-bar">
            <div class="qb-filter-row">
                <div class="qb-search-wrapper">
                    <span class="material-symbols-outlined qb-search-icon">search</span>
                    <input name="keyword" value="@ViewBag.Keyword" type="text" class="qb-input" placeholder="Search questions..." onkeypress="if(event.key === 'Enter') this.form.submit();" />
                </div>
                
                <select name="level" class="qb-select" onchange="this.form.submit()">
                    <option value="">All Levels</option>
                    <option value="Intern" selected="@(ViewBag.Level == "Intern")">Intern</option>
                    <option value="Fresher" selected="@(ViewBag.Level == "Fresher")">Fresher</option>
                    <option value="Junior" selected="@(ViewBag.Level == "Junior")">Junior</option>
                    <option value="Middle" selected="@(ViewBag.Level == "Middle")">Middle</option>
                    <option value="Senior" selected="@(ViewBag.Level == "Senior")">Senior</option>
                    <option value="All" selected="@(ViewBag.Level == "All")">All</option>
                </select>

                <select name="questionType" class="qb-select" onchange="this.form.submit()">
                    <option value="">All Tech Stacks</option>
                    <option value="Java" selected="@(ViewBag.QuestionType == "Java")">Java</option>
                    <option value=".NET" selected="@(ViewBag.QuestionType == ".NET")">.NET</option>
                    <option value="React" selected="@(ViewBag.QuestionType == "React")">React</option>
                    <option value="NodeJS" selected="@(ViewBag.QuestionType == "NodeJS")">NodeJS</option>
                    <option value="AI" selected="@(ViewBag.QuestionType == "AI")">AI</option>
                    <option value="All" selected="@(ViewBag.QuestionType == "All")">All</option>
                </select>
                
                <select name="categoryId" class="qb-select" onchange="this.form.submit()">
                    <option value="">All Categories</option>
                    <option value="00000000-0000-0000-0000-000000000001" selected="@(ViewBag.CategoryId?.ToString() == "00000000-0000-0000-0000-000000000001")">DSA</option>
                    <option value="00000000-0000-0000-0000-000000000002" selected="@(ViewBag.CategoryId?.ToString() == "00000000-0000-0000-0000-000000000002")">System Design</option>
                    <option value="00000000-0000-0000-0000-000000000003" selected="@(ViewBag.CategoryId?.ToString() == "00000000-0000-0000-0000-000000000003")">Behavioral</option>
                    <option value="00000000-0000-0000-0000-000000000004" selected="@(ViewBag.CategoryId?.ToString() == "00000000-0000-0000-0000-000000000004")">Framework</option>
                </select>
            </div>
            
            <div class="qb-filter-row">
                <div class="qb-status-toggles">
                    <button type="submit" name="status" value="Active" class="qb-toggle @(ViewBag.Status == "Active" ? "active" : "")">Active</button>
                    <button type="submit" name="status" value="Inactive" class="qb-toggle @(ViewBag.Status == "Inactive" ? "active" : "")">Inactive</button>
                    @if(!string.IsNullOrEmpty(ViewBag.Status))
                    {
                        <button type="submit" name="status" value="" class="qb-toggle" style="background:transparent; border:none; text-decoration:underline; font-size:12px;">Clear Status</button>
                    }
                </div>
            </div>
        </form>

        <div class="glass-card qb-table-wrapper">
            <table class="qb-table">
                <thead>
                    <tr>
                        <th style="width: 5%">#</th>
                        <th style="width: 35%">QUESTION</th>
                        <th style="width: 10%">LEVEL</th>
                        <th style="width: 15%">TECH STACK</th>
                        <th style="width: 15%">CATEGORY</th>
                        <th style="width: 10%">STATUS</th>
                        <th style="width: 10%; text-align: right;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model.Items != null && Model.Items.Any())
                    {
                        var index = (Model.PageIndex - 1) * Model.PageSize + 1;
                        foreach(var item in Model.Items)
                        {
                            <tr>
                                <td class="ad-code">@index</td>
                                <td style="font-weight: 500;">@item.Content</td>
                                <td><span class="qb-pill">@item.Level</span></td>
                                <td style="color: var(--ad-on-surface-variant);">@(string.IsNullOrEmpty(item.TechStack) ? "All" : item.TechStack)</td>
                                <td style="color: var(--ad-on-surface-variant);">@(string.IsNullOrEmpty(item.CategoryName) ? "System Design" : item.CategoryName)</td>
                                <td>
                                    @if(item.Status == "Active")
                                    {
                                        <div class="qb-status qb-status-active">
                                            <span class="qb-status-dot"></span> Active
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="qb-status qb-status-inactive">
                                            <span class="qb-status-dot"></span> Inactive
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="qb-actions">
                                        <a href="/Manager/QuestionBank/@item.QuestionId" class="qb-action-btn qb-action-view" title="View">
                                            <span class="material-symbols-outlined" style="font-size: 20px;">visibility</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" style="text-align: center; color: var(--ad-on-surface-variant); padding: 32px;">No questions found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if(Model.TotalPages > 1)
        {
            <div class="glass-card" style="padding: 8px; border-radius: 12px; max-width: max-content; margin: 0 auto;">
                <div class="qb-pagination">
                    @if(Model.PageIndex > 1)
                    {
                        <a href="?page=@(Model.PageIndex - 1)&keyword=@ViewBag.Keyword&level=@ViewBag.Level&questionType=@ViewBag.QuestionType&categoryId=@ViewBag.CategoryId&status=@ViewBag.Status" class="qb-page-btn">
                            <span class="material-symbols-outlined">chevron_left</span>
                        </a>
                    }
                    
                    <span class="qb-page-btn active">@Model.PageIndex</span>

                    @if(Model.PageIndex < Model.TotalPages)
                    {
                        <a href="?page=@(Model.PageIndex + 1)&keyword=@ViewBag.Keyword&level=@ViewBag.Level&questionType=@ViewBag.QuestionType&categoryId=@ViewBag.CategoryId&status=@ViewBag.Status" class="qb-page-btn">
                            <span class="material-symbols-outlined">chevron_right</span>
                        </a>
                    }
                </div>
            </div>
        }
    </main>
    
    <script>
        // Make the sidebar Question Bank item active manually since we're not inside AdminController
        document.addEventListener("DOMContentLoaded", function() {
            fixMojibakeText(document.querySelector('main'));
            var links = document.querySelectorAll('.ad-nav-item');
            links.forEach(function(link) {
                link.classList.remove('active');
                if (link.getAttribute('href') === '/Manager/QuestionBank') {
                    link.classList.add('active');
                }
            });
        });

        function fixMojibakeText(root) {
            if (!root) return;
            const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
            const nodes = [];
            while (walker.nextNode()) nodes.push(walker.currentNode);
            nodes.forEach(node => node.nodeValue = fixText(node.nodeValue));
        }

        function fixText(value) {
            const text = String(value || '');
            const looksMojibake = /[ÃÂ]|áº|á»|�/.test(text);
            if (!looksMojibake) return text;
            try {
                const windows1252 = {
                    0x20AC: 0x80, 0x201A: 0x82, 0x0192: 0x83, 0x201E: 0x84,
                    0x2026: 0x85, 0x2020: 0x86, 0x2021: 0x87, 0x02C6: 0x88,
                    0x2030: 0x89, 0x0160: 0x8A, 0x2039: 0x8B, 0x0152: 0x8C,
                    0x017D: 0x8E, 0x2018: 0x91, 0x2019: 0x92, 0x201C: 0x93,
                    0x201D: 0x94, 0x2022: 0x95, 0x2013: 0x96, 0x2014: 0x97,
                    0x02DC: 0x98, 0x2122: 0x99, 0x0161: 0x9A, 0x203A: 0x9B,
                    0x0153: 0x9C, 0x017E: 0x9E, 0x0178: 0x9F
                };
                const bytes = Uint8Array.from([...text].map(ch => {
                    const code = ch.charCodeAt(0);
                    return windows1252[code] || (code & 255);
                }));
                const fixed = new TextDecoder('utf-8', { fatal: false }).decode(bytes);
                return /[ÃÂ]|áº|á»|�/.test(fixed) ? text : fixed;
            } catch {
                return text;
            }
        }
    </script>
</body>
</html>
