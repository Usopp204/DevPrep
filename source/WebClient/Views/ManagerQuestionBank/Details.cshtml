@model WebClient.Models.Manager.QuestionBankDetailViewModel
@{
    Layout = null;
    ViewData["Title"] = "Question Details";

    var categoryName = !string.IsNullOrWhiteSpace(Model.CategoryName) ? Model.CategoryName : "General";
    var status = string.IsNullOrWhiteSpace(Model.Status) ? "Active" : Model.Status.Trim();
    var isActive = string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase);
    var tags = string.IsNullOrWhiteSpace(Model.Tags)
        ? Array.Empty<string>()
        : Model.Tags.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim()).Where(x => !string.IsNullOrWhiteSpace(x)).ToArray();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DevPrep AI Manager</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    <style>
        :root {
            --bg-main: #0f1424;
            --bg-panel: #111827;
            --border-main: #252b3d;
            --text-main: #ffffff;
            --text-muted: #9ca3af;
            --text-blue: #93c5fd;
            --primary: #6366f1;
            --success: #10b981;
            --warning: #f59e0b;
        }

        body {
            background: var(--bg-main);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
        }

        .admin-main-wrapper {
            margin-left: 260px;
            padding-top: 78px;
            min-height: 100vh;
            background: var(--bg-main);
        }

        .admin-content {
            padding: 28px 28px 60px;
        }

        .back-link {
            color: var(--text-blue);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
        }

        .back-link:hover {
            color: #ffffff;
        }

        .question-card,
        .meta-card,
        .answer-card {
            border: 1px solid var(--border-main);
            background: rgba(17, 24, 39, 0.95);
            border-radius: 12px;
        }

        .question-card {
            padding: 24px;
        }

        .badge-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 7px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .badge-active {
            background: rgba(16, 185, 129, 0.14);
            color: #6ee7b7;
        }

        .badge-inactive {
            background: rgba(245, 158, 11, 0.14);
            color: #fcd34d;
        }

        .meta-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 800;
            color: var(--text-blue);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 7px;
        }

        .meta-value {
            color: #ffffff;
            font-weight: 700;
        }

        .tag-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 7px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: #dbeafe;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 700;
        }

        .question-title {
            font-size: 30px;
            font-weight: 800;
            line-height: 1.25;
            letter-spacing: -0.04em;
            margin: 18px 0 0;
            color: #ffffff;
        }

        .question-content,
        .answer-content {
            white-space: pre-line;
            color: #e5e7eb;
            line-height: 1.75;
            font-size: 14px;
        }

        .section-title {
            font-size: 18px;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 14px;
        }

        .info-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border: 1px solid var(--border-main);
            border-radius: 10px;
            background: rgba(15, 19, 34, 0.85);
        }

        .info-icon {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(99, 102, 241, 0.16);
            color: #c4b5fd;
            flex-shrink: 0;
        }

        .drawer-loader {
            width: 28px;
            height: 28px;
            border: 3px solid rgba(255, 255, 255, 0.08);
            border-top-color: #4cd7f6;
            border-radius: 50%;
            animation: spin 0.85s linear infinite;
            margin: 80px auto;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }

        @@media (max-width: 991.98px) {
            .admin-main-wrapper {
                margin-left: 0;
                padding-top: 70px;
            }
        }
    </style>
</head>
<body class="admin-page">
    @await Html.PartialAsync("_ManagerTopbar")
    @await Html.PartialAsync("_ManagerSidebar")

    <main class="admin-main-wrapper">
        <div class="admin-content">
            <div class="mb-4">
                <a href="/Manager/QuestionBank" class="back-link">
                    <span class="material-symbols-outlined">arrow_back</span>
                    Back to Question Bank
                </a>
            </div>

            <div class="row g-4">
                <div class="col-12 col-lg-8">
                    <div class="question-card mb-4">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="badge-status @(isActive ? "badge-active" : "badge-inactive")">
                                <span style="font-size: 8px;">●</span>
                                @(isActive ? "ACTIVE" : "INACTIVE")
                            </span>
                            <span class="tag-badge">@Model.QuestionType</span>
                            <span class="tag-badge">@Model.Level</span>
                            <span class="tag-badge">@Model.Difficulty</span>
                        </div>

                        <h1 class="question-title">@Model.Content</h1>

                        @if (tags.Length > 0)
                        {
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                @foreach (var tag in tags)
                                {
                                    <span class="tag-badge">#@tag</span>
                                }
                            </div>
                        }
                    </div>

                    <div class="answer-card p-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="material-symbols-outlined" style="color:#4cd7f6;">fact_check</span>
                            <div class="section-title mb-0">Expected Answer / Rubric</div>
                        </div>

                        <div class="answer-content">
                            @if (!string.IsNullOrWhiteSpace(Model.ExpectedAnswer))
                            {
                                @Model.ExpectedAnswer
                            }
                            else
                            {
                                <span style="color: var(--text-muted); font-style: italic;">No expected answer or rubric provided for this question.</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-4">
                    <div class="meta-card p-4 mb-4">
                        <div class="section-title">Question Metadata</div>

                        <div class="mb-4">
                            <div class="meta-label">Category</div>
                            <div class="info-row">
                                <div class="info-icon">
                                    <span class="material-symbols-outlined">cubes</span>
                                </div>
                                <div class="overflow-hidden">
                                    <div class="meta-value text-truncate">@categoryName</div>
                                    <div style="color: var(--text-muted); font-size: 12px;">Question category</div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="meta-label">Date Created</div>
                            <div class="meta-value">@Model.CreatedAt.ToString("MMM dd, yyyy")</div>
                        </div>

                        <div class="mb-4">
                            <div class="meta-label">Last Updated</div>
                            <div class="meta-value">@Model.UpdatedAt.ToString("MMM dd, yyyy")</div>
                        </div>

                        <div class="mb-4">
                            <div class="meta-label">Tech Stack</div>
                            <div class="meta-value">@(string.IsNullOrWhiteSpace(Model.TechStack) ? "N/A" : Model.TechStack)</div>
                        </div>

                        <div>
                            <div class="meta-label">Interaction Type</div>
                            <div class="meta-value">@Model.QuestionType</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            fixMojibakeText(document.querySelector('main'));
        });

        function fixMojibakeText(root) {
            if (!root) return;
            const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
            const nodes = [];
            while (walker.nextNode()) nodes.push(walker.currentNode);
            nodes.forEach(node => node.nodeValue = fixText(node.nodeValue));
        }

        function fixText(value) {
            const text = String(value || '');
            const looksMojibake = /[ÃƒÃ‚]|Ã¡Âº|Ã¡Â»|ï¿½/.test(text);
            if (!looksMojibake) return text;
            try {
                const windows1252 = {
                    0x20AC: 0x80, 0x201A: 0x82, 0x0192: 0x83, 0x201E: 0x84,
                    0x2026: 0x85, 0x2020: 0x86, 0x2021: 0x87, 0x02C6: 0x88,
                    0x2030: 0x89, 0x0160: 0x8A, 0x2039: 0x8B, 0x0152: 0x8C,
                    0x017D: 0x8E, 0x2018: 0x91, 0x2019: 0x92, 0x201C: 0x93,
                    0x201D: 0x94, 0x2022: 0x95, 0x2013: 0x96, 0x2014: 0x97,
                    0x02DC: 0x98, 0x2122: 0x99, 0x0161: 0x9A, 0x203A: 0x9B,
                    0x0153: 0x9C, 0x017E: 0x9E, 0x0178: 0x9F
                };
                const bytes = Uint8Array.from([...text].map(ch => {
                    const code = ch.charCodeAt(0);
                    return windows1252[code] || (code & 255);
                }));
                const fixed = new TextDecoder('utf-8', { fatal: false }).decode(bytes);
                return /[ÃƒÃ‚]|Ã¡Âº|Ã¡Â»|ï¿½/.test(fixed) ? text : fixed;
            } catch {
                return text;
            }
        }
    </script>
</body>
</html>
