@model WebClient.Models.Manager.QuestionBankDetailViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Question Details - DevPrep AI Admin</title>
    <!-- Bootstrap and existing Admin CSS for Topbar/Sidebar -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-surface": "#e5e1e7",
                        "primary": "#e2dfff",
                        "primary-container": "#4f46e5",
                        "surface": "#131317",
                        "surface-container": "#201f23",
                        "surface-container-low": "#1c1b1f",
                        "surface-container-high": "#2a292d",
                        "surface-variant": "#353438",
                        "on-surface-variant": "#c8c5d0",
                        "outline": "#928f9a",
                        "border-subtle": "rgba(255, 255, 255, 0.08)",
                        "success": "#10B981",
                        "warning": "#F9D949",
                        "error": "#ffb4ab",
                        "tertiary-fixed": "#e9ddff",
                        "secondary": "#4cd7f6"
                    },
                    fontFamily: {
                        "code-label": ["JetBrains Mono"]
                    }
                }
            }
        }
    </script>
    <style>
        .glass-card-tw {
            background: rgba(17, 24, 39, 0.6);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-top: 1px solid rgba(255, 255, 255, 0.15);
            border-left: 1px solid rgba(255, 255, 255, 0.15);
        }
    </style>
</head>
<body class="admin-page bg-[#0e1323]">
    @await Html.PartialAsync("_AdminTopbar")
    @await Html.PartialAsync("_AdminSidebar")

    <main class="ad-main text-on-surface" style="padding-top: 80px; padding-left: 24px; padding-right: 24px; max-width: 1200px; margin: 0 auto;">
        
        <div class="flex items-center gap-4 mb-8">
            <a href="/Manager/QuestionBank" class="text-on-surface-variant hover:text-primary transition-colors flex items-center gap-2" style="text-decoration: none; color: #c8c5d0;">
                <span class="material-symbols-outlined">arrow_back</span>
                Back to Question Bank
            </a>
        </div>

        <div class="glass-card-tw rounded-3xl p-8 mb-8" style="padding: 32px; border-radius: 24px;">
            <div class="flex justify-between items-start mb-6">
                <div>
                    <div class="flex items-center gap-3 mb-2">
                        <span class="px-3 py-1 rounded-full bg-surface-container text-sm text-on-surface-variant font-code-label">@Model.QuestionType</span>
                        <span class="px-3 py-1 rounded-full bg-primary-container text-white text-sm font-bold">@Model.Level</span>
                        @if(Model.Status == "Active")
                        {
                            <span class="flex items-center gap-1 text-sm" style="color: #10B981;">
                                <span class="material-symbols-outlined" style="font-size: 16px;">check_circle</span> Active
                            </span>
                        }
                        else
                        {
                            <span class="flex items-center gap-1 text-sm" style="color: #F9D949;">
                                <span class="material-symbols-outlined" style="font-size: 16px;">warning</span> Inactive
                            </span>
                        }
                    </div>
                    <h1 class="text-3xl font-bold text-white mt-4 leading-tight">@Model.Content</h1>
                </div>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-8 py-6 border-y border-border-subtle" style="border-top: 1px solid rgba(255,255,255,0.08); border-bottom: 1px solid rgba(255,255,255,0.08); padding-top: 24px; padding-bottom: 24px;">
                <div>
                    <p class="text-on-surface-variant text-sm font-code-label uppercase mb-1">Category</p>
                    <p class="text-white font-medium">@(string.IsNullOrEmpty(Model.CategoryName) ? "Uncategorized" : Model.CategoryName)</p>
                </div>
                <div>
                    <p class="text-on-surface-variant text-sm font-code-label uppercase mb-1">Difficulty</p>
                    <p class="text-white font-medium">@Model.Difficulty</p>
                </div>
                <div>
                    <p class="text-on-surface-variant text-sm font-code-label uppercase mb-1">Tech Stack</p>
                    <p class="text-white font-medium">@(string.IsNullOrEmpty(Model.TechStack) ? "N/A" : Model.TechStack)</p>
                </div>
                <div>
                    <p class="text-on-surface-variant text-sm font-code-label uppercase mb-1">Date Created</p>
                    <p class="text-white font-medium">@Model.CreatedAt.ToString("MMM dd, yyyy")</p>
                </div>
            </div>

            <div class="mt-8">
                <h3 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">fact_check</span>
                    Expected Answer / Rubric
                </h3>
                <div class="bg-surface-container rounded-2xl p-6 border border-border-subtle" style="background: #201f23; padding: 24px; border-radius: 16px;">
                    @if (!string.IsNullOrEmpty(Model.ExpectedAnswer))
                    {
                        var lines = Model.ExpectedAnswer.Split('\n', StringSplitOptions.RemoveEmptyEntries);
                        <ul class="space-y-3">
                            @foreach(var line in lines)
                            {
                                <li class="flex items-start gap-3 text-on-surface">
                                    <span class="material-symbols-outlined text-success mt-1" style="font-size: 18px; color: #10B981;">check</span>
                                    <span style="color: #e5e1e7;">@line.Trim()</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-on-surface-variant italic">No expected answer or rubric provided for this question.</p>
                    }
                </div>
            </div>
        </div>
    </main>
</body>
</html>
