@model WebClient.Models.Profile.ChangePasswordViewModel
@{
    Layout = null;
    ViewData["ProfileActive"] = "password";
    var successMessage = TempData["Message"] as string;
    var modelError = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change Password | DevPrep AI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@@300;400;500;600;700&family=Inter:wght@@100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
</head>
<body class="pf-page">
    @await Html.PartialAsync("_ProfileTopbar")

    <div class="pf-shell">
        @await Html.PartialAsync("_ProfileSidebar")

        <main class="pf-main">
            <div class="pf-glow"></div>
            <div class="pf-content" style="max-width: 760px;">
                <h1 class="pf-page-title">Change Password</h1>

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="pf-alert pf-alert-success">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                        <span>@successMessage</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(modelError))
                {
                    <div class="pf-alert pf-alert-error">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                        <span>@modelError</span>
                    </div>
                }

                <div class="pf-card">
                    <div class="pf-card-topborder"></div>
                    <form asp-controller="Profile" asp-action="ChangePassword" method="post" novalidate>
                        <div class="pf-card-pad" style="display:flex; flex-direction:column; gap:24px;">
                            <!-- Current Password -->
                            <div class="pf-field">
                                <label class="pf-label" asp-for="CurrentPassword">Current Password</label>
                                <div class="pf-input-wrap">
                                    <input class="pf-input" asp-for="CurrentPassword" type="password" placeholder="••••••••" autocomplete="current-password" />
                                    <button class="pf-eye-btn" type="button" onclick="togglePassword('CurrentPassword')">
                                        <span class="material-symbols-outlined">visibility_off</span>
                                    </button>
                                </div>
                                <span asp-validation-for="CurrentPassword" class="pf-field-error"></span>
                            </div>

                            <!-- New Password + checklist điều kiện -->
                            <div class="pf-field">
                                <label class="pf-label" asp-for="NewPassword">New Password</label>
                                <div class="pf-input-wrap">
                                    <input class="pf-input" asp-for="NewPassword" type="password" placeholder="••••••••" autocomplete="new-password" />
                                    <button class="pf-eye-btn" type="button" onclick="togglePassword('NewPassword')">
                                        <span class="material-symbols-outlined">visibility_off</span>
                                    </button>
                                </div>
                                <span asp-validation-for="NewPassword" class="pf-field-error"></span>
                                <div class="pw-reqs" id="pw-reqs">
                                    <p class="pw-reqs-title">Password must contain:</p>
                                    <ul class="pw-reqs-list">
                                        <li class="pw-req" data-rule="len"><span class="material-symbols-outlined pw-req-icon">radio_button_unchecked</span><span>At least 8 characters</span></li>
                                        <li class="pw-req" data-rule="upper"><span class="material-symbols-outlined pw-req-icon">radio_button_unchecked</span><span>One uppercase letter (A-Z)</span></li>
                                        <li class="pw-req" data-rule="lower"><span class="material-symbols-outlined pw-req-icon">radio_button_unchecked</span><span>One lowercase letter (a-z)</span></li>
                                        <li class="pw-req" data-rule="digit"><span class="material-symbols-outlined pw-req-icon">radio_button_unchecked</span><span>One number (0-9)</span></li>
                                    </ul>
                                </div>
                            </div>

                            <!-- Confirm Password -->
                            <div class="pf-field">
                                <label class="pf-label" asp-for="ConfirmPassword">Confirm Password</label>
                                <div class="pf-input-wrap">
                                    <input class="pf-input" asp-for="ConfirmPassword" type="password" placeholder="••••••••" autocomplete="new-password" />
                                    <button class="pf-eye-btn" type="button" onclick="togglePassword('ConfirmPassword')">
                                        <span class="material-symbols-outlined">visibility_off</span>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="pf-field-error"></span>
                            </div>
                        </div>

                        <div class="pf-card-actions">
                            <a class="pf-btn pf-btn-ghost" asp-controller="Profile" asp-action="Index">Cancel</a>
                            <button class="pf-btn pf-btn-primary" type="submit">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>

    <script>
        function togglePassword(inputId) {
            var input = document.getElementById(inputId);
            var icon = input.nextElementSibling.querySelector('.material-symbols-outlined');
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility_off';
            }
        }

        // Checklist điều kiện mật khẩu mới (giống trang Register)
        (function () {
            var pw = document.getElementById('NewPassword');
            var panel = document.getElementById('pw-reqs');
            if (!pw || !panel) return;
            var rules = {
                len: function (v) { return v.length >= 8; },
                upper: function (v) { return /[A-Z]/.test(v); },
                lower: function (v) { return /[a-z]/.test(v); },
                digit: function (v) { return /[0-9]/.test(v); }
            };
            function update() {
                var v = pw.value;
                panel.querySelectorAll('.pw-req').forEach(function (li) {
                    var ok = rules[li.getAttribute('data-rule')](v);
                    li.classList.toggle('met', ok);
                    li.querySelector('.pw-req-icon').textContent = ok ? 'check_circle' : 'radio_button_unchecked';
                });
            }
            pw.addEventListener('focus', function () { panel.classList.add('show'); });
            pw.addEventListener('input', update);
            pw.addEventListener('blur', function () { if (!pw.value) panel.classList.remove('show'); });
            update();
        })();
    </script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>
