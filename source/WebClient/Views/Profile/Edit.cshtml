@model WebClient.Models.Profile.EditProfileViewModel
@{
    Layout = null;
    ViewData["ProfileActive"] = "information";
    var modelError = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Profile | DevPrep AI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@@300;400;500;600;700&family=Inter:wght@@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
</head>
<body class="pf-page">
    @await Html.PartialAsync("_ProfileTopbar")

    <div class="pf-shell">
        @await Html.PartialAsync("_ProfileSidebar")

        <main class="pf-main">
            <div class="pf-glow"></div>
            <div class="pf-content">
                <h1 class="pf-page-title">Edit Profile</h1>

                @if (!string.IsNullOrEmpty(modelError))
                {
                    <div class="pf-alert pf-alert-error">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                        <span>@modelError</span>
                    </div>
                }

                <form asp-controller="Profile" asp-action="Edit" method="post" enctype="multipart/form-data" novalidate>
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="AvatarUrl" />

                    <div class="pf-grid">
                        <!-- Cột trái: avatar + upload -->
                        <div class="pf-card pf-card-pad pf-summary">
                            <label class="pf-avatar-edit" for="avatar-input" title="Change photo">
                                <div class="pf-avatar-lg">
                                    <img id="avatar-preview" src="@Model.AvatarUrl" alt="Avatar"
                                         style="@(Model.HasAvatar ? "" : "display:none;")" />
                                    <span id="avatar-initial" style="@(Model.HasAvatar ? "display:none;" : "")">@Model.Initial</span>
                                </div>
                                <div class="pf-avatar-overlay">Change</div>
                            </label>
                            <input class="pf-file-input" id="avatar-input" asp-for="Avatar"
                                   type="file" accept="image/png,image/jpeg,image/gif,image/webp" />

                            <label class="pf-btn pf-btn-ghost pf-btn-block" for="avatar-input" style="margin-top:8px;">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                                Update Photo
                            </label>
                            <span asp-validation-for="Avatar" class="pf-field-error"></span>
                            <p class="pf-photo-hint">JPG, GIF or PNG. Max size of 5M</p>
                        </div>

                        <!-- Cột phải: form -->
                        <div class="pf-card">
                            <div class="pf-card-topborder"></div>
                            <div class="pf-card-header">
                                <h2 class="pf-card-title">Personal Details</h2>
                            </div>
                            <div class="pf-card-pad">
                                <div class="pf-form-grid">
                                    <div class="pf-field">
                                        <label class="pf-label" asp-for="FullName">Full Name</label>
                                        <input class="pf-input" asp-for="FullName" type="text" placeholder="Your full name" />
                                        <span asp-validation-for="FullName" class="pf-field-error"></span>
                                    </div>
                                    <div class="pf-field">
                                        <label class="pf-label">Email</label>
                                        <input class="pf-input" value="@Model.Email" type="email" readonly />
                                    </div>
                                </div>
                            </div>
                            <div class="pf-card-actions">
                                <a class="pf-btn pf-btn-ghost" asp-controller="Profile" asp-action="Index">Cancel</a>
                                <button class="pf-btn pf-btn-primary" type="submit">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                                    Save Changes
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </main>
    </div>

    <script>
        // Preview ảnh vừa chọn trước khi lưu
        (function () {
            var input = document.getElementById('avatar-input');
            var preview = document.getElementById('avatar-preview');
            var initial = document.getElementById('avatar-initial');
            if (!input) return;
            input.addEventListener('change', function () {
                var file = input.files && input.files[0];
                if (!file) return;
                var url = URL.createObjectURL(file);
                preview.src = url;
                preview.style.display = '';
                if (initial) initial.style.display = 'none';
            });
        })();
    </script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>
