@model WebClient.Models.Payment.CreditHistoryViewModel
@{
    ViewData["Title"] = "Credit History";
    ViewData["ProfileActive"] = "credits";
    Layout = null;
    string TypeCls(string t) => t switch
    {
        "Usage"    => "badge-usage",
        "Purchase" => "badge-purchase",
        "Refund"   => "badge-refund",
        "Bonus"    => "badge-bonus",
        _          => "badge-usage"
    };
    string TypeIcon(string t) => t switch
    {
        "Usage"    => "remove_circle",
        "Purchase" => "add_circle",
        "Refund"   => "replay_circle_filled",
        "Bonus"    => "redeem",
        _          => "toll"
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Credit History – DevPrep AI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg:             #0e1323;
            --surface:        rgba(17, 24, 39, 0.72);
            --surface-hover:  rgba(255,255,255,0.05);
            --border:         rgba(255,255,255,0.08);
            --border-muted:   rgba(255,255,255,0.04);
            --primary:        #c7c2ff;
            --primary-dim:    rgba(199,194,255,0.12);
            --secondary:      #4cd7f6;
            --success:        #10B981;
            --success-dim:    rgba(16,185,129,0.12);
            --error:          #ff6b6b;
            --error-dim:      rgba(255,107,107,0.12);
            --warning:        #F9D949;
            --text:           #e5e1e7;
            --text-muted:     #9ca3af;
            --text-dim:       #6b7280;
            --radius-sm:      8px;
            --radius-md:      12px;
            --radius-lg:      16px;
        }

        html, body { height: 100%; }
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }

        .cr-main { flex: 1; margin-left: var(--pf-sidebar-w); padding: 32px 32px 48px; overflow-x: hidden; min-width: 0; }

        .page-header { margin-bottom: 28px; }
        .page-label {
            font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 600;
            letter-spacing: 0.12em; text-transform: uppercase; color: var(--secondary); margin-bottom: 6px;
        }
        .page-title { font-size: 24px; font-weight: 700; color: var(--text); letter-spacing: -0.02em; }
        .page-sub   { font-size: 13px; color: var(--text-muted); margin-top: 4px; }

        .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 28px; }
        .stat-card {
            background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg);
            padding: 22px 24px; backdrop-filter: blur(12px); position: relative; overflow: hidden;
        }
        .stat-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; }
        .stat-card.stat-primary::before { background: linear-gradient(90deg, #6366f1, #a855f7); }
        .stat-card.stat-error::before   { background: linear-gradient(90deg, #ff6b6b, #f97316); }
        .stat-card.stat-success::before { background: linear-gradient(90deg, #10B981, #34d399); }
        .stat-label {
            font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 600;
            letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 12px;
        }
        .stat-value { font-size: 32px; font-weight: 700; letter-spacing: -0.04em; line-height: 1; margin-bottom: 4px; }
        .stat-value.primary { color: var(--primary); }
        .stat-value.error   { color: var(--error); }
        .stat-value.success { color: var(--success); }
        .stat-unit { font-size: 12px; color: var(--text-muted); font-weight: 500; }
        .stat-icon { position: absolute; top: 20px; right: 20px; font-size: 28px; opacity: 0.12; }
        .stat-icon.primary { color: var(--primary); }
        .stat-icon.error   { color: var(--error); }
        .stat-icon.success { color: var(--success); }

        .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); backdrop-filter: blur(12px); overflow: hidden; }

        .toolbar { display: flex; align-items: center; gap: 10px; padding: 16px 20px; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
        .type-chips { display: flex; gap: 8px; flex-wrap: wrap; }
        .chip {
            display: inline-flex; align-items: center; gap: 5px; padding: 7px 14px;
            border-radius: 20px; border: 1px solid var(--border); background: rgba(255,255,255,0.03);
            color: var(--text-muted); font-family: 'JetBrains Mono', monospace; font-size: 11px;
            font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase;
            text-decoration: none; transition: background 0.15s, color 0.15s, border-color 0.15s;
        }
        .chip:hover { background: var(--surface-hover); color: var(--text); }
        .chip.chip-now { background: var(--primary-dim); color: var(--primary); border-color: rgba(199,194,255,0.3); }
        .chip .material-symbols-outlined { font-size: 14px; }

        .cr-table { width: 100%; border-collapse: collapse; }
        .cr-table th {
            text-align: left; padding: 12px 20px; font-family: 'JetBrains Mono', monospace;
            font-size: 9px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
            color: var(--text-dim); border-bottom: 1px solid var(--border); white-space: nowrap;
        }
        .cr-table td { padding: 14px 20px; border-bottom: 1px solid var(--border-muted); font-size: 13px; vertical-align: middle; }
        .cr-table tbody tr { transition: background 0.1s; }
        .cr-table tbody tr:hover { background: var(--surface-hover); }
        .cr-table tbody tr:last-child td { border-bottom: none; }
        .th-right, .td-right { text-align: right; }
        /* Specificity đủ mạnh để thắng `.cr-table th { text-align:left }` cho tiêu đề. */
        .cr-table th.th-center, .cr-table td.td-center { text-align: center; }

        .cr-date { color: var(--text); font-weight: 500; }
        .cr-time { font-size: 11px; color: var(--text-dim); margin-top: 2px; }
        .cr-desc { color: var(--text); }
        .cr-ref  { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--text-dim); margin-top: 2px; }

        .cr-change { font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 14px; }
        .cr-change.neg { color: var(--error); }
        .cr-change.pos { color: var(--success); }
        .cr-balance { font-family: 'JetBrains Mono', monospace; font-weight: 600; color: var(--secondary); }

        .badge {
            display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 20px;
            font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 600;
            letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap;
        }
        .badge .material-symbols-outlined { font-size: 12px; }
        .badge-usage    { background: var(--error-dim);   color: var(--error); }
        .badge-purchase { background: var(--success-dim); color: var(--success); }
        .badge-refund   { background: var(--success-dim); color: var(--success); }
        .badge-bonus    { background: var(--success-dim); color: var(--success); }

        .table-empty { text-align: center; padding: 64px 24px; color: var(--text-muted); }
        .table-empty .material-symbols-outlined { font-size: 48px; opacity: 0.25; display: block; margin-bottom: 12px; }
        .table-empty p { font-size: 14px; margin-bottom: 16px; }

        .error-banner {
            margin: 0 20px 20px; background: var(--error-dim); border: 1px solid rgba(255,107,107,0.2);
            border-radius: var(--radius-md); padding: 12px 16px; font-size: 13px; color: var(--error);
        }

        .pagination { display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; border-top: 1px solid var(--border); }
        .pagination-info { font-size: 12px; color: var(--text-muted); }
        .pagination-nav  { display: flex; gap: 6px; }
        .page-btn {
            display: inline-flex; align-items: center; gap: 4px; padding: 6px 12px;
            border-radius: var(--radius-sm); border: 1px solid var(--border); background: rgba(255,255,255,0.03);
            color: var(--text-muted); font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600;
            text-decoration: none; transition: background 0.15s, color 0.15s;
        }
        .page-btn:hover        { background: var(--surface-hover); color: var(--text); }
        .page-btn.page-btn-now { background: var(--primary-dim); color: var(--primary); border-color: rgba(199,194,255,0.25); }
        .page-btn .material-symbols-outlined { font-size: 14px; }

        @@media (max-width: 768px) {
            .cr-main { padding: 20px 16px 40px; }
            .stats-grid { grid-template-columns: 1fr 1fr; }
            .col-hide { display: none; }
            .toolbar { flex-direction: column; align-items: stretch; }
        }
        @@media (max-width: 480px) { .stats-grid { grid-template-columns: 1fr; } }
    </style>
    <link rel="stylesheet" href="~/css/components/pagination.css" asp-append-version="true" />
</head>
<body class="pf-page">

@await Html.PartialAsync("_ProfileTopbar")

<div class="pf-shell">
    @await Html.PartialAsync("_ProfileSidebar")

    <main class="cr-main">

        <!-- Page header -->
        <div class="page-header">
            <p class="page-label">Credit Wallet</p>
            <h1 class="page-title">Credit History</h1>
            <p class="page-sub">Every credit deduction, purchase and refund on your wallet</p>
        </div>

        <!-- Stats -->
        <div class="stats-grid">
            <div class="stat-card stat-primary">
                <span class="material-symbols-outlined stat-icon primary" style="font-variation-settings:'FILL' 1;">toll</span>
                <p class="stat-label">Current Balance</p>
                <p class="stat-value primary">@Model.Balance.Balance</p>
                <p class="stat-unit">credits available</p>
            </div>
            <div class="stat-card stat-error">
                <span class="material-symbols-outlined stat-icon error" style="font-variation-settings:'FILL' 1;">remove_circle</span>
                <p class="stat-label">Total Used</p>
                <p class="stat-value error">@Model.TotalUsed</p>
                <p class="stat-unit">credits spent on interviews</p>
            </div>
            <div class="stat-card stat-success">
                <span class="material-symbols-outlined stat-icon success" style="font-variation-settings:'FILL' 1;">replay_circle_filled</span>
                <p class="stat-label">Total Refunded</p>
                <p class="stat-value success">@Model.TotalRefunded</p>
                <p class="stat-unit">credits returned</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="error-banner">
                <strong>Error:</strong> @Model.ErrorMessage
            </div>
        }

        <!-- Ledger table card -->
        <div class="card">

            <!-- Type filter chips (server-side filter, giữ phân trang đúng) -->
            <div class="toolbar">
                <div class="type-chips">
                    <a asp-controller="Profile" asp-action="CreditHistory"
                       class="chip @(Model.Type is null ? "chip-now" : "")">All</a>
                    <a asp-controller="Profile" asp-action="CreditHistory" asp-route-type="Usage"
                       class="chip @(Model.Type == "Usage" ? "chip-now" : "")">
                        <span class="material-symbols-outlined">remove_circle</span> Usage
                    </a>
                    <a asp-controller="Profile" asp-action="CreditHistory" asp-route-type="Purchase"
                       class="chip @(Model.Type == "Purchase" ? "chip-now" : "")">
                        <span class="material-symbols-outlined">add_circle</span> Purchase
                    </a>
                    <a asp-controller="Profile" asp-action="CreditHistory" asp-route-type="Refund"
                       class="chip @(Model.Type == "Refund" ? "chip-now" : "")">
                        <span class="material-symbols-outlined">replay_circle_filled</span> Refund
                    </a>
                </div>
            </div>

            @if (Model.Items.Count == 0 && string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="table-empty">
                    <span class="material-symbols-outlined">toll</span>
                    <p>No credit activity@(Model.Type is null ? "" : $" of type \"{Model.Type}\"") yet.</p>
                </div>
            }
            else if (Model.Items.Count > 0)
            {
                <div style="overflow-x:auto;">
                    <table class="cr-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Description</th>
                                <th class="th-center">Change</th>
                                <th class="th-center col-hide">Balance After</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Model.Items)
                            {
                                var neg = e.CreditChange < 0;
                                <tr>
                                    <td>
                                        <div class="cr-date">@e.CreatedAt.ToString("dd MMM yyyy", DisplayCulture.Neutral)</div>
                                        <div class="cr-time">@e.CreatedAt.ToString("HH:mm")</div>
                                    </td>
                                    <td>
                                        <span class="badge @TypeCls(e.EntryType)">
                                            <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1;">@TypeIcon(e.EntryType)</span>
                                            @e.EntryType
                                        </span>
                                    </td>
                                    <td>
                                        <div class="cr-desc">@(string.IsNullOrWhiteSpace(e.Description) ? (e.EntryType == "Usage" ? "Interview session" : e.EntryType) : e.Description)</div>
                                        @if (e.ReferenceId is not null)
                                        {
                                            <div class="cr-ref">Ref: @e.ReferenceId.Value.ToString()[..8]…</div>
                                        }
                                    </td>
                                    <td class="td-center">
                                        <span class="cr-change @(neg ? "neg" : "pos")">@(neg ? "" : "+")@e.CreditChange</span>
                                    </td>
                                    <td class="td-center col-hide">
                                        <span class="cr-balance">@e.BalanceAfter</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination (giữ filter type khi chuyển trang) -->
                @if (Model.TotalPages > 1 || Model.TotalCount > 0)
                {
                    var start = (Model.Page - 1) * Model.PageSize + 1;
                    var end   = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
                    <div class="pagination">
                        <span class="pagination-info">
                            Showing @start–@end of @Model.TotalCount entr@(Model.TotalCount == 1 ? "y" : "ies")
                        </span>
                        @{
                            string PageUrl(int pageNumber) => Url.Action("CreditHistory", "Profile", new
                            {
                                page = pageNumber,
                                type = Model.Type
                            }) ?? "#";
                        }
                        <partial name="_Pagination" model="new WebClient.Models.Shared.PaginationViewModel
                        {
                            CurrentPage = Model.Page,
                            TotalPages = Model.TotalPages,
                            PageUrl = PageUrl
                        }" />
                    </div>
                }
            }
        </div>

    </main>
</div>

</body>
</html>
