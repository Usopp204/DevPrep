@model WebClient.Models.Payment.TransactionHistoryViewModel
@{
    ViewData["Title"] = "Transaction History";
    ViewData["ProfileActive"] = "transactions";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Transaction History – DevPrep AI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg:             #0e1323;
            --bg-alt:         #111827;
            --surface:        rgba(17, 24, 39, 0.72);
            --surface-hover:  rgba(255,255,255,0.05);
            --border:         rgba(255,255,255,0.08);
            --border-muted:   rgba(255,255,255,0.04);
            --primary:        #c7c2ff;
            --primary-dim:    rgba(199,194,255,0.12);
            --secondary:      #4cd7f6;
            --success:        #10B981;
            --success-dim:    rgba(16,185,129,0.12);
            --error:          #ff6b6b;
            --error-dim:      rgba(255,107,107,0.12);
            --warning:        #F9D949;
            --text:           #e5e1e7;
            --text-muted:     #9ca3af;
            --text-dim:       #6b7280;
            --radius-sm:      8px;
            --radius-md:      12px;
            --radius-lg:      16px;
            --radius-xl:      20px;
        }

        html, body { height: 100%; }
        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        /* ── Main content ───────────────────────────────────── */
        .tx-main {
            flex: 1;
            margin-left: var(--pf-sidebar-w);
            padding: 32px 32px 48px;
            overflow-x: hidden;
            min-width: 0;
        }

        /* ── Page header ─────────────────────────────────── */
        .page-header { margin-bottom: 28px; }
        .page-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--secondary);
            margin-bottom: 6px;
        }
        .page-title { font-size: 24px; font-weight: 700; color: var(--text); letter-spacing: -0.02em; }
        .page-sub   { font-size: 13px; color: var(--text-muted); margin-top: 4px; }

        /* ── Stats bento ─────────────────────────────────── */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 28px;
        }
        .stat-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 22px 24px;
            backdrop-filter: blur(12px);
            position: relative;
            overflow: hidden;
        }
        .stat-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
        }
        .stat-card.stat-primary::before { background: linear-gradient(90deg, #6366f1, #a855f7); }
        .stat-card.stat-success::before { background: linear-gradient(90deg, #10B981, #34d399); }
        .stat-card.stat-secondary::before { background: linear-gradient(90deg, #4cd7f6, #818cf8); }
        .stat-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 12px;
        }
        .stat-value {
            font-size: 32px;
            font-weight: 700;
            letter-spacing: -0.04em;
            line-height: 1;
            margin-bottom: 4px;
        }
        .stat-value.primary   { color: var(--primary); }
        .stat-value.success   { color: var(--success); }
        .stat-value.secondary { color: var(--secondary); }
        .stat-unit { font-size: 12px; color: var(--text-muted); font-weight: 500; }
        .stat-icon {
            position: absolute;
            top: 20px; right: 20px;
            font-size: 28px;
            opacity: 0.12;
        }
        .stat-icon.primary   { color: var(--primary); }
        .stat-icon.success   { color: var(--success); }
        .stat-icon.secondary { color: var(--secondary); }

        /* ── Card ────────────────────────────────────────── */
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            backdrop-filter: blur(12px);
            overflow: hidden;
        }

        /* ── Table toolbar ───────────────────────────────── */
        .toolbar {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            flex-wrap: wrap;
        }
        .search-wrap {
            position: relative;
            flex: 1;
            min-width: 180px;
        }
        .search-icon {
            position: absolute;
            left: 10px; top: 50%;
            transform: translateY(-50%);
            font-size: 16px;
            color: var(--text-dim);
            pointer-events: none;
        }
        .search-input {
            width: 100%;
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            color: var(--text);
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            padding: 8px 12px 8px 34px;
            outline: none;
            transition: border-color 0.15s, background 0.15s;
        }
        .search-input::placeholder { color: var(--text-dim); }
        .search-input:focus { border-color: rgba(199,194,255,0.4); background: rgba(255,255,255,0.06); }

        .filter-select {
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            color: var(--text);
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            padding: 8px 12px;
            outline: none;
            cursor: pointer;
            transition: border-color 0.15s;
        }
        .filter-select:focus { border-color: rgba(199,194,255,0.4); }
        .filter-select option { background: #1a1f30; }

        .date-input {
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            color: var(--text);
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            padding: 8px 12px;
            outline: none;
            transition: border-color 0.15s;
        }
        .date-input:focus { border-color: rgba(199,194,255,0.4); }
        .date-input::-webkit-calendar-picker-indicator { filter: invert(0.7); cursor: pointer; }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            border-radius: var(--radius-sm);
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            text-decoration: none;
            transition: opacity 0.15s, background 0.15s;
        }
        .btn .material-symbols-outlined { font-size: 16px; }
        .btn-primary {
            background: linear-gradient(135deg, #6366f1, #a855f7);
            color: #fff;
        }
        .btn-primary:hover { opacity: 0.88; }
        .btn-ghost {
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--border);
            color: var(--text-muted);
        }
        .btn-ghost:hover { background: rgba(255,255,255,0.08); color: var(--text); }

        /* ── Table ────────────────────────────────────────── */
        .tx-table {
            width: 100%;
            border-collapse: collapse;
        }
        .tx-table th {
            text-align: left;
            padding: 12px 20px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 9px;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--text-dim);
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }
        .tx-table td {
            padding: 14px 20px;
            border-bottom: 1px solid var(--border-muted);
            font-size: 13px;
            vertical-align: middle;
        }
        .tx-table tbody tr { transition: background 0.1s; }
        .tx-table tbody tr:hover { background: var(--surface-hover); }
        .tx-table tbody tr:last-child td { border-bottom: none; }
        .tx-table .th-right { text-align: right; }
        .tx-table .td-right { text-align: right; }

        .order-code {
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            font-weight: 600;
            color: var(--text);
            letter-spacing: 0.02em;
        }
        .order-method {
            font-size: 11px;
            color: var(--text-dim);
            margin-top: 2px;
        }
        .tx-date   { color: var(--text); font-weight: 500; }
        .tx-time   { font-size: 11px; color: var(--text-dim); margin-top: 2px; }
        .tx-desc   { color: var(--text); }
        .tx-credits {
            font-weight: 700;
            color: var(--secondary);
            font-size: 14px;
        }
        .tx-amount { color: var(--text); font-weight: 500; }
        .tx-currency { font-size: 11px; color: var(--text-dim); }

        /* Status badges */
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px 10px;
            border-radius: 20px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            white-space: nowrap;
        }
        .badge .material-symbols-outlined { font-size: 12px; }
        .badge-paid    { background: var(--success-dim); color: var(--success); }
        .badge-failed  { background: var(--error-dim);   color: var(--error);   }
        .badge-pending { background: rgba(249,217,73,0.12); color: var(--warning); }

        /* Empty / error states */
        .table-empty {
            text-align: center;
            padding: 64px 24px;
            color: var(--text-muted);
        }
        .table-empty .material-symbols-outlined { font-size: 48px; opacity: 0.25; display: block; margin-bottom: 12px; }
        .table-empty p { font-size: 14px; margin-bottom: 16px; }

        .error-banner {
            margin: 0 20px 20px;
            background: var(--error-dim);
            border: 1px solid rgba(255,107,107,0.2);
            border-radius: var(--radius-md);
            padding: 12px 16px;
            font-size: 13px;
            color: var(--error);
        }

        /* Hidden by JS filters */
        .tx-row.hidden { display: none; }

        /* ── Pagination ───────────────────────────────────── */
        .pagination {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 20px;
            border-top: 1px solid var(--border);
        }
        .pagination-info { font-size: 12px; color: var(--text-muted); }
        .pagination-nav  { display: flex; gap: 6px; }
        .page-btn {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 6px 12px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            background: rgba(255,255,255,0.03);
            color: var(--text-muted);
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            transition: background 0.15s, color 0.15s;
        }
        .page-btn:hover         { background: var(--surface-hover); color: var(--text); }
        .page-btn.page-btn-now  { background: var(--primary-dim); color: var(--primary); border-color: rgba(199,194,255,0.25); }
        .page-btn .material-symbols-outlined { font-size: 14px; }

        /* ── No-result overlay ────────────────────────────── */
        .no-filter-result {
            text-align: center;
            padding: 40px 24px;
            color: var(--text-muted);
            font-size: 13px;
            display: none;
        }

        /* ── Responsive ──────────────────────────────────── */
        @@media (max-width: 768px) {
            .tx-main { padding: 20px 16px 40px; }
            .stats-grid { grid-template-columns: 1fr 1fr; }
            .col-hide { display: none; }
            .toolbar { flex-direction: column; align-items: stretch; }
        }
        @@media (max-width: 480px) {
            .stats-grid { grid-template-columns: 1fr; }
        }
    </style>
    <link rel="stylesheet" href="~/css/components/pagination.css" asp-append-version="true" />
</head>
<body class="pf-page">

@await Html.PartialAsync("_ProfileTopbar")

<div class="pf-shell">
    @await Html.PartialAsync("_ProfileSidebar")

    <main class="tx-main">

        <!-- Page header -->
        <div class="page-header">
            <p class="page-label">Credit Wallet</p>
            <h1 class="page-title">Transaction History</h1>
            <p class="page-sub">Your credit purchases and wallet activity</p>
        </div>

        <!-- Stats bento -->
        <div class="stats-grid">
            <div class="stat-card stat-primary">
                <span class="material-symbols-outlined stat-icon primary" style="font-variation-settings:'FILL' 1;">toll</span>
                <p class="stat-label">Current Balance</p>
                <p class="stat-value primary">@Model.Balance.Balance</p>
                <p class="stat-unit">credits available</p>
            </div>
            <div class="stat-card stat-success">
                <span class="material-symbols-outlined stat-icon success" style="font-variation-settings:'FILL' 1;">shopping_cart</span>
                <p class="stat-label">Total Purchased</p>
                <p class="stat-value success">@Model.Balance.TotalPurchased</p>
                <p class="stat-unit">credits all-time</p>
            </div>
            <div class="stat-card stat-secondary">
                <span class="material-symbols-outlined stat-icon secondary" style="font-variation-settings:'FILL' 1;">live_help</span>
                <p class="stat-label">Sessions Remaining</p>
                <p class="stat-value secondary">@Model.Balance.Balance</p>
                <p class="stat-unit">interview sessions</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="error-banner">
                <strong>Error:</strong> @Model.ErrorMessage
            </div>
        }

        <!-- Transaction table card -->
        <div class="card">

            <!-- Toolbar -->
            <div class="toolbar">
                <div class="search-wrap">
                    <span class="material-symbols-outlined search-icon">search</span>
                    <input type="text" id="searchInput" class="search-input"
                           placeholder="Search by order code..." />
                </div>
                <select id="statusFilter" class="filter-select" aria-label="Status filter">
                    <option value="">All Status</option>
                    <option value="Paid">Paid</option>
                    <option value="Failed">Failed</option>
                    <option value="Pending">Pending</option>
                </select>
                <input type="date" id="dateFrom" class="date-input" title="From date" />
                <input type="date" id="dateTo"   class="date-input" title="To date" />
                <a asp-controller="Payment" asp-action="Index" class="btn btn-primary">
                    <span class="material-symbols-outlined">add</span>
                    Buy Credits
                </a>
            </div>

            @if (Model.Items.Count == 0 && string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="table-empty">
                    <span class="material-symbols-outlined">receipt_long</span>
                    <p>No transactions yet.</p>
                    <a asp-controller="Payment" asp-action="Index" class="btn btn-primary" style="margin:0 auto;">
                        <span class="material-symbols-outlined">add</span>
                        Purchase your first credit package
                    </a>
                </div>
            }
            else if (Model.Items.Count > 0)
            {
                <div style="overflow-x:auto;">
                    <table class="tx-table" id="txTable">
                        <thead>
                            <tr>
                                <th>Transaction Code</th>
                                <th class="col-hide">Date</th>
                                <th>Description</th>
                                <th class="th-right">Amount</th>
                                <th style="text-align:center;">Status</th>
                            </tr>
                        </thead>
                        <tbody id="txBody">
                            @foreach (var tx in Model.Items)
                            {
                                var txDate = (tx.PaidAt ?? tx.CreatedAt);
                                var badgeCls = tx.Status == "Paid" ? "badge-paid" : (tx.Status == "Failed" ? "badge-failed" : "badge-pending");
                                var badgeIcon = tx.Status == "Paid" ? "check_circle" : (tx.Status == "Failed" ? "cancel" : "schedule");
                                <tr class="tx-row"
                                    data-order="@tx.OrderCode.ToLower()"
                                    data-status="@tx.Status"
                                    data-date="@txDate.ToString("yyyy-MM-dd")">
                                    <td>
                                        <div class="order-code">@tx.OrderCode</div>
                                        <div class="order-method">@tx.PaymentMethod</div>
                                    </td>
                                    <td class="col-hide">
                                        <div class="tx-date">@txDate.ToString("dd MMM yyyy")</div>
                                        <div class="tx-time">@txDate.ToString("HH:mm")</div>
                                    </td>
                                    <td>
                                        <div class="tx-desc">@tx.Credits Credits Package</div>
                                    </td>
                                    <td class="td-right">
                                        <div class="tx-amount">@tx.Amount.ToString("N0")</div>
                                        <div class="tx-currency">@tx.Currency</div>
                                    </td>
                                    <td style="text-align:center;">
                                        <span class="badge @badgeCls">
                                            <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1;">@badgeIcon</span>
                                            @tx.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- No filter result message -->
                <div class="no-filter-result" id="noFilterResult">
                    <span class="material-symbols-outlined" style="font-size:32px;display:block;margin-bottom:8px;opacity:0.3;">search_off</span>
                    No transactions match your filters.
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1 || Model.TotalCount > 0)
                {
                    var start = (Model.Page - 1) * Model.PageSize + 1;
                    var end   = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
                    <div class="pagination" id="paginationBar">
                        <span class="pagination-info">
                            Showing @start–@end of @Model.TotalCount transaction(s)
                        </span>
                        @{
                            string PageUrl(int pageNumber) => Url.Action("TransactionHistory", "Profile", new
                            {
                                page = pageNumber
                            }) ?? "#";
                        }
                        <partial name="_Pagination" model="new WebClient.Models.Shared.PaginationViewModel
                        {
                            CurrentPage = Model.Page,
                            TotalPages = Model.TotalPages,
                            PageUrl = PageUrl
                        }" />
                    </div>
                }
            }
        </div>

    </main>
</div>

<script>
(function () {
    const searchInput  = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');
    const dateFrom     = document.getElementById('dateFrom');
    const dateTo       = document.getElementById('dateTo');
    const rows         = document.querySelectorAll('#txBody .tx-row');
    const noResult     = document.getElementById('noFilterResult');
    const pagination   = document.getElementById('paginationBar');

    function applyFilters() {
        const q      = searchInput.value.trim().toLowerCase();
        const status = statusFilter.value;
        const from   = dateFrom.value ? new Date(dateFrom.value) : null;
        const to     = dateTo.value   ? new Date(dateTo.value + 'T23:59:59') : null;
        let visible  = 0;

        rows.forEach(row => {
            const matchQ      = !q || row.dataset.order.includes(q);
            const matchStatus = !status || row.dataset.status === status;
            const rowDate     = new Date(row.dataset.date);
            const matchFrom   = !from || rowDate >= from;
            const matchTo     = !to   || rowDate <= to;
            const show = matchQ && matchStatus && matchFrom && matchTo;
            row.classList.toggle('hidden', !show);
            if (show) visible++;
        });

        if (noResult) noResult.style.display = (visible === 0 && rows.length > 0) ? 'block' : 'none';
        // Hide pagination when filters are active to avoid confusion
        if (pagination) pagination.style.display = (q || status || dateFrom.value || dateTo.value) ? 'none' : 'flex';
    }

    searchInput.addEventListener('input',  applyFilters);
    statusFilter.addEventListener('change', applyFilters);
    dateFrom.addEventListener('change',    applyFilters);
    dateTo.addEventListener('change',      applyFilters);
})();
</script>

</body>
</html>
