@model WebClient.Models.Manager.ManagerNewsDetailViewModel
@{
    Layout = null;
    ViewData["Title"] = "News Detail";
    var displayDate = Model.PublishedAt ?? Model.CreatedAt;
    var publishedText = Model.PublishedAt.HasValue ? Model.PublishedAt.Value.ToString("dd/MM/yyyy HH:mm") : "Not published";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DevPrep AI Manager Console</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        :root {
            --bg-main: #0f1424;
            --bg-panel: #111827;
            --border-main: #252b3d;
            --text-main: #ffffff;
            --text-muted: #9ca3af;
            --text-blue: #93c5fd;
            --primary: #6366f1;
        }

        body {
            background: var(--bg-main);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
        }

        .admin-main-wrapper {
            margin-left: 260px;
            padding-top: 78px;
            min-height: 100vh;
            background: var(--bg-main);
        }

        .admin-content {
            padding: 28px 28px 60px;
        }

        .page-title {
            font-size: 30px;
            font-weight: 800;
            letter-spacing: -0.04em;
            margin-bottom: 4px;
        }

        .page-subtitle {
            color: var(--text-blue);
            font-size: 14px;
            margin-bottom: 0;
        }

        .btn-outline-soft {
            background: transparent;
            color: #cbd5e1;
            border: 1px solid #30384e;
            border-radius: 9px;
            padding: 10px 14px;
            text-decoration: none;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-outline-soft:hover {
            background: rgba(255,255,255,.06);
            color: #fff;
        }

        .nd-layout{display:grid;grid-template-columns:minmax(0,2fr) minmax(280px,0.9fr);gap:24px;align-items:start}
        .nd-hero{overflow:hidden;border-radius:8px;margin-bottom:20px}
        .nd-banner{height:260px;background:linear-gradient(135deg,#1f2937,#111827);display:flex;align-items:flex-end;padding:28px;border-bottom:1px solid var(--ad-border)}
        .nd-banner.has-image{background-size:cover;background-position:center}
        .nd-title{font-size:34px;font-weight:800;color:#fff;max-width:920px;margin:0;text-shadow:0 2px 10px rgba(0,0,0,.45)}
        .nd-body{padding:24px}
        .nd-meta{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px}
        .nd-pill{font-family:'JetBrains Mono',monospace;font-size:11px;text-transform:uppercase;padding:5px 10px;border-radius:999px;background:rgba(226,223,255,.1);color:var(--ad-primary)}
        .nd-summary{font-size:16px;color:var(--ad-on-surface-variant);line-height:1.65;margin-bottom:24px}
        .nd-content{white-space:pre-wrap;font-family:'Inter',sans-serif;font-size:15px;line-height:1.75;color:var(--ad-on-surface);background:var(--ad-surface-container);border:1px solid var(--ad-border);border-radius:8px;padding:20px}
        .nd-side-card{background:var(--ad-surface-container);border:1px solid var(--ad-border);border-radius:8px;padding:20px;margin-bottom:16px}
        .nd-side-title{font-family:'JetBrains Mono',monospace;font-size:11px;text-transform:uppercase;color:var(--ad-on-surface-variant);letter-spacing:.06em;margin-bottom:14px}
        .nd-metric{font-size:28px;font-weight:800;color:var(--ad-on-surface)}
        .nd-meta-row{display:flex;justify-content:space-between;gap:14px;padding:10px 0;border-bottom:1px solid var(--ad-border);font-size:13px}
        .nd-meta-row:last-child{border-bottom:none}
        .nd-meta-label{color:var(--ad-on-surface-variant);font-weight:600}
        .nd-meta-value{color:var(--ad-on-surface);text-align:right;word-break:break-word}
        .nd-slug{font-family:'JetBrains Mono',monospace;font-size:12px;background:rgba(255,255,255,.04);border:1px solid var(--ad-border);border-radius:6px;padding:4px 8px;display:inline-block}
        @@media (max-width: 1100px){.nd-layout{grid-template-columns:1fr}}
    </style>
</head>
<body class="admin-page">
    @await Html.PartialAsync("_ManagerTopbar")
    @await Html.PartialAsync("_ManagerSidebar")

    <main class="admin-main-wrapper">
        <div class="admin-content">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                <div>
                    <h1 class="page-title">News Detail</h1>
                    <p class="page-subtitle">Full article content, metadata and performance metrics.</p>
                </div>
                <a href="/Manager/News" class="btn-outline-soft">
                    <i class="fa-solid fa-arrow-left"></i> Back
                </a>
            </div>

        <div class="nd-layout">
            <article class="glass-card nd-hero">
                @if (!string.IsNullOrWhiteSpace(Model.ThumbnailUrl))
                {
                    <div class="nd-banner has-image" style="background-image:linear-gradient(180deg,rgba(0,0,0,.15),rgba(0,0,0,.76)),url('@Model.ThumbnailUrl')">
                        <h1 class="nd-title">@Model.Title</h1>
                    </div>
                }
                else
                {
                    <div class="nd-banner">
                        <h1 class="nd-title">@Model.Title</h1>
                    </div>
                }

                <div class="nd-body">
                    <div class="nd-meta">
                        <span class="nd-pill">@Model.Status</span>
                        <span class="nd-pill">@(Model.CategoryName ?? "Uncategorized")</span>
                        <span class="nd-pill">@displayDate.ToString("MMM dd, yyyy")</span>
                        <span class="nd-pill">@Model.ViewCount views</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Summary))
                    {
                        <div class="nd-summary">@Model.Summary</div>
                    }

                    <h2 style="font-size:18px;font-weight:700;margin-bottom:12px;color:var(--ad-on-surface);">Raw Article Text</h2>
                    <div class="nd-content">@Model.Content</div>
                </div>
            </article>

            <aside>
                <div class="nd-side-card">
                    <div class="nd-side-title">Performance Metrics</div>
                    <div class="nd-meta-label">Views</div>
                    <div class="nd-metric">@Model.ViewCount.ToString("N0")</div>
                </div>

                <div class="nd-side-card">
                    <div class="nd-side-title">Article Summary</div>
                    <div class="nd-summary" style="margin-bottom:0;">@(string.IsNullOrWhiteSpace(Model.Summary) ? "No summary provided." : Model.Summary)</div>
                </div>

                <div class="nd-side-card">
                    <div class="nd-side-title">Article Metadata</div>
                    <div class="nd-meta-row"><span class="nd-meta-label">Status</span><span class="nd-meta-value">@Model.Status</span></div>
                    <div class="nd-meta-row"><span class="nd-meta-label">Slug</span><span class="nd-meta-value"><span class="nd-slug">@Model.Slug</span></span></div>
                    <div class="nd-meta-row"><span class="nd-meta-label">News ID</span><span class="nd-meta-value">@Model.NewsId</span></div>
                    <div class="nd-meta-row"><span class="nd-meta-label">Category</span><span class="nd-meta-value">@(Model.CategoryName ?? "Uncategorized")</span></div>
                    <div class="nd-meta-row"><span class="nd-meta-label">Published At</span><span class="nd-meta-value">@publishedText</span></div>
                    <div class="nd-meta-row"><span class="nd-meta-label">Created At</span><span class="nd-meta-value">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span></div>
                    <div class="nd-meta-row"><span class="nd-meta-label">Updated At</span><span class="nd-meta-value">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</span></div>
                </div>
            </aside>
        </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
