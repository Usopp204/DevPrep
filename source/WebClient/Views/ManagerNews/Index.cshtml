@model WebClient.Models.Manager.ManagerNewsPagedResult<WebClient.Models.Manager.ManagerNewsListItemViewModel>

@{
    Layout = null;
    ViewData["Title"] = "News Articles";

    var pageIndex = Model.PageIndex > 0 ? Model.PageIndex : 1;
    var pageSize = Model.PageSize > 0 ? Model.PageSize : 10;
    var totalCount = Model.TotalCount;
    var totalPages = Model.TotalPages > 0 ? Model.TotalPages : 1;

    var startItem = totalCount == 0 ? 0 : ((pageIndex - 1) * pageSize) + 1;
    var endItem = Math.Min(pageIndex * pageSize, totalCount);

    string BuildPageUrl(int page)
    {
        var values = new Dictionary<string, string?>
                {
                    ["keyword"] = ViewBag.Keyword,
                    ["status"] = ViewBag.Status,
                    ["categoryId"] = ((Guid?)ViewBag.CategoryId)?.ToString(),
                    ["page"] = page.ToString(),
                    ["pageSize"] = pageSize.ToString()
                };

        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/Manager/News", values);
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DevPrep AI Manager Console</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        :root {
            --bg-main: #0f1424;
            --bg-panel: #111827;
            --bg-panel-2: #151f36;
            --bg-head: #171a24;
            --border-main: #252b3d;
            --text-main: #ffffff;
            --text-muted: #9ca3af;
            --text-blue: #93c5fd;
            --primary: #6366f1;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
        }

        body {
            background: var(--bg-main);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
        }

        .admin-main-wrapper {
            margin-left: 260px;
            padding-top: 78px;
            min-height: 100vh;
            background: var(--bg-main);
        }

        .admin-content {
            padding: 28px 28px 60px;
        }

        .page-title {
            font-size: 30px;
            font-weight: 800;
            letter-spacing: -0.04em;
            margin-bottom: 4px;
        }

        .page-subtitle {
            color: var(--text-blue);
            font-size: 14px;
            margin-bottom: 0;
        }

        .filter-card {
            border: 1px solid var(--border-main);
            background: rgba(17, 24, 39, 0.95);
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 18px;
        }

        .filter-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 800;
            color: var(--text-blue);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 7px;
        }

        .admin-input, .admin-select {
            height: 42px;
            border-radius: 7px;
            border: 1px solid #30384e;
            background: #0f1322;
            color: #ffffff;
            font-size: 14px;
            box-shadow: none !important;
        }

        .admin-input:focus, .admin-select:focus {
            border-color: var(--primary) !important;
            background: #161824 !important;
            color: #ffffff !important;
        }

        .admin-select option {
            background-color: #11121a !important;
            color: #ffffff !important;
        }

        .admin-input::placeholder { color: #64748b; }

        .btn-filter {
            height: 42px; width: 100%; border: none; border-radius: 7px;
            background: #35304f; color: #ffffff; font-weight: 800;
        }
        .btn-filter:hover { background: #4f46e5; color: #ffffff; }

        .btn-clear {
            height: 42px; width: 100%; border-radius: 7px;
            border: 1px solid #30384e; background: transparent;
            color: #cbd5e1; font-weight: 700; text-decoration: none;
            display: flex; align-items: center; justify-content: center;
        }
        .btn-clear:hover { background: rgba(255,255,255,.06); color: #ffffff; }

        .table-shell {
            border: 1px solid var(--border-main);
            background: var(--bg-panel);
            border-radius: 12px;
            overflow: hidden;
        }

        .admin-table {
            width: 100%; margin: 0; color: #dbeafe;
            --bs-table-bg: #111827; --bs-table-color: #dbeafe;
            --bs-table-border-color: #242b3e; --bs-table-hover-bg: #151f36;
            --bs-table-hover-color: #ffffff;
        }

        .admin-table thead th {
            background: #171a24 !important; color: #a9c7f5 !important;
            font-family: 'JetBrains Mono', monospace; font-size: 11px;
            text-transform: uppercase; letter-spacing: 0.08em;
            border-bottom: 1px solid var(--border-main);
            padding: 15px 14px; white-space: nowrap;
        }

        .admin-table tbody tr { background: #111827 !important; }
        .admin-table tbody td {
            background: #111827 !important; color: #dbeafe !important;
            border-bottom: 1px solid #242b3e; padding: 16px 14px;
            vertical-align: middle; font-size: 14px;
        }
        .admin-table tbody tr:hover td { background: #151f36 !important; }

        .news-title { color: #ffffff; font-weight: 800; }
        .news-summary { color: var(--text-muted); font-size: 12px; margin-top: 4px; max-width: 480px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        .status-badge {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 6px 10px; border-radius: 7px;
            font-family: 'JetBrains Mono', monospace; font-size: 11px;
            font-weight: 800; text-transform: uppercase;
        }
        .status-published { background: rgba(16,185,129,.14); color: #34d399; }
        .status-draft { background: rgba(245,158,11,.16); color: #fbbf24; }
        .status-archived { background: rgba(239,68,68,.15); color: #f87171; }
        .status-deleted { background: rgba(239,68,68,.15); color: #f87171; }

        .deleted-row { opacity: 0.72; }
        .deleted-row .news-title { color: #94a3b8 !important; text-decoration: line-through; }

        .slug-text { color: var(--text-muted); font-size: 12px; }
        .summary-text { color: var(--text-muted); font-size: 12px; max-width: 380px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .date-text { color: var(--text-muted); font-size: 12px; }

        .action-btn {
            width: 34px; height: 34px; border: none; background: transparent;
            display: inline-flex; align-items: center; justify-content: center;
            border-radius: 8px; transition: 0.15s ease; text-decoration: none;
        }
        .action-btn:hover { background: rgba(255,255,255,.08); }
        .action-view { color: #94a3b8; }
        .action-view:hover { color: #ffffff; }

        .empty-row { height: 140px; color: #cbd5e1; text-align: center; font-weight: 600; }

        .table-footer {
            padding: 14px 16px; color: #cbd5e1; font-size: 13px;
            display: flex; align-items: center; justify-content: space-between;
            gap: 12px; border-top: 1px solid #242b3e; background: #111827;
        }

        .pager { display: flex; gap: 8px; align-items: center; }
        .pager a, .pager span {
            min-width: 34px; height: 34px; border-radius: 7px;
            border: 1px solid #30384e; color: #cbd5e1; text-decoration: none;
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 13px; font-weight: 700;
        }
        .pager .active-page { background: var(--primary); border-color: var(--primary); color: #ffffff; }

        @@media (max-width: 991.98px) {
            .admin-main-wrapper { margin-left: 0; padding-top: 70px; }
            .admin-content { padding: 20px 14px 50px; }
            .table-footer { flex-direction: column; align-items: flex-start; }
        }
    </style>
</head>
<body class="admin-page">
    @await Html.PartialAsync("_ManagerTopbar")
    @await Html.PartialAsync("_ManagerSidebar")

    <main class="admin-main-wrapper">
        <div class="admin-content">
            <div class="d-flex align-items-start justify-content-between gap-3 mb-4">
                <div>
                    <h1 class="page-title">News Articles</h1>
                    <p class="page-subtitle">View published articles, drafts and archived news content.</p>
                </div>
            </div>

            <form method="get" action="/Manager/News" id="managerFilterForm" class="filter-card" onsubmit="document.getElementById('pageIdxInput').value = 1;">
                <input type="hidden" name="page" id="pageIdxInput" value="@pageIndex" />
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-lg-5">
                        <div class="filter-label">Search</div>
                        <input name="keyword" value="@ViewBag.Keyword" type="text" class="form-control admin-input" placeholder="Search title, slug, or summary..." />
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="filter-label">Category</div>
                        <select name="categoryId" class="form-select admin-select">
                            <option value="">All Categories</option>
                            @if (ViewBag.Categories != null)
                            {
                                foreach (var cat in (List<WebClient.Models.Manager.ManagerNewsCategoryViewModel>)ViewBag.Categories)
                                {
                                    <option value="@cat.CategoryId" selected="@(ViewBag.CategoryId != null && ((Guid?)ViewBag.CategoryId).Value == cat.CategoryId ? "selected" : null)">@cat.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="filter-label">Status</div>
                        <select name="status" class="form-select admin-select">
                            <option value="">All Status</option>
                            <option value="Published" selected="@(ViewBag.Status == "Published")">Published</option>
                            <option value="Draft" selected="@(ViewBag.Status == "Draft")">Draft</option>
                            <option value="Archived" selected="@(ViewBag.Status == "Archived")">Archived</option>
                            <option value="Deleted" selected="@(ViewBag.Status == "Deleted")">Deleted</option>
                        </select>
                    </div>
                    <div class="col-6 col-lg-2">
                        <button class="btn-filter" type="submit">Apply Filter</button>
                    </div>
                    <div class="col-6 col-lg-2">
                        <a class="btn-clear" href="/Manager/News">Clear</a>
                    </div>
                </div>
            </form>

            <div class="table-shell">
                <div class="table-responsive">
                    <table class="table admin-table align-middle">
                        <thead>
                            <tr>
                                <th style="width: 28%;">Title & Slug</th>
                                <th style="width: 28%;">Summary</th>
                                <th style="width: 12%;">Status</th>
                                <th style="width: 8%;">Views</th>
                                <th style="width: 14%;">Created At</th>
                                <th style="width: 8%;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Any())
                            {
                                foreach (var item in Model.Items)
                                {
                                    var statusClass = item.IsDeleted ? "status-deleted" : (item.Status ?? "").ToLowerInvariant() switch
                                    {
                                        "published" => "status-published",
                                        "draft" => "status-draft",
                                        "archived" => "status-archived",
                                        _ => "status-draft"
                                    };
                                    var statusText = item.IsDeleted ? "DELETED" : (item.Status ?? "Unknown").ToUpperInvariant();

                                    <tr class="@(item.IsDeleted ? "deleted-row" : "")">
                                        <td>
                                            <div class="news-title" title="@item.Title">@item.Title</div>
                                            <div class="slug-text">@item.Slug</div>
                                        </td>
                                        <td>
                                            <div class="summary-text" title="@item.Summary">
                                                @(string.IsNullOrWhiteSpace(item.Summary) ? "No summary provided." : item.Summary)
                                            </div>
                                        </td>
                                        <td>
                                            <span class="status-badge @statusClass">
                                                <span style="font-size: 8px;">&bull;</span>
                                                @statusText
                                            </span>
                                        </td>
                                        <td>
                                            @if (item.ViewCount >= 1000)
                                            {
                                                @((item.ViewCount / 1000.0).ToString("0.0") + "k")
                                            }
                                            else
                                            {
                                                @item.ViewCount
                                            }
                                        </td>
                                        <td class="date-text">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end">
                                            <a class="action-btn action-view" href="/Manager/News/@item.NewsId" title="View details">
                                                <span class="material-symbols-outlined fs-5">visibility</span>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="empty-row">
                                        <i class="fa-regular fa-newspaper d-block mb-2" style="font-size: 28px;"></i>
                                        No news articles found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="table-footer">
                    <div>
                        Showing <strong>@startItem</strong>-<strong>@endItem</strong> of <strong>@totalCount</strong> articles
                    </div>
                    @if (totalPages > 1)
                    {
                        var prevPage = pageIndex <= 1 ? 1 : pageIndex - 1;
                        var nextPage = pageIndex >= totalPages ? totalPages : pageIndex + 1;

                        <div class="pager">
                            <a href="@BuildPageUrl(prevPage)"><i class="fa-solid fa-chevron-left"></i></a>
                            @{
                                var maxVisiblePages = 30;
                                var startPage = Math.Max(1, pageIndex - (maxVisiblePages / 2));
                                var endPage = Math.Min(totalPages, startPage + maxVisiblePages - 1);
                                if (endPage - startPage + 1 < maxVisiblePages)
                                {
                                    startPage = Math.Max(1, endPage - maxVisiblePages + 1);
                                }
                            }

                            @for (var i = startPage; i <= endPage; i++)
                            {
                                if (i == pageIndex)
                                {
                                    <span class="active-page">@i</span>
                                }
                                else
                                {
                                    <a href="@BuildPageUrl(i)">@i</a>
                                }
                            }
                            <a href="@BuildPageUrl(nextPage)"><i class="fa-solid fa-chevron-right"></i></a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
