@model WebClient.Models.Manager.ManagerNewsPagedResult<WebClient.Models.Manager.ManagerNewsListItemViewModel>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>News - DevPrep AI Manager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        .mn-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px}
        .mn-title{font-size:24px;font-weight:700;color:var(--ad-on-surface);margin:0}
        .mn-filter{display:flex;gap:12px;align-items:center;padding:16px;border-radius:8px;margin-bottom:20px}
        .mn-search{position:relative;flex:1}
        .mn-search .material-symbols-outlined{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--ad-on-surface-variant);font-size:20px}
        .mn-input,.mn-select{background:var(--ad-surface-container);border:1px solid var(--ad-border);color:var(--ad-on-surface);border-radius:8px;padding:10px 12px;outline:none}
        .mn-input{width:100%;padding-left:40px}
        .mn-select{min-width:150px}
        .mn-table-wrap{border-radius:8px;overflow:hidden}
        .mn-table{width:100%;border-collapse:collapse}
        .mn-table th{padding:14px 16px;background:var(--ad-surface-container-high);border-bottom:1px solid var(--ad-border);font-family:'JetBrains Mono',monospace;font-size:11px;text-transform:uppercase;color:var(--ad-on-surface-variant)}
        .mn-table td{padding:14px 16px;border-bottom:1px solid var(--ad-border);color:var(--ad-on-surface);vertical-align:middle}
        .mn-table tr:hover{background:rgba(255,255,255,.025)}
        .mn-title-cell{font-weight:700;margin-bottom:4px}
        .mn-summary{font-size:12px;color:var(--ad-on-surface-variant);max-width:560px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .mn-chip{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;background:rgba(226,223,255,.1);color:var(--ad-primary);font-size:11px;font-weight:700;text-transform:uppercase}
        .mn-chip.published{background:rgba(16,185,129,.12);color:var(--ad-success)}
        .mn-action{display:inline-flex;align-items:center;justify-content:center;color:var(--ad-on-surface-variant);text-decoration:none}
        .mn-action:hover{color:var(--ad-primary)}
        .mn-pagination{display:flex;justify-content:space-between;align-items:center;padding:14px 16px}
        .mn-page-links{display:flex;gap:6px}
        .mn-page{min-width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--ad-border);border-radius:8px;color:var(--ad-on-surface-variant);text-decoration:none}
        .mn-page.cur{background:var(--ad-primary);color:var(--ad-on-primary,#1d192b);border-color:var(--ad-primary);font-weight:700}
    </style>
</head>
<body class="admin-page">
    @await Html.PartialAsync("_AdminTopbar")
    @await Html.PartialAsync("_AdminSidebar")

    <main class="ad-main">
        <div class="mn-header">
            <h1 class="mn-title">News Tracker</h1>
        </div>

        <form method="get" action="/Manager/News" class="glass-card mn-filter">
            <div class="mn-search">
                <span class="material-symbols-outlined">search</span>
                <input class="mn-input" name="keyword" value="@ViewBag.Keyword" placeholder="Search title, slug, or summary..." />
            </div>
            <select class="mn-select" name="status" onchange="this.form.submit()">
                <option value="">All Status</option>
                <option value="Published" selected="@(ViewBag.Status == "Published")">Published</option>
                <option value="Draft" selected="@(ViewBag.Status == "Draft")">Draft</option>
                <option value="Archived" selected="@(ViewBag.Status == "Archived")">Archived</option>
            </select>
        </form>

        <div class="glass-card mn-table-wrap">
            <table class="mn-table">
                <thead>
                    <tr>
                        <th>Article</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Views</th>
                        <th>Published</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="mn-title-cell">@item.Title</div>
                                <div class="mn-summary">@(string.IsNullOrWhiteSpace(item.Summary) ? item.Slug : item.Summary)</div>
                            </td>
                            <td>@(item.CategoryName ?? "Uncategorized")</td>
                            <td><span class="mn-chip @(item.Status == "Published" ? "published" : "")">@item.Status</span></td>
                            <td>@item.ViewCount</td>
                            <td>@((item.PublishedAt ?? item.CreatedAt).ToString("MMM dd, yyyy"))</td>
                            <td style="text-align:right">
                                <a class="mn-action" href="/Manager/News/@item.NewsId" title="View details">
                                    <span class="material-symbols-outlined">visibility</span>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align:center;color:var(--ad-on-surface-variant);padding:42px 16px;">No news articles found.</td>
                    </tr>
                }
                </tbody>
            </table>

            <div class="mn-pagination">
                @{
                    var currentPage = Model.PageIndex < 1 ? 1 : Model.PageIndex;
                    var displayFrom = Model.TotalCount == 0 || !Model.Items.Any() ? 0 : (currentPage - 1) * Model.PageSize + 1;
                    var displayTo = Model.TotalCount == 0 || !Model.Items.Any() ? 0 : Math.Min(displayFrom + Model.Items.Count - 1, Model.TotalCount);
                }
                <span style="color:var(--ad-on-surface-variant);font-size:12px;">Showing @displayFrom-@displayTo of @Model.TotalCount news articles</span>
                @if (Model.TotalPages > 1)
                {
                    <div class="mn-page-links">
                        @if (currentPage > 1)
                        {
                            <a class="mn-page" href="?page=@(currentPage - 1)&keyword=@ViewBag.Keyword&status=@ViewBag.Status"><span class="material-symbols-outlined">chevron_left</span></a>
                        }
                        <span class="mn-page cur">@currentPage</span>
                        @if (currentPage < Model.TotalPages)
                        {
                            <a class="mn-page" href="?page=@(currentPage + 1)&keyword=@ViewBag.Keyword&status=@ViewBag.Status"><span class="material-symbols-outlined">chevron_right</span></a>
                        }
                    </div>
                }
            </div>
        </div>
    </main>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll('.ad-nav-item').forEach(function (link) {
                link.classList.remove('active');
                if (link.getAttribute('href') === '/Manager/News') link.classList.add('active');
            });
        });
    </script>
</body>
</html>
