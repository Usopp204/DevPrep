@model WebClient.Models.Manager.ManagerNewsPagedResult<WebClient.Models.Manager.ManagerNewsListItemViewModel>

@{
    Layout = null;
    ViewData["Title"] = "News Articles";

    var pageIndex = Model.PageIndex > 0 ? Model.PageIndex : 1;
    var pageSize = Model.PageSize > 0 ? Model.PageSize : 10;
    var totalPages = Model.TotalPages > 0 ? Model.TotalPages : 1;

    string BuildPageUrl(int page)
    {
        var values = new Dictionary<string, string?>
                {
                    ["keyword"] = ViewBag.Keyword,
                    ["status"] = ViewBag.Status,
                    ["categoryId"] = ((Guid?)ViewBag.CategoryId)?.ToString(),
                    ["page"] = page.ToString(),
                    ["pageSize"] = pageSize.ToString()
                };

        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/Manager/News", values);
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DevPrep AI Manager Console</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        :root {
            --bg-main: #0b0c10;
            --bg-panel: #111827;
            --bg-panel-2: #151f36;
            --bg-head: #171a24;
            --border-main: #252b3d;
            --text-main: #ffffff;
            --text-muted: #9ca3af;
            --text-blue: #93c5fd;
            --primary: #6366f1;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
        }

        body {
            background: var(--bg-main);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
        }

        .admin-main-wrapper {
            margin-left: 260px;
            padding-top: 70px;
            min-height: 100vh;
            background: var(--bg-main);
        }

        .admin-content {
            padding: 24px 28px 48px;
        }

        .page-title {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -0.04em;
            margin-bottom: 4px;
        }

        .page-subtitle {
            color: var(--text-blue);
            font-size: 14px;
            margin-bottom: 0;
        }

        .filter-card {
            margin-bottom: 24px;
        }

        .filter-label {
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 800;
            color: var(--text-blue);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 7px;
        }

        .admin-input, .admin-select {
            height: 42px;
            border-radius: 8px;
            border: 1px solid #292c3d !important;
            background: #11121a !important;
            color: #ffffff !important;
            font-size: 14px;
            box-shadow: none !important;
        }

        .admin-input:focus, .admin-select:focus {
            border-color: var(--primary) !important;
            background: #161824 !important;
            color: #ffffff !important;
        }

        .admin-select option {
            background-color: #11121a !important;
            color: #ffffff !important;
        }

        .admin-input::placeholder { color: #64748b; }

        .btn-filter {
            height: 42px; width: 100%; border: none; border-radius: 8px;
            background: #2e2a47; color: #ffffff; font-weight: 800;
        }
        .btn-filter:hover { background: #3b3659; color: #ffffff; }

        .table-shell {
            border: 1px solid #242636;
            background: #11121a;
            border-radius: 12px;
            overflow: hidden;
            padding: 8px;
        }

        .admin-table {
            width: 100%; margin: 0; color: #cbd5e1;
            --bs-table-bg: transparent; --bs-table-color: #cbd5e1;
            --bs-table-border-color: #1e202e; --bs-table-hover-bg: #171926;
            --bs-table-hover-color: #ffffff;
        }

        .admin-table thead th {
            background: #161722 !important; color: #94a3b8 !important;
            font-family: 'Inter', sans-serif; font-size: 12px;
            text-transform: uppercase; letter-spacing: 0.07em;
            border-bottom: 1px solid #242636;
            padding: 16px 14px; white-space: nowrap;
        }

        .admin-table tbody tr { background: transparent !important; }
        .admin-table tbody td {
            background: transparent !important; color: #cbd5e1 !important;
            border-bottom: 1px solid #1e202e; padding: 18px 14px;
            vertical-align: middle; font-size: 14px;
        }
        .admin-table tbody tr:hover td { background: #171926 !important; }

        .news-title { color: #ffffff !important; font-weight: 700; max-width: 360px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        .status-badge {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 6px 10px; border-radius: 6px;
            font-family: 'Inter', sans-serif; font-size: 11px;
            font-weight: 800;
        }
        .status-published { background: rgba(16,185,129,.14); color: #10b981; }
        .status-draft { background: rgba(245,158,11,.14); color: #f59e0b; }
        .status-archived { background: rgba(239,68,68,.15); color: #f87171; }
        .status-deleted { background: rgba(239,68,68,.15); color: #f87171; }
        .status-dot { width: 6px; height: 6px; border-radius: 999px; display: inline-block; background-color: currentColor; }

        .deleted-row { opacity: 0.72; }
        .deleted-row .news-title { color: #94a3b8 !important; text-decoration: line-through; }

        .slug-text, .summary-text, .date-text { color: #94a3b8 !important; }
        .summary-text { max-width: 380px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        .action-btn { color: #94a3b8 !important; background: none; border: none; padding: 0; line-height: 1; text-decoration: none; display: inline-flex; align-items: center; }
        .action-btn:hover { color: #ffffff !important; }

        .empty-row { color: #94a3b8 !important; padding: 44px 0 !important; text-align: center; }

        .page-footer { background: #11121a; border-top: 1px solid #242636; padding: 18px; }
        .page-link-custom { background: #11121a !important; border: 1px solid #242636 !important; color: #94a3b8 !important; padding: 8px 13px; border-radius: 6px; text-decoration: none; min-width: 38px; text-align: center; display: inline-flex; align-items: center; justify-content: center; gap: 4px; font-size: 14px; }
        .page-link-custom:hover { background: #1c1d29 !important; color: #ffffff !important; }
        .page-link-custom.active { background: #6366f1 !important; border-color: #6366f1 !important; color: #ffffff !important; }
        .page-link-custom.disabled { background: #0b0c10 !important; border-color: #161722 !important; color: #475569 !important; pointer-events: none; }

        @@media (max-width: 991.98px) {
            .admin-main-wrapper { margin-left: 0; padding-top: 70px; }
            .admin-content { padding: 20px 14px 50px; }
            .table-footer { flex-direction: column; align-items: flex-start; }
        }
    </style>
</head>
<body class="admin-page">
    @await Html.PartialAsync("_ManagerTopbar")
    @await Html.PartialAsync("_ManagerSidebar")

    <main class="admin-main-wrapper">
        <div class="admin-content">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="page-title m-0">Content Inventory</h1>
                    <div class="page-subtitle mt-2">Manage news articles, status, categories and content visibility.</div>
                </div>
            </div>

            <form method="get" action="/Manager/News" id="managerFilterForm" class="filter-card" onsubmit="document.getElementById('pageIdxInput').value = 1;">
                <input type="hidden" name="page" id="pageIdxInput" value="@pageIndex" />
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <div class="filter-label">Search</div>
                        <input name="keyword" value="@ViewBag.Keyword" type="text" class="form-control admin-input" placeholder="Search news articles, slugs..." />
                    </div>
                    <div class="col-md-3">
                        <div class="filter-label">Status</div>
                        <select name="status" class="form-select admin-select">
                            <option value="">All Statuses</option>
                            <option value="Published" selected="@(ViewBag.Status == "Published")">Published</option>
                            <option value="Draft" selected="@(ViewBag.Status == "Draft")">Draft</option>
                            <option value="Archived" selected="@(ViewBag.Status == "Archived")">Archived</option>
                            <option value="Deleted" selected="@(ViewBag.Status == "Deleted")">Deleted</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <div class="filter-label">Category</div>
                        <select name="categoryId" class="form-select admin-select">
                            <option value="">All Categories</option>
                            @if (ViewBag.Categories != null)
                            {
                                foreach (var cat in (List<WebClient.Models.Manager.ManagerNewsCategoryViewModel>)ViewBag.Categories)
                                {
                                    <option value="@cat.CategoryId" selected="@(ViewBag.CategoryId != null && ((Guid?)ViewBag.CategoryId).Value == cat.CategoryId ? "selected" : null)">@cat.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="btn-filter" type="submit">Apply Filter</button>
                    </div>
                </div>
            </form>

            <div class="table-shell">
                <div class="table-responsive">
                    <table class="table admin-table align-middle">
                        <thead>
                            <tr>
                                <th style="width: 28%;">Title & Slug</th>
                                <th style="width: 28%;">Summary</th>
                                <th style="width: 12%;">Status</th>
                                <th style="width: 8%;">Views</th>
                                <th style="width: 14%;">Created At</th>
                                <th style="width: 8%;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Any())
                            {
                                foreach (var item in Model.Items)
                                {
                                    var statusClass = item.IsDeleted ? "status-deleted" : (item.Status ?? "").ToLowerInvariant() switch
                                    {
                                        "published" => "status-published",
                                        "draft" => "status-draft",
                                        "archived" => "status-archived",
                                        _ => "status-draft"
                                    };
                                    var statusText = item.IsDeleted ? "DELETED" : (item.Status ?? "Unknown").ToUpperInvariant();

                                    <tr class="@(item.IsDeleted ? "deleted-row" : "")">
                                        <td>
                                            <div class="news-title" title="@item.Title">@item.Title</div>
                                            <div class="slug-text">@item.Slug</div>
                                        </td>
                                        <td>
                                            <div class="summary-text" title="@item.Summary">
                                                @(string.IsNullOrWhiteSpace(item.Summary) ? "No summary provided." : item.Summary)
                                            </div>
                                        </td>
                                        <td>
                                            <span class="status-badge @statusClass">
                                                <span class="status-dot"></span>
                                                @statusText
                                            </span>
                                        </td>
                                        <td>
                                            @if (item.ViewCount >= 1000)
                                            {
                                                @((item.ViewCount / 1000.0).ToString("0.0") + "k")
                                            }
                                            else
                                            {
                                                @item.ViewCount
                                            }
                                        </td>
                                        <td class="date-text">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end pe-4">
                                            <a class="action-btn action-view" href="/Manager/News/@item.NewsId" title="View details">
                                                <span class="material-symbols-outlined fs-5">visibility</span>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="empty-row">
                                        <i class="fa-regular fa-newspaper d-block mb-2" style="font-size: 28px;"></i>
                                        No news articles found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPages > 1)
                {
                    <div class="page-footer d-flex justify-content-between align-items-center">
                        <a href="@BuildPageUrl(pageIndex - 1)" class="page-link-custom @(pageIndex == 1 ? "disabled" : "")">
                            <span class="material-symbols-outlined fs-5">chevron_left</span>
                            Previous
                        </a>
                        <div class="d-flex gap-2 flex-wrap justify-content-center">
                            @for (var i = 1; i <= totalPages; i++)
                            {
                                <a href="@BuildPageUrl(i)" class="page-link-custom @(pageIndex == i ? "active" : "")">@i</a>
                            }
                        </div>
                        <a href="@BuildPageUrl(pageIndex + 1)" class="page-link-custom @(pageIndex == totalPages ? "disabled" : "")">
                            Next
                            <span class="material-symbols-outlined fs-5">chevron_right</span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
