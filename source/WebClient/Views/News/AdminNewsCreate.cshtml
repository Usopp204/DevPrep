@model WebClient.Models.News.AdminNewsFormViewModel

@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - DevPrep AI Admin Dashboard</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@100..900&family=JetBrains+Mono:wght@@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    <style>
        body.admin-page {
            background: #0f0e17;
            color: #fff;
            font-family: 'Inter',sans-serif;
        }

        .admin-main-content {
            margin-left: 260px;
            padding: 40px;
        }

        .page-title {
            font-size: 2.3rem;
            font-weight: 800;
        }

        .text-muted-custom {
            color: #94a3b8;
        }

        .form-card {
            background: #161426;
            border: 1px solid #232038;
            border-radius: 14px;
            overflow: hidden;
            max-width: 1100px;
        }

        .form-body {
            padding: 32px;
        }

        .form-footer {
            background: #131120;
            border-top: 1px solid #232038;
            padding: 24px 32px;
            display: flex;
            justify-content: center;
            gap: 18px;
        }

        .form-label-custom {
            color: #94a3b8;
            font-size: .78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .05em;
            margin-bottom: 8px;
        }

        .form-control-custom, .form-select-custom {
            background: #0d0c14;
            border: 1px solid #2e2a47;
            color: #fff;
            border-radius: 8px;
            padding: 12px 14px;
        }

            .form-control-custom:focus, .form-select-custom:focus {
                background: #0d0c14;
                border-color: #8b5cf6;
                color: #fff;
                box-shadow: none;
            }

            .form-select-custom option {
                background: #1e1b2e;
                color: #fff;
            }

        .textarea-summary {
            min-height: 90px;
        }

        .textarea-content {
            min-height: 260px;
            background: #020203;
        }

        .upload-box {
            height: 115px;
            background: #22202c;
            border: 1px dashed #38344f;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: #c4b5fd;
            cursor: pointer;
        }

        .preview-box {
            height: 180px;
            background: #11101d;
            border: 1px solid #232038;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

            .preview-box img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .btn-main {
            background: #c4b5fd;
            color: #11101d;
            border: none;
            border-radius: 8px;
            padding: 12px 34px;
            font-weight: 800;
        }

            .btn-main:hover {
                background: #a78bfa;
                color: #11101d;
            }

        .btn-cancel {
            background: #0d0c14;
            color: #fff;
            border: 1px solid #232038;
            border-radius: 8px;
            padding: 12px 28px;
            text-decoration: none;
            font-weight: 700;
        }

        .alert-custom {
            background: rgba(239,68,68,.12);
            border: 1px solid rgba(239,68,68,.25);
            color: #fca5a5;
            border-radius: 10px;
            padding: 12px 16px;
        }

        .radio-wrap {
            background: #0d0c14;
            border: 1px solid #232038;
            border-radius: 8px;
            padding: 12px 14px;
            display: flex;
            gap: 24px;
        }

        .slug-hint {
            font-size: 0.78rem;
            color: #6d6a85;
            margin-top: 6px;
        }
    </style>
</head>

<body class="admin-page">

    @await Html.PartialAsync("_AdminTopbar")
    @await Html.PartialAsync("_AdminSidebar")

    <main class="admin-main-content">
        <div class="container-fluid">

            <div class="mb-3 small fw-semibold">
                <a href="/admin/news" class="text-decoration-none text-muted-custom">News</a>
                <span class="text-muted-custom mx-2">&gt;</span>
                <span style="color:#c4b5fd;">Create Post</span>
            </div>

            <h1 class="page-title">Create News Article</h1>
            <p class="text-muted-custom mb-5">
                Craft compelling announcements and guides for the developer community. Ensure content is accurate and formatted for readability.
            </p>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert-custom mb-4">@ViewBag.ErrorMessage</div>
            }

            <form method="post" action="/admin/news/create" enctype="multipart/form-data" class="form-card">
                <div class="form-body">
                    <div class="row g-4">

                        <div class="col-md-6">
                            <label class="form-label-custom">Article Title</label>
                            <input id="titleInput" name="Title" value="@Model.Title" class="form-control form-control-custom" placeholder="Enter article title" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-custom">Slug (URL Path)</label>
                            <input id="slugInput" name="Slug" value="@Model.Slug" class="form-control form-control-custom" placeholder="Để trống sẽ tự động tạo từ tiêu đề" />
                            <div class="slug-hint">Tự động sinh từ Tiêu đề. Bạn có thể sửa lại nếu muốn URL ngắn gọn hơn.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-custom">Category</label>
                            <select name="CategoryId" class="form-select form-select-custom">
                                <option value="">No Category</option>
                                @foreach (var cat in Model.Categories)
                                {
                                    if (Model.CategoryId == cat.CategoryId)
                                    {
                                        <option value="@cat.CategoryId" selected>@cat.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@cat.CategoryId">@cat.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-custom">Publication Status</label>
                            <div class="radio-wrap">
                                <label><input type="radio" name="Status" value="Published" checked="@(Model.Status == "Published")" /> Published</label>
                                <label><input type="radio" name="Status" value="Draft" checked="@(Model.Status == "Draft")" /> Draft</label>
                                <label><input type="radio" name="Status" value="Archived" checked="@(Model.Status == "Archived")" /> Archived</label>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label-custom">Short Summary (SEO)</label>
                            <textarea name="Summary" class="form-control form-control-custom textarea-summary" placeholder="Write a brief, engaging summary...">@Model.Summary</textarea>
                        </div>

                        <div class="col-md-7">
                            <label class="form-label-custom">Thumbnail Media</label>
                            <input id="thumbnailUrl" name="ThumbnailUrl" value="@Model.ThumbnailUrl" class="form-control form-control-custom mb-3" placeholder="https://blob.devprep.io/news/2.png" />

                            <label for="thumbnailFile" class="upload-box">
                                <div>
                                    <div class="material-symbols-outlined mb-1">upload</div>
                                    <div class="fw-bold">Or click to upload locally</div>
                                    <div class="small text-muted-custom">MAX SIZE: 5MB JPG, PNG, WEBP</div>
                                </div>
                            </label>
                            <input id="thumbnailFile" name="ThumbnailFile" type="file" accept="image/*" class="d-none" />
                        </div>

                        <div class="col-md-5">
                            <label class="form-label-custom">Preview</label>
                            <div class="preview-box">
                                <img id="thumbnailPreview" src="" alt="" style="display:none;" />
                                <span id="previewPlaceholder" class="material-symbols-outlined" style="font-size:64px;color:#6366f1;">image</span>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label-custom">Article Content</label>
                            <textarea name="Content" class="form-control form-control-custom textarea-content">@Model.Content</textarea>
                        </div>

                    </div>
                </div>

                <div class="form-footer">
                    <a href="/admin/news" class="btn-cancel">Cancel</a>
                    <button type="submit" class="btn btn-main">Add News Post</button>
                </div>
            </form>

        </div>
    </main>

    <script>
        const fileInput = document.getElementById('thumbnailFile');
        const urlInput = document.getElementById('thumbnailUrl');
        const preview = document.getElementById('thumbnailPreview');
        const placeholder = document.getElementById('previewPlaceholder');

        function showPreview(src) {
            if (!src) return;
            preview.src = src;
            preview.style.display = 'block';
            placeholder.style.display = 'none';
        }

        urlInput.addEventListener('input', function () {
            showPreview(this.value);
        });

        fileInput.addEventListener('change', function () {
            const file = this.files[0];
            if (!file) return;
            showPreview(URL.createObjectURL(file));
        });

        // ============================================
        // AUTO-GENERATE SLUG FROM TITLE (xử lý tiếng Việt)
        // ============================================
        function slugifyClientSide(str) {
            if (!str) return '';

            str = str.toLowerCase();

            // Xử lý riêng đ/Đ trước, vì ký tự này không tách dấu qua NFD
            str = str.replace(/đ/g, 'd').replace(/Đ/g, 'd');

            // Tách dấu ra khỏi ký tự gốc rồi loại bỏ (ệ -> e, ư -> u, ă -> a...)
            str = str.normalize('NFD').replace(/[\u0300-\u036f]/g, '');

            // Loại bỏ ký tự không phải chữ/số/khoảng trắng/dấu gạch ngang
            str = str.replace(/[^a-z0-9\s-]/g, '');

            // Khoảng trắng -> '-'
            str = str.trim().replace(/\s+/g, '-');

            // Gộp nhiều '-' liên tiếp thành 1
            str = str.replace(/-+/g, '-');

            return str;
        }

        const titleInput = document.getElementById('titleInput');
        const slugInput = document.getElementById('slugInput');

        // Nếu trang Create được load lại sau lỗi validate và Slug đã có giá trị
        // (do admin đã tự nhập trước đó), đánh dấu để không ghi đè giá trị đó nữa.
        if (slugInput.value.trim() !== '') {
            slugInput.dataset.userEdited = 'true';
        }

        titleInput.addEventListener('input', function () {
            // Chỉ tự động điền nếu admin CHƯA từng tự tay sửa ô Slug
            if (!slugInput.dataset.userEdited) {
                slugInput.value = slugifyClientSide(this.value);
            }
        });

        slugInput.addEventListener('input', function () {
            // Admin đã tự gõ vào ô Slug -> ngừng auto-fill từ giờ
            this.dataset.userEdited = 'true';
        });
    </script>

</body>
</html>