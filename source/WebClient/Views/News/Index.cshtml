@model WebClient.Models.News.NewsViewModel
@{
    Layout = null;
    var featured = Model.HasItems ? Model.Items[0] : null;
    var rest = Model.HasItems ? Model.Items.Skip(1).ToList() : new List<WebClient.Models.News.NewsListItem>();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>News &amp; Features | DevPrep AI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@@100..900&family=Inter:wght@@100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/news.css" asp-append-version="true" />
</head>
<body class="nw-page">
    @await Html.PartialAsync("_Navbar")

    <main class="nw-main">
        <header class="nw-header">
            <h1 class="nw-title">News &amp; Features</h1>
            <p class="nw-subtitle">Explore what makes DevPrep AI the smartest way to prepare.</p>
        </header>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="nw-alert">
                <span class="material-symbols-outlined">error</span>
                <span>@Model.Error</span>
            </div>
        }
        else
        {
            <!-- Search + category filter — cả 2 chạy qua server (GET /News, form/link nạp lại trang). -->
            <section class="nw-glass nw-toolbar">
                <form class="nw-search" method="get" asp-controller="News" asp-action="Index">
                    <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                    <button type="submit" class="nw-search-btn" aria-label="Search">
                        <span class="material-symbols-outlined">search</span>
                    </button>
                    <input type="text" name="keyword" value="@Model.Keyword" placeholder="Search articles..." autocomplete="off" />
                </form>
                <div class="nw-chips">
                    <a class="nw-chip @(Model.CategoryId is null ? "active" : "")"
                       href="@Url.Action("Index", "News", new { keyword = Model.Keyword, categoryId = (Guid?)null })">All</a>
                    @foreach (var cat in Model.Categories)
                    {
                        <a class="nw-chip @(Model.CategoryId == cat.CategoryId ? "active" : "")"
                           href="@Url.Action("Index", "News", new { keyword = Model.Keyword, categoryId = cat.CategoryId })">@cat.Name</a>
                    }
                </div>
                @if (Model.IsFiltering)
                {
                    <a class="nw-clear-filters" href="@Url.Action("Index", "News")">Clear filters</a>
                }
            </section>

            @if (Model.HasItems)
            {
                @if (featured is not null)
                {
                    <a class="nw-glass nw-featured nw-item"
                       asp-controller="News" asp-action="Detail" asp-route-slug="@featured.Slug">
                        @if (featured.HasThumbnail)
                        {
                            <div class="nw-featured-media"><img src="@featured.ThumbnailUrl" alt="@featured.Title" /></div>
                        }
                        else
                        {
                            <div class="nw-featured-media nw-ph"><span>@featured.Initial</span></div>
                        }
                        <div class="nw-featured-body">
                            <span class="nw-badge nw-badge-featured">@featured.Category</span>
                            <h2 class="nw-featured-title">@featured.Title</h2>
                            <p class="nw-featured-summary">@featured.Summary</p>
                            <div class="nw-meta">
                                <span>@featured.DisplayDate.ToString("MMM dd, yyyy", DisplayCulture.Neutral)</span>
                                <span class="dot"></span>
                                <span><span class="material-symbols-outlined">visibility</span> @featured.ViewCount views</span>
                            </div>
                        </div>
                    </a>
                }

                <div class="nw-grid">
                    @foreach (var item in rest)
                    {
                        <a class="nw-glass nw-card nw-item"
                           asp-controller="News" asp-action="Detail" asp-route-slug="@item.Slug">
                            @if (item.HasThumbnail)
                            {
                                <div class="nw-thumb"><img src="@item.ThumbnailUrl" alt="@item.Title" /></div>
                            }
                            else
                            {
                                <div class="nw-thumb-ph"><span>@item.Initial</span></div>
                            }
                            <div class="nw-card-body">
                                <span class="nw-badge">@item.Category</span>
                                <h3 class="nw-card-title">@item.Title</h3>
                                <p class="nw-card-summary">@item.Summary</p>
                                <div class="nw-meta">
                                    <span>@item.DisplayDate.ToString("MMM dd, yyyy", DisplayCulture.Neutral)</span>
                                    <span class="dot"></span>
                                    <span><span class="material-symbols-outlined">visibility</span> @item.ViewCount</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="nw-glass nw-pagination" style="border-radius:14px; padding:8px; max-width:fit-content; margin:0 auto;">
                        <a class="nw-page-btn @(Model.Page <= 1 ? "disabled" : "")"
                           href="@Url.Action("Index", "News", new { page = Model.Page - 1, keyword = Model.Keyword, categoryId = Model.CategoryId })">
                            <span class="material-symbols-outlined">chevron_left</span>
                        </a>
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            <a class="nw-page-btn @(p == Model.Page ? "active" : "")"
                               href="@Url.Action("Index", "News", new { page = p, keyword = Model.Keyword, categoryId = Model.CategoryId })">@p</a>
                        }
                        <a class="nw-page-btn @(Model.Page >= Model.TotalPages ? "disabled" : "")"
                           href="@Url.Action("Index", "News", new { page = Model.Page + 1, keyword = Model.Keyword, categoryId = Model.CategoryId })">
                            <span class="material-symbols-outlined">chevron_right</span>
                        </a>
                    </nav>
                }
            }
            else
            {
                <div class="nw-empty">@(Model.IsFiltering ? "No articles match your search." : "No news articles have been published yet.")</div>
            }
        }
    </main>

    @await Html.PartialAsync("_Footer")
</body>
</html>
