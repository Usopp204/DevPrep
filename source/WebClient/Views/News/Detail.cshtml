@model WebClient.Models.News.NewsDetailViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(Model.Found ? Model.Title : "News") | DevPrep AI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@100..900&family=JetBrains+Mono:wght@@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/news.css" asp-append-version="true" />
</head>
<body class="nw-page">
    @await Html.PartialAsync("_Navbar")

    <main class="nw-main nw-detail">
        <a class="nw-back" asp-controller="News" asp-action="Index">
            <span class="material-symbols-outlined">arrow_back</span>
            <span>Back to News</span>
        </a>

        @if (!Model.Found)
        {
            <div class="nw-empty">
                <span class="material-symbols-outlined" style="font-size:48px; display:block; margin-bottom:12px;">article</span>
                @(string.IsNullOrEmpty(Model.Error) ? "Article not found." : Model.Error)
            </div>
        }
        else
        {
            <article>
                <header>
                    <span class="nw-detail-badge">@Model.Category</span>
                    <h1 class="nw-detail-title">@Model.Title</h1>
                    <div class="nw-detail-meta">
                        <span>@Model.DisplayDate.ToString("MMM dd, yyyy")</span>
                        <span class="dot"></span>
                        <span>@Model.ReadMinutes min read</span>
                        <span class="dot"></span>
                        <span><span class="material-symbols-outlined">visibility</span> @Model.ViewCount views</span>
                    </div>
                </header>

                <div class="nw-hero @(Model.HasThumbnail ? "" : "nw-hero-ph")">
                    @if (Model.HasThumbnail)
                    {
                        <img src="@Model.ThumbnailUrl" alt="@Model.Title" />
                    }
                    else
                    {
                        <span class="material-symbols-outlined">article</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Summary))
                {
                    <p class="nw-featured-summary" style="font-size:1.15rem; margin-bottom:28px;">@Model.Summary</p>
                }

                <div class="nw-article-body">
                    @Html.Raw(Model.Content)
                </div>

                <footer class="nw-detail-footer">
                    <span class="nw-tag">@Model.Category</span>
                </footer>
            </article>

            @if (Model.Related.Count > 0)
            {
                <section class="nw-related">
                    <h2 class="nw-related-title">Related Articles</h2>
                    <div class="nw-related-grid">
                        @foreach (var r in Model.Related)
                        {
                            <a class="nw-related-card" asp-controller="News" asp-action="Detail" asp-route-slug="@r.Slug">
                                <div class="nw-related-thumb @(r.HasThumbnail ? "" : "nw-ph")">
                                    @if (r.HasThumbnail)
                                    {
                                        <img src="@r.ThumbnailUrl" alt="@r.Title" />
                                    }
                                    else
                                    {
                                        <span>@r.Initial</span>
                                    }
                                </div>
                                <h4 class="nw-related-name">@r.Title</h4>
                                <span class="nw-related-read">@r.Category</span>
                            </a>
                        }
                    </div>
                </section>
            }
        }
    </main>

    @await Html.PartialAsync("_Footer")
</body>
</html>
