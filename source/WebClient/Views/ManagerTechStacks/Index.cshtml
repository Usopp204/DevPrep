@model WebClient.Models.Manager.TechStacks.ManagerTechStackListViewModel
@{
    ViewData["Title"] = "Tech Stacks";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tech Stacks - DevPrep Manager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/tech-stack-list.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/manager-tech-stacks.css" asp-append-version="true" />
</head>
<body class="admin-page">
    @await Html.PartialAsync("_ManagerTopbar")
    @await Html.PartialAsync("_ManagerSidebar")

    <main class="ad-main tech-stacks-page manager-tech-stacks-page">
        <header class="tech-stacks-header">
            <div>
                <p class="tech-stacks-eyebrow">Question Bank Reference</p>
                <h1 class="ad-page-title">Tech Stacks</h1>
                <p class="tech-stacks-subtitle">
                    Browse the technologies currently available for question classification.
                </p>
            </div>
        </header>

        <section class="tech-stacks-card tech-stacks-filters" aria-label="Tech Stack filters">
            <form method="get" action="/Manager/TechStacks" class="tech-stacks-filter-form">
                <div class="tech-stacks-filter-field">
                    <label for="managerTechStackSearch">Search</label>
                    <div class="tech-stacks-search">
                        <input id="managerTechStackSearch" type="search" name="search"
                               value="@Model.Search" maxlength="200"
                               placeholder="Search by name or description" />
                        <button type="submit" class="tech-stacks-search-button"
                                data-tech-stack-search-button aria-label="Search Tech Stacks" title="Search">
                            <span class="material-symbols-outlined" aria-hidden="true">search</span>
                        </button>
                    </div>
                </div>
                <div class="tech-stacks-filter-field tech-stacks-status-filter">
                    <label for="managerTechStackStatus">Status</label>
                    <select id="managerTechStackStatus" name="status">
                        <option value="All" selected="@(Model.Status == "All")">All</option>
                        <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                        <option value="Inactive" selected="@(Model.Status == "Inactive")">Inactive</option>
                    </select>
                </div>
                <button type="submit" class="ts-button ts-button-secondary">Apply filters</button>
                <a href="/Manager/TechStacks"
                   class="ts-button ts-button-ghost js-reset-tech-stack-filters @(Model.IsFiltered ? string.Empty : "d-none")">Reset filters</a>
            </form>
        </section>

        @await Html.PartialAsync("_TechStackResults", Model)
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/pages/tech-stack-live-list.js" asp-append-version="true" defer></script>
    <script src="~/js/pages/manager-tech-stacks.js" asp-append-version="true" defer></script>
</body>
</html>