@model WebClient.Models.Interview.HistoryViewModel

@{
    Layout = "_InterviewLayout";
    ViewData["Title"] = "Interview History";
    ViewData["BodyClass"] = "history-page history-list-page";
    var currentPage = Math.Max(1, Model.Sessions.Page == 0 ? Model.Page : Model.Sessions.Page);
    var totalPages = Math.Max(1, Model.Sessions.TotalPages);
    string PageUrl(int page) => Url.Action("History", "Interview", new
    {
        page,
        pageSize = Model.PageSize,
        status = Model.Status,
        position = Model.Position,
        questionType = Model.QuestionType,
        keyword = Model.Keyword
    }) ?? "#";
    string StatusClass(string status) => status switch
    {
        "Completed" => "status-completed",
        "Cancelled" => "status-cancelled",
        _ => "status-expired"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/history.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/safe-text.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/pagination.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/feedback-report.css" asp-append-version="true" />
}

    <div class="history-layout">
        <partial name="_InterviewSidebar" model="Model.Sidebar" />

        <main class="history-main-list">
            <header class="history-list-header">
                <div>
                    <p class="history-kicker">Session History</p>
                    <h1>Completed, cancelled, and expired interviews</h1>
                </div>
                <a class="history-ghost-btn" asp-controller="Interview" asp-action="Index">
                    <span class="material-symbols-outlined">add</span> New Interview
                </a>
            </header>

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="history-alert success">@Model.SuccessMessage</div>
            }
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="history-alert error">@Model.ErrorMessage</div>
            }

            <form method="get" asp-controller="Interview" asp-action="History" class="history-filter-bar">
                <label>
                    <span>Status</span>
                    <select name="status">
                        <option value="">All</option>
                        <option value="Completed" selected="@(Model.Status == "Completed")">Completed</option>
                        <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                        <option value="Expired" selected="@(Model.Status == "Expired")">Expired</option>
                    </select>
                </label>
                <label>
                    <span>Position</span>
                    <select name="position">
                        <option value="">All</option>
                        @foreach (var option in Model.Sessions.PositionOptions)
                        {
                            <option value="@option" selected="@(string.Equals(Model.Position, option, StringComparison.OrdinalIgnoreCase))">@option</option>
                        }
                    </select>
                </label>
                <label>
                    <span>Question Type</span>
                    <select name="questionType">
                        <option value="">All</option>
                        @foreach (var option in Model.Sessions.QuestionTypeOptions)
                        {
                            <option value="@option" selected="@(string.Equals(Model.QuestionType, option, StringComparison.OrdinalIgnoreCase))">@option</option>
                        }
                    </select>
                </label>
                <label>
                    <span>Keyword</span>
                    <input name="keyword" value="@Model.Keyword" placeholder="Search title or role" />
                </label>
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <button type="submit" class="history-filter-btn">
                    <span class="material-symbols-outlined">filter_alt</span> Apply
                </button>
            </form>

            @if (Model.Sessions.Items.Count == 0)
            {
                <section class="history-empty-panel">
                    <span class="material-symbols-outlined">forum</span>
                    <h2>No interview history yet</h2>
                    <p>Completed, cancelled, and expired sessions will appear here after an interview ends.</p>
                    <a asp-controller="Interview" asp-action="Index">Start a new interview</a>
                </section>
            }
            else
            {
                <section class="history-table-shell">
                    <div class="history-table-head">
                        <span>Session</span>
                        <span>Question Type</span>
                        <span>Level</span>
                        <span>Status</span>
                        <span>Questions</span>
                        <span>Duration</span>
                        <span>Timeline</span>
                        <span class="history-actions-heading">Actions</span>
                    </div>
                    @foreach (var session in Model.Sessions.Items)
                    {
                        var detailsUrl = Url.Action("Details", "Interview", new { id = session.SessionId });
                        var questionTypeDisplay = string.IsNullOrWhiteSpace(session.QuestionType) ? "Not specified" : session.QuestionType;
                        <article class="history-row" data-href="@detailsUrl">
                            <a class="history-row-main" href="@detailsUrl">
                                <strong>@(session.Position ?? "Interview Session")</strong>
                            </a>
                            <div class="history-cell-center history-question-type">@questionTypeDisplay</div>
                            <div class="history-cell-center">@session.Level</div>
                            <div class="history-cell-center"><span class="history-status @StatusClass(session.Status)">@session.DisplayStatus</span></div>
                            <div class="history-cell-center">@session.AnsweredQuestions/@session.TotalQuestions</div>
                            <div class="history-cell-center">@session.DurationMinutes min</div>
                            <div class="history-date">
                                <span>Created @WebClient.Helpers.TimeFormat.RelativeTime(session.CreatedAt)</span>
                                @if (session.EndedAt is not null)
                                {
                                    <span>Ended @session.EndedAt.Value.ToString("MMM d, yyyy HH:mm", DisplayCulture.Neutral)</span>
                                }
                            </div>
                            <div class="history-actions history-cell-center">
                                <a class="history-action-btn history-icon-action history-view-btn"
                                   href="@detailsUrl"
                                   aria-label="View Details"
                                   title="View Details">
                                    <span class="material-symbols-outlined history-action-icon" aria-hidden="true">visibility</span>
                                </a>
                                <form method="post" asp-controller="Interview" asp-action="DeleteSession" asp-route-id="@session.SessionId">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="page" value="@currentPage" />
                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                    <input type="hidden" name="status" value="@Model.Status" />
                                    <input type="hidden" name="position" value="@Model.Position" />
                                    <input type="hidden" name="questionType" value="@Model.QuestionType" />
                                    <input type="hidden" name="keyword" value="@Model.Keyword" />
                                    <button type="button"
                                            class="history-action-btn history-icon-action history-delete-btn"
                                            data-delete-session-trigger
                                            data-session-title="@(session.Position ?? "Interview Session")"
                                            aria-label="Delete"
                                            title="Delete">
                                        <span class="material-symbols-outlined history-action-icon" aria-hidden="true">delete</span>
                                    </button>
                                </form>
                            </div>
                        </article>
                    }
                </section>

                <div class="history-pagination">
                <partial name="_Pagination" model="new WebClient.Models.Shared.PaginationViewModel
                {
                    CurrentPage = currentPage,
                    TotalPages = totalPages,
                    PageUrl = PageUrl
                }" />
                </div>
            }
        </main>
    </div>
<div class="feedback-report-modal" data-delete-session-modal hidden>
    <div class="feedback-report-backdrop" data-delete-session-close></div>
    <section class="feedback-report-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-session-title" aria-describedby="delete-session-description">
        <header class="feedback-report-dialog-header">
            <div>
                <p>Confirmation</p>
                <h2 id="delete-session-title">Delete interview session?</h2>
            </div>
            <button type="button" class="feedback-report-close" data-delete-session-close aria-label="Close dialog">
                <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>
        </header>
        <p class="feedback-report-description" id="delete-session-description">
            Are you sure you want to remove <strong data-delete-session-name>this interview session</strong> from your history? This action cannot be undone.
        </p>
        <div class="feedback-report-actions">
            <button type="button" class="feedback-report-cancel" data-delete-session-close>Cancel</button>
            <button type="button" class="feedback-report-submit feedback-report-submit-danger" data-delete-session-confirm>
                <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                Delete
            </button>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/pages/dashboard.js" asp-append-version="true"></script>
    <script src="~/js/pages/interview-history.js" asp-append-version="true"></script>
}
