@model WebClient.Models.Interview.HistoryViewModel

@{
    Layout = null;
    var detail = Model.Detail;
    var report = detail?.Report;

    string Band(decimal score) =>
        score >= 80 ? "var(--color-success)" : score >= 60 ? "var(--color-warning)" : "var(--color-destructive)";

    void ScoreBar(string label, decimal score)
    {
        var color = Band(score);
        <div class="h-bar-row">
            <div class="h-bar-head"><span style="color:var(--color-text-secondary)">@label</span><span style="color:@color">@Math.Round(score)/100</span></div>
            <div class="h-bar-track"><div class="h-bar-fill" style="width:@(Math.Round(score))%; background:@color"></div></div>
        </div>
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Interview History - DevPrep</title>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme-session.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/history.css" asp-append-version="true" />
</head>
<body class="history-page">
    <div class="history-layout">

        <!-- Left: session list -->
        <aside class="history-sidebar">
            <div class="history-brand">InterviewAI</div>
            <a class="history-new-btn" asp-controller="Interview" asp-action="Index">
                <span class="material-symbols-outlined">add</span> New Interview
            </a>
            <div class="history-sidebar-label">Past Sessions</div>

            @if (Model.Sessions.Count == 0)
            {
                <div class="history-empty">No interviews yet.</div>
            }
            else
            {
                <ul class="session-list">
                    @foreach (var session in Model.Sessions)
                    {
                        var active = session.SessionId == Model.SelectedSessionId ? "session-item-active" : "";
                        <li>
                            <a class="session-item @active" asp-controller="Interview" asp-action="History" asp-route-sessionId="@session.SessionId">
                                <span class="session-item-title">@(session.Title ?? session.Position ?? "Interview") &middot; @session.Level</span>
                                <span class="session-item-meta">
                                    <span class="session-badge">@session.Status</span>
                                    @session.DurationMinutes min &middot; @session.AnsweredQuestions/@session.TotalQuestions Qs
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </aside>

        <!-- Center: transcript -->
        <main class="history-transcript">
            @if (detail is null)
            {
                <div class="transcript-header"><h2 class="transcript-title">Transcript</h2></div>
                <div class="transcript-body"><p class="panel-empty">Select a session from the sidebar.</p></div>
            }
            else
            {
                <div class="transcript-header">
                    <h2 class="transcript-title">@(detail.Position ?? "Interview") &middot; @detail.Level</h2>
                    <div class="transcript-meta">
                        <span class="chip"><span class="material-symbols-outlined" style="font-size:14px">signal_cellular_alt</span>@detail.Level</span>
                        <span class="chip"><span class="material-symbols-outlined" style="font-size:14px">forum</span>@detail.AnsweredQuestions/@detail.TotalQuestions answered</span>
                        <span class="chip"><span class="material-symbols-outlined" style="font-size:14px">flag</span>@detail.Status</span>
                    </div>
                </div>
                <div class="transcript-body">
                    @foreach (var question in detail.Questions.OrderBy(q => q.OrderIndex))
                    {
                        var userAnswer = detail.ChatHistory
                            .FirstOrDefault(m => m.SessionQuestionId == question.SessionQuestionId
                                                  && m.SenderType == "User" && m.MessageType == "Answer");
                        // A skipped question is stored as a User "Answer" with blank content — show it
                        // as "No answer recorded" rather than an empty bubble.
                        var hasAnswer = userAnswer is not null && !string.IsNullOrWhiteSpace(userAnswer.Content);
                        <div class="q-divider">
                            <div class="line"></div>
                            <div class="label">Question @question.OrderIndex</div>
                            <div class="line"></div>
                        </div>
                        <div class="chat-row chat-row-ai">
                            <div class="chat-bubble chat-bubble-ai">@question.Content</div>
                        </div>
                        <div class="chat-row chat-row-user">
                            <div class="chat-bubble @(hasAnswer ? "chat-bubble-user" : "chat-bubble-no-answer")">
                                @(hasAnswer ? userAnswer!.Content : "No answer recorded")
                            </div>
                        </div>
                    }

                    @if (detail.Status is "Completed" or "Expired")
                    {
                        <div class="ended-marker">
                            <span class="material-symbols-outlined">flag</span>
                            Interview @detail.Status
                            @if (detail.StartedAt is not null && detail.EndedAt is not null)
                            {
                                <text> &middot; @((detail.EndedAt.Value - detail.StartedAt.Value).ToString(@"mm\m\ ss\s"))</text>
                            }
                        </div>
                    }
                </div>
            }
        </main>

        <!-- Right: score / feedback -->
        <aside class="history-panel">
            @if (detail is not null)
            {
                <div class="panel-tabs">
                    <button class="panel-tab active" data-tab="score" type="button" onclick="switchTab('score')">Score &amp; Stats</button>
                    <button class="panel-tab" data-tab="feedback" type="button" onclick="switchTab('feedback')">Detailed Feedback</button>
                </div>
                <div class="panel-body">
                    <!-- Score & Stats -->
                    <div class="panel-view active" id="view-score">
                        @if (report is null)
                        {
                            <p class="panel-empty">No report yet for this session.</p>
                        }
                        else
                        {
                            var color = Band(report.OverallScore);
                            <div class="score-hero">
                                <span class="num" style="color:@color">@Math.Round(report.OverallScore)<span style="font-size:14px; color:var(--color-text-tertiary)">/100</span></span>
                                @if (!string.IsNullOrEmpty(report.Grade))
                                {
                                    <span class="grade">Grade @report.Grade</span>
                                }
                            </div>
                            <div class="h-bars">
                                @if (report.TechnicalScore is not null) { ScoreBar("Technical", report.TechnicalScore.Value); }
                                @if (report.TheoryScore is not null) { ScoreBar("Theory", report.TheoryScore.Value); }
                                @if (report.CommunicationScore is not null) { ScoreBar("Communication", report.CommunicationScore.Value); }
                                @if (report.ProblemSolvingScore is not null) { ScoreBar("Problem Solving", report.ProblemSolvingScore.Value); }
                            </div>
                        }

                        @if (detail.Evaluations.Count > 0)
                        {
                            <div>
                                <div class="panel-section-title">Per-Question Scores</div>
                                @foreach (var ev in detail.Evaluations)
                                {
                                    var q = detail.Questions.FirstOrDefault(x => x.SessionQuestionId == ev.SessionQuestionId);
                                    var c = Band(ev.Score);
                                    <div class="per-q">
                                        <span class="txt">Q@(q?.OrderIndex.ToString() ?? "?") &mdash; @q?.Content</span>
                                        <span class="score" style="color:@c; border:1px solid @c">@Math.Round(ev.Score)</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Detailed Feedback -->
                    <div class="panel-view" id="view-feedback">
                        @if (report is not null && !string.IsNullOrEmpty(report.Summary))
                        {
                            <div class="fb-card summary">
                                <h4><span class="material-symbols-outlined" style="font-size:16px">auto_awesome</span> AI Coach Summary</h4>
                                <p>@report.Summary</p>
                            </div>
                        }
                        @if (report is not null && !string.IsNullOrEmpty(report.Strengths))
                        {
                            <div class="fb-card strengths">
                                <h4>Strengths</h4>
                                <ul>
                                    @foreach (var item in report.Strengths.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            </div>
                        }
                        @if (report is not null && !string.IsNullOrEmpty(report.Improvements))
                        {
                            <div class="fb-card improve">
                                <h4>Areas to Improve</h4>
                                <ul>
                                    @foreach (var item in report.Improvements.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (detail.Evaluations.Count == 0 && report is null)
                        {
                            <p class="panel-empty">No evaluation data for this session yet.</p>
                        }
                        else if (detail.Evaluations.Count > 0)
                        {
                            <div>
                                <div class="panel-section-title">Question-by-Question Feedback</div>
                                @foreach (var ev in detail.Evaluations)
                                {
                                    var q = detail.Questions.FirstOrDefault(x => x.SessionQuestionId == ev.SessionQuestionId);
                                    var c = Band(ev.Score);
                                    <div class="fb-q">
                                        <div class="fb-q-head">
                                            <strong>Q@(q?.OrderIndex.ToString() ?? "?")</strong>
                                            <span style="color:@c">@Math.Round(ev.Score)/100</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(ev.AiFeedback))
                                        {
                                            <p style="font-size:13px; color:var(--color-text-secondary); margin:0 0 6px">@ev.AiFeedback</p>
                                        }
                                        @if (!string.IsNullOrEmpty(ev.Strengths))
                                        {
                                            <p style="font-size:13px; color:var(--color-success); margin:0">&check; @ev.Strengths</p>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </aside>
    </div>

    <script>
        function switchTab(tab) {
            document.querySelectorAll('.panel-tab').forEach(function (b) {
                b.classList.toggle('active', b.dataset.tab === tab);
            });
            document.getElementById('view-score').classList.toggle('active', tab === 'score');
            document.getElementById('view-feedback').classList.toggle('active', tab === 'feedback');
        }
    </script>
</body>
</html>
