@model WebClient.Models.Interview.RoomViewModel

@{
    Layout = null;
    var isActive = Model.Status is "Initialized" or "InProgress";
    var progressPct = Model.TotalQuestions > 0 ? Model.AnsweredQuestions * 100 / Model.TotalQuestions : 0;

    // Static greeting shown before the first question (modeled on ai-service's _greeting_text).
    // Display-only: composed here from session config, never stored as a ChatMessage.
    var positionPart = string.IsNullOrWhiteSpace(Model.Position) ? "" : $"{Model.Position} ";
    var greeting = $"Welcome, and thank you for joining today's {positionPart}interview " +
                   $"at the {Model.Level} level. I'll ask a series of questions to explore how you " +
                   "think and what you know — take your time, feel free to think out loud, and " +
                   "answer just as you would in a real interview. Ready when you are. Let's begin!";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Interview Room - DevPrep</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme-session.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/interview-room.css" asp-append-version="true" />
</head>
<body class="room-page">
    <div id="room-app"
         class="room-layout"
         data-session-id="@Model.SessionId"
         data-remaining-seconds="@Model.RemainingSeconds"
         data-current-question-id="@Model.CurrentQuestionId"
         data-total-questions="@Model.TotalQuestions"
         data-answered-questions="@Model.AnsweredQuestions"
         data-message-url="@Url.Action("Message", "Interview", new { id = Model.SessionId })"
         data-end-url="@Url.Action("EndSession", "Interview", new { id = Model.SessionId })"
         data-tts-url="@Url.Action("Tts", "Interview")"
         data-stt-url="@Url.Action("Stt", "Interview")"
         data-hint-url="@Url.Action("Hint", "Interview")"
         data-report-url="@Url.Action("Report", "Evaluation")"
         data-is-active="@isActive.ToString().ToLowerInvariant()">

        <!-- LEFT PANEL: Session Info -->
        <aside class="room-sidebar">
            <div class="room-sidebar-top">
                <div class="room-brand">
                    <span class="material-symbols-outlined">auto_awesome</span>
                    <span class="room-brand-name">InterviewAI</span>
                </div>

                <div class="timer-box">
                    <span class="timer-label">TIME REMAINING</span>
                    <div class="timer-value" id="timer">--:--</div>
                </div>

                <div class="session-info">
                    <div class="info-block">
                        <span class="info-key">Status</span>
                        <span class="info-val" id="status-text">@Model.Status</span>
                    </div>
                    <div class="info-block">
                        <span class="info-key">Progress</span>
                        <span class="info-val" id="progress-text">@Model.AnsweredQuestions/@Model.TotalQuestions</span>
                    </div>
                </div>
            </div>

            <div class="room-progress">
                <div class="room-progress-head">
                    <span class="k">PROGRESS</span>
                    <span class="v">@Model.AnsweredQuestions / @Model.TotalQuestions</span>
                </div>
                <div class="progress-track">
                    <div class="progress-fill" style="width:@(progressPct)%"></div>
                </div>
            </div>
        </aside>

        <!-- CENTER PANEL: Chat -->
        <main class="room-chat">
            <div class="room-chat-header">
                <div class="chat-header-left">
                    <div class="avatar">
                        <span class="material-symbols-outlined">smart_toy</span>
                    </div>
                    <div>
                        <div class="title">AI Interviewer <span class="status-dot"></span></div>
                        <div class="subtitle">Active Session</div>
                    </div>
                </div>
                <div class="chat-header-actions">
                    <button type="button"><span class="material-symbols-outlined">more_vert</span></button>
                </div>
            </div>

            <div id="chat-messages" class="chat-messages">
                <div class="ai-glow"></div>
                <div class="chat-row chat-row-ai">
                    <div class="chat-bubble chat-bubble-ai chat-bubble-greeting">@greeting</div>
                </div>
                @foreach (var message in Model.ChatHistory)
                {
                    var rowClass = message.SenderType == "AI" ? "chat-row chat-row-ai" : "chat-row chat-row-user";
                    var bubbleClass = message.SenderType == "AI" ? "chat-bubble chat-bubble-ai" : "chat-bubble chat-bubble-user";
                    <div class="@rowClass">
                        <div class="@bubbleClass">@message.Content</div>
                    </div>
                }
            </div>

            @if (!isActive)
            {
                <div class="room-ended-note">This interview has already ended (status: @Model.Status).</div>
            }

            <div class="chat-input-bar">
                <div class="chat-input-inner">
                    <button type="button" class="icon-btn" title="Attach (coming soon)" disabled>
                        <span class="material-symbols-outlined">attach_file</span>
                    </button>
                    <textarea id="answer-input" class="chat-input" rows="1"
                              placeholder="Type your answer…"
                              @(isActive ? "" : "disabled")></textarea>
                    <button id="mic-btn" class="btn-mic" type="button" title="Record a voice answer" @(isActive ? "" : "disabled")>
                        <span class="material-symbols-outlined">mic</span>
                    </button>
                    <button id="send-btn" class="btn-send" @(isActive ? "" : "disabled")>
                        <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1;">send</span>
                    </button>
                </div>
                <div class="input-hint">Press Enter to send, Shift + Enter for new line</div>
            </div>
        </main>

        <!-- RIGHT PANEL: Camera & Controls -->
        <aside class="room-camera">
            <div class="room-camera-top">
                <div class="camera-section">
                    <span class="camera-label">CAMERA PREVIEW</span>
                    <div class="camera-box">
                        <video id="camera-video" autoplay playsinline muted class="camera-feed d-none"></video>
                        <div id="camera-placeholder" class="camera-placeholder">
                            <span class="material-symbols-outlined">videocam_off</span>
                            <span>Camera off</span>
                        </div>
                        <div class="camera-controls">
                            <button type="button" class="cam-btn" disabled><span class="material-symbols-outlined">mic_off</span></button>
                            <button type="button" class="cam-btn" disabled><span class="material-symbols-outlined">videocam_off</span></button>
                        </div>
                    </div>
                    <button id="camera-toggle" class="btn-camera" type="button">Turn On Camera</button>
                </div>

                <div class="ai-voice-section">
                    <div class="ai-voice-header">
                        <span class="camera-label">AI VOICE</span>
                        <button id="voice-toggle" class="toggle-switch is-on" type="button" aria-pressed="true">
                            <span class="toggle-knob"></span>
                        </button>
                    </div>
                    <div class="visualizer">
                        <div class="waveform-bar"></div>
                        <div class="waveform-bar"></div>
                        <div class="waveform-bar"></div>
                        <div class="waveform-bar"></div>
                        <div class="waveform-bar"></div>
                        <div class="waveform-bar"></div>
                    </div>
                    <span class="ai-voice-caption">AI voice</span>
                </div>
            </div>

            <div class="room-camera-actions">
                <span class="quick-actions-label">QUICK ACTIONS</span>
                <button id="hint-btn" class="btn-secondary" type="button" @(isActive ? "" : "disabled")>
                    <span class="material-symbols-outlined icon-hint">lightbulb</span>
                    Ask for hint
                </button>
                <button id="skip-btn" class="btn-secondary" type="button" @(isActive ? "" : "disabled")>
                    <span class="material-symbols-outlined icon-skip">skip_next</span>
                    Skip question
                </button>
                <button id="end-btn" class="btn-end" type="button" @(isActive ? "" : "disabled")>
                    <span class="material-symbols-outlined">exit_to_app</span>
                    End Interview
                </button>
            </div>
        </aside>
    </div>

    <script src="~/js/pages/interview-room.js" asp-append-version="true"></script>
</body>
</html>
