@model WebClient.Models.Interview.RoomViewModel

@{
    Layout = null;
    var isActive = Model.Status is "Initialized" or "InProgress" or "Paused";
    var isPaused = Model.Status == "Paused";
    var progressPct = Model.TotalQuestions > 0 ? Model.AnsweredQuestions * 100 / Model.TotalQuestions : 0;

    // Static greeting shown before the first question (modeled on ai-service's _greeting_text).
    // Display-only: composed here from session config, never stored as a ChatMessage.
    var positionPart = string.IsNullOrWhiteSpace(Model.Position) ? "" : $"{Model.Position} ";
    var greeting = $"Welcome, and thank you for joining today's {positionPart}interview " +
                   $"at the {Model.Level} level. I'll ask a series of questions to explore how you " +
                   "think and what you know — take your time, feel free to think out loud, and " +
                   "answer just as you would in a real interview. Ready when you are. Let's begin!";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Interview Room - DevPrep</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme-session.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/driver.js/driver.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/interview-room.css" asp-append-version="true" />
</head>
<body class="room-page">

    @if (TempData["RoomInfoMessage"] is string infoMessage)
    {
        <div class="room-info-banner" id="room-info-banner" role="status">@infoMessage</div>
        <script>
            (function () {
                var banner = document.getElementById("room-info-banner");
                if (!banner) return;
                setTimeout(function () {
                    banner.classList.add("fade-out");
                    banner.addEventListener("animationend", function () { banner.remove(); }, { once: true });
                }, 5000);
            })();
        </script>
    }

    <div id="room-app"
         class="room-layout"
         data-session-id="@Model.SessionId"
         data-remaining-seconds="@Model.RemainingSeconds"
         data-current-question-id="@Model.CurrentQuestionId"
         data-verification-check-id="@Model.VerificationCheckId"
         data-verification-check-expires-at="@Model.VerificationCheckExpiresAt?.ToString("O")"
         data-idle-reminder-seconds="@Model.IdleReminderSeconds"
         data-idle-hard-seconds="@Model.IdleHardSeconds"
         data-idle-elapsed-seconds="@Model.IdleElapsedSeconds"
         data-total-questions="@Model.TotalQuestions"
         data-answered-questions="@Model.AnsweredQuestions"
         data-initial-status="@Model.Status"
         data-pause-count="@Model.PauseCount"
         data-pauses-remaining="@Model.PausesRemaining"
         data-paused-seconds-remaining="@Model.PausedSecondsRemaining"
         data-has-seen-tour="@Model.HasSeenRoomTour.ToString().ToLowerInvariant()"
         data-tour-seen-url="@Url.Action("TourSeen", "Interview")"
         data-message-url="@Url.Action("Message", "Interview", new { id = Model.SessionId })"
         data-complete-url="@Url.Action("CompleteSession", "Interview", new { id = Model.SessionId })"
         data-cancel-url="@Url.Action("EndSession", "Interview", new { id = Model.SessionId })"
         data-pause-url="@Url.Action("Pause", "Interview", new { id = Model.SessionId })"
         data-unpause-url="@Url.Action("Unpause", "Interview", new { id = Model.SessionId })"
         data-camera-violation-url="@Url.Action("CameraViolation", "Interview", new { id = Model.SessionId })"
         data-verify-in-session-url="@Url.Action("VerifyInSession", "Verification", new { sessionId = Model.SessionId })"
         data-in-session-check-url="@Url.Action("InSessionCheck", "Verification", new { sessionId = Model.SessionId })"
         data-tts-url="@Url.Action("Tts", "Interview")"
         data-stt-url="@Url.Action("Stt", "Interview")"
         data-hint-url="@Url.Action("Hint", "Interview")"
         data-report-url="@Url.Action("Report", "Evaluation")"
         data-details-url="@Url.Action("Details", "Interview", new { id = Model.SessionId })"
         data-is-active="@isActive.ToString().ToLowerInvariant()">

        <!-- LEFT PANEL: Session Info -->
        <aside class="room-sidebar">
            <div class="room-sidebar-top">
                <div class="timer-box">
                    <span class="timer-label">TIME REMAINING</span>
                    <div class="timer-value" id="timer">--:--</div>
                </div>

                <div class="session-info">
                    <span class="session-info-title">SESSION OVERVIEW</span>
                    <div class="info-block info-block-role">
                        <span class="info-key">Role</span>
                        <span class="info-val">@(string.IsNullOrWhiteSpace(Model.Position) ? "—" : Model.Position)</span>
                    </div>
                    <div class="session-info-meta">
                        <div class="info-block info-block-meta">
                            <span class="info-key">Level</span>
                            <span class="info-chip">@Model.Level</span>
                        </div>
                        <div class="info-block info-block-meta">
                            <span class="info-key">Status</span>
                            <span class="info-status" id="status-text">@(Model.Status == "InProgress" ? "Active" : Model.Status)</span>
                        </div>
                    </div>
                </div>

                <!-- In-session cheating check warning (identity mismatch / multiple faces).
                     Hidden until interview-room.js's background check actually flags something —
                     see the .camera-status-warning/.content-warning tint pattern this reuses. -->
                <div class="integrity-alert d-none" id="cheating-warning"
                     role="alert" aria-live="assertive">
                    <span class="material-symbols-outlined integrity-alert-icon"
                          id="integrity-status-icon">warning</span>
                    <div class="integrity-alert-content">
                        <strong class="integrity-alert-title"
                                id="integrity-status-title">Verification warning</strong>
                        <span class="integrity-alert-message"
                              id="integrity-status-message"></span>
                    </div>
                </div>
            </div>

            <div class="room-progress">
                <div class="room-progress-head">
                    <span class="k">PROGRESS</span>
                    <span class="v" id="progress-text">@Model.AnsweredQuestions / @Model.TotalQuestions</span>
                </div>
                <div class="progress-track">
                    <div class="progress-fill" style="width:@(progressPct)%"></div>
                </div>
            </div>
        </aside>

        <!-- CENTER PANEL: Chat -->
        <main class="room-chat">
            <div class="room-chat-header">
                <div class="chat-header-left">
                    <div class="avatar">
                        <span class="material-symbols-outlined">smart_toy</span>
                    </div>
                    <div>
                        <div class="title">DevPrep AI <span class="status-dot"></span></div>
                        <div class="subtitle">Active Session</div>
                    </div>
                </div>
                <div class="chat-header-actions">
                    <button id="replay-tour-btn" type="button" title="Replay the guided tour" @(isActive ? "" : "disabled")>
                        <span class="material-symbols-outlined">help_outline</span>
                    </button>
                </div>
            </div>

            <div id="chat-messages" class="chat-messages">
                <div class="ai-glow"></div>
                <div class="chat-row chat-row-ai">
                    <div class="chat-bubble chat-bubble-ai chat-bubble-greeting">@greeting</div>
                </div>
                @foreach (var message in Model.ChatHistory)
                {
                    // Empty user answers represent Skip/TimedOut and must not render as blank bubbles.
                    if (message.SenderType == "User" && string.IsNullOrWhiteSpace(message.Content))
                    {
                        continue;
                    }
                    var rowClass = message.SenderType == "AI" ? "chat-row chat-row-ai" : "chat-row chat-row-user";
                    var bubbleClass = message.SenderType == "AI" ? "chat-bubble chat-bubble-ai" : "chat-bubble chat-bubble-user";
                    <div class="@rowClass">
                        <div class="@bubbleClass">@message.Content</div>
                    </div>
                }
            </div>

            @if (!isActive)
            {
                <div class="room-ended-note">This interview has already ended (status: @Model.Status).</div>
            }

            <div id="idle-modal-backdrop" class="idle-modal-backdrop d-none"></div>
            <div id="idle-banner" class="idle-banner d-none"></div>

            <!-- In-session cheating strike popup — same .idle-banner/.idle-modal-backdrop shell as
                 the idle Tier-1 reminder above, a separate DOM instance so the two can never
                 collide (see interview-room.js showCheatingBanner/hideCheatingBanner). Only for a
                 real strike (identity mismatch / multiple faces / no-face just converted) — the
                 sidebar #cheating-warning above still carries the gentle no-face-not-yet-a-strike
                 reminder on its own, this popup never covers that case. -->
            <div id="cheating-banner-backdrop" class="idle-modal-backdrop d-none"></div>
            <div id="cheating-banner" class="idle-banner d-none"></div>

            <div class="chat-input-bar">
                <div class="chat-input-inner">
                    <textarea id="answer-input" class="chat-input" rows="1"
                              placeholder="Type your answer…"
                              @(isActive ? "" : "disabled")></textarea>
                    <button id="mic-btn" class="btn-mic" type="button" title="Record a voice answer" @(isActive ? "" : "disabled")>
                        <span class="material-symbols-outlined">mic</span>
                    </button>
                    <button id="send-btn" class="btn-send" @(isActive ? "" : "disabled")>
                        <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1;">send</span>
                    </button>
                </div>
                <p id="content-warning" class="content-warning d-none" role="alert"></p>
                <div class="input-hint">Press Enter to send, Shift + Enter for new line</div>
            </div>

            <!-- Covers the whole chat panel while paused — hides the current question and history
                 so pausing can't be used to read carefully / look things up. -->
            <div id="pause-overlay" class="pause-overlay @(isPaused ? "" : "d-none")">
                <div class="pause-overlay-content">
                    <span class="material-symbols-outlined pause-overlay-icon">pause_circle</span>
                    <div class="pause-overlay-title">Interview Paused</div>
                    <div class="pause-overlay-sub" id="pause-overlay-quota"></div>
                    <button id="resume-btn" class="btn-camera" type="button">Resume Interview</button>
                </div>
            </div>
        </main>

        <!-- RIGHT PANEL: Camera & Controls -->
        <aside class="room-camera">
            <div class="room-camera-top">
                <div class="camera-section">
                    <span class="camera-label">CAMERA PREVIEW</span>
                    <div class="camera-box">
                        <video id="camera-video" autoplay playsinline muted class="camera-feed d-none"></video>
                        <div id="camera-placeholder" class="camera-placeholder">
                            <span class="material-symbols-outlined">videocam_off</span>
                            <span>Camera off</span>
                        </div>
                        <!-- Camera is mandatory (anti-cheating) — this overlay reports its current
                             state and is updated by interview-room.js. -->
                        <span id="camera-status" class="camera-status">Camera: Starting…</span>
                    </div>
                </div>

                <div class="ai-voice-section">
                    <div class="ai-voice-header">
                        <span class="camera-label">AI VOICE</span>
                        <button id="voice-toggle" class="toggle-switch is-on" type="button" aria-pressed="true">
                            <span class="toggle-knob"></span>
                        </button>
                    </div>
                    <div class="visualizer">
                        <div class="waveform-bar"></div>
                        <div class="waveform-bar"></div>
                        <div class="waveform-bar"></div>
                        <div class="waveform-bar"></div>
                        <div class="waveform-bar"></div>
                        <div class="waveform-bar"></div>
                    </div>
                    <span class="ai-voice-caption">AI voice</span>
                </div>
            </div>

            <div class="room-camera-actions">
                <span class="quick-actions-label">QUICK ACTIONS</span>
                <button id="hint-btn" class="btn-secondary" type="button" @(isActive ? "" : "disabled")>
                    <span class="material-symbols-outlined icon-hint">lightbulb</span>
                    Ask for hint
                </button>
                <button id="skip-btn" class="btn-secondary" type="button" @(isActive ? "" : "disabled")>
                    <span class="material-symbols-outlined icon-skip">skip_next</span>
                    Skip question
                </button>
                <button id="pause-btn" class="btn-secondary" type="button" @(isActive ? "" : "disabled")>
                    <span class="material-symbols-outlined icon-pause">pause_circle</span>
                    <span id="pause-btn-label">Pause Interview</span>
                </button>
                <span class="quick-actions-note" id="pause-quota-text"></span>
                <button id="cancel-interview-btn" class="btn-cancel-interview" type="button" aria-label="Cancel Interview" @(isActive ? "" : "disabled")>
                    <span class="material-symbols-outlined">exit_to_app</span>
                    Cancel Interview
                </button>
            </div>
        </aside>
    </div>

    <dialog id="cancel-interview-dialog"
            class="cancel-interview-dialog"
            aria-modal="true"
            aria-labelledby="cancel-interview-title"
            aria-describedby="cancel-interview-description">
        <div class="cancel-interview-dialog-content">
            <h2 id="cancel-interview-title">Cancel this interview?</h2>
            <p id="cancel-interview-description">
                Cancelling ends this session immediately. Any answers already submitted may still be evaluated,
                and you can still submit Interview Feedback.
                <strong>Credit already spent on this interview will not be refunded.</strong>
            </p>
            <div class="cancel-interview-dialog-actions">
                <button id="continue-interview-btn" class="btn-continue-interview" type="button">Continue Interview</button>
                <button id="confirm-cancel-interview-btn" class="btn-confirm-cancel" type="button">Cancel Interview</button>
            </div>
        </div>
    </dialog>

    <script src="~/lib/driver.js/driver.js.iife.js" asp-append-version="true"></script>
    <script src="~/js/pages/content-filter.js" asp-append-version="true"></script>
    <script src="~/js/pages/interview-room.js" asp-append-version="true"></script>
</body>
</html>
