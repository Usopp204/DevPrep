@model WebClient.Models.Interview.DashboardViewModel

@{
    Layout = null;
    var levels = new[] { "Intern", "Fresher", "Junior", "Middle", "Senior" };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Configure Your Interview - DevPrep</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/dashboard.css" asp-append-version="true" />
</head>
<body class="dashboard-page">
    <!-- Left sidebar -->
    <nav class="dash-sidebar">
        <div class="dash-brand">
            <div class="dash-brand-icon">
                <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1;">graphic_eq</span>
            </div>
            <div>
                <h1 class="dash-brand-title">InterviewAI</h1>
                <p class="dash-brand-sub">Elite Coaching</p>
            </div>
        </div>

        <a class="btn-gradient dash-new-btn" asp-controller="Interview" asp-action="Index">
            <span class="material-symbols-outlined">add</span>
            <span>New Interview</span>
        </a>

        <div class="dash-sidebar-label">Recent Sessions</div>
        @{
            // Ongoing sessions reopen in the Room; finished ones open in the History transcript.
            bool IsOngoing(string status) => status is "Initialized" or "InProgress";
        }
        @if (Model.RecentSessions.Count == 0)
        {
            <div class="dash-sidebar-empty">No sessions yet.</div>
        }
        else
        {
            <div class="dash-session-list">
                @foreach (var session in Model.RecentSessions)
                {
                    var title = session.Title ?? session.Position ?? "Interview";
                    var url = IsOngoing(session.Status)
                        ? Url.Action("Room", "Interview", new { id = session.SessionId })
                        : Url.Action("History", "Interview", new { sessionId = session.SessionId });
                    <a class="dash-session-item" href="@url">
                        <span class="dash-session-title">@title</span>
                        <span class="dash-session-meta">@session.Level &middot; @WebClient.Helpers.TimeFormat.RelativeTime(session.CreatedAt)</span>
                    </a>
                }
            </div>
            <a class="dash-sidebar-link" asp-controller="Interview" asp-action="History">View all history</a>
        }

        <div class="dash-sidebar-spacer"></div>

        <div class="dash-sidebar-footer">
            <a class="dash-footer-item" href="#" onclick="return false;">
                <span class="material-symbols-outlined">settings</span>
                <span>Settings</span>
            </a>
            <a class="dash-footer-item" href="#" onclick="return false;">
                <span class="material-symbols-outlined">help</span>
                <span>Support</span>
            </a>
        </div>
    </nav>

    <!-- Main content -->
    <main class="dash-main">
        <div class="dash-main-inner">
            <header class="dash-header">
                <h2 class="dash-title">Configure Your Interview</h2>
                <p class="dash-subtitle">Set up your session parameters below.</p>
            </header>

            @if (TempData["ErrorMessage"] is string tempError)
            {
                <div class="dash-alert">@tempError</div>
            }
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="dash-alert">@Model.ErrorMessage</div>
            }

            <form method="post" asp-controller="Interview" asp-action="Start" class="dash-card"
                  id="dash-form" data-catalog-url="@Url.Action("Catalog", "Interview")">
                <div class="dash-card-accent"></div>

                <!-- Job Role (drives the ai-service question plan; options loaded from /catalog) -->
                <div class="dash-field">
                    <label class="dash-label" for="role">Job Role</label>
                    <select id="role" name="Position" class="dash-input">
                        <option value="Backend">Backend</option>
                        <option value="Frontend">Frontend</option>
                    </select>
                </div>

                <!-- Experience Level (segmented control) -->
                <div class="dash-field">
                    <label class="dash-label">Experience Level</label>
                    <div class="dash-segment">
                        @foreach (var level in levels)
                        {
                            <input class="seg-input" type="radio" name="Level" value="@level" id="lvl-@level"
                                   checked="@(Model.Level == level)" />
                            <label class="seg-label" for="lvl-@level">@level</label>
                        }
                    </div>
                </div>

                <!-- Job Description (optional context for the AI's questions) -->
                <div class="dash-field">
                    <label class="dash-label" for="jd">Job Description (JD)</label>
                    <textarea id="jd" name="Jd" class="dash-input"
                              placeholder="Paste the job description to tailor the AI's questions… (optional)"></textarea>
                </div>

                <!-- Duration -->
                <div class="dash-field">
                    <label class="dash-label" asp-for="DurationMinutes">Duration</label>
                    <select asp-for="DurationMinutes" class="dash-input">
                        <option value="15">15 Minutes</option>
                        <option value="30">30 Minutes</option>
                        <option value="45">45 Minutes</option>
                        <option value="60">60 Minutes</option>
                    </select>
                </div>

                <!-- Focus Areas (technologies for the selected role; loaded from /catalog) -->
                <div class="dash-field">
                    <label class="dash-label">Focus Areas <span class="dash-hint" style="text-transform:none">(optional)</span></label>
                    <p class="dash-hint">Pick the technologies to be tested. Leave empty to cover the whole role.</p>
                    <div id="focus-control" class="dash-chips">
                        <span class="dash-hint">Loading technologies…</span>
                    </div>
                    <!-- Selected focus areas are mirrored here as hidden inputs (name="FocusAreas"). -->
                    <div id="focus-selected"></div>
                </div>

                <div class="dash-actions">
                    <button type="submit" class="btn-gradient dash-start-btn">
                        <span>Start Interview</span>
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </button>
                </div>
            </form>
        </div>
    </main>

    <script src="~/js/pages/dashboard.js" asp-append-version="true"></script>
</body>
</html>
