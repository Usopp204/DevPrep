@model WebClient.Models.Interview.DashboardViewModel

@{
    Layout = "_InterviewLayout";
    ViewData["Title"] = "Configure Your Interview";
    ViewData["BodyClass"] = "dashboard-page";
    var levels = new[] { "Intern", "Fresher", "Junior", "Middle", "Senior" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/dashboard.css" asp-append-version="true" />
}

    <partial name="_InterviewSidebar" model="Model.Sidebar" />

    <main class="dash-main">
        <div class="dash-main-inner">
            <header class="dash-header">
                <h2 class="dash-title">Configure Your Interview</h2>
                <p class="dash-subtitle">Set up your session parameters below.</p>
            </header>

            @if (Model.ActiveSession is not null)
            {
                var remainingMinutes = Math.Max(1, (int)Math.Ceiling(Model.ActiveSession.RemainingSeconds / 60.0));
                <div class="dash-alert">
                    You have an interview in progress — @remainingMinutes minute@(remainingMinutes == 1 ? "" : "s") remaining.
                    <a asp-controller="Interview" asp-action="Room" asp-route-id="@Model.ActiveSession.SessionId">Resume</a>
                </div>
            }

            @if (TempData["ErrorMessage"] is string tempError)
            {
                <div class="dash-alert">@tempError</div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="dash-alert">@Model.ErrorMessage</div>
            }

            <form method="post"
                  asp-controller="Interview"
                  asp-action="Start"
                  class="dash-card"
                  id="dash-form"
                  data-catalog-url="@Url.Action("Catalog", "Interview")">
                @Html.AntiForgeryToken()

                <div class="dash-card-accent"></div>

                <div class="dash-field">
                    <label class="dash-label" for="role">Job Role</label>
                    <select id="role" name="Position" class="dash-input">
                        <option value="Backend" selected="@(Model.Position == "Backend")">Backend</option>
                        <option value="Frontend" selected="@(Model.Position == "Frontend")">Frontend</option>
                    </select>
                </div>

                <div class="dash-field">
                    <label class="dash-label">Experience Level</label>
                    <div class="dash-segment">
                        @foreach (var level in levels)
                        {
                            <input class="seg-input"
                                   type="radio"
                                   name="Level"
                                   value="@level"
                                   id="lvl-@level"
                                   checked="@(Model.Level == level)" />
                            <label class="seg-label" for="lvl-@level">@level</label>
                        }
                    </div>
                </div>

                <div class="dash-field">
                    <label class="dash-label" for="jd">Job Description (JD)</label>
                    <textarea id="jd"
                              name="Jd"
                              class="dash-input"
                              placeholder="Paste the job description to tailor the AI questions. Optional.">@Model.Jd</textarea>
                </div>

                <div class="dash-field">
                    <label class="dash-label" asp-for="DurationMinutes">Duration</label>
                    <p class="dash-hint">Your credit balance: <strong>@Model.CreditBalance</strong></p>
                    <select asp-for="DurationMinutes" class="dash-input">
                        @foreach (var (minutes, cost) in WebClient.Helpers.CreditPricing.DurationToCreditCost)
                        {
                            var affordable = Model.CreditBalance >= cost;
                            <option value="@minutes" disabled="@(!affordable)">
                                @minutes Minutes — @cost credits@(affordable ? "" : " (insufficient balance)")
                            </option>
                        }
                    </select>
                    @{
                        var cheapestCost = WebClient.Helpers.CreditPricing.DurationToCreditCost.Values.Min();
                    }
                    @if (Model.CreditBalance < cheapestCost)
                    {
                        <div class="dash-alert">
                            Not enough credit for any interview duration.
                            <a asp-controller="Payment" asp-action="Index">Top up credits</a>.
                        </div>
                    }
                </div>

                <div class="dash-field">
                    <label class="dash-label">
                        Focus Areas <span class="dash-hint" style="text-transform:none">(optional)</span>
                    </label>
                    <p class="dash-hint">Pick technologies to emphasize. Leave empty to cover the whole role.</p>
                    <div id="focus-control" class="dash-chips">
                        <span class="dash-hint">Loading technologies...</span>
                    </div>
                    <div id="focus-selected"></div>
                </div>

                <div class="dash-actions">
                    <button type="submit" class="btn-gradient dash-start-btn">
                        <span>Start Interview</span>
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </button>
                </div>
            </form>
        </div>
    </main>

@section Scripts {
    <script src="~/js/pages/dashboard.js" asp-append-version="true"></script>
}
