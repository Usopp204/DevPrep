@model WebClient.Models.Interview.DashboardViewModel

@{
    Layout = "_InterviewLayout";
    ViewData["Title"] = "Configure Your Interview";
    ViewData["BodyClass"] = "dashboard-page";
    var levels = new[] { "Intern", "Fresher", "Junior", "Middle", "Senior" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/dashboard.css" asp-append-version="true" />
}

    <partial name="_InterviewSidebar" model="Model.Sidebar" />

    <main class="dash-main">
        <div class="dash-main-inner">
            <header class="dash-header">
                <h2 class="dash-title">Configure Your Interview</h2>
                <p class="dash-subtitle">Set up your session parameters below.</p>
            </header>

            @if (TempData["ErrorMessage"] is string tempError)
            {
                <div class="dash-alert">@tempError</div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="dash-alert">@Model.ErrorMessage</div>
            }

            <form method="post"
                  asp-controller="Interview"
                  asp-action="Start"
                  class="dash-card"
                  id="dash-form"
                  data-catalog-url="@Url.Action("Catalog", "Interview")">
                @Html.AntiForgeryToken()

                <div class="dash-card-accent"></div>

                <div class="dash-field">
                    <label class="dash-label" for="role">Job Role</label>
                    <select id="role" name="Position" class="dash-input">
                        <option value="Backend" selected="@(Model.Position == "Backend")">Backend</option>
                        <option value="Frontend" selected="@(Model.Position == "Frontend")">Frontend</option>
                    </select>
                </div>

                <div class="dash-field">
                    <label class="dash-label">Experience Level</label>
                    <div class="dash-segment">
                        @foreach (var level in levels)
                        {
                            <input class="seg-input"
                                   type="radio"
                                   name="Level"
                                   value="@level"
                                   id="lvl-@level"
                                   checked="@(Model.Level == level)" />
                            <label class="seg-label" for="lvl-@level">@level</label>
                        }
                    </div>
                </div>

                <div class="dash-field">
                    <label class="dash-label">Job Description (JD)</label>
                    <p class="dash-hint">Shares one JD with the Profile &gt; CV &amp; JD page — parse it in either place and it shows up in both.</p>
                    <div id="ijd-status" class="dash-hint" style="min-height:18px;"></div>

                    <!-- Existing/just-parsed JD — read-only summary + Đổi JD -->
                    <div id="ijd-parsed" class="ijd-card" style="display:none;">
                        <div class="ijd-card-head">
                            <div>
                                <div class="ijd-pos" id="ijd-parsed-position">—</div>
                                <div class="ijd-co" id="ijd-parsed-company"></div>
                            </div>
                            <button type="button" class="dash-chip dash-chip-outline selectable" id="ijd-change-btn">✎ Change JD</button>
                        </div>
                        <div id="ijd-req-wrap" style="display:none;">
                            <div class="ijd-group-label ijd-req">Required Skills</div>
                            <div class="ijd-tags" id="ijd-req-tags"></div>
                        </div>
                        <div id="ijd-nice-wrap" style="display:none;">
                            <div class="ijd-group-label ijd-nice">Nice-to-have Skills</div>
                            <div class="ijd-tags" id="ijd-nice-tags"></div>
                        </div>
                    </div>

                    <!-- Loading overlay (spinner + elapsed time) shown while a parse is in flight -->
                    <div class="ijd-loading" id="ijd-loading">
                        <div class="ijd-spinner"></div>
                        <div class="ijd-elapsed" id="ijd-elapsed">0s</div>
                        <div class="ijd-progress-wrap"><div class="ijd-progress-fill"></div></div>
                        <div class="ijd-loading-msg" id="ijd-loading-msg">AI is reading the JD content...</div>
                    </div>

                    <!-- No JD yet (or user chose Đổi JD) — same parse flow as Profile/CV & JD -->
                    <div id="ijd-input">
                        <div class="ijd-tabs">
                            <button type="button" class="dash-chip selectable selected" id="ijd-tab-paste">📋 Paste text</button>
                            <button type="button" class="dash-chip selectable" id="ijd-tab-file">📄 Upload file</button>
                        </div>
                        <div id="ijd-paste-mode">
                            <textarea id="ijd-text" class="dash-input" placeholder="Paste the Job Description content here..."></textarea>
                        </div>
                        <div id="ijd-file-mode" style="display:none;">
                            <label class="ijd-drop" id="ijd-drop">
                                <input type="file" id="ijd-file" accept=".pdf,.doc,.docx" style="display:none;" />
                                <span>Click or drag &amp; drop the JD file (PDF, DOC, DOCX)</span>
                                <div id="ijd-file-name" class="dash-hint"></div>
                            </label>
                        </div>
                        <div class="ijd-parse-actions">
                            <button type="button" class="btn-gradient ijd-parse-btn" id="ijd-btn-ai">🤖 AI Parse</button>
                            <button type="button" class="dash-chip dash-chip-outline selectable" id="ijd-btn-normal">📋 Normal (skip AI)</button>
                            <button type="button" class="dash-chip dash-chip-outline selectable" id="ijd-btn-cancel" style="display:none;">✕ Cancel</button>
                        </div>
                    </div>

                    <input type="hidden" id="ijd-hidden-text" name="Jd" value="@Model.Jd" />
                    <input type="hidden" id="ijd-hidden-id" name="JdId" value="@Model.JdId" />
                </div>

                <div class="dash-field">
                    <label class="dash-label" asp-for="DurationMinutes">Duration</label>
                    <p class="dash-hint">Your credit balance: <strong>@Model.CreditBalance</strong></p>
                    <select asp-for="DurationMinutes" class="dash-input">
                        @foreach (var (minutes, cost) in WebClient.Helpers.CreditPricing.DurationToCreditCost)
                        {
                            var affordable = Model.CreditBalance >= cost;
                            <option value="@minutes" disabled="@(!affordable)">
                                @minutes Minutes — @cost credits@(affordable ? "" : " (insufficient balance)")
                            </option>
                        }
                    </select>
                    @{
                        var cheapestCost = WebClient.Helpers.CreditPricing.DurationToCreditCost.Values.Min();
                    }
                    @if (Model.CreditBalance < cheapestCost)
                    {
                        <div class="dash-alert">
                            Not enough credit for any interview duration.
                            <a asp-controller="Payment" asp-action="Index">Top up credits</a>.
                        </div>
                    }
                </div>

                <div class="dash-field">
                    <label class="dash-label">
                        Focus Areas <span class="dash-hint" style="text-transform:none">(optional)</span>
                    </label>
                    <p class="dash-hint">Pick technologies to emphasize. Leave empty to cover the whole role.</p>
                    <div id="focus-control" class="dash-chips">
                        <span class="dash-hint">Loading technologies...</span>
                    </div>
                    <div id="focus-selected"></div>
                </div>

                <div class="dash-actions">
                    <button type="submit" class="btn-gradient dash-start-btn">
                        <span>Start Interview</span>
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </button>
                </div>
            </form>
        </div>
    </main>

@section Scripts {
    <script src="~/js/pages/dashboard.js" asp-append-version="true"></script>
}
