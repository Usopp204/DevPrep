@model WebClient.Models.Admin.AdminQuestionViewModel

@{
    ViewData["Title"] = "Cập nhật câu hỏi";
    Layout = null;

    var qDetail = ViewBag.QuestionDetail as WebClient.Models.Admin.AdminQuestionDetailDto;

    var formActionUrl = qDetail != null
        ? $"/admin/questions/edit/{qDetail.QuestionId}"
        : "/admin/questions";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - DevPrep AI Admin Dashboard</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@100..900&family=JetBrains+Mono:wght@@500&display=swap"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />

    <style>
        body.admin-page {
            margin: 0;
            padding: 0;
            background-color: #0f0f11;
            color: #ffffff;
            overflow-x: hidden;
            font-family: 'Inter', sans-serif;
        }

        .admin-main-wrapper {
            margin-left: 260px;
            padding-top: 70px;
            min-height: 100vh;
            transition: all 0.3s ease;
        }

        .page-container {
            padding: 28px 30px 60px;
        }

        .page-title {
            color: #ffffff;
            font-size: 1.75rem;
            font-weight: 800;
            margin-bottom: 5px;
        }

        .page-subtitle {
            color: #a1a1aa;
            font-size: 0.9rem;
            margin-bottom: 0;
        }

        .form-card {
            background-color: #16161a;
            border: 1px solid #26262b;
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 22px;
        }

        .section-title {
            color: #ffffff;
            font-size: 0.85rem;
            font-weight: 800;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 9px;
            border-bottom: 1px solid #26262b;
            padding-bottom: 11px;
            margin-bottom: 22px;
        }

            .section-title i {
                color: #6366f1;
            }

        .field-label {
            display: block;
            color: #a1a1aa;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        .custom-input {
            width: 100%;
            background-color: #0f0f11 !important;
            border: 1px solid #26262b !important;
            color: #ffffff !important;
            border-radius: 8px !important;
            padding: 12px 16px;
            font-size: 0.95rem;
            box-shadow: none !important;
        }

            .custom-input:focus {
                border-color: #6366f1 !important;
                box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2) !important;
            }

            .custom-input::placeholder {
                color: #52525b !important;
            }

        select.custom-input {
            appearance: none;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23a1a1aa' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e") !important;
            background-repeat: no-repeat !important;
            background-position: right 16px center !important;
            background-size: 12px 12px !important;
        }

            select.custom-input option {
                color: #ffffff !important;
                background-color: #11121a !important;
            }

        .status-options {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .btn-check {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .status-option {
            min-width: 118px;
            background-color: #0f0f11;
            border: 1px solid #303038;
            color: #a1a1aa;
            border-radius: 8px;
            padding: 11px 18px;
            font-size: 0.87rem;
            font-weight: 700;
            text-align: center;
            cursor: pointer;
            transition: all 0.18s ease;
        }

            .status-option:hover {
                background-color: #202026;
                border-color: #52525b;
                color: #ffffff;
            }

            .status-option::before {
                content: "";
                width: 9px;
                height: 9px;
                border: 2px solid currentColor;
                border-radius: 50%;
                display: inline-block;
                margin-right: 7px;
                vertical-align: 1px;
            }

        #statusActive:checked + .status-active {
            color: #34d399;
            border-color: #10b981;
            background: rgba(16, 185, 129, 0.12);
            box-shadow: 0 0 0 1px rgba(16, 185, 129, 0.35);
        }

        #statusDraft:checked + .status-draft {
            color: #fbbf24;
            border-color: #f59e0b;
            background: rgba(245, 158, 11, 0.12);
            box-shadow: 0 0 0 1px rgba(245, 158, 11, 0.35);
        }

        #statusArchived:checked + .status-archived {
            color: #f87171;
            border-color: #ef4444;
            background: rgba(239, 68, 68, 0.12);
            box-shadow: 0 0 0 1px rgba(239, 68, 68, 0.35);
        }

        #statusInactive:checked + .status-inactive {
            color: #c4b5fd;
            border-color: #8b5cf6;
            background: rgba(139, 92, 246, 0.12);
            box-shadow: 0 0 0 1px rgba(139, 92, 246, 0.35);
        }

        .action-area {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 14px;
            padding-top: 8px;
        }

        .btn-cancel {
            min-width: 145px;
            border: 1px solid #3f3f46;
            color: #ffffff;
            background: transparent;
            border-radius: 8px;
            padding: 11px 24px;
            font-weight: 600;
            text-decoration: none;
            text-align: center;
        }

            .btn-cancel:hover {
                color: #ffffff;
                background-color: #27272a;
            }

        .btn-save {
            min-width: 170px;
            border: none;
            color: #ffffff;
            background-color: #6366f1;
            border-radius: 8px;
            padding: 11px 24px;
            font-weight: 700;
        }

            .btn-save:hover {
                background-color: #4f46e5;
            }

            .btn-save:disabled {
                opacity: 0.65;
                cursor: not-allowed;
            }

        @@media (max-width: 991.98px) {
            .admin-main-wrapper {
                margin-left: 0;
                padding-top: 80px;
            }

            .page-container {
                padding: 20px 15px 50px;
            }

            .status-option {
                flex: 1;
                min-width: 130px;
            }
        }
    </style>
</head>

<body class="admin-page">

    @await Html.PartialAsync("_AdminTopbar")
    @await Html.PartialAsync("_AdminSidebar")

    <main class="admin-main-wrapper">
        <div class="container-fluid page-container">

            <div class="mb-4">
                <h1 class="page-title">
                    Update Interview Question
                </h1>

                <p class="page-subtitle">
                    Edit question information, difficulty, status and classification.
                </p>
            </div>

            @if (qDetail == null)
            {
                <div class="alert alert-danger">
                    Không tìm thấy dữ liệu câu hỏi để cập nhật.
                </div>

                <a href="/admin/questions"
                   class="btn btn-outline-secondary">
                    Back to Questions
                </a>
            }
            else
            {
                <form id="updateQuestionForm"
                      method="post"
                      action="@formActionUrl">

                    @Html.AntiForgeryToken()

                    <!-- Question information -->
                    <section class="form-card">
                        <div class="section-title">
                            <i class="fa-regular fa-file-lines"></i>
                            Question Information
                        </div>

                        <div class="mb-4">
                            <label class="field-label"
                                   for="questionInput">
                                Question content
                            </label>

                            <!-- QUAN TRỌNG: name phải là Question -->
                            <textarea id="questionInput"
                                      class="form-control custom-input"
                                      rows="5"
                                      required
                                      name="Question"
                                      placeholder="Enter question content...">@qDetail.Question</textarea>
                        </div>

                        <div class="mb-4">
                            <label class="field-label"
                                   for="answerInput">
                                Answer
                            </label>

                            <textarea id="answerInput"
                                      class="form-control custom-input"
                                      rows="5"
                                      name="Answer"
                                      placeholder="Enter the expected answer...">@qDetail.Answer</textarea>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="field-label"
                                       for="categoryInput">
                                    Category
                                </label>

                                <select id="categoryInput"
                                        class="form-select custom-input"
                                        required
                                        name="CategoryId">

                                    <option value=""
                                            disabled>
                                        Select Category
                                    </option>

                                    @if (Model.Categories != null)
                                    {
                                        foreach (var category in Model.Categories)
                                        {
                                            <option value="@category.CategoryId"
                                                    selected="@(category.CategoryId == qDetail.CategoryId
                                                        ? "selected"
                                                        : null)">
                                                @category.Category
                                            </option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="field-label"
                                       for="difficultyInput">
                                    Difficulty
                                </label>

                                <select id="difficultyInput"
                                        class="form-select custom-input"
                                        required
                                        name="Difficulty">

                                    <option value=""
                                            disabled>
                                        Select Difficulty
                                    </option>

                                    @foreach (var d in new[] { "Intern", "Fresher", "Junior", "Middle", "Senior" })
                                    {
                                        <option value="@d"
                                                selected="@(string.Equals(
                                                    d,
                                                    qDetail.Difficulty,
                                                    StringComparison.OrdinalIgnoreCase)
                                                    ? "selected"
                                                    : null)">
                                            @d
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>
                    </section>

                    <!-- Position and status -->
                    <section class="form-card">
                        <div class="section-title">
                            <i class="fa-solid fa-layer-group"></i>
                            Position & Status
                        </div>
                        <div class="mb-4">
                            <label class="field-label"
                                   for="positionInput">
                                Position
                            </label>

                            <select id="positionInput"
                                    class="form-select custom-input"
                                    name="PositionId">

                                <option value="">-- No position --</option>

                                @if (Model.Positions != null)
                                {
                                    foreach (var position in Model.Positions)
                                    {
                                        <option value="@position.PositionId"
                                                selected="@(position.PositionId == qDetail.PositionId
                                                    ? "selected"
                                                    : null)">
                                            @position.Name
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <div>
                            <label class="field-label">
                                Status
                            </label>

                            <div class="status-options">

                                <input type="radio"
                                       class="btn-check"
                                       name="Status"
                                       id="statusActive"
                                       value="Active"
                                       checked="@(string.Equals(
                                           qDetail.Status,
                                           "Active",
                                           StringComparison.OrdinalIgnoreCase)
                                           ? "checked"
                                           : null)" />

                                <label class="status-option status-active"
                                       for="statusActive">
                                    Active
                                </label>

                                <input type="radio"
                                       class="btn-check"
                                       name="Status"
                                       id="statusDraft"
                                       value="Draft"
                                       checked="@(string.Equals(
                                           qDetail.Status,
                                           "Draft",
                                           StringComparison.OrdinalIgnoreCase)
                                           ? "checked"
                                           : null)" />

                                <label class="status-option status-draft"
                                       for="statusDraft">
                                    Draft
                                </label>

                                @* <input type="radio" *@
                                @*        class="btn-check" *@
                                @*        name="Status" *@
                                @*        id="statusArchived" *@
                                @*        value="Archived" *@
                                @*        checked="@(string.Equals( *@
                                @*            qDetail.Status, *@
                                @*            "Archived", *@
                                @*            StringComparison.OrdinalIgnoreCase) *@
                                @*            ? "checked" *@
                                @*            : null)" /> *@

                                @* <label class="status-option status-archived" *@
                                @*        for="statusArchived"> *@
                                @*     Archived *@
                                @* </label> *@

                                @* <input type="radio" *@
                                @*        class="btn-check" *@
                                @*        name="Status" *@
                                @*        id="statusInactive" *@
                                @*        value="Inactive" *@
                                @*        checked="@(string.Equals( *@
                                @*            qDetail.Status, *@
                                @*            "Inactive", *@
                                @*            StringComparison.OrdinalIgnoreCase) *@
                                @*            ? "checked" *@
                                @*            : null)" /> *@

                                @* <label class="status-option status-inactive" *@
                                @*        for="statusInactive"> *@
                                @*     Inactive *@
                                @* </label> *@

                            </div>
                        </div>
                    </section>

                    @* <!-- Technology and tags --> *@
                    @* <section class="form-card"> *@
                    @*     <div class="section-title"> *@
                    @*         <i class="fa-solid fa-tags"></i> *@
                    @*         Technology & Tags *@
                    @*     </div> *@

                    @*     <div class="row g-3"> *@
                    @*         <div class="col-md-6"> *@
                    @*             <label class="field-label" *@
                    @*                    for="techStackInput"> *@
                    @*                 Tech stack *@
                    @*             </label> *@

                    @*             <input id="techStackInput" *@
                    @*                    type="text" *@
                    @*                    class="form-control custom-input" *@
                    @*                    maxlength="255" *@
                    @*                    name="TechStack" *@
                    @*                    @* value="@qDetail.TechStack" *@ 
                    @*                    placeholder="e.g. ASP.NET Core, C#, React, SQL Server..." /> *@
                    @*         </div> *@

                    @*         <div class="col-md-6"> *@
                    @*             <label class="field-label" *@
                    @*                    for="tagsInput"> *@
                    @*                 Tags *@
                    @*             </label> *@

                    @*             <input id="tagsInput" *@
                    @*                    type="text" *@
                    @*                    class="form-control custom-input" *@
                    @*                    maxlength="500" *@
                    @*                    name="Tags" *@
                    @*                    @* value="@qDetail.Tags" *@ 
                    @*                    placeholder="e.g. oop, dotnet, logic..." /> *@
                    @*         </div> *@
                    @*     </div> *@
                    @* </section> *@

                    <div class="action-area">
                        <a href="/admin/questions"
                           class="btn-cancel">
                            Cancel
                        </a>

                        <button type="submit"
                                id="btnSaveQuestion"
                                class="btn-save">
                            Save Changes
                        </button>
                    </div>

                </form>
            }

        </div>
    </main>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@@11"></script>

    <script>
        const updateForm = document.getElementById('updateQuestionForm');
        const saveButton = document.getElementById('btnSaveQuestion');

        if (updateForm) {
            updateForm.addEventListener('submit', async function (event) {
                event.preventDefault();

                const form = this;
                const questionInput = form.querySelector('[name="Question"]');
                const difficultyInput = form.querySelector('[name="Difficulty"]');
                const categoryInput = form.querySelector('[name="CategoryId"]');
                const statusInput = form.querySelector('[name="Status"]:checked');

                if (!questionInput || !questionInput.value.trim()) {
                    await Swal.fire({
                        title: 'Update Failed!',
                        text: 'Vui lòng nhập nội dung câu hỏi.',
                        icon: 'error',
                        background: '#16161a',
                        color: '#ffffff',
                        confirmButtonColor: '#ef4444'
                    });

                    questionInput?.focus();
                    return;
                }

                if (!difficultyInput || !difficultyInput.value.trim()) {
                    await Swal.fire({
                        title: 'Update Failed!',
                        text: 'Vui lòng nhập Difficulty.',
                        icon: 'error',
                        background: '#16161a',
                        color: '#ffffff',
                        confirmButtonColor: '#ef4444'
                    });

                    difficultyInput?.focus();
                    return;
                }

                if (!categoryInput || !categoryInput.value) {
                    await Swal.fire({
                        title: 'Update Failed!',
                        text: 'Vui lòng chọn Category.',
                        icon: 'error',
                        background: '#16161a',
                        color: '#ffffff',
                        confirmButtonColor: '#ef4444'
                    });

                    categoryInput?.focus();
                    return;
                }

                if (!statusInput) {
                    await Swal.fire({
                        title: 'Update Failed!',
                        text: 'Vui lòng chọn Status.',
                        icon: 'error',
                        background: '#16161a',
                        color: '#ffffff',
                        confirmButtonColor: '#ef4444'
                    });

                    return;
                }

                const formData = new FormData(form);

                try {
                    saveButton.disabled = true;
                    saveButton.textContent = 'Saving...';

                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    let result = null;

                    try {
                        result = await response.json();
                    } catch {
                        result = null;
                    }

                    if (!response.ok || !result?.success) {
                        throw new Error(
                            result?.message ??
                            'An error occurred while updating the question.'
                        );
                    }

                    await Swal.fire({
                        title: 'Updated Successfully!',
                        text: result.message ??
                            'The question has been updated successfully.',
                        icon: 'success',
                        background: '#16161a',
                        color: '#ffffff',
                        confirmButtonColor: '#6366f1',
                        timer: 1700,
                        showConfirmButton: false
                    });

                    window.location.href = '/admin/questions';
                } catch (error) {
                    Swal.fire({
                        title: 'Update Failed!',
                        text: error.message,
                        icon: 'error',
                        background: '#16161a',
                        color: '#ffffff',
                        confirmButtonColor: '#ef4444'
                    });
                } finally {
                    saveButton.disabled = false;
                    saveButton.textContent = 'Save Changes';
                }
            });
        }
    </script>

</body>
</html>