@{
    var token = Context.Request.Cookies["access_token"];
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Interview Sessions - DevPrep Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@300;400;500;600;700&family=JetBrains+Mono:wght@@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/tech-stack-list.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin-tech-stacks.css" asp-append-version="true" />
    <style>
        .iv-avatar { display:inline-flex; width:30px; height:30px; border-radius:50%; align-items:center; justify-content:center; background:rgba(129,140,248,.18); color:#a5b4fc; font:700 12px 'JetBrains Mono',monospace; flex:0 0 30px; }
        .iv-badge { display:inline-block; padding:3px 9px; border-radius:6px; background:rgba(148,163,184,.14); color:#cbd5e1; font:600 10px 'JetBrains Mono',monospace; text-transform:uppercase; }
        .tech-stacks-table tbody tr.iv-row { cursor:pointer; }
    </style>
</head>
<body class="admin-page">
    @await Html.PartialAsync("_AdminTopbar")
    @await Html.PartialAsync("_AdminSidebar")

    <main class="ad-main tech-stacks-page">
        <header class="tech-stacks-header">
            <div>
                <p class="tech-stacks-eyebrow">Interview Administration</p>
                <h1 class="ad-page-title">Interview Sessions</h1>
                <p class="tech-stacks-subtitle">Review interview sessions and their transcripts.</p>
            </div>
        </header>

        <section class="tech-stacks-card tech-stacks-filters" aria-label="Session filters">
            <div class="tech-stacks-filter-form" style="grid-template-columns: minmax(220px,1fr) 180px 180px;">
                <div class="tech-stacks-filter-field">
                    <label for="iv-search">Search</label>
                    <div class="tech-stacks-search">
                        <button type="button" class="tech-stacks-search-button" aria-label="Search" title="Search">
                            <span class="material-symbols-outlined" aria-hidden="true">search</span>
                        </button>
                        <input id="iv-search" type="search" placeholder="Search by user" />
                    </div>
                </div>
                <div class="tech-stacks-filter-field tech-stacks-status-filter">
                    <label for="iv-status">Status</label>
                    <select id="iv-status"><option value="">All status</option></select>
                </div>
                <div class="tech-stacks-filter-field tech-stacks-status-filter">
                    <label for="iv-level">Level</label>
                    <select id="iv-level"><option value="">All level</option></select>
                </div>
            </div>
        </section>

        <section class="tech-stacks-card tech-stacks-results">
            <div class="tech-stacks-card-header">
                <div><h2>Sessions</h2><p id="iv-count">Loading…</p></div>
                <span class="tech-stacks-page-count" id="iv-page-count"></span>
            </div>
            <div class="table-responsive">
                <table class="tech-stacks-table">
                    <thead>
                        <tr>
                            <th scope="col">User</th>
                            <th scope="col" class="tech-stack-status-column">Level</th>
                            <th scope="col" class="tech-stack-status-column">Progress</th>
                            <th scope="col" class="tech-stack-status-column">Status</th>
                            <th scope="col">Date</th>
                            <th scope="col" class="tech-stack-actions-column">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="iv-table-body">
                        <tr><td colspan="6" class="text-center" style="padding:40px; color:var(--ts-muted);">Loading…</td></tr>
                    </tbody>
                </table>
            </div>
            <nav class="tech-stacks-pagination" id="iv-pages" aria-label="Session pages" style="display:none;"></nav>
        </section>
    </main>

    <script>
        const API_BASE = 'http://localhost:7000/api/admin/interviews';
        const token = '@token';
        // InProgress and Paused are real InterviewSessions.Status values but are deliberately
        // left out of this dropdown — not user-selectable in the UI.
        const STATUSES = ['Configured', 'Initialized', 'Completed', 'Expired', 'Cancelled'];
        // Lead exists in SessionService.ValidLevels but is deliberately left out of this
        // dropdown — reserved for future development, not yet selectable in the UI.
        const LEVELS = ['Intern', 'Fresher', 'Junior', 'Middle', 'Senior'];
        let currentPage = 1, pageSize = 10, totalPages = 1, searchTimer = null;

        document.addEventListener("DOMContentLoaded", () => {
            fillSelect('iv-status', STATUSES); fillSelect('iv-level', LEVELS);
            ['iv-status', 'iv-level'].forEach(id => document.getElementById(id).addEventListener('change', () => { currentPage = 1; fetchList(); }));
            document.getElementById('iv-search').addEventListener('input', () => { clearTimeout(searchTimer); searchTimer = setTimeout(() => { currentPage = 1; fetchList(); }, 300); });
            fetchList();
        });

        function fillSelect(id, values) { const s = document.getElementById(id); values.forEach(v => { const o = document.createElement('option'); o.value = v; o.textContent = v; s.appendChild(o); }); }
        function openDetail(id) { window.location.href = '/Admin/InterviewSessionDetail/' + id; }

        async function fetchList() {
            const tbody = document.getElementById('iv-table-body');
            try {
                const q = new URLSearchParams({ page: currentPage, pageSize });
                const kw = document.getElementById('iv-search').value.trim(); if (kw) q.set('keyword', kw);
                const st = document.getElementById('iv-status').value; if (st) q.set('status', st);
                const lv = document.getElementById('iv-level').value; if (lv) q.set('level', lv);
                const res = await fetch(`${API_BASE}?${q}`, { headers: { 'Authorization': `Bearer ${token}` } });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const json = await res.json();
                if (json.success) { renderTable(json.data.items || []); renderPagination(json.data); }
                else tbody.innerHTML = `<tr><td colspan="6" class="text-center" style="padding:40px; color:var(--ts-danger);">Failed: ${escapeHtml(json.message)}</td></tr>`;
            } catch (e) { tbody.innerHTML = `<tr><td colspan="6" class="text-center" style="padding:40px; color:var(--ts-danger);">Failed to load. Please sign in again or check ApiGateway (:7000).</td></tr>`; }
        }

        function renderTable(items) {
            const tbody = document.getElementById('iv-table-body');
            if (!items.length) { tbody.innerHTML = `<tr><td colspan="6" class="text-center" style="padding:48px; color:var(--ts-muted);">No sessions found.</td></tr>`; return; }
            tbody.innerHTML = items.map(it => `
                <tr class="iv-row" onclick="openDetail('${it.sessionId}')">
                    <td>
                        <div style="display:flex; align-items:center; gap:9px;">
                            <span class="iv-avatar">${initial(it.userFullName)}</span>
                            <span class="tech-stack-name">${escapeHtml(userLabel(it))}</span>
                        </div>
                    </td>
                    <td class="tech-stack-status-column">${badge(it.level)}</td>
                    <td class="tech-stack-status-column"><span style="font:600 12px 'JetBrains Mono',monospace; color:#cbd5e1;">${it.answeredQuestions}/${it.totalQuestions}</span></td>
                    <td class="tech-stack-status-column">${statusBadge(it.status)}</td>
                    <td>${fmtDate(it.createdAt)}</td>
                    <td class="tech-stack-actions-column">
                        <div class="tech-stack-actions">
                            <button type="button" class="ts-button ts-button-small ts-button-secondary tech-stack-icon-action" title="View" onclick="event.stopPropagation(); openDetail('${it.sessionId}')"><span class="material-symbols-outlined">visibility</span></button>
                        </div>
                    </td>
                </tr>`).join('');
        }

        function renderPagination(data) {
            totalPages = Math.max(1, data.totalPages || 1);
            const ti = data.totalItems || 0, pg = data.page || currentPage;
            currentPage = pg;
            document.getElementById('iv-count').innerText = `${ti} result${ti === 1 ? '' : 's'}`;
            document.getElementById('iv-page-count').innerText = ti > 0 ? `Page ${currentPage} of ${totalPages}` : '';
            const nav = document.getElementById('iv-pages');
            if (totalPages <= 1) { nav.style.display = 'none'; nav.innerHTML = ''; return; }
            nav.style.display = 'flex';
            let html = `<a class="tech-stacks-page-link ${currentPage <= 1 ? 'disabled' : ''}" onclick="gotoPage(${currentPage - 1})">Previous</a>`;
            for (let p = 1; p <= totalPages; p++) html += `<a class="tech-stacks-page-link ${p === currentPage ? 'active' : ''}" onclick="gotoPage(${p})">${p}</a>`;
            html += `<a class="tech-stacks-page-link ${currentPage >= totalPages ? 'disabled' : ''}" onclick="gotoPage(${currentPage + 1})">Next</a>`;
            nav.innerHTML = html;
        }
        function gotoPage(p) { if (p < 1 || p > totalPages || p === currentPage) return; currentPage = p; fetchList(); }

        function badge(t) { return t ? `<span class="iv-badge">${escapeHtml(t)}</span>` : '—'; }
        function statusBadge(s) {
            const active = s === 'Completed';
            const icon = active ? 'check_circle' : 'pause_circle';
            return `<span class="tech-stack-status ${active ? 'is-active' : 'is-inactive'}"><span class="material-symbols-outlined">${icon}</span>${escapeHtml(s || '')}</span>`;
        }
        function fmtDate(d) { if (!d) return '—'; const x = new Date(d); return `<time>${x.toLocaleDateString('en-GB')}<br><span>${x.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })}</span></time>`; }
        function userLabel(it) { return cleanText(it.userFullName) || (it.userId ? 'User ' + String(it.userId).substring(0, 5) : 'Unknown'); }
        function initial(n) { const clean = cleanText(n); return clean && clean.trim() ? clean.trim()[0].toUpperCase() : 'U'; }
        function cleanText(value) {
            let text = String(value || '');
            for (let i = 0; i < 2; i++) {
                if (!/[ÃÂâ]|áº|á»|Ä|Æ|�/.test(text)) break;
                try {
                    const windows1252 = { 0x20AC:0x80,0x201A:0x82,0x0192:0x83,0x201E:0x84,0x2026:0x85,0x2020:0x86,0x2021:0x87,0x02C6:0x88,0x2030:0x89,0x0160:0x8A,0x2039:0x8B,0x0152:0x8C,0x017D:0x8E,0x2018:0x91,0x2019:0x92,0x201C:0x93,0x201D:0x94,0x2022:0x95,0x2013:0x96,0x2014:0x97,0x02DC:0x98,0x2122:0x99,0x0161:0x9A,0x203A:0x9B,0x0153:0x9C,0x017E:0x9E,0x0178:0x9F };
                    const bytes = Uint8Array.from([...text].map(ch => { const code = ch.charCodeAt(0); return windows1252[code] || (code <= 255 ? code : 63); }));
                    const fixed = new TextDecoder('utf-8', { fatal: false }).decode(bytes);
                    if (!fixed || fixed === text) break;
                    text = fixed;
                } catch { break; }
            }
            return text;
        }
        function escapeHtml(u) { return cleanText(u).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;"); }
    </script>
</body>
</html>
