@{
    var token = Context.Request.Cookies["access_token"];
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Position Management - DevPrep Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@300;400;500;600;700&family=JetBrains+Mono:wght@@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/tech-stack-list.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin-tech-stacks.css" asp-append-version="true" />
</head>
<body class="admin-page">
    @await Html.PartialAsync("_AdminTopbar")
    @await Html.PartialAsync("_AdminSidebar")

    <main class="ad-main tech-stacks-page">
        <header class="tech-stacks-header">
            <div>
                <p class="tech-stacks-eyebrow">Question Administration</p>
                <h1 class="ad-page-title">Position Management</h1>
                <p class="tech-stacks-subtitle">Manage the job positions available for question classification.</p>
            </div>
            <button type="button" class="ts-button ts-button-primary" id="pos-create">
                <span class="material-symbols-outlined">add</span>
                Create Position
            </button>
        </header>

        <section class="tech-stacks-card tech-stacks-filters" aria-label="Position filters">
            <div class="tech-stacks-filter-form">
                <div class="tech-stacks-filter-field">
                    <label for="pos-search">Search</label>
                    <div class="tech-stacks-search">
                        <button type="button" class="tech-stacks-search-button" aria-label="Search" title="Search">
                            <span class="material-symbols-outlined" aria-hidden="true">search</span>
                        </button>
                        <input id="pos-search" type="search" maxlength="50" placeholder="Search by name" />
                    </div>
                </div>
                <div class="tech-stacks-filter-field tech-stacks-status-filter">
                    <label for="pos-status">Status</label>
                    <select id="pos-status">
                        <option value="Active" selected>Active</option>
                        <option value="Deleted">Deleted</option>
                    </select>
                </div>
            </div>
        </section>

        <section class="tech-stacks-card tech-stacks-results">
            <div class="tech-stacks-card-header">
                <div><h2>Positions</h2><p id="pos-count">Loading…</p></div>
                <span class="tech-stacks-page-count" id="pos-page-count"></span>
            </div>
            <div class="table-responsive">
                <table class="tech-stacks-table">
                    <thead>
                        <tr>
                            <th scope="col">Position Name</th>
                            <th scope="col" class="tech-stack-status-column">Questions</th>
                            <th scope="col">Created At</th>
                            <th scope="col" class="tech-stack-status-column">Status</th>
                            <th scope="col" class="tech-stack-actions-column">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="pos-table-body">
                        <tr><td colspan="5" class="text-center" style="padding:40px; color:var(--ts-muted);">Loading…</td></tr>
                    </tbody>
                </table>
            </div>
            <nav class="tech-stacks-pagination" id="pos-pages" aria-label="Position pages" style="display:none;"></nav>
        </section>
    </main>

    <!-- Create / Edit modal -->
    <div class="modal fade" id="pos-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content tech-stack-modal-content">
                <div class="modal-header tech-stack-modal-header">
                    <div class="tech-stack-modal-heading">
                        <span class="tech-stack-modal-icon material-symbols-outlined">work</span>
                        <div>
                            <h2 id="pos-modal-title">Create Position</h2>
                            <p>Positions group questions by job role.</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body tech-stack-modal-body">
                    <div class="tech-stack-form-field">
                        <div class="tech-stack-label-row">
                            <label for="pos-name">Name <span class="required-mark">*</span></label>
                            <span class="tech-stack-counter"><span id="pos-name-count">0</span>/50</span>
                        </div>
                        <input class="form-control" id="pos-name" type="text" maxlength="50" placeholder="e.g. Backend" />
                    </div>
                    <div class="tech-stack-form-error" id="pos-modal-error"></div>
                </div>
                <div class="modal-footer tech-stack-modal-footer">
                    <button type="button" class="ts-button ts-button-ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="ts-button ts-button-primary" id="pos-modal-save">
                        <span class="material-symbols-outlined">add_circle</span><span class="button-label">Save</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const API_BASE = 'http://localhost:7000/api/admin/positions';
        const token = '@token';
        let currentPage = 1, pageSize = 10, totalPages = 1, searchTimer = null, editingId = null;
        const modal = new bootstrap.Modal(document.getElementById('pos-modal'));

        document.addEventListener("DOMContentLoaded", () => {
            document.getElementById('pos-status').addEventListener('change', () => { currentPage = 1; fetchList(); });
            document.getElementById('pos-search').addEventListener('input', () => { clearTimeout(searchTimer); searchTimer = setTimeout(() => { currentPage = 1; fetchList(); }, 300); });
            document.getElementById('pos-create').addEventListener('click', () => openModal(null));
            document.getElementById('pos-modal-save').addEventListener('click', saveModal);
            document.getElementById('pos-name').addEventListener('input', () => { document.getElementById('pos-name-count').innerText = document.getElementById('pos-name').value.length; });
            fetchList();
        });

        function escapeHtml(s) { return (s ?? '').toString().replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
        function fmtDate(s) { if (!s) return '—'; const d = new Date(s); return `<time>${d.toLocaleDateString('en-GB')}<br><span>${d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })}</span></time>`; }

        async function fetchList() {
            const tbody = document.getElementById('pos-table-body');
            const status = document.getElementById('pos-status').value;
            try {
                const q = new URLSearchParams({ pageIndex: currentPage, pageSize, status });
                const kw = document.getElementById('pos-search').value.trim(); if (kw) q.set('search', kw);
                const res = await fetch(`${API_BASE}?${q}`, { headers: { 'Authorization': `Bearer ${token}` } });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const json = await res.json();
                if (json.success) { renderTable(json.data.items || []); renderPagination(json.data); }
                else tbody.innerHTML = `<tr><td colspan="5" class="text-center" style="padding:40px; color:var(--ts-danger);">Failed: ${escapeHtml(json.message)}</td></tr>`;
            } catch (e) { tbody.innerHTML = `<tr><td colspan="5" class="text-center" style="padding:40px; color:var(--ts-danger);">Failed to load. Please sign in again or check ApiGateway (:7000).</td></tr>`; }
        }

        function renderTable(items) {
            const tbody = document.getElementById('pos-table-body');
            if (!items.length) { tbody.innerHTML = `<tr><td colspan="5" class="text-center" style="padding:48px; color:var(--ts-muted);">No positions found.</td></tr>`; return; }
            tbody.innerHTML = items.map(it => `
                <tr>
                    <td><span class="tech-stack-name">${escapeHtml(it.name)}</span></td>
                    <td class="tech-stack-status-column">${it.questionCount}</td>
                    <td>${fmtDate(it.createdAt)}</td>
                    <td class="tech-stack-status-column">
                        <span class="tech-stack-status ${it.isDeleted ? 'is-inactive' : 'is-active'}">
                            <span class="material-symbols-outlined">${it.isDeleted ? 'pause_circle' : 'check_circle'}</span>
                            ${it.isDeleted ? 'Deleted' : 'Active'}
                        </span>
                    </td>
                    <td class="tech-stack-actions-column">
                        <div class="tech-stack-actions">
                            ${it.isDeleted
                                ? `<button type="button" class="ts-button ts-button-small ts-button-success tech-stack-icon-action" title="Restore" onclick='restorePosition("${it.positionId}", "${escapeHtml(it.name)}")'><span class="material-symbols-outlined">restart_alt</span></button>`
                                : `<button type="button" class="ts-button ts-button-small ts-button-secondary tech-stack-icon-action" title="Edit" onclick='openModal(${JSON.stringify(it).replace(/'/g, "&#39;")})'><span class="material-symbols-outlined">edit</span></button>
                                   <button type="button" class="ts-button ts-button-small ts-button-danger tech-stack-icon-action" title="Delete" onclick='deletePosition("${it.positionId}", "${escapeHtml(it.name)}", ${it.questionCount})'><span class="material-symbols-outlined">block</span></button>`}
                        </div>
                    </td>
                </tr>`).join('');
        }

        function renderPagination(data) {
            totalPages = Math.max(1, data.totalPages || 1);
            if (currentPage > totalPages) currentPage = totalPages;
            document.getElementById('pos-count').innerText = `${data.totalRecords} result${data.totalRecords === 1 ? '' : 's'}`;
            document.getElementById('pos-page-count').innerText = data.totalRecords > 0 ? `Page ${currentPage} of ${totalPages}` : '';
            const nav = document.getElementById('pos-pages');
            if (totalPages <= 1) { nav.style.display = 'none'; nav.innerHTML = ''; return; }
            nav.style.display = 'flex';
            let html = `<a class="tech-stacks-page-link ${currentPage <= 1 ? 'disabled' : ''}" onclick="gotoPage(${currentPage - 1})">Previous</a>`;
            for (let p = 1; p <= totalPages; p++) html += `<a class="tech-stacks-page-link ${p === currentPage ? 'active' : ''}" onclick="gotoPage(${p})">${p}</a>`;
            html += `<a class="tech-stacks-page-link ${currentPage >= totalPages ? 'disabled' : ''}" onclick="gotoPage(${currentPage + 1})">Next</a>`;
            nav.innerHTML = html;
        }
        function gotoPage(p) { if (p < 1 || p > totalPages || p === currentPage) return; currentPage = p; fetchList(); }

        // ----- Create / Edit modal -----
        function openModal(item) {
            editingId = item ? item.positionId : null;
            document.getElementById('pos-modal-title').innerText = item ? 'Edit Position' : 'Create Position';
            document.getElementById('pos-name').value = item ? item.name : '';
            document.getElementById('pos-name-count').innerText = item ? item.name.length : 0;
            document.getElementById('pos-modal-error').innerText = '';
            modal.show();
            setTimeout(() => document.getElementById('pos-name').focus(), 200);
        }
        async function saveModal() {
            const name = document.getElementById('pos-name').value.trim();
            const err = document.getElementById('pos-modal-error');
            if (!name) { err.innerText = 'Name is required.'; return; }
            const opts = { headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ name }) };
            try {
                const res = editingId
                    ? await fetch(`${API_BASE}/${editingId}`, { ...opts, method: 'PUT' })
                    : await fetch(API_BASE, { ...opts, method: 'POST' });
                const json = await res.json().catch(() => null);
                if (res.ok && json && json.success) { modal.hide(); fetchList(); return; }
                if (res.status === 403) { err.innerText = 'Only Admin can manage positions.'; return; }
                err.innerText = (json && json.message) || `Request failed (HTTP ${res.status}).`;
            } catch (e) { err.innerText = 'Cannot reach ApiGateway (:7000).'; }
        }

        // ----- Soft delete / Restore -----
        function deletePosition(id, name, questionCount) {
            const warn = questionCount > 0 ? ` ${questionCount} question(s) currently use it — they keep showing this name.` : '';
            Swal.fire({ title: 'Delete position?', html: `Delete "<b>${escapeHtml(name)}</b>"?${warn} You can restore it later.`, icon: 'warning', showCancelButton: true, confirmButtonColor: '#dc2626', confirmButtonText: 'Delete', background: '#111827', color: '#e5e7eb' })
                .then(async r => { if (!r.isConfirmed) return;
                    try { const res = await fetch(`${API_BASE}/${id}`, { method: 'DELETE', headers: { 'Authorization': `Bearer ${token}` } });
                        if (res.status === 204) { fetchList(); return; }
                        if (res.status === 403) { Swal.fire({ text: 'Only Admin can delete positions.', icon: 'error', background: '#111827', color: '#e5e7eb' }); return; }
                        Swal.fire({ text: 'Delete failed.', icon: 'error', background: '#111827', color: '#e5e7eb' });
                    } catch (e) { Swal.fire({ text: 'Operation failed. Check ApiGateway (:7000).', icon: 'error', background: '#111827', color: '#e5e7eb' }); } });
        }
        function restorePosition(id, name) {
            Swal.fire({ title: 'Restore position?', html: `Restore "<b>${escapeHtml(name)}</b>"?`, icon: 'question', showCancelButton: true, confirmButtonColor: '#059669', confirmButtonText: 'Restore', background: '#111827', color: '#e5e7eb' })
                .then(async r => { if (!r.isConfirmed) return;
                    try { const res = await fetch(`${API_BASE}/${id}/restore`, { method: 'POST', headers: { 'Authorization': `Bearer ${token}` } });
                        const json = await res.json().catch(() => null);
                        if (res.ok && json && json.success) { fetchList(); return; }
                        if (res.status === 403) { Swal.fire({ text: 'Only Admin can restore positions.', icon: 'error', background: '#111827', color: '#e5e7eb' }); return; }
                        Swal.fire({ text: (json && json.message) || 'Restore failed.', icon: 'error', background: '#111827', color: '#e5e7eb' });
                    } catch (e) { Swal.fire({ text: 'Operation failed. Check ApiGateway (:7000).', icon: 'error', background: '#111827', color: '#e5e7eb' }); } });
        }
    </script>
</body>
</html>
