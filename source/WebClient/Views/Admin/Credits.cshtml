@{
    var token = Context.Request.Cookies["access_token"];
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Credit Adjust - DevPrep AI</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700;800;900&family=JetBrains+Mono:wght@@500&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@@100..700,0..1&display=swap" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#e2dfff", "on-primary": "#2c2a5e", "primary-container": "#c3c0ff",
                        "on-primary-container": "#4e4c83", "secondary": "#4cd7f6", "secondary-container": "#03b5d4",
                        "on-secondary-container": "#00424e", "tertiary": "#e9ddff", "tertiary-container": "#d0bcff",
                        "success": "#10B981", "warning": "#F9D949", "error": "#ffb4ab",
                        "surface": "#131317", "surface-container": "#201f23", "surface-container-low": "#1c1b1f",
                        "surface-container-high": "#2a292d", "surface-container-highest": "#353438",
                        "on-surface": "#e5e1e7", "on-surface-variant": "#c8c5d0",
                        "border-subtle": "rgba(255,255,255,0.08)", "background": "#0e1323", "outline": "#928f9a"
                    },
                    borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                    spacing: { "sm": "12px", "md": "16px", "lg": "24px", "xl": "32px", "gutter": "24px", "xs": "8px", "max-width": "1280px" },
                    fontFamily: { "display-lg": ["Inter"], "code-label": ["JetBrains Mono"], "headline-md": ["Inter"], "body-sm": ["Inter"], "body-md": ["Inter"] }
                }
            }
        }
    </script>
    <style>
        body { background-color: #0e1323; color: #e5e1e7; }
        .glass-card { background: rgba(32,31,35,0.4); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.08); border-top: 1px solid rgba(255,255,255,0.15); }
        .ad-sidebar h2, .ad-sidebar p, .ad-sidebar a { margin-bottom: 0; }
        .cr-main { margin-left: 250px; padding-top: 80px; padding-left: 24px; padding-right: 24px; min-height: 100vh; background: #0e1323; }
        .cr-input { background: #11121a !important; border: 1px solid #292c3d !important; border-radius: 10px; padding: 10px 12px; color: #ffffff !important; font-size: 14px; width: 100%; }
        .cr-input:focus { outline: none; border-color: #c3c0ff !important; }
    </style>
</head>
<body class="font-body-md overflow-x-hidden">
    @await Html.PartialAsync("_AdminTopbar")
    @await Html.PartialAsync("_AdminSidebar")

    <main class="cr-main">
        <div class="max-w-[640px] mx-auto">
            <div class="mb-6">
                <h1 class="font-display-lg text-[24px] font-bold text-primary tracking-tight">Credit Adjust</h1>
                <p class="text-on-surface-variant font-body-sm mt-1">Add or deduct credits for an account by email. Added credits appear in the user's Credit History as a <span class="text-success font-bold">Refund</span> entry; deductions appear as <span class="text-error font-bold">Usage</span>.</p>
            </div>

            <section class="glass-card rounded-2xl p-lg space-y-md">
                <div>
                    <label class="font-code-label text-[11px] uppercase text-on-surface-variant block mb-1" for="cr-email">Account Email <span class="text-error">*</span></label>
                    <input id="cr-email" class="cr-input" type="email" maxlength="256" placeholder="user@example.com" />
                </div>
                <div>
                    <label class="font-code-label text-[11px] uppercase text-on-surface-variant block mb-1" for="cr-amount">Amount <span class="text-error">*</span></label>
                    <input id="cr-amount" class="cr-input" type="number" min="1" max="1000000" placeholder="e.g. 10" />
                </div>
                <div>
                    <label class="font-code-label text-[11px] uppercase text-on-surface-variant block mb-1" for="cr-desc">Description (optional)</label>
                    <input id="cr-desc" class="cr-input" type="text" maxlength="255" placeholder="Reason for the adjustment..." />
                </div>
                <p id="cr-error" class="text-error font-body-sm hidden"></p>
                <p id="cr-success" class="text-success font-body-sm hidden"></p>
                <div class="flex gap-md pt-2">
                    <button id="cr-add" class="flex-1 px-lg py-sm rounded-xl bg-success/90 text-white font-bold hover:bg-success flex items-center justify-center gap-xs" type="button">
                        <span class="material-symbols-outlined text-[20px]">add_circle</span> Add Credit
                    </button>
                    <button id="cr-deduct" class="flex-1 px-lg py-sm rounded-xl border border-error text-error font-bold hover:bg-error/10 flex items-center justify-center gap-xs" type="button">
                        <span class="material-symbols-outlined text-[20px]">remove_circle</span> Deduct Credit
                    </button>
                </div>
            </section>
        </div>
    </main>

    <!-- Confirm modal -->
    <div id="confirm-modal" class="fixed inset-0 z-[80] hidden items-center justify-center bg-black/50 backdrop-blur-sm">
        <div class="glass-card rounded-2xl p-lg w-[380px]">
            <h3 class="font-headline-md text-primary mb-2">Confirm</h3>
            <p id="confirm-msg" class="text-on-surface-variant font-body-sm mb-lg">Are you sure?</p>
            <div class="flex justify-end gap-sm">
                <button id="confirm-cancel" class="px-lg py-sm rounded-xl border border-border-subtle text-on-surface hover:bg-surface-container-high" type="button">Cancel</button>
                <button id="confirm-ok" class="px-lg py-sm rounded-xl bg-primary-container text-on-primary-container font-bold hover:brightness-110" type="button">OK</button>
            </div>
        </div>
    </div>

    <script>
        const API_BASE = 'http://localhost:7000/api/payment/admin/credits';
        const token = '@token';
        let confirmCb = null;

        document.addEventListener("DOMContentLoaded", () => {
            document.getElementById('cr-add').addEventListener('click', () => submitAdjust('add'));
            document.getElementById('cr-deduct').addEventListener('click', () => submitAdjust('deduct'));
            document.getElementById('confirm-ok').addEventListener('click', () => { const cb = confirmCb; hideConfirm(); if (cb) cb(); });
            document.getElementById('confirm-cancel').addEventListener('click', hideConfirm);
        });

        function showConfirm(msg, cb) { document.getElementById('confirm-msg').innerText = msg; confirmCb = cb; const m = document.getElementById('confirm-modal'); m.classList.remove('hidden'); m.classList.add('flex'); }
        function hideConfirm() { const m = document.getElementById('confirm-modal'); m.classList.add('hidden'); m.classList.remove('flex'); confirmCb = null; }
        function showError(msg) { const e = document.getElementById('cr-error'); e.innerText = msg; e.classList.remove('hidden'); document.getElementById('cr-success').classList.add('hidden'); }
        function showSuccess(msg) { const s = document.getElementById('cr-success'); s.innerText = msg; s.classList.remove('hidden'); document.getElementById('cr-error').classList.add('hidden'); }

        function submitAdjust(kind) {
            const email = document.getElementById('cr-email').value.trim();
            const amount = parseInt(document.getElementById('cr-amount').value, 10);
            const description = document.getElementById('cr-desc').value.trim();
            if (!email) { showError('Email is required.'); return; }
            if (!amount || amount < 1) { showError('Amount must be a positive number.'); return; }

            const verb = kind === 'add' ? 'Add' : 'Deduct';
            showConfirm(`${verb} ${amount.toLocaleString('en-US')} credit(s) ${kind === 'add' ? 'to' : 'from'} "${email}"?`, async () => {
                try {
                    const res = await fetch(`${API_BASE}/${kind}`, {
                        method: 'POST',
                        headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email, amount, description: description || null })
                    });
                    const json = await res.json().catch(() => null);
                    if (res.ok && json && json.success) {
                        showSuccess(`Done. ${json.email} now has ${Number(json.balanceAfter).toLocaleString('en-US')} credit(s).`);
                        document.getElementById('cr-amount').value = '';
                        document.getElementById('cr-desc').value = '';
                        return;
                    }
                    showError((json && json.message) || `Request failed (HTTP ${res.status}).`);
                } catch (e) { showError('Cannot reach ApiGateway (:7000).'); }
            });
        }
    </script>
</body>
</html>
