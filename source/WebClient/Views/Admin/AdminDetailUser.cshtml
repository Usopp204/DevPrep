@model WebClient.Models.Admin.AdminUserDetailDto

@{
    Layout = null;
    ViewData["Title"] = "User Detail";

    var displayName = string.IsNullOrWhiteSpace(Model.FullName) ? "Unknown User" : Model.FullName;
    var email = string.IsNullOrWhiteSpace(Model.Email) ? "No email" : Model.Email;
    var status = Model.Status ?? "Unknown";
    var role = Model.Role ?? "User";
    var isBlocked = string.Equals(status, "Blocked", StringComparison.OrdinalIgnoreCase);
    var initial = displayName.Substring(0, 1).ToUpperInvariant();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - DevPrep AI Admin Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@100..900&family=JetBrains+Mono:wght@@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    <style>
        body {
            background: #0f1424;
            color: #fff;
            font-family: 'Inter', sans-serif;
        }

        .admin-main-wrapper {
            margin-left: 260px;
            padding-top: 78px;
            min-height: 100vh;
            background: #0f1424;
        }

        .admin-content {
            padding: 28px;
        }

        .card-dark {
            background: #111827;
            border: 1px solid #252b3d;
            border-radius: 14px;
            padding: 20px;
        }

        .page-title {
            font-size: 30px;
            font-weight: 800;
            margin-bottom: 4px;
        }

        .page-subtitle {
            color: #93c5fd;
            font-size: 14px;
        }

        .avatar-box {
            width: 82px;
            height: 82px;
            border-radius: 18px;
            background: #1e293b;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 34px;
            font-weight: 800;
            color: #93c5fd;
            overflow: hidden;
        }

            .avatar-box img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .admin-main-wrapper .label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            color: #93c5fd;
            text-transform: uppercase;
            letter-spacing: .08em;
            margin-bottom: 4px;
        }

        .value {
            font-weight: 700;
            color: #ffffff;
            word-break: break-word;
        }

        .muted-text {
            color: #9ca3af;
        }

        .badge-soft {
            display: inline-flex;
            padding: 6px 10px;
            border-radius: 8px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .badge-active {
            background: rgba(16,185,129,.14);
            color: #34d399;
        }

        .badge-blocked {
            background: rgba(239,68,68,.15);
            color: #f87171;
        }

        .badge-pending {
            background: rgba(245,158,11,.16);
            color: #fbbf24;
        }

        .badge-role {
            background: rgba(99,102,241,.16);
            color: #c4b5fd;
        }

        .stat-card {
            background: #151f36;
            border: 1px solid #27324d;
            border-radius: 12px;
            padding: 16px;
        }

        .stat-value {
            font-size: 24px;
            font-weight: 900;
        }

        .table-dark-custom {
            --bs-table-bg: #111827;
            --bs-table-color: #dbeafe;
            --bs-table-border-color: #242b3e;
            margin: 0;
        }

            .table-dark-custom thead th {
                background: #171a24 !important;
                color: #a9c7f5 !important;
                font-family: 'JetBrains Mono', monospace;
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: .08em;
                padding: 14px;
            }

            .table-dark-custom tbody td {
                background: #111827 !important;
                color: #dbeafe !important;
                padding: 14px;
                border-bottom: 1px solid #242b3e;
            }

        .btn-main {
            background: #6366f1;
            color: #fff;
            border: none;
            border-radius: 9px;
            padding: 10px 14px;
            font-weight: 800;
            text-decoration: none;
        }

            .btn-main:hover {
                background: #4f46e5;
                color: #fff;
            }

        .btn-outline-soft {
            background: transparent;
            color: #cbd5e1;
            border: 1px solid #30384e;
            border-radius: 9px;
            padding: 10px 14px;
            text-decoration: none;
            font-weight: 800;
        }

            .btn-outline-soft:hover {
                background: rgba(255,255,255,.06);
                color: #fff;
            }
    </style>
</head>

<body class="admin-page">
    @await Html.PartialAsync("_AdminTopbar")
    @await Html.PartialAsync("_AdminSidebar")

    <main class="admin-main-wrapper">
        <div class="admin-content">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                <div>
                    <h1 class="page-title">User Detail</h1>
                    <p class="page-subtitle">Full account profile, credit balance and interview session history.</p>
                </div>

                <div class="d-flex gap-2">
                    <a href="/Admin/User" class="btn-outline-soft">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back
                    </a>

                    <a href="/Admin/User/Edit/@Model.UserId" class="btn-main">
                        <i class="fa-regular fa-pen-to-square me-1"></i> Edit Role
                    </a>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            <div class="row g-4">
                <div class="col-12 col-xl-4">
                    <div class="card-dark h-100">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="avatar-box">
                                @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                                {
                                    <img src="@Model.AvatarUrl" alt="Avatar" />
                                }
                                else
                                {
                                    @initial
                                }
                            </div>

                            <div>
                                <h3 class="mb-1 fw-bold">@displayName</h3>
                                <div class="muted-text">@email</div>
                                <div class="mt-2 d-flex gap-2">
                                    <span class="badge-soft badge-role">@role</span>

                                    @if (isBlocked)
                                    {
                                        <span class="badge-soft badge-blocked">Blocked</span>
                                    }
                                    else if (string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge-soft badge-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-soft badge-pending">@status</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12">
                                <div class="label">Account ID</div>
                                <div class="value">@Model.AccountId</div>
                            </div>

                            <div class="col-12">
                                <div class="label">User ID</div>
                                <div class="value">@Model.UserId</div>
                            </div>

                            <div class="col-6">
                                <div class="label">Email Verified</div>
                                <div class="value">@(Model.IsEmailVerified ? "Yes" : "No")</div>
                            </div>

                            <div class="col-6">
                                <div class="label">Face Verified</div>
                                <div class="value">@(Model.IsFaceVerified ? "Yes" : "No")</div>
                            </div>

                            <div class="col-6">
                                <div class="label">Voice Verified</div>
                                <div class="value">@(Model.IsVoiceVerified ? "Yes" : "No")</div>
                            </div>

                            

                            <div class="col-12">
                                <div class="label">Created At</div>
                                <div class="value">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>

                            <div class="col-12">
                                <div class="label">Updated At</div>
                                <div class="value">@(Model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</div>
                            </div>

                            <div class="col-12">
                                <div class="label">Last Login</div>
                                <div class="value">@(Model.LastLoginAt?.ToString("dd/MM/yyyy HH:mm") ?? "Never")</div>
                            </div>

                            @if (isBlocked)
                            {
                                <div class="col-12">
                                    <div class="label">Blocked Reason</div>
                                    <div class="value text-danger">@(Model.BlockedReason ?? "N/A")</div>
                                </div>

                                <div class="col-12">
                                    <div class="label">Blocked At</div>
                                    <div class="value">@(Model.BlockedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-8">
                    <div class="row g-3 mb-4">
                        @* <div class="col-12 col-md-6"> *@
                        @*     <div class="stat-card"> *@
                        @*         <div class="label">Current Credit Balance</div> *@
                        @*         <div class="stat-value">@Model.CurrentCreditBalance.ToString("N0")</div> *@
                        @*     </div> *@
                        @* </div> *@

                        <div class="col-12 col-md-6">
                            <div class="stat-card">
                                <div class="label">Total Sessions</div>
                                <div class="stat-value">@Model.Sessions.Count</div>
                            </div>
                        </div>
                    </div>

                    <div class="card-dark">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold mb-0">Session History</h5>
                            <span class="muted-text">@Model.Sessions.Count sessions</span>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-dark-custom align-middle">
                                <thead>
                                    <tr>
                                        <th>Position</th>
                                        <th>Level</th>
                                        <th>Status</th>
                                        <th>Started</th>
                                        <th>Questions</th>
                                        <th>Credit</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Sessions.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-5 text-secondary">
                                                No interview sessions found.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var s in Model.Sessions)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-bold text-white">@(s.Title ?? "Untitled Session")</div>
                                                    <div class="muted-text small">
                                                        Duration: @(s.DurationMinutes?.ToString() ?? "N/A") min
                                                    </div>
                                                </td>
                                                <td>@(s.Level ?? "N/A")</td>
                                                <td>@(s.Status ?? "N/A")</td>
                                                <td>@(s.StartedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                                <td>@s.AnsweredQuestions / @s.TotalQuestions</td>
                                                <td>@s.CreditCost</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>