@model WebClient.Models.Admin.AdminQuestionViewModel

@{
    Layout = null;
    ViewData["Title"] = "Question Repository";

    var query = ViewBag.CurrentQuery as WebClient.Models.Admin.AdminQuestionQueryDto
        ?? new WebClient.Models.Admin.AdminQuestionQueryDto();

    var pageIndex = Model.PagedResult.PageIndex > 0 ? Model.PagedResult.PageIndex : query.PageIndex;
    if (pageIndex <= 0)
    {
        pageIndex = 1;
    }

    var pageSize = Model.PagedResult.PageSize > 0 ? Model.PagedResult.PageSize : query.PageSize;
    if (pageSize <= 0)
    {
        pageSize = 10;
    }

    var totalRecords = Model.PagedResult.TotalRecords;
    var totalPages = Model.PagedResult.TotalPages > 0
        ? Model.PagedResult.TotalPages
        : (int)Math.Ceiling((double)totalRecords / pageSize);

    if (totalPages <= 0)
    {
        totalPages = 1;
    }

    var startItem = totalRecords == 0 ? 0 : ((pageIndex - 1) * pageSize) + 1;
    var endItem = Math.Min(pageIndex * pageSize, totalRecords);

    string BuildPageUrl(int page)
    {
        var values = new Dictionary<string, string?>
                {
                    ["Keyword"] = query.Keyword,
                    ["QuestionType"] = query.QuestionType,
                    ["Level"] = query.Level,
                    ["Difficulty"] = query.Difficulty,
                    ["TechStack"] = query.TechStack,
                    ["CategoryId"] = query.CategoryId?.ToString(),
                    ["Status"] = query.Status,
                    ["PageIndex"] = page.ToString(),
                    ["PageSize"] = pageSize.ToString()
                };

        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/admin/questions", values);
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - DevPrep AI Admin Dashboard</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@100..900&family=JetBrains+Mono:wght@@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    <style>
        :root {
            --bg-main: #0f1424;
            --bg-panel: #111827;
            --bg-panel-2: #151f36;
            --bg-head: #171a24;
            --border-main: #252b3d;
            --text-main: #ffffff;
            --text-muted: #9ca3af;
            --text-blue: #93c5fd;
            --primary: #6366f1;
            --danger: #ff5d7a;
            --success: #10b981;
            --warning: #f59e0b;
        }

        body {
            background: var(--bg-main);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
        }

        .admin-main-wrapper {
            margin-left: 260px;
            padding-top: 78px;
            min-height: 100vh;
            background: var(--bg-main);
        }

        .admin-content {
            padding: 28px 28px 60px;
        }

        .page-title {
            font-size: 30px;
            font-weight: 800;
            letter-spacing: -0.04em;
            margin-bottom: 4px;
        }

        .page-subtitle {
            color: var(--text-blue);
            font-size: 14px;
            margin-bottom: 0;
        }

        .btn-add {
            background: var(--primary);
            color: #ffffff;
            border: none;
            border-radius: 9px;
            padding: 10px 16px;
            font-weight: 800;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .btn-add:hover {
                background: #4f46e5;
                color: #ffffff;
            }

        .btn-bulk-delete {
            display: none;
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
            border: 1px solid rgba(239, 68, 68, 0.45);
            border-radius: 9px;
            padding: 10px 16px;
            font-weight: 800;
        }

            .btn-bulk-delete:hover {
                background: #ef4444;
                color: #ffffff;
            }

        .filter-card {
            border: 1px solid var(--border-main);
            background: rgba(17, 24, 39, 0.95);
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 18px;
        }

        .filter-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 800;
            color: var(--text-blue);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 7px;
        }

        .admin-input,
        .admin-select {
            height: 42px;
            border-radius: 7px;
            border: 1px solid #30384e;
            background: #0f1322;
            color: #ffffff;
            font-size: 14px;
            box-shadow: none !important;
        }

            .admin-input:focus,
            .admin-select:focus {
                border-color: var(--primary);
                background: #0f1322;
                color: #ffffff;
            }

            .admin-input::placeholder {
                color: #64748b;
            }

        .btn-filter {
            height: 42px;
            width: 100%;
            border: none;
            border-radius: 7px;
            background: #35304f;
            color: #ffffff;
            font-weight: 800;
        }

            .btn-filter:hover {
                background: #4f46e5;
                color: #ffffff;
            }

        .btn-clear {
            height: 42px;
            width: 100%;
            border-radius: 7px;
            border: 1px solid #30384e;
            background: transparent;
            color: #cbd5e1;
            font-weight: 700;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .btn-clear:hover {
                background: rgba(255, 255, 255, 0.06);
                color: #ffffff;
            }

        .table-shell {
            border: 1px solid var(--border-main);
            background: var(--bg-panel);
            border-radius: 12px;
            overflow: hidden;
        }

        .admin-table {
            width: 100%;
            margin: 0;
            color: #dbeafe;
            --bs-table-bg: #111827;
            --bs-table-color: #dbeafe;
            --bs-table-border-color: #242b3e;
            --bs-table-hover-bg: #151f36;
            --bs-table-hover-color: #ffffff;
        }

            .admin-table thead th {
                background: #171a24 !important;
                color: #a9c7f5 !important;
                font-family: 'JetBrains Mono', monospace;
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                border-bottom: 1px solid var(--border-main);
                padding: 15px 14px;
                white-space: nowrap;
            }

            .admin-table tbody tr {
                background: #111827 !important;
            }

            .admin-table tbody td {
                background: #111827 !important;
                color: #dbeafe !important;
                border-bottom: 1px solid #242b3e;
                padding: 16px 14px;
                vertical-align: middle;
                font-size: 14px;
            }

            .admin-table tbody tr:hover td {
                background: #151f36 !important;
            }

        .question-title {
            color: #ffffff;
            font-weight: 800;
            max-width: 560px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .question-meta {
            color: var(--text-muted);
            font-size: 12px;
            margin-top: 5px;
        }

        .deleted-row {
            opacity: 0.68;
        }

            .deleted-row .question-title {
                color: #94a3b8;
                text-decoration: line-through;
            }

        .form-check-input-custom {
            background-color: #1b1c26 !important;
            border: 1px solid #475569 !important;
            width: 17px;
            height: 17px;
            cursor: pointer;
        }

            .form-check-input-custom:checked {
                background-color: #6366f1 !important;
                border-color: #6366f1 !important;
            }

        .pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 7px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .pill-type {
            background: rgba(14, 165, 233, 0.16);
            color: #7dd3fc;
        }

        .pill-level {
            background: rgba(99, 102, 241, 0.16);
            color: #c4b5fd;
        }

        .pill-easy {
            background: rgba(16, 185, 129, 0.14);
            color: #34d399;
        }

        .pill-medium {
            background: rgba(245, 158, 11, 0.16);
            color: #fbbf24;
        }

        .pill-hard {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
        }

        .pill-tech {
            background: rgba(148, 163, 184, 0.14);
            color: #cbd5e1;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 7px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .status-active {
            background: rgba(16, 185, 129, 0.14);
            color: #34d399;
        }

        .status-draft {
            background: rgba(148, 163, 184, 0.14);
            color: #cbd5e1;
        }

        .status-archived,
        .status-deleted {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
        }

        .action-btn {
            width: 34px;
            height: 34px;
            border: none;
            background: transparent;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            transition: 0.15s ease;
            text-decoration: none;
        }

            .action-btn:hover {
                background: rgba(255, 255, 255, 0.08);
            }

        .action-view {
            color: #93c5fd;
        }

        .action-edit {
            color: #a78bfa;
        }

        .action-delete {
            color: #fb7185;
        }

        .action-restore {
            color: #10b981;
        }

        .empty-row {
            height: 140px;
            color: #cbd5e1;
            text-align: center;
            font-weight: 600;
        }

        .table-footer {
            padding: 14px 16px;
            color: #cbd5e1;
            font-size: 13px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            border-top: 1px solid #242b3e;
            background: #111827;
        }

        .pager {
            display: flex;
            gap: 8px;
            align-items: center;
        }

            .pager a,
            .pager span {
                min-width: 34px;
                height: 34px;
                border-radius: 7px;
                border: 1px solid #30384e;
                color: #cbd5e1;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                font-weight: 700;
            }

            .pager .active-page {
                background: var(--primary);
                border-color: var(--primary);
                color: #ffffff;
            }

        .error-box {
            border: 1px solid rgba(239, 68, 68, 0.45);
            background: rgba(239, 68, 68, 0.08);
            color: #fecaca;
            border-radius: 10px;
            padding: 13px 16px;
            margin-bottom: 18px;
            font-weight: 700;
        }

        @@media (max-width: 991.98px) {
            .admin-main-wrapper {
                margin-left: 0;
                padding-top: 70px;
            }

            .admin-content {
                padding: 20px 14px 50px;
            }

            .table-footer {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>

<body class="admin-page">
    @await Html.PartialAsync("_AdminTopbar")
    @await Html.PartialAsync("_AdminSidebar")

    <main class="admin-main-wrapper">
        <div class="admin-content">
            <div class="d-flex align-items-start justify-content-between gap-3 mb-4">
                <div>
                    <h1 class="page-title">Question Repository</h1>
                    <p class="page-subtitle">Manage interview questions, categories, difficulty levels and publishing status.</p>
                </div>

                <div class="d-flex gap-2">
                    <button type="button" id="btnBulkDelete" class="btn-bulk-delete">
                        <i class="fa-solid fa-trash-can me-2"></i>
                        Delete Selected (<span id="selectedCount">0</span>)
                    </button>

                    <a href="/admin/questions/create" class="btn-add">
                        <i class="fa-solid fa-plus"></i>
                        New Question
                    </a>
                </div>
            </div>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="error-box">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>
                    @ViewBag.ErrorMessage
                </div>
            }

            <form method="get" action="/admin/questions" id="adminFilterForm" class="filter-card">
                <input type="hidden" name="PageIndex" id="pageIdxInput" value="@pageIndex" />

                <div class="row g-3 align-items-end">
                    <div class="col-12 col-xl-4">
                        <div class="filter-label">Search</div>
                        <input class="form-control admin-input"
                               type="text"
                               name="Keyword"
                               value="@query.Keyword"
                               placeholder="Search questions by text, tags or tech stack..."
                               onkeypress="if(event.key === 'Enter') { event.preventDefault(); submitWithResetPage(); }" />
                    </div>

                    <div class="col-12 col-sm-6 col-xl-2">
                        <div class="filter-label">Category</div>
                        <select class="form-select admin-select" name="CategoryId">
                            <option value="">All Categories</option>
                            @if (Model.Categories != null)
                            {
                                foreach (var category in Model.Categories)
                                {
                                    <option value="@category.CategoryId"
                                            selected="@(query.CategoryId.HasValue && query.CategoryId.Value == category.CategoryId)">
                                        @category.Name
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-2">
                        <div class="filter-label">Type</div>
                        <select class="form-select admin-select" name="QuestionType">
                            <option value="">All Types</option>
                            <option value="Theory" selected="@(string.Equals(query.QuestionType, "Theory", StringComparison.OrdinalIgnoreCase))">Theory</option>
                            <option value="Coding" selected="@(string.Equals(query.QuestionType, "Coding", StringComparison.OrdinalIgnoreCase))">Coding</option>
                            <option value="Situational" selected="@(string.Equals(query.QuestionType, "Situational", StringComparison.OrdinalIgnoreCase))">Situational</option>
                            <option value="Behavioral" selected="@(string.Equals(query.QuestionType, "Behavioral", StringComparison.OrdinalIgnoreCase))">Behavioral</option>
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-2">
                        <div class="filter-label">Level</div>
                        <select class="form-select admin-select" name="Level">
                            <option value="">All Levels</option>
                            <option value="Intern" selected="@(string.Equals(query.Level, "Intern", StringComparison.OrdinalIgnoreCase))">Intern</option>
                            <option value="Junior" selected="@(string.Equals(query.Level, "Junior", StringComparison.OrdinalIgnoreCase))">Junior</option>
                            <option value="Middle" selected="@(string.Equals(query.Level, "Middle", StringComparison.OrdinalIgnoreCase))">Middle</option>
                            <option value="Senior" selected="@(string.Equals(query.Level, "Senior", StringComparison.OrdinalIgnoreCase))">Senior</option>
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-2">
                        <div class="filter-label">Difficulty</div>
                        <select class="form-select admin-select" name="Difficulty">
                            <option value="">All Difficulty</option>
                            <option value="Easy" selected="@(string.Equals(query.Difficulty, "Easy", StringComparison.OrdinalIgnoreCase))">Easy</option>
                            <option value="Medium" selected="@(string.Equals(query.Difficulty, "Medium", StringComparison.OrdinalIgnoreCase))">Medium</option>
                            <option value="Hard" selected="@(string.Equals(query.Difficulty, "Hard", StringComparison.OrdinalIgnoreCase))">Hard</option>
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-2">
                        <div class="filter-label">Status</div>
                        <select class="form-select admin-select" name="Status">
                            <option value="">All Statuses</option>
                            <option value="Active" selected="@(string.Equals(query.Status, "Active", StringComparison.OrdinalIgnoreCase))">Active</option>
                            <option value="Draft" selected="@(string.Equals(query.Status, "Draft", StringComparison.OrdinalIgnoreCase))">Draft</option>
                            <option value="Archived" selected="@(string.Equals(query.Status, "Archived", StringComparison.OrdinalIgnoreCase))">Archived</option>
                            <option value="Deleted" selected="@(string.Equals(query.Status, "Deleted", StringComparison.OrdinalIgnoreCase))">Deleted</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6 col-xl-2">
                        <button class="btn-filter" type="submit">Apply Filter</button>
                    </div>

                    <div class="col-12 col-md-6 col-xl-2">
                        <a class="btn-clear" href="/admin/questions">Clear</a>
                    </div>
                </div>
            </form>

            <div class="table-shell">
                <div class="table-responsive">
                    <table class="table admin-table align-middle">
                        <thead>
                            <tr>
                                <th style="width: 4%; text-align: center;">
                                    <input class="form-check-input form-check-input-custom" type="checkbox" id="selectAllCheckbox">
                                </th>
                                <th style="width: 34%;">Question</th>
                                <th style="width: 10%;">Type</th>
                                <th style="width: 10%;">Level</th>
                                <th style="width: 12%;">Difficulty</th>
                                <th style="width: 12%;">Tech Stack</th>
                                <th style="width: 10%;">Status</th>
                                <th style="width: 8%;" class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.PagedResult.Items != null && Model.PagedResult.Items.Any())
                            {
                                foreach (var item in Model.PagedResult.Items)
                                {
                                    var isSoftDeleted = item.IsDeleted;

                                    var diffClass = (item.Difficulty ?? "").ToLowerInvariant() switch
                                    {
                                        "hard" => "pill-hard",
                                        "medium" => "pill-medium",
                                        _ => "pill-easy"
                                    };

                                    var statusText = isSoftDeleted ? "Deleted" : (item.Status ?? "Unknown");

                                    var statusClass = statusText.ToLowerInvariant() switch
                                    {
                                        "active" => "status-active",
                                        "draft" => "status-draft",
                                        "deleted" => "status-deleted",
                                        "archived" => "status-archived",
                                        "inactive" => "status-archived",
                                        _ => "status-draft"
                                    };

                                    <tr id="row-@item.QuestionId" class="@(isSoftDeleted ? "deleted-row" : "")">
                                        <td class="text-center">
                                            @if (!isSoftDeleted)
                                            {
                                                <input class="form-check-input form-check-input-custom question-checkbox"
                                                       type="checkbox"
                                                       value="@item.QuestionId">
                                            }
                                        </td>

                                        <td>
                                            <a href="/admin/questions/detail/@item.QuestionId"
                                               class="question-title text-decoration-none d-block"
                                               title="@item.Content">
                                                @item.Content
                                            </a>

                                            <div class="question-meta">
                                                ID: @(item.QuestionId.ToString().Length > 8 ? "Q-" + item.QuestionId.ToString().Substring(0, 8).ToUpper() : item.QuestionId.ToString())
                                            </div>
                                        </td>

                                        <td>
                                            <span class="pill pill-type">@(item.QuestionType ?? "N/A")</span>
                                        </td>

                                        <td>
                                            <span class="pill pill-level">@(item.Level ?? "N/A")</span>
                                        </td>

                                        <td>
                                            <span class="pill @diffClass">@(item.Difficulty ?? "N/A")</span>
                                        </td>

                                        <td>
                                            <span class="pill pill-tech">
                                                @(string.IsNullOrWhiteSpace(item.TechStack) ? "N/A" : item.TechStack)
                                            </span>
                                        </td>

                                        <td>
                                            <span class="status-badge @statusClass">
                                                <span style="font-size: 8px;">●</span>
                                                @statusText
                                            </span>
                                        </td>

                                        <td class="text-end">
                                            <a href="/admin/questions/detail/@item.QuestionId"
                                               class="action-btn action-view"
                                               title="View detail">
                                                <i class="fa-regular fa-eye"></i>
                                            </a>

                                            @if (!item.IsDeleted)
                                            {
                                                <a href="/admin/questions/edit/@item.QuestionId"
                                                   class="action-btn action-edit"
                                                   title="Edit question">
                                                    <i class="fa-regular fa-pen-to-square"></i>
                                                </a>
                                            }

                                            @if (item.IsDeleted)
                                            {
                                                <button type="button"
                                                        onclick="restoreQuestion('@item.QuestionId')"
                                                        class="action-btn action-restore"
                                                        title="Restore question">
                                                    <i class="fa-solid fa-trash-arrow-up"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        onclick="deleteQuestion('@item.QuestionId')"
                                                        class="action-btn action-delete"
                                                        title="Delete question">
                                                    <i class="fa-regular fa-trash-can"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="empty-row">
                                        <i class="fa-regular fa-folder-open d-block mb-2" style="font-size: 28px;"></i>
                                        No questions match your criteria.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="table-footer">
                    <div>
                        Showing <strong>@startItem</strong>-<strong>@endItem</strong> of <strong>@totalRecords</strong> questions
                    </div>

                    @if (totalPages > 1)
                    {
                        var prevPage = pageIndex <= 1 ? 1 : pageIndex - 1;
                        var nextPage = pageIndex >= totalPages ? totalPages : pageIndex + 1;

                        <div class="pager">
                            <a href="@BuildPageUrl(prevPage)">
                                <i class="fa-solid fa-chevron-left"></i>
                            </a>

                            @for (var i = 1; i <= totalPages; i++)
                            {
                                if (i == pageIndex)
                                {
                                    <span class="active-page">@i</span>
                                }
                                else
                                {
                                    <a href="@BuildPageUrl(i)">@i</a>
                                }
                            }

                            <a href="@BuildPageUrl(nextPage)">
                                <i class="fa-solid fa-chevron-right"></i>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function submitWithResetPage() {
            document.getElementById('pageIdxInput').value = 1;
            document.getElementById('adminFilterForm').submit();
        }

        $(document).ready(function () {
            $('#selectAllCheckbox').on('change', function () {
                $('.question-checkbox').prop('checked', this.checked);
                toggleBulkDeleteButton();
            });

            $(document).on('change', '.question-checkbox', function () {
                if (!this.checked) {
                    $('#selectAllCheckbox').prop('checked', false);
                } else if ($('.question-checkbox:checked').length === $('.question-checkbox').length) {
                    $('#selectAllCheckbox').prop('checked', true);
                }

                toggleBulkDeleteButton();
            });

            function toggleBulkDeleteButton() {
                var selectedChecked = $('.question-checkbox:checked').length;
                $('#selectedCount').text(selectedChecked);

                if (selectedChecked > 0) {
                    $('#btnBulkDelete').fadeIn(160);
                } else {
                    $('#btnBulkDelete').fadeOut(160);
                }
            }

            $('#btnBulkDelete').on('click', function () {
                var selectedIds = [];

                $('.question-checkbox:checked').each(function () {
                    selectedIds.push($(this).val());
                });

                if (selectedIds.length === 0) return;

                Swal.fire({
                    title: 'Delete selected questions?',
                    text: `You are about to delete ${selectedIds.length} selected questions.`,
                    icon: 'warning',
                    showCancelButton: true,
                    background: '#111827',
                    color: '#ffffff',
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#475569',
                    confirmButtonText: 'Delete Selected'
                }).then((result) => {
                    if (!result.isConfirmed) return;

                    $.ajax({
                        url: '/admin/questions/bulk-delete',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(selectedIds),
                        success: function (response) {
                            Swal.fire({
                                title: 'Deleted!',
                                text: response.message || 'Selected questions have been deleted.',
                                icon: 'success',
                                background: '#111827',
                                color: '#ffffff',
                                confirmButtonColor: '#6366f1'
                            }).then(() => {
                                location.reload();
                            });
                        },
                        error: function (xhr) {
                            var errMsg = xhr.responseJSON ? xhr.responseJSON.message : "An error occurred during mass deletion.";

                            Swal.fire({
                                title: 'Error!',
                                text: errMsg,
                                icon: 'error',
                                background: '#111827',
                                color: '#ffffff',
                                confirmButtonColor: '#6366f1'
                            });
                        }
                    });
                });
            });
        });

        function deleteQuestion(id) {
            Swal.fire({
                title: 'Delete this question?',
                text: 'This action will soft-delete the selected question.',
                icon: 'warning',
                showCancelButton: true,
                background: '#111827',
                color: '#ffffff',
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#475569',
                confirmButtonText: 'Delete'
            }).then((result) => {
                if (!result.isConfirmed) return;

                $.ajax({
                    url: '/admin/questions/delete/' + id,
                    type: 'POST',
                    success: function (response) {
                        Swal.fire({
                            title: 'Deleted!',
                            text: response.message || 'The question has been deleted.',
                            icon: 'success',
                            background: '#111827',
                            color: '#ffffff',
                            confirmButtonColor: '#6366f1'
                        }).then(() => {
                            location.reload();
                        });
                    },
                    error: function (xhr) {
                        var errMsg = xhr.responseJSON ? xhr.responseJSON.message : "Could not delete this question.";

                        Swal.fire({
                            title: 'Error!',
                            text: errMsg,
                            icon: 'error',
                            background: '#111827',
                            color: '#ffffff',
                            confirmButtonColor: '#6366f1'
                        });
                    }
                });
            });
        }

        function restoreQuestion(id) {
            Swal.fire({
                title: 'Restore this question?',
                text: 'This question will become available again.',
                icon: 'question',
                showCancelButton: true,
                background: '#111827',
                color: '#ffffff',
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#475569',
                confirmButtonText: 'Restore'
            }).then((result) => {
                if (!result.isConfirmed) return;

                $.ajax({
                    url: '/admin/questions/restore/' + id,
                    type: 'POST',
                    success: function (response) {
                        Swal.fire({
                            title: 'Restored!',
                            text: response.message || 'The question has been restored.',
                            icon: 'success',
                            background: '#111827',
                            color: '#ffffff',
                            confirmButtonColor: '#10b981'
                        }).then(() => {
                            location.reload();
                        });
                    },
                    error: function (xhr) {
                        var errMsg = xhr.responseJSON ? xhr.responseJSON.message : "Could not restore this question.";

                        Swal.fire({
                            title: 'Error!',
                            text: errMsg,
                            icon: 'error',
                            background: '#111827',
                            color: '#ffffff',
                            confirmButtonColor: '#6366f1'
                        });
                    }
                });
            });
        }
    </script>
</body>
</html>