@{
    var token = Context.Request.Cookies["access_token"];
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Announcements - DevPrep AI</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700;800;900&family=JetBrains+Mono:wght@@500&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@@100..700,0..1&display=swap" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#e2dfff", "on-primary": "#2c2a5e", "primary-container": "#c3c0ff",
                        "on-primary-container": "#4e4c83", "secondary": "#4cd7f6", "secondary-container": "#03b5d4",
                        "on-secondary-container": "#00424e", "tertiary": "#e9ddff", "tertiary-container": "#d0bcff",
                        "success": "#10B981", "warning": "#F9D949", "error": "#ffb4ab",
                        "surface": "#131317", "surface-container": "#201f23", "surface-container-low": "#1c1b1f",
                        "surface-container-high": "#2a292d", "surface-container-highest": "#353438",
                        "on-surface": "#e5e1e7", "on-surface-variant": "#c8c5d0",
                        "border-subtle": "rgba(255,255,255,0.08)", "background": "#0e1323", "outline": "#928f9a"
                    },
                    borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                    spacing: { "sm": "12px", "md": "16px", "lg": "24px", "xl": "32px", "gutter": "24px", "xs": "8px", "max-width": "1280px" },
                    fontFamily: { "display-lg": ["Inter"], "code-label": ["JetBrains Mono"], "headline-md": ["Inter"], "body-sm": ["Inter"], "body-md": ["Inter"] }
                }
            }
        }
    </script>
    <style>
        body { background-color: #0e1323; color: #e5e1e7; }
        .glass-card { background: rgba(32,31,35,0.4); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.08); border-top: 1px solid rgba(255,255,255,0.15); }
        .ad-sidebar h2, .ad-sidebar p, .ad-sidebar a { margin-bottom: 0; }
        .an-main { margin-left: 250px; padding-top: 80px; padding-left: 24px; padding-right: 24px; min-height: 100vh; background: #0e1323; }
        .an-input { background: #11121a !important; border: 1px solid #292c3d !important; border-radius: 10px; padding: 8px 12px; color: #ffffff !important; font-size: 13px; width: 100%; }
        .an-input:focus { outline: none; border-color: #c3c0ff !important; }
    </style>
</head>
<body class="font-body-md overflow-x-hidden">
    @await Html.PartialAsync("_AdminTopbar")
    @await Html.PartialAsync("_AdminSidebar")

    <main class="an-main">
        <div class="mb-6 flex items-center justify-between">
            <h1 class="font-display-lg text-[24px] font-bold text-primary tracking-tight">Announcements</h1>
            <button id="an-create" type="button" class="px-lg py-2 rounded-xl bg-primary-container text-on-primary-container font-bold text-[13px] hover:brightness-110 transition-all">
                <span class="material-symbols-outlined text-[16px] align-middle">add</span> Create Announcement
            </button>
        </div>

        <div class="max-w-max-width mx-auto">
            <section class="glass-card rounded-2xl p-md mb-lg flex flex-wrap items-center gap-md">
                <p class="text-on-surface-variant font-body-sm m-0">Active announcements show as a popup on the homepage for every visitor (guest and user).</p>
                <button id="an-deleted" type="button" title="Show only soft-deleted announcements (to restore)"
                        class="ml-auto px-md py-1 rounded-full bg-surface-container border border-border-subtle text-on-surface-variant text-[10px] uppercase font-code-label hover:text-error transition-all">
                    <span class="material-symbols-outlined text-[14px] align-middle">delete_history</span> Show deleted
                </button>
            </section>

            <section class="glass-card rounded-2xl overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse min-w-[820px]">
                        <thead>
                            <tr class="bg-surface-container-high/50 border-b border-border-subtle">
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Title</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Content</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Visible</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Created</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="an-table-body" class="font-body-sm text-on-surface">
                            <tr><td colspan="5" class="text-center py-4">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>

    <!-- Create / Edit modal -->
    <div id="an-modal" class="fixed inset-0 z-[80] hidden items-center justify-center bg-black/50 backdrop-blur-sm">
        <div class="glass-card rounded-2xl p-lg w-[520px]">
            <h3 id="an-modal-title" class="font-headline-md text-primary mb-4">Create Announcement</h3>
            <div class="mb-3">
                <label class="font-code-label text-[11px] uppercase text-on-surface-variant block mb-1" for="an-title">Title <span class="text-error">*</span></label>
                <input id="an-title" class="an-input" type="text" maxlength="200" placeholder="e.g. Scheduled maintenance" />
                <div class="text-right text-[10px] text-on-surface-variant mt-1"><span id="an-title-count">0</span>/200</div>
            </div>
            <div class="mb-2">
                <label class="font-code-label text-[11px] uppercase text-on-surface-variant block mb-1" for="an-content">Content <span class="text-error">*</span></label>
                <textarea id="an-content" class="an-input" rows="5" maxlength="2000" placeholder="Announcement content shown to visitors..."></textarea>
                <div class="text-right text-[10px] text-on-surface-variant mt-1"><span id="an-content-count">0</span>/2000</div>
            </div>
            <label class="flex items-center gap-sm mb-3 cursor-pointer">
                <input id="an-active" type="checkbox" checked class="rounded bg-surface-container border-border-subtle" />
                <span class="font-body-sm text-on-surface">Visible on homepage</span>
            </label>
            <p id="an-modal-error" class="text-error font-body-sm mb-3 hidden"></p>
            <div class="flex justify-end gap-sm">
                <button id="an-modal-cancel" class="px-lg py-sm rounded-xl border border-border-subtle text-on-surface hover:bg-surface-container-high" type="button">Cancel</button>
                <button id="an-modal-save" class="px-lg py-sm rounded-xl bg-primary-container text-on-primary-container font-bold hover:brightness-110" type="button">Save</button>
            </div>
        </div>
    </div>

    <!-- Confirm modal -->
    <div id="confirm-modal" class="fixed inset-0 z-[90] hidden items-center justify-center bg-black/50 backdrop-blur-sm">
        <div class="glass-card rounded-2xl p-lg w-[360px]">
            <h3 class="font-headline-md text-primary mb-2">Confirm</h3>
            <p id="confirm-msg" class="text-on-surface-variant font-body-sm mb-lg">Are you sure?</p>
            <div class="flex justify-end gap-sm">
                <button id="confirm-cancel" class="px-lg py-sm rounded-xl border border-border-subtle text-on-surface hover:bg-surface-container-high" type="button">Cancel</button>
                <button id="confirm-ok" class="px-lg py-sm rounded-xl bg-error/90 text-white font-bold hover:bg-error" type="button">OK</button>
            </div>
        </div>
    </div>

    <script>
        // NotificationAPI qua gateway (route /api/notifications strip prefix). Response là JSON thô
        // (list = mảng, lỗi = {message}) — KHÔNG bọc {success,data} như các service khác.
        const API_BASE = 'http://localhost:7000/api/notifications/admin/announcements';
        const token = '@token';
        let confirmCb = null, editingId = null, showDeleted = false;

        document.addEventListener("DOMContentLoaded", () => {
            document.getElementById('an-create').addEventListener('click', () => openModal(null));
            document.getElementById('an-modal-cancel').addEventListener('click', closeModal);
            document.getElementById('an-modal-save').addEventListener('click', saveModal);
            document.getElementById('an-title').addEventListener('input', updateCounters);
            document.getElementById('an-content').addEventListener('input', updateCounters);
            document.getElementById('an-deleted').addEventListener('click', () => {
                showDeleted = !showDeleted;
                const b = document.getElementById('an-deleted');
                b.classList.toggle('text-error', showDeleted);
                b.classList.toggle('border-error', showDeleted);
                fetchList();
            });
            document.getElementById('confirm-ok').addEventListener('click', () => { const cb = confirmCb; hideConfirm(); if (cb) cb(); });
            document.getElementById('confirm-cancel').addEventListener('click', hideConfirm);
            fetchList();
        });

        function escapeHtml(s) { return (s ?? '').toString().replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
        function fmtDate(s) { if (!s) return '—'; const d = new Date(s); return d.toLocaleDateString('en-GB') + ' ' + d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }); }
        function showConfirm(msg, cb) { document.getElementById('confirm-msg').innerText = msg; confirmCb = cb; const m = document.getElementById('confirm-modal'); m.classList.remove('hidden'); m.classList.add('flex'); }
        function hideConfirm() { const m = document.getElementById('confirm-modal'); m.classList.add('hidden'); m.classList.remove('flex'); confirmCb = null; }

        async function fetchList() {
            const tbody = document.getElementById('an-table-body');
            try {
                const res = await fetch(`${API_BASE}?onlyDeleted=${showDeleted}`, { headers: { 'Authorization': `Bearer ${token}` } });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const items = await res.json();
                renderTable(items || []);
            } catch (e) { tbody.innerHTML = `<tr><td colspan="5" class="text-center py-4 text-error">Failed to load data. Please sign in again or check ApiGateway (:7000).</td></tr>`; }
        }

        function renderTable(items) {
            const tbody = document.getElementById('an-table-body');
            if (!items.length) { tbody.innerHTML = `<tr><td colspan="5" class="text-center py-4 text-on-surface-variant">No announcements found.</td></tr>`; return; }
            tbody.innerHTML = items.map(it => `
                <tr class="border-b border-border-subtle/50 hover:bg-surface-container-high/30">
                    <td class="px-lg py-md font-semibold text-on-surface max-w-[220px]"><p class="truncate">${escapeHtml(it.title)}</p></td>
                    <td class="px-lg py-md max-w-[340px]"><p class="truncate text-on-surface-variant">${escapeHtml(it.content)}</p></td>
                    <td class="px-lg py-md">${it.isDeleted
                        ? '<span class="px-xs py-0.5 rounded text-[9px] uppercase font-code-label bg-error/20 text-error">Deleted</span>'
                        : (it.isActive
                            ? '<span class="px-xs py-0.5 rounded text-[9px] uppercase font-code-label bg-success/20 text-success">Visible</span>'
                            : '<span class="px-xs py-0.5 rounded text-[9px] uppercase font-code-label bg-surface-container-highest text-on-surface-variant">Hidden</span>')}</td>
                    <td class="px-lg py-md font-code-label text-on-surface-variant">${fmtDate(it.createdAt)}</td>
                    <td class="px-lg py-md text-right">
                        <div class="flex justify-end gap-md">
                            ${it.isDeleted
                                ? `<button class="text-on-surface-variant hover:text-success" onclick='restoreAnnouncement("${it.announcementId}")' title="Restore"><span class="material-symbols-outlined text-[20px]">restore_from_trash</span></button>`
                                : `<button class="text-on-surface-variant hover:text-primary" onclick='openModal(${JSON.stringify(it).replace(/'/g, "&#39;")})' title="Edit"><span class="material-symbols-outlined text-[20px]">edit</span></button>
                                   <button class="text-on-surface-variant hover:text-error" onclick='deleteAnnouncement("${it.announcementId}")' title="Delete"><span class="material-symbols-outlined text-[20px]">delete</span></button>`}
                        </div>
                    </td>
                </tr>`).join('');
        }

        // ----- Create / Edit modal -----
        function openModal(item) {
            editingId = item ? item.announcementId : null;
            document.getElementById('an-modal-title').innerText = item ? 'Edit Announcement' : 'Create Announcement';
            document.getElementById('an-title').value = item ? item.title : '';
            document.getElementById('an-content').value = item ? item.content : '';
            document.getElementById('an-active').checked = item ? !!item.isActive : true;
            hideModalError(); updateCounters();
            const m = document.getElementById('an-modal'); m.classList.remove('hidden'); m.classList.add('flex');
            document.getElementById('an-title').focus();
        }
        function closeModal() { const m = document.getElementById('an-modal'); m.classList.add('hidden'); m.classList.remove('flex'); editingId = null; }
        function showModalError(msg) { const e = document.getElementById('an-modal-error'); e.innerText = msg; e.classList.remove('hidden'); }
        function hideModalError() { document.getElementById('an-modal-error').classList.add('hidden'); }
        function updateCounters() {
            document.getElementById('an-title-count').innerText = document.getElementById('an-title').value.length;
            document.getElementById('an-content-count').innerText = document.getElementById('an-content').value.length;
        }

        async function saveModal() {
            const title = document.getElementById('an-title').value.trim();
            const content = document.getElementById('an-content').value.trim();
            const isActive = document.getElementById('an-active').checked;
            if (!title) { showModalError('Title is required.'); return; }
            if (!content) { showModalError('Content is required.'); return; }
            const body = JSON.stringify({ title, content, isActive });
            const opts = { headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }, body };
            try {
                const res = editingId
                    ? await fetch(`${API_BASE}/${editingId}`, { ...opts, method: 'PUT' })
                    : await fetch(API_BASE, { ...opts, method: 'POST' });
                if (res.ok) { closeModal(); fetchList(); return; }
                const json = await res.json().catch(() => null);
                showModalError((json && json.message) || `Request failed (HTTP ${res.status}).`);
            } catch (e) { showModalError('Cannot reach ApiGateway (:7000).'); }
        }

        // ----- Soft delete / Restore -----
        function deleteAnnouncement(id) {
            showConfirm('Delete this announcement? It will stop showing on the homepage. You can restore it later via "Show deleted".', async () => {
                try {
                    const res = await fetch(`${API_BASE}/${id}`, { method: 'DELETE', headers: { 'Authorization': `Bearer ${token}` } });
                    if (res.status === 204) { fetchList(); return; }
                    alert('Delete failed.');
                } catch (e) { alert('Operation failed. Check ApiGateway (:7000).'); }
            });
        }

        function restoreAnnouncement(id) {
            showConfirm('Restore this announcement?', async () => {
                try {
                    const res = await fetch(`${API_BASE}/${id}/restore`, { method: 'POST', headers: { 'Authorization': `Bearer ${token}` } });
                    if (res.ok) { fetchList(); return; }
                    alert('Restore failed.');
                } catch (e) { alert('Operation failed. Check ApiGateway (:7000).'); }
            });
        }
    </script>
</body>
</html>
