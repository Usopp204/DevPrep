@model WebClient.Models.Admin.AdminQuestionDetailDto

@{
    ViewData["Title"] = "Chi tiết câu hỏi";
    Layout = null;

    string status = Model.Status?.Trim() ?? "Active";
    bool isSoftDeleted = Model.IsDeleted;
    string categoryName = !string.IsNullOrWhiteSpace(Model.Category)
        ? Model.Category
        : "General";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - DevPrep AI Admin Dashboard</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@100..900&family=JetBrains+Mono:wght@@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    <style>
        .admin-main-wrapper {
            margin-left: 260px;
            padding-top: 80px;
            min-height: 100vh;
            background-color: #0f0f11;
            transition: all 0.3s ease;
        }

        .card-custom {
            background-color: #16161a;
            border-radius: 12px;
            border: 1px solid #26262b;
        }

        .deleted-card {
            opacity: 0.75;
        }

        .deleted-title {
            color: #94a3b8 !important;
            text-decoration: line-through;
        }

        .title-responsive {
            font-size: calc(1.2rem + 0.5vw);
        }

        .back-to-repository {
            color: #ffffff !important;
            font-weight: 500;
            font-size: 0.95rem;
            transition: color 0.2s ease-in-out;
        }

            .back-to-repository:hover {
                color: #6366f1 !important;
            }

        .text-light-gray {
            color: #d4d4d8 !important;
        }

        .sidebar-heading {
            font-size: 0.8rem;
            letter-spacing: 0.08em;
            border-bottom: 1px solid #26262b;
            padding-bottom: 8px;
        }

        .meta-label {
            font-size: 0.75rem;
            color: #a1a1aa;
            letter-spacing: 0.05em;
        }

        .answer-content {
            line-height: 1.7;
            color: #e4e4e7 !important;
            white-space: pre-line;
            font-size: 0.95rem;
        }

        .badge-status {
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            padding: 6px 12px;
            border-radius: 6px;
        }

        .status-active {
            background-color: #6366f1;
            color: #ffffff !important;
        }

        .status-draft {
            background-color: #94a3b8;
            color: #11121a !important;
        }

        .status-archived,
        .status-deleted {
            background-color: #ef4444;
            color: #ffffff !important;
        }

        .tag-badge {
            background-color: #24242b;
            color: #e4e4e7;
            border: 1px solid #3f3f46;
            padding: 6px 10px;
            font-size: 0.8rem;
            font-weight: 400;
        }

        .btn-soft-delete {
            border-radius: 8px;
            font-weight: 500;
        }

        @@media (max-width: 991.98px) {
            .admin-main-wrapper {
                margin-left: 0;
                padding-top: 70px;
            }
        }

        @@media (max-width: 575.98px) {
            .badge-status {
                font-size: 0.7rem;
                padding: 4px 8px;
            }

            .answer-content {
                font-size: 0.9rem;
            }
        }
    </style>
</head>

<body class="admin-page" style="background-color: #0f0f11;">

    @await Html.PartialAsync("_AdminTopbar")
    @await Html.PartialAsync("_AdminSidebar")

    <div class="admin-main-wrapper">
        <div class="container-fluid text-white py-4 px-2 px-sm-3 px-md-4" style="font-family: 'Inter', sans-serif;">

            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-3 mb-4">
                <a href="/admin/questions" class="back-to-repository d-flex align-items-center gap-2 text-decoration-none py-2">
                    <i class="fa-solid fa-arrow-left"></i>
                    Back to list question
                </a>

                <div class="d-flex gap-2 justify-content-sm-end">
                    @if (isSoftDeleted)
                    {
                        <button class="btn btn-outline-success btn-soft-delete d-flex align-items-center justify-content-center gap-2 px-3 flex-fill flex-sm-none"
                                onclick="restoreQuestion('@Model.QuestionId')">
                            <i class="fa-solid fa-trash-arrow-up"></i>
                            Restore
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-outline-danger btn-soft-delete d-flex align-items-center justify-content-center gap-2 px-3 flex-fill flex-sm-none"
                                onclick="deleteQuestion('@Model.QuestionId')">
                            <i class="fa-regular fa-trash-can"></i>
                            Delete
                        </button>
                    }

                    @if (!isSoftDeleted)
                    {
                        <a href="/admin/questions/edit/@Model.QuestionId"
                           class="btn btn-primary d-flex align-items-center justify-content-center gap-2 px-3 flex-fill flex-sm-none"
                           style="background-color: #6366f1; border: none; border-radius: 8px; font-weight: 500;">
                            <i class="fa-regular fa-pen-to-square"></i>
                            Edit
                        </a>
                    }
                </div>
            </div>

            <div class="row g-4">
                <div class="col-12 col-lg-8">

                    <div class="p-3 p-md-4 mb-4 card-custom @(isSoftDeleted ? "deleted-card" : "")">
                        <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                            @if (isSoftDeleted)
                            {
                                <span class="badge badge-status status-deleted">DELETED</span>
                            }
                            else if (string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge badge-status status-active">ACTIVE</span>
                            }
                            else if (string.Equals(status, "Draft", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge badge-status status-draft">DRAFT</span>
                            }
                            else if (string.Equals(status, "Archived", StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(status, "Inactive", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge badge-status status-archived">ARCHIVED</span>
                            }
                            else
                            {
                                <span class="badge badge-status status-draft">@status.ToUpper()</span>
                            }

                            <span class="text-light-gray" style="font-size: 0.85rem; font-weight: 500;">
                                <i class="fa-regular fa-calendar-days me-1 text-muted"></i>
                                Created: @Model.CreatedAt.ToString("MMM dd, yyyy")
                            </span>

                            @if (isSoftDeleted && Model.DeletedAt.HasValue)
                            {
                                <span class="text-light-gray" style="font-size: 0.85rem; font-weight: 500;">
                                    <i class="fa-regular fa-trash-can me-1 text-danger"></i>
                                    Deleted: @Model.DeletedAt.Value.ToString("MMM dd, yyyy")
                                </span>
                            }
                        </div>

                        <h2 class="fw-bold mb-3 title-responsive @(isSoftDeleted ? "deleted-title" : "")"
                            style="line-height: 1.4; color: #ffffff;">
                            @Model.Question
                        </h2>

                        @* <div class="d-flex flex-wrap gap-2"> *@
                        @*     @if (!string.IsNullOrEmpty(Model.TechStack)) *@
                        @*     { *@
                        @*         <span class="badge tag-badge">#@Model.TechStack</span> *@
                        @*     } *@

                        @*     @if (!string.IsNullOrEmpty(Model.Tags)) *@
                        @*     { *@
                        @*         foreach (var tag in Model.Tags.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries)) *@
                        @*         { *@
                        @*             <span class="badge tag-badge">#@tag.Trim()</span> *@
                        @*         } *@
                        @*     } *@
                        @* </div> *@
                    </div>

                    <div class="card-custom" style="overflow: hidden;">
                        <div class="p-3 d-flex align-items-center gap-2" style="background-color: #1e1e24; border-bottom: 1px solid #26262b;">
                            <i class="fa-regular fa-circle-check text-success"></i>

                            <span class="fw-bold text-uppercase tracking-wider"
                                  style="font-size: 0.8rem; color: #f4f4f5; letter-spacing: 0.05em;">
                                Standard Reference Solution
                            </span>
                        </div>

                        <div class="p-3 p-md-4">
                            <h5 class="fw-bold mb-3" style="color: #ffffff; font-size: 1.1rem;">
                                Key Talking Points
                            </h5>

                            <div class="answer-content">
                                @Model.Answer
                            </div>
                        </div>
                    </div>

                </div>

                <div class="col-12 col-lg-4 mb-5">
                    <div class="p-3 p-md-4 card-custom">
                        <p class="text-uppercase fw-bold text-white mb-4 sidebar-heading">
                            Question Metadata
                        </p>

                        <div class="mb-4">
                            <label class="d-block mb-2 meta-label">DOMAIN (CATEGORY)</label>

                            <div class="d-flex align-items-center gap-3 p-2"
                                 style="background-color: #0f0f11; border-radius: 8px; border: 1px solid #26262b;">

                                <div class="d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width: 40px; height: 40px; background-color: #1e1e24; border-radius: 6px;">
                                    <i class="fa-solid fa-cubes text-info"></i>
                                </div>

                                <div class="overflow-hidden">
                                    <span class="d-block fw-bold text-white text-capitalize text-truncate"
                                          style="font-size: 0.95rem;">
                                        @categoryName
                                    </span>

                                    <small class="text-muted d-block"
                                           style="font-size: 0.75rem; color: #71717a !important;">
                                        Chuyên mục câu hỏi
                                    </small>
                                </div>
                            </div>
                        </div>

                        @* <div class="mb-4"> *@
                        @*     <label class="d-block mb-1 meta-label">EXPERIENCE LEVEL</label> *@
                        @*     <span class="fw-bold text-white" style="font-size: 1rem;">@Model.Level</span> *@
                        @* </div> *@

                        <div class="mb-4">
                            <label class="d-block mb-2 meta-label">DIFFICULTY LEVEL</label>

                            @{
                                string diff = Model.Difficulty?.ToLower() ?? "easy";
                                string badgeColor = diff == "easy"
                                ? "bg-success text-white"
                                : diff == "medium"
                                ? "bg-warning text-dark"
                                : "bg-danger text-white";
                            }

                            <span class="badge @badgeColor px-3 py-1 fw-bold text-uppercase"
                                  style="border-radius: 6px; font-size: 0.75rem; letter-spacing: 0.05em;">
                                @Model.Difficulty
                            </span>
                        </div>

                        @* <div class="mb-4"> *@
                        @*     <label class="d-block mb-2 meta-label">TECH STACK</label> *@

                        @*     <span class="badge px-3 py-1 text-white" *@
                        @*           style="background-color: #24242b; border: 1px solid #3f3f46; border-radius: 6px; font-size: 0.8rem;"> *@
                        @*         <i class="fa-brands fa-microsoft text-info me-1"></i> *@
                        @*         @(string.IsNullOrWhiteSpace(Model.TechStack) ? "N/A" : Model.TechStack) *@
                        @*     </span> *@
                        @* </div> *@

                        @* <div> *@
                        @*     <label class="d-block mb-2 meta-label">INTERACTION TYPE</label> *@

                        @*     <span class="text-white d-flex align-items-center gap-2 fw-medium" *@
                        @*           style="font-size: 0.9rem;"> *@
                        @*         <i class="fa-solid fa-code text-info"></i> *@
                        @*         @Model.QuestionType *@
                        @*     </span> *@
                        @* </div> *@

                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@@11"></script>

    <script>
        function deleteQuestion(id) {
            Swal.fire({
                title: 'Xác nhận xóa?',
                text: 'Bạn có chắc chắn muốn xóa mềm câu hỏi này không?',
                icon: 'warning',
                showCancelButton: true,
                background: '#11121a',
                color: '#fff',
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#475569',
                confirmButtonText: 'Vâng, xóa mềm!'
            }).then((result) => {
                if (!result.isConfirmed) {
                    return;
                }

                $.ajax({
                    url: '/admin/questions/delete/' + id,
                    type: 'POST',
                    success: function (response) {
                        Swal.fire({
                            title: 'Deleted!',
                            text: response.message || 'Xóa mềm câu hỏi thành công.',
                            icon: 'success',
                            background: '#11121a',
                            color: '#fff',
                            confirmButtonColor: '#6366f1'
                        }).then(() => {
                            window.location.href = '/admin/questions';
                        });
                    },
                    error: function (xhr) {
                        var errMsg = xhr.responseJSON ? xhr.responseJSON.message : 'Không thể xóa câu hỏi này.';

                        Swal.fire({
                            title: 'Error!',
                            text: errMsg,
                            icon: 'error',
                            background: '#11121a',
                            color: '#fff',
                            confirmButtonColor: '#6366f1'
                        });
                    }
                });
            });
        }

        function restoreQuestion(id) {
            Swal.fire({
                title: 'Xác nhận khôi phục?',
                text: 'Bạn muốn khôi phục câu hỏi này?',
                icon: 'question',
                showCancelButton: true,
                background: '#11121a',
                color: '#fff',
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#475569',
                confirmButtonText: 'Khôi phục ngay'
            }).then((result) => {
                if (!result.isConfirmed) {
                    return;
                }

                $.ajax({
                    url: '/admin/questions/restore/' + id,
                    type: 'POST',
                    success: function (response) {
                        Swal.fire({
                            title: 'Restored!',
                            text: response.message || 'Khôi phục câu hỏi thành công.',
                            icon: 'success',
                            background: '#11121a',
                            color: '#fff',
                            confirmButtonColor: '#10b981'
                        }).then(() => {
                            window.location.reload();
                        });
                    },
                    error: function (xhr) {
                        var errMsg = xhr.responseJSON ? xhr.responseJSON.message : 'Không thể khôi phục câu hỏi này.';

                        Swal.fire({
                            title: 'Error!',
                            text: errMsg,
                            icon: 'error',
                            background: '#11121a',
                            color: '#fff',
                            confirmButtonColor: '#6366f1'
                        });
                    }
                });
            });
        }
    </script>
</body>
</html>