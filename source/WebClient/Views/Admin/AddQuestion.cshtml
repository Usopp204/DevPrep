@model WebClient.Models.Admin.AdminQuestionViewModel

@{
    Layout = null;
    ViewData["Title"] = "Create New Interview Question";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DevPrep AI Admin Dashboard</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@100..900&family=JetBrains+Mono:wght@@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    <style>
        body.admin-page {
            background-color: #0b0c10;
            color: #f1f2f4;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            margin: 0;
            padding: 0;
        }

        .ad-main {
            margin-left: 260px;
            padding: 90px 32px 48px;
            min-height: 100vh;
            transition: all 0.3s ease;
        }

        .ad-page-title {
            color: #ffffff;
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            margin-bottom: 6px;
        }

        .ad-page-date {
            color: #94a3b8;
            font-size: 0.95rem;
            margin-bottom: 0;
        }

        .form-card {
            background-color: #16161a;
            border-radius: 12px;
            border: 1px solid #26262b;
        }

        .section-title {
            font-size: 0.85rem;
            letter-spacing: 0.05em;
            border-bottom: 1px solid #26262b;
            padding-bottom: 10px;
        }

        .field-label {
            font-size: 0.75rem;
            color: #a1a1aa;
            letter-spacing: 0.05em;
        }

        .custom-input {
            background-color: #0f0f11 !important;
            border: 1px solid #26262b !important;
            color: #ffffff !important;
            border-radius: 8px !important;
            padding: 12px 16px;
            font-size: 0.95rem;
        }

            .custom-input:focus {
                border-color: #6366f1 !important;
                box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2) !important;
            }

            .custom-input::placeholder {
                color: #52525b !important;
            }

        select.custom-input {
            appearance: none;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23a1a1aa' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e") !important;
            background-repeat: no-repeat !important;
            background-position: right 16px center !important;
            background-size: 12px 12px !important;
        }

        .btn-custom-radio {
            background-color: #0f0f11;
            border: 1px solid #26262b;
            color: #a1a1aa;
            border-radius: 8px;
            padding: 10px 24px;
            font-weight: 500;
            transition: all 0.2s ease;
        }

            .btn-custom-radio:hover {
                background-color: #1e1e24;
                color: #ffffff;
            }

        .btn-check:checked + .btn-custom-radio {
            background-color: #24242b !important;
            border-color: #6366f1 !important;
            color: #6366f1 !important;
            box-shadow: 0 0 0 1px #6366f1;
        }

        .text-indigo {
            color: #6366f1;
        }

        .btn-submit {
            background-color: #6366f1;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            color: #ffffff;
        }

            .btn-submit:hover {
                background-color: #4f46e5;
                color: #ffffff;
            }

        .btn-cancel {
            border-radius: 8px;
            font-weight: 500;
            border-color: #3f3f46;
            color: #ffffff;
        }

            .btn-cancel:hover {
                background-color: #27272a;
                color: #ffffff;
                border-color: #52525b;
            }

        @@media (max-width: 991.98px) {
            .ad-main {
                margin-left: 0;
                padding: 90px 18px 40px;
            }
        }
    </style>
</head>

<body class="admin-page">
    @await Html.PartialAsync("_AdminTopbar")
    @await Html.PartialAsync("_AdminSidebar")

    <main class="ad-main">
        <header class="mb-4">
            <h1 class="ad-page-title">Create New Interview Question</h1>
            <p class="ad-page-date">Define a high-quality prompt and evaluation criteria for the AI Coach engine.</p>
        </header>

        <form id="addQuestionForm" method="post" action="/admin/questions/create" class="text-white pb-5">
            <div class="row g-4">
                <div class="col-lg-12">

                    <div class="form-card p-4 mb-4">
                        <p class="section-title text-uppercase fw-bold text-white mb-4 d-flex align-items-center gap-2">
                            <i class="fa-regular fa-file-lines text-indigo"></i>
                            Question Definition
                        </p>

                        <div class="mb-4">
                            <label class="field-label d-block mb-2 fw-semibold">
                                QUESTION CONTENT / PROMPT
                            </label>

                            <textarea class="form-control custom-input"
                                      rows="4"
                                      placeholder="e.g., Explain the concept of Eventual Consistency in distributed systems..."
                                      required
                                      name="Content"></textarea>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="field-label d-block mb-2 fw-semibold">
                                    CATEGORY
                                </label>

                                <select class="form-select custom-input" required name="CategoryId">
                                    <option value="" disabled selected>Select Category</option>

                                    @if (Model?.Categories != null && Model.Categories.Any())
                                    {
                                        foreach (var cat in Model.Categories)
                                        {
                                            <option value="@cat.CategoryId">@cat.Name</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="field-label d-block mb-2 fw-semibold">
                                    QUESTION TYPE
                                </label>

                                <select class="form-select custom-input" required name="QuestionType">
                                    <option value="" disabled selected>Select Question Type</option>
                                    <option value="Behavioral">Behavioral</option>
                                    <option value="Situational">Situational</option>
                                    <option value="Theory">Theory</option>
                                    <option value="Coding">Coding</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-card p-4 mb-4">
                        <p class="section-title text-uppercase fw-bold text-white mb-4 d-flex align-items-center gap-2">
                            <i class="fa-solid fa-layer-group text-indigo"></i>
                            Targeting & Complexity
                        </p>

                        <div class="row g-3 align-items-center">
                            <div class="col-md-6">
                                <label class="field-label d-block mb-2 fw-semibold">
                                    TARGET LEVEL
                                </label>

                                <select class="form-select custom-input" required name="Level">
                                    <option value="" disabled selected>Select Target Level</option>
                                    <option value="Intern">Intern</option>
                                    <option value="Junior">Junior</option>
                                    <option value="Middle">Middle</option>
                                    <option value="Senior">Senior</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="field-label d-block mb-2 fw-semibold">
                                    DIFFICULTY
                                </label>

                                <div class="d-flex gap-2 btn-group-toggle flex-wrap">
                                    <input type="radio" class="btn-check" name="Difficulty" id="diffEasy" value="Easy" checked>
                                    <label class="btn btn-custom-radio px-4" for="diffEasy">Easy</label>

                                    <input type="radio" class="btn-check" name="Difficulty" id="diffMedium" value="Medium">
                                    <label class="btn btn-custom-radio px-4" for="diffMedium">Medium</label>

                                    <input type="radio" class="btn-check" name="Difficulty" id="diffHard" value="Hard">
                                    <label class="btn btn-custom-radio px-4" for="diffHard">Hard</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-card p-4 mb-4">
                        <p class="section-title text-uppercase fw-bold text-white mb-4 d-flex align-items-center gap-2">
                            <i class="fa-regular fa-circle-check text-indigo"></i>
                            Evaluation Criteria
                        </p>

                        <div class="mb-2">
                            <label class="field-label d-block mb-2 fw-semibold">
                                EXPECTED ANSWER / IDEAL RESPONSE
                            </label>

                            <textarea class="form-control custom-input"
                                      rows="5"
                                      placeholder="Define the key points the candidate should touch upon. AI will use this as a reference for scoring..."
                                      required
                                      name="ExpectedAnswer"></textarea>
                        </div>
                    </div>

                    <div class="form-card p-4 mb-4">
                        <p class="section-title text-uppercase fw-bold text-white mb-4 d-flex align-items-center gap-2">
                            <i class="fa-solid fa-tags text-indigo"></i>
                            Taxonomy
                        </p>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="field-label d-block mb-2 fw-semibold">
                                    TECH STACK
                                </label>

                                <select class="form-select custom-input" name="TechStack">
                                    <option value="" selected>Select Tech Stack</option>
                                    <option value="ASP.NET Core">ASP.NET Core</option>
                                    <option value="C#">C#</option>
                                    <option value="Java">Java</option>
                                    <option value="JavaScript">JavaScript</option>
                                    <option value="React">React</option>
                                    <option value="Node.js">Node.js</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="field-label d-block mb-2 fw-semibold">
                                    TAGS
                                </label>

                                <input type="text"
                                       class="form-control custom-input"
                                       placeholder="Enter tags, e.g. oop, dotnet, logic"
                                       name="Tags" />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center align-items-center gap-3 mt-4 pt-2">
                        <a href="/admin/questions" class="btn btn-outline-secondary btn-cancel px-5">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-primary btn-submit px-5">
                            Add Question
                        </button>
                    </div>

                </div>
            </div>
        </form>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.getElementById('addQuestionForm').addEventListener('submit', function (e) {
            e.preventDefault();

            const form = this;
            const formData = new FormData(form);

            fetch(form.action, {
                method: 'POST',
                body: formData
            })
            .then(async response => {
                let result = null;

                try {
                    result = await response.json();
                } catch (e) {
                    result = null;
                }

                if (response.ok && result && result.success) {
                    Swal.fire({
                        title: 'Success!',
                        text: result.message || 'Question has been added successfully.',
                        icon: 'success',
                        background: '#16161a',
                        color: '#ffffff',
                        confirmButtonColor: '#6366f1',
                        timer: 1800,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.href = '/admin/questions';
                    });

                    return;
                }

                throw new Error((result && result.message) || 'An error occurred while adding the question.');
            })
            .catch(error => {
                Swal.fire({
                    title: 'Error Failed!',
                    text: error.message,
                    icon: 'error',
                    background: '#16161a',
                    color: '#ffffff',
                    confirmButtonColor: '#ef4444'
                });
            });
        });
    </script>
</body>
</html>