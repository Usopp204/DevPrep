@model WebClient.Models.Admin.AdminQuestionViewModel

@{
    Layout = null;
    ViewData["Title"] = "Create New Interview Question";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - DevPrep AI Admin Dashboard</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@100..900&family=JetBrains+Mono:wght@@500&display=swap"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />

    <style>
        body.admin-page {
            background-color: #0b0c10;
            color: #f1f2f4;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .ad-main {
            margin-left: 260px;
            padding: 90px 32px 48px;
            min-height: 100vh;
            transition: all 0.3s ease;
        }

        .ad-page-title {
            color: #ffffff;
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            margin-bottom: 6px;
        }

        .ad-page-description {
            color: #94a3b8;
            font-size: 0.95rem;
            margin-bottom: 0;
        }

        .form-card {
            background-color: #16161a;
            border-radius: 12px;
            border: 1px solid #26262b;
            padding: 24px;
            margin-bottom: 22px;
        }

        .section-title {
            color: #ffffff;
            font-size: 0.85rem;
            font-weight: 800;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            border-bottom: 1px solid #26262b;
            padding-bottom: 11px;
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            gap: 9px;
        }

            .section-title i {
                color: #6366f1;
            }

        .field-label {
            display: block;
            font-size: 0.75rem;
            color: #a1a1aa;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .required-mark {
            color: #f87171;
            margin-left: 3px;
        }

        .custom-input {
            width: 100%;
            background-color: #0f0f11 !important;
            border: 1px solid #26262b !important;
            color: #ffffff !important;
            border-radius: 8px !important;
            padding: 12px 16px;
            font-size: 0.95rem;
            box-shadow: none !important;
        }

            .custom-input:focus {
                border-color: #6366f1 !important;
                box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2) !important;
            }

            .custom-input::placeholder {
                color: #52525b !important;
            }

        select.custom-input {
            appearance: none;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23a1a1aa' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e") !important;
            background-repeat: no-repeat !important;
            background-position: right 16px center !important;
            background-size: 12px 12px !important;
        }

            select.custom-input option {
                color: #ffffff !important;
                background-color: #11121a !important;
            }

        .status-options {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .btn-check {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .status-option {
            min-width: 118px;
            background-color: #0f0f11;
            border: 1px solid #303038;
            color: #a1a1aa;
            border-radius: 8px;
            padding: 11px 18px;
            font-size: 0.87rem;
            font-weight: 700;
            text-align: center;
            cursor: pointer;
            transition: all 0.18s ease;
        }

            .status-option:hover {
                background-color: #202026;
                border-color: #52525b;
                color: #ffffff;
            }

            .status-option::before {
                content: "";
                width: 9px;
                height: 9px;
                border: 2px solid currentColor;
                border-radius: 50%;
                display: inline-block;
                margin-right: 7px;
                vertical-align: 1px;
            }

        #statusActive:checked + .status-active {
            color: #34d399;
            border-color: #10b981;
            background: rgba(16, 185, 129, 0.12);
            box-shadow: 0 0 0 1px rgba(16, 185, 129, 0.35);
        }

        #statusDraft:checked + .status-draft {
            color: #fbbf24;
            border-color: #f59e0b;
            background: rgba(245, 158, 11, 0.12);
            box-shadow: 0 0 0 1px rgba(245, 158, 11, 0.35);
        }

        #statusArchived:checked + .status-archived {
            color: #f87171;
            border-color: #ef4444;
            background: rgba(239, 68, 68, 0.12);
            box-shadow: 0 0 0 1px rgba(239, 68, 68, 0.35);
        }

        #statusInactive:checked + .status-inactive {
            color: #c4b5fd;
            border-color: #8b5cf6;
            background: rgba(139, 92, 246, 0.12);
            box-shadow: 0 0 0 1px rgba(139, 92, 246, 0.35);
        }

        .action-area {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 14px;
            padding-top: 8px;
        }

        .btn-cancel {
            min-width: 145px;
            border: 1px solid #3f3f46;
            color: #ffffff;
            background: transparent;
            border-radius: 8px;
            padding: 11px 24px;
            font-weight: 600;
            text-decoration: none;
            text-align: center;
        }

            .btn-cancel:hover {
                color: #ffffff;
                background-color: #27272a;
            }

        .btn-submit {
            min-width: 170px;
            border: none;
            color: #ffffff;
            background-color: #6366f1;
            border-radius: 8px;
            padding: 11px 24px;
            font-weight: 700;
        }

            .btn-submit:hover {
                background-color: #4f46e5;
            }

            .btn-submit:disabled {
                opacity: 0.65;
                cursor: not-allowed;
            }

        @@media (max-width: 991.98px) {
            .ad-main {
                margin-left: 0;
                padding: 90px 18px 40px;
            }

            .status-option {
                flex: 1;
                min-width: 130px;
            }
        }
    </style>
</head>

<body class="admin-page">

    @await Html.PartialAsync("_AdminTopbar")
    @await Html.PartialAsync("_AdminSidebar")

    <main class="ad-main">

        <header class="mb-4">
            <h1 class="ad-page-title">
                Create New Interview Question
            </h1>

            <p class="ad-page-description">
                Create a new interview question and configure its classification and status.
            </p>
        </header>

        <form id="addQuestionForm"
              method="post"
              action="/admin/questions/create"
              novalidate
              class="text-white pb-5">

            @Html.AntiForgeryToken()

            <!-- Question Information -->
            <section class="form-card">

                <div class="section-title">
                    <i class="fa-regular fa-file-lines"></i>
                    Question Information
                </div>

                <!-- Question -->
                <div class="mb-4">
                    <label class="field-label"
                           for="questionInput">
                        Question content
                        <span class="required-mark">*</span>
                    </label>

                    <textarea id="questionInput"
                              class="form-control custom-input"
                              rows="5"
                              maxlength="5000"
                              required
                              name="Question"
                              placeholder="Enter question content..."></textarea>
                </div>

                <!-- Answer -->
                <div class="mb-4">
                    <label class="field-label"
                           for="answerInput">
                        Answer
                        <span class="required-mark">*</span>
                    </label>

                    <textarea id="answerInput"
                              class="form-control custom-input"
                              rows="5"
                              required
                              name="Answer"
                              placeholder="Enter the expected answer or ideal response..."></textarea>
                </div>

                <div class="row g-3">

                    <!-- Category -->
                    <div class="col-md-6">
                        <label class="field-label"
                               for="categoryInput">
                            Category
                            <span class="required-mark">*</span>
                        </label>

                        <select id="categoryInput"
                                class="form-select custom-input"
                                required
                                name="CategoryId">

                            <option value=""
                                    selected
                                    disabled>
                                Select Category
                            </option>

                            @if (Model.Categories != null &&
                            Model.Categories.Any())
                            {
                                foreach (var category in Model.Categories)
                                {
                                    <option value="@category.CategoryId">
                                        @category.Category
                                    </option>
                                }
                            }
                            else
                            {
                                <option value=""
                                        disabled>
                                    No active categories available
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Difficulty -->
                   <!-- Difficulty -->
                    <div class="col-md-6">
                        <label class="field-label"
                               for="difficultyInput">
                            Difficulty
                            <span class="required-mark">*</span>
                        </label>

                        <select id="difficultyInput"
                                class="form-select custom-input"
                                required
                                name="Difficulty">

                            <option value=""
                                    selected
                                    disabled>
                                Select Difficulty
                            </option>

                            <option value="Intern">Intern</option>
                            <option value="Fresher">Fresher</option>
                            <option value="Junior">Junior</option>
                            <option value="Middle">Middle</option>
                            <option value="Senior">Senior</option>
                        </select>
                    </div>

                </div>
            </section>

            <!-- Position and Status -->
            <section class="form-card">

                <div class="section-title">
                    <i class="fa-solid fa-layer-group"></i>
                    Position & Status
                </div>

                <!-- Position -->
                <div class="mb-4">
                    <label class="field-label"
                           for="positionInput">
                        Position
                        <span class="required-mark">*</span>
                    </label>

                    <select id="positionInput"
                            class="form-select custom-input"
                            required
                            name="PositionId">

                        <option value=""
                                selected
                                disabled>
                            Select Position
                        </option>

                        @if (Model.Positions != null &&
                        Model.Positions.Any())
                        {
                            foreach (var position in Model.Positions)
                            {
                                <option value="@position.PositionId">
                                    @position.Name
                                </option>
                            }
                        }
                        else
                        {
                            <option value=""
                                    disabled>
                                No positions available
                            </option>
                        }
                    </select>
                </div>

                <!-- Status -->
                <div>
                    <label class="field-label">
                        Status
                        <span class="required-mark">*</span>
                    </label>

                    <div class="status-options">

                        <input type="radio"
                               class="btn-check"
                               name="Status"
                               id="statusActive"
                               value="Active"
                               required
                               checked />

                        <label class="status-option status-active"
                               for="statusActive">
                            Active
                        </label>

                        <input type="radio"
                               class="btn-check"
                               name="Status"
                               id="statusDraft"
                               value="Draft" />

                        <label class="status-option status-draft"
                               for="statusDraft">
                            Draft
                        </label>

                    </div>
                </div>
            </section>



            <!-- Actions -->
            <div class="action-area">

                <a href="/admin/questions"
                   class="btn-cancel">
                    Cancel
                </a>

                <button type="submit"
                        id="btnAddQuestion"
                        class="btn-submit">
                    Add Question
                </button>

            </div>

        </form>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@@11"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const addForm =
            document.getElementById('addQuestionForm');

        const addButton =
            document.getElementById('btnAddQuestion');

        function showValidationError(message, input) {
            return Swal.fire({
                title: 'Create Failed!',
                text: message,
                icon: 'error',
                background: '#16161a',
                color: '#ffffff',
                confirmButtonColor: '#ef4444'
            }).then(() => {
                if (input) {
                    input.focus();
                }
            });
        }

        if (addForm) {
            addForm.addEventListener(
                'submit',
                async function (event) {
                    event.preventDefault();

                    const form = this;

                    const questionInput =
                        form.querySelector('[name="Question"]');

                    const answerInput =
                        form.querySelector('[name="Answer"]');

                    const categoryInput =
                        form.querySelector('[name="CategoryId"]');

                    const difficultyInput =
                        form.querySelector('[name="Difficulty"]');

                    const positionInput =
                        form.querySelector('[name="PositionId"]');

                    // const techStackInput =
                    //     form.querySelector('[name="TechStack"]');

                    // const tagsInput =
                    //     form.querySelector('[name="Tags"]');

                    const statusInput =
                        form.querySelector('[name="Status"]:checked');

                    if (!questionInput.value.trim()) {
                        await showValidationError(
                            'Please enter the question text.',
                            questionInput
                        );

                        return;
                    }

                    if (!answerInput.value.trim()) {
                        await showValidationError(
                            'Please enter the answer.',
                            answerInput
                        );

                        return;
                    }

                    if (!categoryInput.value) {
                        await showValidationError(
                            'Please choose a category.',
                            categoryInput
                        );

                        return;
                    }

                    if (!difficultyInput.value.trim()) {
                        await showValidationError(
                            'Please choose a difficulty.',
                            difficultyInput
                        );

                        return;
                    }

                    if (!positionInput.value) {
                        await showValidationError(
                            'Please choose a position.',
                            positionInput
                        );

                        return;
                    }

                    if (!statusInput) {
                        await showValidationError(
                            'Please choose a status.',
                            null
                        );

                        return;
                    }

                    // if (!techStackInput.value.trim()) {
                    //     await showValidationError(
                    //         'Vui lòng nhập Tech Stack.',
                    //         techStackInput
                    //     );

                    //     return;
                    // }

                    // if (!tagsInput.value.trim()) {
                    //     await showValidationError(
                    //         'Vui lòng nhập Tags.',
                    //         tagsInput
                    //     );

                    //     return;
                    //     return;
                    // }

                    /*
                     * Loại bỏ khoảng trắng thừa trước khi gửi.
                     */
                    questionInput.value =
                        questionInput.value.trim();

                    answerInput.value =
                        answerInput.value.trim();

                    difficultyInput.value =
                        difficultyInput.value.trim();

                    positionInput.value =
                        positionInput.value.trim();

                    // techStackInput.value =
                    //     techStackInput.value.trim();

                    // tagsInput.value =
                    //     tagsInput.value.trim();

                    const formData =
                        new FormData(form);

                    try {
                        addButton.disabled = true;
                        addButton.textContent = 'Creating...';

                        const response = await fetch(
                            form.action,
                            {
                                method: 'POST',
                                body: formData,
                                headers: {
                                    'X-Requested-With':
                                        'XMLHttpRequest'
                                }
                            }
                        );

                        let result = null;

                        try {
                            result = await response.json();
                        } catch {
                            result = null;
                        }

                        if (!response.ok ||
                            !result?.success) {

                            throw new Error(
                                result?.message ??
                                'An error occurred while adding the question.'
                            );
                        }

                        await Swal.fire({
                            title: 'Created Successfully!',
                            text: result.message ??
                                'Question has been added successfully.',
                            icon: 'success',
                            background: '#16161a',
                            color: '#ffffff',
                            confirmButtonColor: '#6366f1',
                            timer: 1700,
                            showConfirmButton: false
                        });

                        window.location.href =
                            '/admin/questions';

                    } catch (error) {

                        await Swal.fire({
                            title: 'Create Failed!',
                            text: error.message ??
                                'An error occurred while adding the question.',
                            icon: 'error',
                            background: '#16161a',
                            color: '#ffffff',
                            confirmButtonColor: '#ef4444'
                        });

                    } finally {

                        addButton.disabled = false;
                        addButton.textContent =
                            'Add Question';
                    }
                }
            );
        }
    </script>

</body>
</html>