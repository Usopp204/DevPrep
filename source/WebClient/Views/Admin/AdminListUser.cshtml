@model WebClient.Models.Admin.AdminUserViewModel

@{
    Layout = null;
    ViewData["Title"] = "User Management";

    var query = Model.Query ?? new WebClient.Models.Admin.AdminUserQueryDto();
    var paged = Model.PagedResult ?? new WebClient.Models.Admin.AdminUserPagedResult<WebClient.Models.Admin.AdminUserListItemDto>();
    var users = paged.Items ?? new List<WebClient.Models.Admin.AdminUserListItemDto>();

    var pageIndex = paged.PageIndex > 0 ? paged.PageIndex : query.Page;
    var pageSize = paged.PageSize > 0 ? paged.PageSize : query.PageSize;
    var totalCount = paged.TotalCount;
    var totalPages = paged.TotalPages;

    var startItem = totalCount == 0 ? 0 : ((pageIndex - 1) * pageSize) + 1;
    var endItem = Math.Min(pageIndex * pageSize, totalCount);

    string BuildPageUrl(int page)
    {
        var values = new Dictionary<string, string?>
                {
                    ["Keyword"] = query.Keyword,
                    ["Role"] = query.Role,
                    ["Status"] = query.Status,
                    ["CreatedFrom"] = query.CreatedFrom?.ToString("yyyy-MM-dd"),
                    ["CreatedTo"] = query.CreatedTo?.ToString("yyyy-MM-dd"),
                    ["Page"] = page.ToString(),
                    ["PageSize"] = pageSize.ToString()
                };

        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/Admin/User", values);
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - DevPrep AI Admin Dashboard</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@100..900&family=JetBrains+Mono:wght@@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    <style>
        :root {
            --bg-main: #0f1424;
            --bg-panel: #111827;
            --bg-panel-2: #151a2b;
            --bg-table-head: #171a24;
            --border-main: #252b3d;
            --text-main: #ffffff;
            --text-muted: #9ca3af;
            --text-blue: #93c5fd;
            --primary: #6366f1;
            --danger: #ff5d7a;
            --success: #10b981;
            --warning: #f59e0b;
        }

        body {
            background: var(--bg-main);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
        }

        .admin-main-wrapper {
            margin-left: 260px;
            padding-top: 78px;
            min-height: 100vh;
            background: var(--bg-main);
        }

        .admin-content {
            padding: 28px 28px 60px;
        }

        .page-title {
            font-size: 30px;
            font-weight: 800;
            letter-spacing: -0.04em;
            margin-bottom: 4px;
        }

        .page-subtitle {
            color: var(--text-blue);
            font-size: 14px;
            margin-bottom: 24px;
        }

        .filter-card {
            border: 1px solid var(--border-main);
            background: rgba(17, 24, 39, 0.95);
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 18px;
        }

        .filter-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 800;
            color: var(--text-blue);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 7px;
        }

        .admin-input,
        .admin-select {
            height: 42px;
            border-radius: 7px;
            border: 1px solid #30384e;
            background: #0f1322;
            color: #ffffff;
            font-size: 14px;
            box-shadow: none !important;
        }

            .admin-input:focus,
            .admin-select:focus {
                border-color: var(--primary);
                background: #0f1322;
                color: #ffffff;
            }

            .admin-input::placeholder {
                color: #64748b;
            }

        .btn-filter {
            height: 42px;
            width: 100%;
            border: none;
            border-radius: 7px;
            background: #35304f;
            color: #ffffff;
            font-weight: 800;
        }

            .btn-filter:hover {
                background: #4f46e5;
                color: #ffffff;
            }

        .btn-clear {
            height: 42px;
            width: 100%;
            border-radius: 7px;
            border: 1px solid #30384e;
            background: transparent;
            color: #cbd5e1;
            font-weight: 700;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .btn-clear:hover {
                background: rgba(255, 255, 255, 0.06);
                color: #ffffff;
            }

        .table-shell {
            border: 1px solid var(--border-main);
            background: var(--bg-panel);
            border-radius: 12px;
            overflow: hidden;
        }

        .admin-table {
            width: 100%;
            margin: 0;
            color: #dbeafe;
            --bs-table-bg: #111827;
            --bs-table-color: #dbeafe;
            --bs-table-border-color: #242b3e;
            --bs-table-hover-bg: #151f36;
            --bs-table-hover-color: #ffffff;
        }

            .admin-table thead th {
                background: #171a24 !important;
                color: #a9c7f5 !important;
                font-family: 'JetBrains Mono', monospace;
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                border-bottom: 1px solid var(--border-main);
                padding: 15px 14px;
                white-space: nowrap;
            }

            .admin-table tbody tr {
                background: #111827 !important;
            }

            .admin-table tbody td {
                background: #111827 !important;
                color: #dbeafe !important;
                border-bottom: 1px solid #242b3e;
                padding: 16px 14px;
                vertical-align: middle;
                font-size: 14px;
            }

            .admin-table tbody tr:hover td {
                background: #151f36 !important;
            }

        .user-name {
            color: #ffffff;
            font-weight: 800;
            margin-bottom: 3px;
        }

        .user-email {
            color: #93c5fd;
            font-size: 13px;
        }

        .role-badge,
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 7px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .role-admin {
            background: rgba(99, 102, 241, 0.16);
            color: #c4b5fd;
        }

        .role-manager {
            background: rgba(14, 165, 233, 0.16);
            color: #7dd3fc;
        }

        .role-user {
            background: rgba(148, 163, 184, 0.14);
            color: #cbd5e1;
        }

        .status-active {
            background: rgba(16, 185, 129, 0.14);
            color: #34d399;
        }

        .status-blocked {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
        }

        .status-pending {
            background: rgba(245, 158, 11, 0.16);
            color: #fbbf24;
        }

        .metric-strong {
            color: #ffffff;
            font-weight: 800;
        }

        .muted-small {
            color: var(--text-muted);
            font-size: 12px;
        }

        .action-btn {
            width: 34px;
            height: 34px;
            border: none;
            background: transparent;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            transition: 0.15s ease;
            text-decoration: none;
        }

            .action-btn:hover {
                background: rgba(255, 255, 255, 0.08);
            }

        .action-view {
            color: #93c5fd;
        }

        .action-edit {
            color: #a78bfa;
        }

        .action-block {
            color: #fb7185;
        }

        .action-unblock {
            color: #10b981;
        }

        .empty-row {
            height: 140px;
            color: #cbd5e1;
            text-align: center;
            font-weight: 600;
        }

        .table-footer {
            padding: 14px 16px;
            color: #cbd5e1;
            font-size: 13px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            border-top: 1px solid #242b3e;
            background: #111827;
        }

        .pager {
            display: flex;
            gap: 8px;
            align-items: center;
        }

            .pager a,
            .pager span {
                min-width: 34px;
                height: 34px;
                border-radius: 7px;
                border: 1px solid #30384e;
                color: #cbd5e1;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                font-weight: 700;
            }

            .pager .active-page {
                background: var(--primary);
                border-color: var(--primary);
                color: #ffffff;
            }

        .error-box {
            border: 1px solid rgba(239, 68, 68, 0.45);
            background: rgba(239, 68, 68, 0.08);
            color: #fecaca;
            border-radius: 10px;
            padding: 13px 16px;
            margin-bottom: 18px;
            font-weight: 700;
        }

        @@media (max-width: 991.98px) {
            .admin-main-wrapper {
                margin-left: 0;
                padding-top: 70px;
            }

            .admin-content {
                padding: 20px 14px 50px;
            }

            .table-footer {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>

<body class="admin-page">
    @await Html.PartialAsync("_AdminTopbar")
    @await Html.PartialAsync("_AdminSidebar")

    <main class="admin-main-wrapper">
        <div class="admin-content">
            <div class="d-flex align-items-start justify-content-between gap-3 mb-4">
                <div>
                    <h1 class="page-title">User Management</h1>
                    <p class="page-subtitle">Manage user accounts, roles, credit balance and account status.</p>
                </div>
            </div>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="error-box">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>
                    @ViewBag.ErrorMessage
                </div>
            }

            <form method="get" action="/Admin/User" class="filter-card">
                <input type="hidden" name="Page" value="1" />
                <input type="hidden" name="PageSize" value="@pageSize" />

                <div class="row g-3 align-items-end">
                    <div class="col-12 col-xl-4">
                        <div class="filter-label">Search</div>
                        <input class="form-control admin-input"
                               type="text"
                               name="Keyword"
                               value="@query.Keyword"
                               placeholder="Search by full name or email..." />
                    </div>

                    <div class="col-12 col-sm-6 col-xl-2">
                        <div class="filter-label">Role</div>
                        <select class="form-select admin-select" name="Role">
                            <option value="">All Roles</option>
                            <option value="Admin" selected="@(string.Equals(query.Role, "Admin", StringComparison.OrdinalIgnoreCase))">Admin</option>
                            <option value="Manager" selected="@(string.Equals(query.Role, "Manager", StringComparison.OrdinalIgnoreCase))">Manager</option>
                            <option value="User" selected="@(string.Equals(query.Role, "User", StringComparison.OrdinalIgnoreCase))">User</option>
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-2">
                        <div class="filter-label">Status</div>
                        <select class="form-select admin-select" name="Status">
                            <option value="">All Statuses</option>
                            <option value="Active" selected="@(string.Equals(query.Status, "Active", StringComparison.OrdinalIgnoreCase))">Active</option>
                            <option value="Blocked" selected="@(string.Equals(query.Status, "Blocked", StringComparison.OrdinalIgnoreCase))">Blocked</option>
                            <option value="Pending" selected="@(string.Equals(query.Status, "Pending", StringComparison.OrdinalIgnoreCase))">Pending</option>
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-2">
                        <div class="filter-label">Created From</div>
                        <input class="form-control admin-input"
                               type="date"
                               name="CreatedFrom"
                               value="@(query.CreatedFrom.HasValue ? query.CreatedFrom.Value.ToString("yyyy-MM-dd") : "")" />
                    </div>

                    <div class="col-12 col-sm-6 col-xl-2">
                        <div class="filter-label">Created To</div>
                        <input class="form-control admin-input"
                               type="date"
                               name="CreatedTo"
                               value="@(query.CreatedTo.HasValue ? query.CreatedTo.Value.ToString("yyyy-MM-dd") : "")" />
                    </div>

                    <div class="col-12 col-md-6 col-xl-2">
                        <button class="btn-filter" type="submit">Apply Filter</button>
                    </div>

                    <div class="col-12 col-md-6 col-xl-2">
                        <a class="btn-clear" href="/Admin/User">Clear</a>
                    </div>
                </div>
            </form>

            <div class="table-shell">
                <div class="table-responsive">
                    <table class="table admin-table align-middle">
                        <thead>
                            <tr>
                                <th style="width: 32%;">User Information</th>
                                <th style="width: 13%;">Role</th>
                                <th style="width: 18%;">Registered</th>
                                <th style="width: 12%;">Credits</th>
                                <th style="width: 13%;">Status</th>
                                <th style="width: 12%;" class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (users.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="empty-row">
                                        <i class="fa-regular fa-folder-open d-block mb-2" style="font-size: 28px;"></i>
                                        No users found.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var user in users)
                                {
                                    var displayName = string.IsNullOrWhiteSpace(user.FullName) ? "Unknown User" : user.FullName;
                                  

                                    var roleClass = (user.Role ?? "").ToLowerInvariant() switch
                                    {
                                        "admin" => "role-admin",
                                        "manager" => "role-manager",
                                        _ => "role-user"
                                    };

                                    var statusClass = (user.Status ?? "").ToLowerInvariant() switch
                                    {
                                        "active" => "status-active",
                                        "blocked" => "status-blocked",
                                        "pending" => "status-pending",
                                        _ => "status-pending"
                                    };

                                    var isBlocked = string.Equals(user.Status, "Blocked", StringComparison.OrdinalIgnoreCase);

                                    <tr>
                                        <td>
                                            <a class="user-name text-decoration-none"
                                               href="/Admin/User/Detail/@user.UserId">
                                                @displayName
                                            </a>
                                        </td>

                                        <td>
                                            <span class="role-badge @roleClass">
                                                @(user.Role ?? "User")
                                            </span>
                                        </td>

                                        <td>
                                            <div class="metric-strong">@user.CreatedAt.ToString("dd/MM/yyyy")</div>
                                            <div class="muted-small">@user.CreatedAt.ToString("HH:mm")</div>
                                        </td>

                                        <td>
                                            <span class="metric-strong">@user.CreditBalance.ToString("N0")</span>
                                        </td>

                                        <td>
                                            <span class="status-badge @statusClass">
                                                <span style="font-size: 8px;">●</span>
                                                @(user.Status ?? "Unknown")
                                            </span>
                                        </td>

                                        <td class="text-end">
                                            <a class="action-btn action-view"
                                               href="/Admin/User/Detail/@user.UserId"
                                               title="View details">
                                                <i class="fa-regular fa-eye"></i>
                                            </a>

                                            <a class="action-btn action-edit"
                                               href="/Admin/User/Edit/@user.UserId"
                                               title="Edit role">
                                                <i class="fa-regular fa-pen-to-square"></i>
                                            </a>

                                            @if (isBlocked)
                                            {
                                                <button class="action-btn action-unblock"
                                                        type="button"
                                                        title="Activate user"
                                                        onclick="changeUserStatus('@user.UserId', 'Active')">
                                                    <i class="fa-solid fa-rotate-left"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="action-btn action-block"
                                                        type="button"
                                                        title="Block user"
                                                        onclick="changeUserStatus('@user.UserId', 'Blocked')">
                                                    <i class="fa-solid fa-ban"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="table-footer">
                    <div>
                        Showing <strong>@startItem</strong>-<strong>@endItem</strong> of <strong>@totalCount</strong> users
                    </div>

                    @if (totalPages > 1)
                    {
                        var prevPage = pageIndex <= 1 ? 1 : pageIndex - 1;
                        var nextPage = pageIndex >= totalPages ? totalPages : pageIndex + 1;

                        <div class="pager">
                            <a href="@BuildPageUrl(prevPage)">
                                <i class="fa-solid fa-chevron-left"></i>
                            </a>

                            @for (var i = 1; i <= totalPages; i++)
                            {
                                if (i == pageIndex)
                                {
                                    <span class="active-page">@i</span>
                                }
                                else
                                {
                                    <a href="@BuildPageUrl(i)">@i</a>
                                }
                            }

                            <a href="@BuildPageUrl(nextPage)">
                                <i class="fa-solid fa-chevron-right"></i>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@@11"></script>

    <script>
        async function changeUserStatus(userId, targetStatus) {
            const isBlocking = targetStatus === 'Blocked';

            const result = await Swal.fire({
                title: isBlocking ? 'Block this user?' : 'Activate this user?',
                text: isBlocking
                    ? 'User will no longer be allowed to access the system.'
                    : 'User will be activated again.',
                input: isBlocking ? 'textarea' : null,
                inputPlaceholder: 'Reason for blocking this user...',
                icon: isBlocking ? 'warning' : 'question',
                showCancelButton: true,
                background: '#111827',
                color: '#ffffff',
                confirmButtonColor: isBlocking ? '#ef4444' : '#10b981',
                cancelButtonColor: '#475569',
                confirmButtonText: isBlocking ? 'Block User' : 'Activate User'
            });

            if (!result.isConfirmed) {
                return;
            }

            const payload = {
                status: targetStatus,
                reason: isBlocking ? (result.value || 'Blocked by admin') : 'Activated by admin'
            };

            try {
                const response = await fetch('/Admin/User/status/' + userId, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();

                if (!response.ok || !data.success) {
                    throw new Error(data.message || 'Unable to update user status.');
                }

                await Swal.fire({
                    title: 'Success',
                    text: data.message || 'User status updated successfully.',
                    icon: 'success',
                    background: '#111827',
                    color: '#ffffff',
                    confirmButtonColor: '#6366f1'
                });

                window.location.reload();
            } catch (error) {
                Swal.fire({
                    title: 'Error',
                    text: error.message || 'Something went wrong.',
                    icon: 'error',
                    background: '#111827',
                    color: '#ffffff',
                    confirmButtonColor: '#6366f1'
                });
            }
        }
    </script>
</body>
</html>