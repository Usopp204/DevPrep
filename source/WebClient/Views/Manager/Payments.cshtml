@{
    var token = Context.Request.Cookies["access_token"];
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Transaction Audit - DevPrep Manager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        :root { --border-m:rgba(255,255,255,.04); --primary:#818cf8; --primary-dim:rgba(129,140,248,.12); --success:#10B981; --success-dim:rgba(16,185,129,.12); --error:#f87171; --error-dim:rgba(248,113,113,.12); --warning:#fbbf24; --warning-dim:rgba(251,191,36,.12); --text:#e5e1e7; --text-muted:#9ca3af; --text-dim:#6b7280; --r-sm:8px; --r-md:12px; --r-lg:16px; }
        .page-head { margin-bottom:28px; }.page-label,.filter-field label,.mono-label { font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:var(--text-dim); }.page-label { color:var(--primary); margin-bottom:6px; }
        .data-card { background:rgba(17,24,39,.4); backdrop-filter:blur(12px); border:1px solid rgba(255,255,255,.08); border-top-color:rgba(255,255,255,.12); border-radius:var(--r-lg); overflow:hidden; }.data-card-head { display:flex; align-items:center; justify-content:space-between; padding:16px 20px; border-bottom:1px solid var(--ad-border); gap:12px; }.data-card-title { font-size:15px; font-weight:600; color:var(--text); }
        .filter-bar { display:flex; flex-wrap:wrap; gap:10px; align-items:flex-end; padding:16px 20px; margin-bottom:20px; }.filter-field { display:flex; flex-direction:column; gap:4px; }.filter-field input,.filter-field select { background:#11121a !important; border:1px solid #292c3d !important; border-radius:var(--r-sm); color:#ffffff !important; font-size:13px; padding:7px 10px; min-width:130px; }.filter-field select option { background-color:#11121a !important; color:#ffffff !important; } input[type="date"] { color-scheme: dark !important; }.filter-field input:focus,.filter-field select:focus { outline:none; border-color:var(--primary); background:#161824 !important; }.filter-actions { display:flex; gap:8px; }.btn-filter,.btn-clear { border-radius:var(--r-sm); padding:8px 16px; font-size:13px; font-weight:600; cursor:pointer; }.btn-filter { background:var(--primary-dim); color:var(--primary); border:1px solid rgba(129,140,248,.25); }.btn-clear { background:rgba(255,255,255,.03); color:var(--text-muted); border:1px solid var(--ad-border); }.btn-clear:hover,.btn-filter:hover { color:var(--text); background:rgba(129,140,248,.2); }
        .revenue-stats { display:grid; grid-template-columns:repeat(3,minmax(160px,1fr)); gap:14px; }.revenue-card { padding:18px 20px; margin-bottom:20px; }.revenue-stat-label { font-size:11px; color:var(--text-dim); text-transform:uppercase; letter-spacing:.08em; margin-bottom:4px; }.revenue-stat-value { font-size:22px; font-weight:700; color:var(--text); }
        .tx-table { width:100%; border-collapse:collapse; }.tx-table th { text-align:left; padding:12px 18px; font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:var(--text-dim); border-bottom:1px solid var(--ad-border); white-space:nowrap; }.tx-table td { padding:15px 18px; border-bottom:1px solid var(--border-m); font-size:14px; vertical-align:middle; color:var(--text); }.tx-table tbody tr { cursor:pointer; }.tx-table tbody tr:hover { background:rgba(255,255,255,.03); }.tx-table tbody tr:last-child td { border-bottom:none; }.mono { font-family:'JetBrains Mono',monospace; font-size:12px; }.muted { color:var(--text-muted); }.order-code { display:inline-block; max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; vertical-align:middle; }
        .badge-pill { display:inline-flex; align-items:center; gap:4px; padding:4px 12px; border-radius:20px; font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; }.badge-pill .material-symbols-outlined { font-size:13px; }.badge-paid { background:var(--success-dim); color:var(--success); }.badge-failed { background:var(--error-dim); color:var(--error); }.badge-pending { background:var(--warning-dim); color:var(--warning); }.badge-neutral { background:rgba(107,114,128,.15); color:var(--text-muted); }
        .pager { display:flex; align-items:center; justify-content:space-between; padding:14px 20px; border-top:1px solid var(--ad-border); }.pager-info { font-size:13px; color:var(--text-muted); }.pager-nav { display:flex; gap:5px; }.pager-btn { display:inline-flex; align-items:center; justify-content:center; min-width:34px; min-height:32px; padding:6px 10px; border-radius:var(--r-sm); border:1px solid var(--ad-border); background:rgba(255,255,255,.03); color:var(--text-muted); font-size:13px; font-weight:600; }.pager-btn:hover:not(:disabled) { background:rgba(255,255,255,.06); color:var(--text); }.pager-btn.now { background:var(--primary-dim); color:var(--primary); border-color:rgba(129,140,248,.25); }.pager-btn:disabled { opacity:.4; cursor:not-allowed; }.empty-msg { text-align:center; padding:48px; color:var(--text-muted); font-size:14px; }
        .detail-overlay { display:none; position:fixed; inset:0; z-index:500; background:rgba(0,0,0,.68); backdrop-filter:blur(4px); padding:20px; overflow-y:auto; }.detail-overlay.open { display:flex; align-items:flex-start; justify-content:center; }.detail-modal { width:100%; max-width:760px; margin:auto; background:#0e1323; border:1px solid rgba(255,255,255,.1); border-radius:var(--r-lg); box-shadow:0 24px 64px rgba(0,0,0,.5); overflow:hidden; }.detail-head { display:flex; align-items:center; justify-content:space-between; padding:18px 22px; border-bottom:1px solid var(--ad-border); }.detail-body { padding:22px; }.detail-section { margin-top:18px; }.detail-row { display:flex; justify-content:space-between; gap:24px; padding:10px 0; border-bottom:1px solid var(--border-m); }.detail-row:last-child { border-bottom:0; }.detail-row-value { text-align:right; word-break:break-word; }.icon-btn { border:0; background:transparent; color:var(--text-muted); padding:4px; line-height:1; }.icon-btn:hover { color:#ffffff; }
        @@media (max-width:900px) { .revenue-stats { grid-template-columns:1fr; }.filter-field { width:calc(50% - 5px); }.filter-field input,.filter-field select { width:100%; min-width:0; } } @@media (max-width:650px) { .filter-field { width:100%; }.pager { gap:10px; align-items:flex-start; flex-direction:column; }.ad-main { padding-left:16px; padding-right:16px; } }
    </style>
    <link rel="stylesheet" href="~/css/components/pagination.css" asp-append-version="true" />
</head>
<body class="admin-page">
@await Html.PartialAsync("_ManagerTopbar")
@await Html.PartialAsync("_ManagerSidebar")
<main class="ad-main">
    <header class="page-head"><div><p class="page-label">Manager Monitoring</p><h1 class="ad-page-title">Transaction Audit</h1></div></header>
    <section class="data-card filter-bar">
        <div class="filter-field"><label for="pay-search">Search order code</label><input id="pay-search" type="text" placeholder="ORD-..." /></div>
        <div class="filter-field"><label for="pay-status">Status</label><select id="pay-status"><option value="">All</option><option value="Paid">Paid</option><option value="Pending">Pending</option><option value="Failed">Failed</option><option value="Expired">Expired</option><option value="Cancelled">Cancelled</option></select></div>
        <div class="filter-field"><label for="pay-method">Method</label><select id="pay-method"><option value="">All</option><option value="VNPay">VNPay</option></select></div>
        <div class="filter-field"><label for="pay-from">From date</label><input id="pay-from" type="date" /></div>
        <div class="filter-field"><label for="pay-to">To date</label><input id="pay-to" type="date" /></div>
        <div class="filter-field"><label for="pay-min">Min amount</label><input id="pay-min" type="number" min="0" placeholder="0" /></div>
        <div class="filter-field"><label for="pay-max">Max amount</label><input id="pay-max" type="number" min="0" placeholder="0" /></div>
        <div class="filter-actions"><button id="pay-apply" class="btn-filter" type="button">Apply</button><button id="pay-clear" class="btn-clear" type="button">Clear</button></div>
    </section>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mb-4">
        <div class="col"><div class="glass-card ad-stat"><div class="ad-stat-top"><span class="ad-stat-label">Total Transactions</span><span class="material-symbols-outlined" style="color:var(--primary);opacity:.6;font-variation-settings:'FILL' 1;">receipt_long</span></div><div><div class="ad-stat-value" id="pay-stat-total">-</div></div></div></div>
        <div class="col"><div class="glass-card ad-stat"><div class="ad-stat-top"><span class="ad-stat-label">Paid Transactions</span><span class="material-symbols-outlined" style="color:var(--success);opacity:.6;font-variation-settings:'FILL' 1;">check_circle</span></div><div><div class="ad-stat-value" id="pay-stat-paid-count" style="color:var(--success);">-</div></div></div></div>
        <div class="col"><div class="glass-card ad-stat"><div class="ad-stat-top"><span class="ad-stat-label">Total Amount</span><span class="material-symbols-outlined" style="color:var(--primary);opacity:.6;font-variation-settings:'FILL' 1;">payments</span></div><div><div class="ad-stat-value" id="pay-stat-total-amount">-</div></div></div></div>
        <div class="col"><div class="glass-card ad-stat"><div class="ad-stat-top"><span class="ad-stat-label">Paid Amount</span><span class="material-symbols-outlined" style="color:var(--success);opacity:.6;font-variation-settings:'FILL' 1;">account_balance_wallet</span></div><div><div class="ad-stat-value" id="pay-stat-paid-amount" style="color:var(--success);">-</div></div></div></div>
    </div>
    <section class="data-card"><div class="data-card-head"><span class="data-card-title">All Transactions</span><span id="pay-head-summary" class="muted" style="font-size:13px">Loading...</span></div><div style="overflow-x:auto"><table class="tx-table"><thead><tr><th>Order Code</th><th>User ID</th><th style="text-align:right">Credits</th><th style="text-align:right">Amount</th><th>Method</th><th>Date</th><th style="text-align:center">Status</th><th style="text-align:right">View</th></tr></thead><tbody id="pay-table-body"><tr><td colspan="8" class="empty-msg">Loading...</td></tr></tbody></table></div><div class="pager"><span id="pay-summary" class="pager-info">Loading...</span><nav id="pay-pages" class="devprep-pagination devprep-pagination-inline" aria-label="Pagination"></nav></div></section>
</main>
<div id="pay-detail" class="detail-overlay" onclick="if (event.target === this) closeDetail()"><section class="detail-modal"><header class="detail-head"><div><p class="page-label">Read only</p><h2 class="data-card-title" style="font-size:18px">Payment Details</h2></div><button class="icon-btn" type="button" onclick="closeDetail()" title="Close"><span class="material-symbols-outlined">close</span></button></header><div id="pay-detail-body" class="detail-body">Loading...</div></section></div>
<script>
    const API_BASE = '@ViewData["ApiBaseUrl"]/api/admin/manager/payments';
    const token = '@token';
    let currentPage = 1, pageSize = 10, totalPages = 1, searchTimer;
    document.addEventListener('DOMContentLoaded', () => {
        ['pay-status','pay-method','pay-from','pay-to','pay-min','pay-max'].forEach(id => document.getElementById(id).addEventListener('change', applyFilters));
        document.getElementById('pay-search').addEventListener('input', () => { clearTimeout(searchTimer); searchTimer = setTimeout(applyFilters, 300); });
        document.getElementById('pay-apply').addEventListener('click', applyFilters); document.getElementById('pay-clear').addEventListener('click', clearFilters); fetchList();
    });
    function applyFilters() { currentPage = 1; fetchList(); }
    function clearFilters() { ['pay-search','pay-from','pay-to','pay-min','pay-max'].forEach(id => document.getElementById(id).value = ''); document.getElementById('pay-status').value = ''; document.getElementById('pay-method').value = ''; applyFilters(); }
    async function fetchList() { const tbody = document.getElementById('pay-table-body'); tbody.innerHTML = '<tr><td colspan="8" class="empty-msg">Loading...</td></tr>'; try { const q = new URLSearchParams({ page:currentPage, pageSize }); setQuery(q,'keyword',value('pay-search')); setQuery(q,'status',value('pay-status')); setQuery(q,'paymentMethod',value('pay-method')); setQuery(q,'dateFrom',value('pay-from')); setQuery(q,'dateTo',value('pay-to')); setQuery(q,'minAmount',value('pay-min')); setQuery(q,'maxAmount',value('pay-max')); const res = await fetch(`${API_BASE}?${q}`, { headers:{ Authorization:`Bearer ${token}` } }); if (!res.ok) throw new Error(`HTTP ${res.status}`); const json = await res.json(); if (!json.success) throw new Error(json.message || 'Failed'); renderStats(json.data || {}); renderTable(json.data?.items || []); renderPagination(json.data || {}); } catch (error) { console.error(error); tbody.innerHTML = '<tr><td colspan="8" class="empty-msg">Payments are temporarily unavailable.</td></tr>'; renderPagination({ totalCount:0, totalPages:1 }); } }
    function renderStats(data) { const total = data.totalCount || data.totalItems || 0; document.getElementById('pay-stat-total').innerText = total; document.getElementById('pay-stat-paid-count').innerText = data.paidCount || 0; document.getElementById('pay-stat-total-amount').innerText = moneyNumber(data.totalAmount); document.getElementById('pay-stat-paid-amount').innerText = moneyNumber(data.paidAmount); }
    function renderTable(items) { const tbody = document.getElementById('pay-table-body'); if (!items.length) { tbody.innerHTML = '<tr><td colspan="8" class="empty-msg">No transactions yet.</td></tr>'; return; } tbody.innerHTML = items.map(i => `<tr onclick="openDetail('${i.orderId}')"><td><span class="mono order-code" title="${escapeHtml(i.orderCode)}">${escapeHtml(i.orderCode)}</span></td><td><span class="mono muted" title="${escapeHtml(i.userId)}">${escapeHtml(shortId(i.userId))}</span></td><td style="text-align:right"><strong>${i.credits ?? 0}</strong></td><td style="text-align:right"><span class="mono">${moneyNumber(i.amount)}</span><span class="muted" style="font-size:11px"> ${escapeHtml(i.currency || 'VND')}</span></td><td class="muted">${escapeHtml(i.paymentMethod || '-')}</td><td><span class="mono muted">${fmtDateTime(i.paidAt || i.createdAt)}</span></td><td style="text-align:center">${statusBadge(i.status)}</td><td style="text-align:right"><button class="icon-btn" type="button" title="View details" onclick="event.stopPropagation();openDetail('${i.orderId}')"><span class="material-symbols-outlined">visibility</span></button></td></tr>`).join(''); }
    async function openDetail(id) { document.getElementById('pay-detail').classList.add('open'); const body = document.getElementById('pay-detail-body'); body.innerHTML = 'Loading...'; try { const res = await fetch(`${API_BASE}/${id}`, { headers:{ Authorization:`Bearer ${token}` } }); if (!res.ok) throw new Error(); const json = await res.json(); if (!json.success || !json.data) throw new Error(); renderDetail(json.data); } catch { body.innerHTML = '<p class="muted">Cannot load payment details.</p>'; } }
    function closeDetail() { document.getElementById('pay-detail').classList.remove('open'); }
    function renderDetail(d) { const tx = d.transaction; const rows = [['Order code',d.orderCode],['Order ID',d.orderId],['User ID',d.userId],['Package ID',d.packageId],['Amount',`${moneyNumber(d.amount)} ${d.currency || 'VND'}`],['Credits',d.credits],['Method',d.paymentMethod],['Status',statusBadge(d.status)],['Paid at',fmtDateTime(d.paidAt)],['Expired at',fmtDateTime(d.expiredAt)],['Created at',fmtDateTime(d.createdAt)],['Updated at',fmtDateTime(d.updatedAt)]]; const txRows = tx ? [['Transaction ID',tx.transactionId],['Transaction status',tx.status],['VNPay transaction no',tx.vnpTransactionNo || '-'],['Bank code',tx.vnpBankCode || '-'],['Response code',tx.vnpResponseCode || '-'],['Pay date',tx.vnpPayDate || '-'],['Callback at',fmtDateTime(tx.createdAt)]] : []; document.getElementById('pay-detail-body').innerHTML = detailSection('Invoice', rows) + detailSection('Transaction Reference', txRows, tx ? escapeHtml(tx.rawCallbackJson || '') : 'No transaction callback recorded.'); }
    function detailSection(title, rows, extra = '') { return `<section class="detail-section"><p class="mono-label">${title}</p>${rows.length ? rows.map(([k,v]) => `<div class="detail-row"><span class="mono-label">${escapeHtml(k)}</span><span class="detail-row-value">${typeof v === 'string' && v.includes('badge-pill') ? v : escapeHtml(v ?? '-')}</span></div>`).join('') : ''}${extra ? `<pre class="mono muted" style="white-space:pre-wrap;margin-top:14px">${extra}</pre>` : ''}</section>`; }
    function renderPagination(data) { totalPages = Math.max(data.totalPages || 1, 1); const total = data.totalCount || data.totalItems || 0, page = data.page || currentPage, size = data.pageSize || pageSize; currentPage = page; const start = total ? (page - 1) * size + 1 : 0, end = Math.min(page * size, total); document.getElementById('pay-summary').innerText = `Showing ${start}-${end} of ${total} transactions`; document.getElementById('pay-head-summary').innerText = `Page ${page} of ${totalPages} - ${total} total`; DevPrepPagination.render({ container: 'pay-pages', currentPage, totalPages, onPageChange: goPage }); }
    function goPage(p) { if (p >= 1 && p <= totalPages && p !== currentPage) { currentPage = p; fetchList(); } }
    function value(id) { return document.getElementById(id).value.trim(); } function setQuery(q,k,v) { if(v) q.set(k,v); } function money(v) { return `${moneyNumber(v)} VND`; } function moneyNumber(v) { return new Intl.NumberFormat('vi-VN',{maximumFractionDigits:0}).format(v || 0); } function shortId(id) { return id ? `${String(id).slice(0,8)}...` : '-'; } function fmtDateTime(d) { return d ? new Date(d).toLocaleString('vi-VN') : '-'; } function escapeHtml(v) { return String(v ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;'); } function statusBadge(s) { const cls = s === 'Paid' ? 'badge-paid' : (s === 'Failed' || s === 'Cancelled' ? 'badge-failed' : (s === 'Pending' ? 'badge-pending' : 'badge-neutral')); const icon = s === 'Paid' ? 'check_circle' : (s === 'Failed' || s === 'Cancelled' ? 'cancel' : 'schedule'); return `<span class="badge-pill ${cls}"><span class="material-symbols-outlined">${icon}</span>${escapeHtml(s || '-')}</span>`; }
</script>
    <script src="~/js/components/pagination.js" asp-append-version="true"></script>
</body>
</html>
