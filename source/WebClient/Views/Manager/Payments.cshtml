@{
    var token = Context.Request.Cookies["access_token"];
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manager Payments - DevPrep AI</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700;800;900&family=JetBrains+Mono:wght@@500&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@@100..700,0..1&display=swap" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#e2dfff", "on-primary-container": "#4e4c83", "primary-container": "#c3c0ff",
                        "secondary": "#4cd7f6", "success": "#10B981", "warning": "#F9D949", "error": "#ffb4ab",
                        "surface-container": "#201f23", "surface-container-high": "#2a292d", "surface-container-highest": "#353438",
                        "on-surface": "#e5e1e7", "on-surface-variant": "#c8c5d0",
                        "border-subtle": "rgba(255,255,255,0.08)", "background": "#0e1323"
                    },
                    spacing: { "xs": "8px", "sm": "12px", "md": "16px", "lg": "24px", "max-width": "1280px" },
                    fontFamily: { "display-lg": ["Inter"], "code-label": ["JetBrains Mono"], "headline-md": ["Inter"], "body-sm": ["Inter"], "body-md": ["Inter"] }
                }
            }
        }
    </script>
    <style>
        body { background-color: #0e1323; color: #e5e1e7; }
        .glass-card { background: rgba(32,31,35,0.4); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.08); border-top: 1px solid rgba(255,255,255,0.15); }
        .pay-main { margin-left: 250px; padding: 80px 24px 32px; min-height: 100vh; background: #0e1323; }
        .pay-toolbar { display: grid; grid-template-columns: repeat(4, minmax(120px, max-content)) minmax(260px, 1fr); gap: 16px; align-items: center; }
        .pay-select, .pay-input { background: #353438; border: 1px solid rgba(255,255,255,.08); border-radius: 10px; padding: 7px 12px; color: #e5e1e7; font-size: 13px; outline: none; }
        .pay-input { width: 100%; min-width: 0; padding-left: 38px; }
        .pay-search-shell { position: relative; min-width: 260px; }
        .pay-search-shell #pay-search {
            width: 100% !important;
            min-width: 0 !important;
            height: 40px !important;
            padding: 8px 14px 8px 44px !important;
            background: #353438 !important;
            color: #e5e1e7 !important;
            border: 1px solid rgba(255,255,255,.08) !important;
            border-radius: 10px !important;
            box-shadow: none !important;
        }
        .pay-search-shell #pay-search::placeholder { color: #9ca3af !important; opacity: 1 !important; }
        .pay-search-shell .material-symbols-outlined { pointer-events: none; z-index: 2; }
        .pay-card-title { font-family: "JetBrains Mono", monospace; font-size: 11px; text-transform: uppercase; color: #c8c5d0; }
        .pay-card-value { font-weight: 800; font-size: 22px; color: #e2dfff; margin-top: 4px; }
        .side-drawer { transition: transform .3s cubic-bezier(.4,0,.2,1); }
        .drawer-hidden { transform: translateX(100%); }
        .ad-sidebar h2, .ad-sidebar p, .ad-sidebar a { margin-bottom: 0; }
        button:disabled { opacity: .45; cursor: not-allowed; }
        @@media (max-width: 1100px) {
            .pay-toolbar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .pay-search-shell { grid-column: 1 / -1; min-width: 0; }
        }
        @@media (max-width: 720px) {
            .pay-main { margin-left: 0; padding-left: 16px; padding-right: 16px; }
            .pay-toolbar { grid-template-columns: 1fr; }
            .pay-search-shell { grid-column: auto; }
        }
    </style>
</head>
<body class="font-body-md overflow-x-hidden">
    @await Html.PartialAsync("_ManagerTopbar")
    @await Html.PartialAsync("_ManagerSidebar")

    <main class="pay-main">
        <div class="mb-6">
            <h1 class="font-display-lg text-[24px] font-bold text-primary tracking-tight">Payment Monitoring</h1>
        </div>

        <div class="max-w-max-width mx-auto">
            <section class="grid grid-cols-1 md:grid-cols-3 gap-md mb-lg">
                <div class="glass-card rounded-2xl p-md">
                    <div class="pay-card-title">Total Volume</div>
                    <div id="pay-total-amount" class="pay-card-value">-</div>
                </div>
                <div class="glass-card rounded-2xl p-md">
                    <div class="pay-card-title">Paid Volume</div>
                    <div id="pay-paid-amount" class="pay-card-value text-success">-</div>
                </div>
                <div class="glass-card rounded-2xl p-md">
                    <div class="pay-card-title">Paid Transactions</div>
                    <div id="pay-paid-count" class="pay-card-value">-</div>
                </div>
            </section>

            <section class="glass-card rounded-2xl p-md mb-lg pay-toolbar">
                <select id="pay-status" class="pay-select">
                    <option value="">All status</option>
                    <option value="Pending">Pending</option>
                    <option value="Paid">Paid</option>
                    <option value="Failed">Failed</option>
                    <option value="Expired">Expired</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
                <select id="pay-method" class="pay-select">
                    <option value="">All methods</option>
                    <option value="VNPay">VNPay</option>
                </select>
                <input id="pay-min" class="pay-select w-[130px]" type="number" min="0" placeholder="Min amount" />
                <input id="pay-max" class="pay-select w-[130px]" type="number" min="0" placeholder="Max amount" />
                <div class="pay-search-shell">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
                    <input id="pay-search" class="pay-input" placeholder="Search order code..." type="text" />
                </div>
            </section>

            <section class="glass-card rounded-2xl overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse min-w-[980px]">
                        <thead>
                            <tr class="bg-surface-container-high/50 border-b border-border-subtle">
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Order</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">User</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Amount</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Credits</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Method</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Reference</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Status</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Date</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="pay-table-body" class="font-body-sm text-on-surface">
                            <tr><td colspan="9" class="text-center py-4">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="px-lg py-md flex items-center justify-between border-t border-border-subtle bg-surface-container/20">
                    <p id="pay-summary" class="font-code-label text-[11px] text-on-surface-variant uppercase">Loading...</p>
                    <div class="flex gap-xs items-center">
                        <button id="pay-prev" class="p-1 rounded bg-surface-container border border-border-subtle text-on-surface-variant hover:text-primary" type="button"><span class="material-symbols-outlined">chevron_left</span></button>
                        <span id="pay-page" class="px-3 py-1 rounded bg-primary-container text-on-primary-container font-code-label text-[11px] font-bold">1</span>
                        <button id="pay-next" class="p-1 rounded bg-surface-container border border-border-subtle text-on-surface-variant hover:text-primary" type="button"><span class="material-symbols-outlined">chevron_right</span></button>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <div class="fixed inset-0 bg-black/40 backdrop-blur-sm z-[60] hidden opacity-0 transition-opacity duration-300" id="drawer-overlay" onclick="toggleDrawer(false)"></div>
    <aside class="fixed top-0 right-0 h-full w-[680px] max-w-full z-[70] glass-card drawer-hidden side-drawer shadow-2xl flex flex-col" id="pay-drawer">
        <div class="p-lg border-b border-border-subtle flex items-center justify-between">
            <h2 class="font-headline-md text-primary">Payment Details</h2>
            <button class="p-2 rounded-full hover:bg-surface-container-high text-on-surface-variant" onclick="toggleDrawer(false)"><span class="material-symbols-outlined">close</span></button>
        </div>
        <div id="pay-detail-body" class="flex-1 overflow-y-auto p-lg space-y-lg">
            <p class="text-on-surface-variant">Loading...</p>
        </div>
    </aside>

    <script>
        const API_BASE = '@ViewData["ApiBaseUrl"]/api/admin/manager/payments';
        const token = '@token';
        let currentPage = 1, pageSize = 10, totalPages = 1, searchTimer = null;

        document.addEventListener('DOMContentLoaded', () => {
            ['pay-status', 'pay-method', 'pay-min', 'pay-max'].forEach(id => document.getElementById(id).addEventListener('change', () => { currentPage = 1; fetchList(); }));
            document.getElementById('pay-search').addEventListener('input', () => { clearTimeout(searchTimer); searchTimer = setTimeout(() => { currentPage = 1; fetchList(); }, 300); });
            document.getElementById('pay-prev').addEventListener('click', () => { if (currentPage > 1) { currentPage--; fetchList(); } });
            document.getElementById('pay-next').addEventListener('click', () => { if (currentPage < totalPages) { currentPage++; fetchList(); } });
            fetchList();
        });

        async function fetchList() {
            const tbody = document.getElementById('pay-table-body');
            tbody.innerHTML = `<tr><td colspan="9" class="text-center py-4">Loading...</td></tr>`;
            try {
                const q = new URLSearchParams({ page: currentPage, pageSize });
                setQuery(q, 'keyword', document.getElementById('pay-search').value.trim());
                setQuery(q, 'status', document.getElementById('pay-status').value);
                setQuery(q, 'paymentMethod', document.getElementById('pay-method').value);
                setQuery(q, 'minAmount', document.getElementById('pay-min').value);
                setQuery(q, 'maxAmount', document.getElementById('pay-max').value);
                const res = await fetch(`${API_BASE}?${q}`, { headers: { 'Authorization': `Bearer ${token}` } });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const json = await res.json();
                if (!json.success) throw new Error(json.message || 'Failed');
                renderStats(json.data);
                renderTable(json.data.items || []);
                renderPagination(json.data);
            } catch (e) {
                console.error(e);
                tbody.innerHTML = `<tr><td colspan="9" class="text-center py-4 text-on-surface-variant">Payments are temporarily unavailable.</td></tr>`;
            }
        }

        function renderStats(data) {
            document.getElementById('pay-total-amount').innerText = money(data.totalAmount);
            document.getElementById('pay-paid-amount').innerText = money(data.paidAmount);
            document.getElementById('pay-paid-count').innerText = String(data.paidCount || 0);
        }

        function renderTable(items) {
            const tbody = document.getElementById('pay-table-body');
            if (!items.length) {
                tbody.innerHTML = `<tr><td colspan="9" class="text-center py-4 text-on-surface-variant">No payments found.</td></tr>`;
                return;
            }
            tbody.innerHTML = items.map(item => `
                <tr class="border-b border-border-subtle/50 hover:bg-surface-container-high/30 cursor-pointer" onclick="openDetail('${item.orderId}')">
                    <td class="px-lg py-md"><span class="font-code-label text-[12px] text-primary">${escapeHtml(item.orderCode)}</span></td>
                    <td class="px-lg py-md"><span class="font-code-label text-[11px] text-on-surface-variant">${shortId(item.userId)}</span></td>
                    <td class="px-lg py-md font-semibold">${money(item.amount)}</td>
                    <td class="px-lg py-md font-code-label text-on-surface-variant">${item.credits}</td>
                    <td class="px-lg py-md">${badge(item.paymentMethod)}</td>
                    <td class="px-lg py-md"><span class="font-code-label text-[11px] text-on-surface-variant">${escapeHtml(item.vnpTransactionNo || item.vnpResponseCode || '-')}</span></td>
                    <td class="px-lg py-md">${statusBadge(item.status)}</td>
                    <td class="px-lg py-md font-code-label text-on-surface-variant">${fmtDate(item.createdAt)}</td>
                    <td class="px-lg py-md text-right">
                        <button class="text-on-surface-variant hover:text-primary" onclick="event.stopPropagation(); openDetail('${item.orderId}')" title="View"><span class="material-symbols-outlined text-[20px]">visibility</span></button>
                    </td>
                </tr>`).join('');
        }

        async function openDetail(id) {
            toggleDrawer(true);
            const body = document.getElementById('pay-detail-body');
            body.innerHTML = `<p class="text-on-surface-variant">Loading...</p>`;
            try {
                const res = await fetch(`${API_BASE}/${id}`, { headers: { 'Authorization': `Bearer ${token}` } });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const json = await res.json();
                if (!json.success || !json.data) throw new Error(json.message || 'Failed');
                renderDetail(json.data);
            } catch (e) {
                body.innerHTML = `<p class="text-error">Cannot load payment details.</p>`;
            }
        }

        function renderDetail(d) {
            const tx = d.transaction;
            const rows = [
                ['Order code', d.orderCode],
                ['Order id', d.orderId],
                ['User id', d.userId],
                ['Package id', d.packageId],
                ['Amount', money(d.amount)],
                ['Credits', d.credits],
                ['Currency', d.currency],
                ['Method', d.paymentMethod],
                ['Status', statusBadge(d.status)],
                ['Paid at', fmtDateTime(d.paidAt)],
                ['Expired at', fmtDateTime(d.expiredAt)],
                ['Created at', fmtDateTime(d.createdAt)],
                ['Updated at', fmtDateTime(d.updatedAt)]
            ];
            const txRows = tx ? [
                ['Transaction id', tx.transactionId],
                ['Transaction status', tx.status],
                ['VNPay transaction no', tx.vnpTransactionNo || '-'],
                ['Bank code', tx.vnpBankCode || '-'],
                ['Response code', tx.vnpResponseCode || '-'],
                ['Pay date', tx.vnpPayDate || '-'],
                ['Secure hash valid', tx.secureHashValid === null || tx.secureHashValid === undefined ? '-' : String(tx.secureHashValid)],
                ['Callback at', fmtDateTime(tx.createdAt)]
            ] : [];

            document.getElementById('pay-detail-body').innerHTML = `
                <div class="glass-card rounded-xl p-md">
                    <div class="flex items-center justify-between mb-3">
                        <div>
                            <p class="font-code-label text-[11px] uppercase text-on-surface-variant">Invoice</p>
                            <h3 class="text-[22px] font-bold text-primary">${escapeHtml(d.orderCode)}</h3>
                        </div>
                        ${statusBadge(d.status)}
                    </div>
                    ${rows.map(detailRow).join('')}
                </div>
                <div class="glass-card rounded-xl p-md">
                    <p class="font-code-label text-[11px] uppercase text-on-surface-variant mb-3">Transaction Reference</p>
                    ${txRows.length ? txRows.map(detailRow).join('') : '<p class="text-on-surface-variant text-[13px] italic">No transaction callback recorded.</p>'}
                    ${tx && tx.rawCallbackJson ? `<pre class="mt-3 p-3 rounded bg-black/25 text-[11px] overflow-x-auto text-on-surface-variant">${escapeHtml(tx.rawCallbackJson)}</pre>` : ''}
                </div>`;
        }

        function detailRow(row) {
            return `<div class="flex justify-between gap-sm py-2 border-b border-border-subtle/40"><span class="font-code-label text-[11px] uppercase text-on-surface-variant">${escapeHtml(row[0])}</span><span class="font-body-sm text-on-surface text-right break-all">${row[1]}</span></div>`;
        }

        function renderPagination(data) {
            totalPages = Math.max(data.totalPages || 1, 1);
            const total = data.totalCount || 0, page = data.page || currentPage, size = data.pageSize || pageSize;
            const start = total === 0 ? 0 : ((page - 1) * size) + 1, end = Math.min(page * size, total);
            document.getElementById('pay-summary').innerText = `Showing ${start}-${end} of ${total} payments`;
            document.getElementById('pay-page').innerText = `${page}`;
            document.getElementById('pay-prev').disabled = page <= 1;
            document.getElementById('pay-next').disabled = page >= totalPages;
        }

        function setQuery(q, key, value) { if (value !== null && value !== undefined && String(value).trim() !== '') q.set(key, value); }
        function money(value) { return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND', maximumFractionDigits: 0 }).format(value || 0); }
        function shortId(id) { return id ? String(id).substring(0, 8) : '-'; }
        function badge(text) { return `<span class="px-xs py-0.5 rounded bg-surface-container-highest text-on-surface-variant text-[10px] uppercase font-code-label">${escapeHtml(text || '-')}</span>`; }
        function statusBadge(status) {
            const map = { Paid: 'bg-success/10 border-success/30 text-success', Pending: 'bg-warning/10 border-warning/30 text-warning', Failed: 'bg-error/10 border-error/30 text-error', Expired: 'bg-surface-container-highest border-border-subtle text-on-surface-variant', Cancelled: 'bg-error/10 border-error/30 text-error' };
            return `<span class="px-xs py-1 rounded-full border text-[10px] font-bold uppercase ${map[status] || 'bg-surface-container-highest border-border-subtle text-on-surface-variant'}">${escapeHtml(status || '')}</span>`;
        }
        function fmtDate(d) { if (!d) return '-'; const x = new Date(d); const m = ["JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"]; return `${m[x.getMonth()]} ${x.getDate().toString().padStart(2,'0')}`; }
        function fmtDateTime(d) { if (!d) return '-'; return new Date(d).toLocaleString(); }
        function escapeHtml(v) { return String(v ?? '').replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;"); }
        function toggleDrawer(show) {
            const drawer = document.getElementById('pay-drawer'), overlay = document.getElementById('drawer-overlay');
            if (show) { drawer.classList.remove('drawer-hidden'); overlay.classList.remove('hidden'); setTimeout(() => overlay.classList.add('opacity-100'), 10); document.body.style.overflow = 'hidden'; }
            else { drawer.classList.add('drawer-hidden'); overlay.classList.remove('opacity-100'); setTimeout(() => { overlay.classList.add('hidden'); document.body.style.overflow = 'auto'; }, 300); }
        }
    </script>
</body>
</html>
