@{
    var token = Context.Request.Cookies["access_token"];
    var apiBaseUrl = (ViewData["ApiBaseUrl"]?.ToString() ?? "http://localhost:7000").TrimEnd('/');
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Announcements - DevPrep AI Manager</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700;800;900&family=JetBrains+Mono:wght@@500&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@@100..700,0..1&display=swap" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#e2dfff", "on-primary": "#2c2a5e", "primary-container": "#c3c0ff",
                        "on-primary-container": "#4e4c83", "success": "#10B981", "error": "#ffb4ab",
                        "surface-container": "#201f23", "surface-container-high": "#2a292d",
                        "surface-container-highest": "#353438", "on-surface": "#e5e1e7",
                        "on-surface-variant": "#c8c5d0", "border-subtle": "rgba(255,255,255,0.08)"
                    },
                    borderRadius: { "xl": "0.5rem", "full": "0.75rem" },
                    spacing: { "sm": "12px", "md": "16px", "lg": "24px", "max-width": "1280px" },
                    fontFamily: { "display-lg": ["Inter"], "code-label": ["JetBrains Mono"], "body-sm": ["Inter"], "body-md": ["Inter"] }
                }
            }
        };
    </script>
    <style>
        body { background-color: #0e1323; color: #e5e1e7; }
        .glass-card { background: rgba(32,31,35,.4); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,.08); border-top-color: rgba(255,255,255,.15); }
        .ad-sidebar h2, .ad-sidebar p, .ad-sidebar a { margin-bottom: 0; }
        .an-main { margin-left: 250px; padding: 80px 24px 32px; min-width: 0; min-height: 100vh; background: #0e1323; }
        .an-content { max-width: 38rem; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.5; }
        .an-title { max-width: 20rem; overflow-wrap: anywhere; }
        @@media (max-width: 767px) { .an-main { margin-left: 0; padding: 72px 16px 24px; } }
    </style>
</head>
<body class="font-body-md overflow-x-hidden">
    @await Html.PartialAsync("_ManagerTopbar")
    @await Html.PartialAsync("_ManagerSidebar")

    <main class="an-main">
        <div class="mb-6">
            <h1 class="font-display-lg text-[24px] font-bold text-primary tracking-tight">Announcements</h1>
            <p class="mt-2 text-on-surface-variant font-body-sm">Read-only announcement information.</p>
        </div>

        <div class="max-w-max-width mx-auto">
            <section class="glass-card rounded-2xl p-md mb-lg flex flex-wrap items-center gap-md">
                <p class="text-on-surface-variant font-body-sm m-0">Visible announcements appear on the homepage for guests and users.</p>
                <button id="an-deleted" type="button" aria-pressed="false"
                        class="ml-auto px-md py-1 rounded-full bg-surface-container border border-border-subtle text-on-surface-variant text-[10px] uppercase font-code-label hover:text-primary transition-all">
                    <span class="material-symbols-outlined text-[14px] align-middle" aria-hidden="true">delete_history</span> Show deleted
                </button>
            </section>

            <section class="glass-card rounded-2xl overflow-hidden" aria-label="Announcement list">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse min-w-[760px]">
                        <thead>
                            <tr class="bg-surface-container-high/50 border-b border-border-subtle">
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Title</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Content</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Visibility</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Created</th>
                            </tr>
                        </thead>
                        <tbody id="an-table-body" class="font-body-sm text-on-surface" aria-live="polite">
                            <tr><td colspan="4" class="text-center py-4 text-on-surface-variant">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>

    <script>
        (() => {
            "use strict";
            const apiUrl = '@($"{apiBaseUrl}/api/notifications/admin/announcements")';
            const token = '@token';
            const tableBody = document.getElementById("an-table-body");
            const deletedFilter = document.getElementById("an-deleted");
            let showDeleted = false;

            function escapeHtml(value) {
                return String(value ?? "").replace(/[&<>"']/g, (character) => ({
                    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
                })[character]);
            }

            function formatDate(value) {
                if (!value) return "—";
                const date = new Date(value);
                return date.toLocaleDateString("en-GB") + " " + date.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" });
            }

            function statusBadge(item) {
                if (item.isDeleted)
                    return '<span class="px-2 py-0.5 rounded text-[9px] uppercase font-code-label bg-error/20 text-error">Deleted</span>';
                return item.isActive
                    ? '<span class="px-2 py-0.5 rounded text-[9px] uppercase font-code-label bg-success/20 text-success">Visible</span>'
                    : '<span class="px-2 py-0.5 rounded text-[9px] uppercase font-code-label bg-surface-container-highest text-on-surface-variant">Hidden</span>';
            }

            function render(items) {
                if (!items.length) {
                    tableBody.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-on-surface-variant">No announcements found.</td></tr>';
                    return;
                }

                tableBody.innerHTML = items.map((item) => `
                    <tr class="border-b border-border-subtle/50 align-top hover:bg-surface-container-high/30">
                        <td class="px-lg py-md font-semibold text-on-surface"><p class="an-title">${escapeHtml(item.title)}</p></td>
                        <td class="px-lg py-md text-on-surface-variant"><p class="an-content">${escapeHtml(item.content)}</p></td>
                        <td class="px-lg py-md">${statusBadge(item)}</td>
                        <td class="px-lg py-md font-code-label text-on-surface-variant whitespace-nowrap">${formatDate(item.createdAt)}</td>
                    </tr>`).join("");
            }

            async function loadAnnouncements() {
                tableBody.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-on-surface-variant">Loading...</td></tr>';
                try {
                    const response = await fetch(apiUrl + "?onlyDeleted=" + showDeleted, {
                        headers: { Authorization: "Bearer " + token, Accept: "application/json" }
                    });
                    if (!response.ok) throw new Error("Announcement list unavailable");
                    const items = await response.json();
                    render(Array.isArray(items) ? items : []);
                } catch {
                    tableBody.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-error">Announcements are temporarily unavailable.</td></tr>';
                }
            }

            deletedFilter.addEventListener("click", () => {
                showDeleted = !showDeleted;
                deletedFilter.setAttribute("aria-pressed", String(showDeleted));
                deletedFilter.classList.toggle("text-primary", showDeleted);
                loadAnnouncements();
            });

            loadAnnouncements();
        })();
    </script>
</body>
</html>