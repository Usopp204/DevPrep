@{
    var token = Context.Request.Cookies["access_token"];
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Credit Packages - DevPrep Manager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        :root { --surface-h:rgba(255,255,255,.05); --border:rgba(255,255,255,.08); --border-m:rgba(255,255,255,.04); --primary:#818cf8; --primary-dim:rgba(129,140,248,.12); --success:#10B981; --success-dim:rgba(16,185,129,.12); --text:#e5e1e7; --text-muted:#9ca3af; --text-dim:#6b7280; --r-sm:8px; --r-md:12px; --r-lg:16px; }
        .page-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:28px; flex-wrap:wrap; gap:12px; }.page-label,.mono-label { font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:var(--primary); margin-bottom:6px; }.data-card { background:rgba(17,24,39,.4); backdrop-filter:blur(12px); border:1px solid var(--border); border-top-color:rgba(255,255,255,.12); border-radius:var(--r-lg); overflow:hidden; }.data-card-head { display:flex; align-items:center; justify-content:space-between; padding:16px 20px; border-bottom:1px solid var(--border); gap:12px; flex-wrap:wrap; }.data-card-title { font-size:15px; font-weight:600; color:var(--text); }
        .filter-bar { display:flex; gap:10px; align-items:flex-end; padding:16px 20px; margin-bottom:20px; flex-wrap:wrap; }.filter-field { display:flex; flex-direction:column; gap:4px; }.filter-field label { font-family:'JetBrains Mono',monospace; font-size:10px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:var(--text-dim); }.filter-field input,.filter-field select { min-width:180px; background:rgba(255,255,255,.03); border:1px solid var(--border); border-radius:var(--r-sm); color:var(--text); font-size:13px; padding:7px 10px; }.filter-field input:focus,.filter-field select:focus { outline:none; border-color:var(--primary); }.btn-filter,.btn-clear { border-radius:var(--r-sm); padding:8px 16px; font-size:13px; font-weight:600; cursor:pointer; }.btn-filter { background:var(--primary-dim); color:var(--primary); border:1px solid rgba(129,140,248,.25); }.btn-clear { background:rgba(255,255,255,.03); color:var(--text-muted); border:1px solid var(--border); }.btn-clear:hover,.btn-filter:hover { color:var(--text); background:rgba(129,140,248,.2); }
        .pkg-table { width:100%; border-collapse:collapse; }.pkg-table th { text-align:left; padding:13px 20px; font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:var(--text-dim); border-bottom:1px solid var(--border); white-space:nowrap; }.pkg-table td { padding:16px 20px; border-bottom:1px solid var(--border-m); font-size:14px; vertical-align:middle; }.pkg-table tbody tr { cursor:pointer; }.pkg-table tbody tr:hover { background:var(--surface-h); }.pkg-table tbody tr:last-child td { border-bottom:none; }.th-r,.td-r { text-align:right!important; }.pkg-name { font-weight:600; color:var(--text); }.pkg-desc { font-size:12px; color:var(--text-dim); margin-top:2px; max-width:420px; }.pkg-credits-total { font-size:15px; font-weight:700; color:var(--primary); }.pkg-credits-break,.pkg-currency { font-size:12px; color:var(--text-dim); margin-top:1px; }.pkg-price { font-weight:600; color:var(--text); }.pkg-sort,.mono { font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--text-muted); }.badge-active,.badge-inactive { display:inline-flex; align-items:center; gap:4px; padding:4px 12px; border-radius:20px; font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; }.badge-active { background:var(--success-dim); color:var(--success); }.badge-inactive { background:rgba(107,114,128,.15); color:var(--text-dim); }.badge-active .material-symbols-outlined,.badge-inactive .material-symbols-outlined { font-size:13px; }.icon-btn { border:0; background:transparent; color:var(--text-muted); padding:4px; line-height:1; }.icon-btn:hover { color:var(--primary); }
        .pager { display:flex; align-items:center; justify-content:space-between; padding:14px 20px; border-top:1px solid var(--border); }.pager-info { font-size:13px; color:var(--text-muted); }.pager-nav { display:flex; gap:5px; }.pager-btn { display:inline-flex; align-items:center; justify-content:center; min-width:34px; min-height:32px; padding:6px 10px; border-radius:var(--r-sm); border:1px solid var(--border); background:rgba(255,255,255,.03); color:var(--text-muted); font-size:13px; font-weight:600; }.pager-btn:hover:not(:disabled) { background:var(--surface-h); color:var(--text); }.pager-btn.now { background:var(--primary-dim); color:var(--primary); border-color:rgba(129,140,248,.25); }.pager-btn:disabled { opacity:.4; cursor:not-allowed; }.empty-msg { text-align:center; padding:48px 24px; color:var(--text-muted); }
        .detail-overlay { display:none; position:fixed; inset:0; z-index:500; background:rgba(0,0,0,.68); backdrop-filter:blur(4px); padding:20px; overflow-y:auto; }.detail-overlay.open { display:flex; align-items:flex-start; justify-content:center; }.detail-modal { width:100%; max-width:620px; margin:auto; background:#0e1323; border:1px solid var(--border); border-radius:var(--r-lg); box-shadow:0 24px 64px rgba(0,0,0,.5); overflow:hidden; }.detail-head { display:flex; justify-content:space-between; align-items:center; padding:18px 22px; border-bottom:1px solid var(--border); }.detail-body { padding:22px; }.detail-row { display:flex; justify-content:space-between; gap:24px; padding:10px 0; border-bottom:1px solid var(--border-m); }.detail-row:last-child { border-bottom:0; }.detail-value { text-align:right; word-break:break-word; }.detail-label { color:var(--text-dim); }.icon-close { border:0; background:transparent; color:var(--text-muted); }.icon-close:hover { color:var(--primary); }
        @@media(max-width:650px) { .filter-field { width:100%; }.filter-field input,.filter-field select { width:100%; }.pager { flex-direction:column; align-items:flex-start; gap:10px; }.ad-main { padding-left:16px; padding-right:16px; } }
    </style>
    <link rel="stylesheet" href="~/css/components/pagination.css" asp-append-version="true" />
</head>
<body class="admin-page">
@await Html.PartialAsync("_ManagerTopbar")
@await Html.PartialAsync("_ManagerSidebar")
<main class="ad-main">
    <header class="page-head"><div><p class="page-label">Manager Monitoring</p><h1 class="ad-page-title">Credit Package Management</h1></div></header>
    <section class="data-card filter-bar"><div class="filter-field"><label for="cp-search">Search package</label><input id="cp-search" type="text" placeholder="Package name..." /></div><div class="filter-field"><label for="cp-active">Status</label><select id="cp-active"><option value="">All</option><option value="true">Active</option><option value="false">Inactive</option></select></div><div><button id="cp-apply" class="btn-filter" type="button">Apply</button><button id="cp-clear" class="btn-clear" type="button">Clear</button></div></section>
    <section class="data-card"><div class="data-card-head"><span class="data-card-title">All Packages</span><span id="cp-head-summary" style="font-size:13px;color:var(--text-muted)">Loading...</span></div><div style="overflow-x:auto"><table class="pkg-table"><thead><tr><th>Package</th><th class="th-r">Credits</th><th class="th-r">Price</th><th style="text-align:center">Status</th><th style="text-align:center">Order</th><th style="text-align:right">View</th></tr></thead><tbody id="cp-table-body"><tr><td colspan="6" class="empty-msg">Loading...</td></tr></tbody></table></div><div class="pager"><span id="cp-summary" class="pager-info">Loading...</span><nav id="cp-pages" class="devprep-pagination devprep-pagination-inline" aria-label="Pagination"></nav></div></section>
</main>
<div id="cp-detail" class="detail-overlay" onclick="if(event.target === this) closeDetail()"><section class="detail-modal"><header class="detail-head"><div><p class="page-label">Read only</p><h2 class="data-card-title" style="font-size:18px">Credit Package Details</h2></div><button class="icon-close" type="button" onclick="closeDetail()" title="Close"><span class="material-symbols-outlined">close</span></button></header><div id="cp-detail-body" class="detail-body">Loading...</div></section></div>
<script>
    const API_BASE = '@ViewData["ApiBaseUrl"]/api/admin/manager/credit-packages'; const token = '@token'; let currentPage = 1, pageSize = 10, totalPages = 1, searchTimer;
    document.addEventListener('DOMContentLoaded', () => { document.getElementById('cp-active').addEventListener('change', applyFilters); document.getElementById('cp-search').addEventListener('input', () => { clearTimeout(searchTimer); searchTimer = setTimeout(applyFilters, 300); }); document.getElementById('cp-apply').addEventListener('click', applyFilters); document.getElementById('cp-clear').addEventListener('click', () => { document.getElementById('cp-search').value = ''; document.getElementById('cp-active').value = ''; applyFilters(); }); fetchList(); });
    function applyFilters() { currentPage = 1; fetchList(); }
    async function fetchList() { const tbody = document.getElementById('cp-table-body'); tbody.innerHTML = '<tr><td colspan="6" class="empty-msg">Loading...</td></tr>'; try { const q = new URLSearchParams({page:currentPage,pageSize}); const keyword = document.getElementById('cp-search').value.trim(), active = document.getElementById('cp-active').value; if(keyword)q.set('keyword',keyword); if(active)q.set('isActive',active); const res = await fetch(`${API_BASE}?${q}`,{headers:{Authorization:`Bearer ${token}`}}); if(!res.ok)throw new Error(); const json=await res.json(); if(!json.success)throw new Error(); renderTable(json.data?.items || []); renderPagination(json.data || {}); } catch(e) { console.error(e); tbody.innerHTML='<tr><td colspan="6" class="empty-msg">Credit packages are temporarily unavailable.</td></tr>'; renderPagination({totalItems:0,totalPages:1}); } }
    function renderTable(items) { const tbody=document.getElementById('cp-table-body'); if(!items.length){tbody.innerHTML='<tr><td colspan="6" class="empty-msg">No packages found.</td></tr>';return;} tbody.innerHTML=items.map(p=>`<tr onclick="openDetail('${p.packageId}')"><td><div class="pkg-name">${escapeHtml(p.name)}</div><div class="pkg-desc">${escapeHtml(p.description || '')}</div></td><td class="td-r"><div class="pkg-credits-total">${p.credits || 0}${p.bonusCredits ? ` + ${p.bonusCredits}` : ''} CR</div><div class="pkg-credits-break">${p.bonusCredits ? `${p.credits || 0} base + ${p.bonusCredits} bonus` : 'No bonus credits'}</div></td><td class="td-r"><div class="pkg-price">${moneyNumber(p.price)}</div><div class="pkg-currency">${escapeHtml(p.currency || 'VND')}</div></td><td style="text-align:center">${statusBadge(p.isActive)}</td><td style="text-align:center"><span class="pkg-sort">${p.sortOrder ?? '-'}</span></td><td style="text-align:right"><button class="icon-btn" type="button" title="View details" onclick="event.stopPropagation();openDetail('${p.packageId}')"><span class="material-symbols-outlined">visibility</span></button></td></tr>`).join(''); }
    async function openDetail(id) { document.getElementById('cp-detail').classList.add('open'); const body=document.getElementById('cp-detail-body');body.innerHTML='Loading...';try{const res=await fetch(`${API_BASE}/${id}`,{headers:{Authorization:`Bearer ${token}`}});if(!res.ok)throw new Error();const json=await res.json();if(!json.success||!json.data)throw new Error();renderDetail(json.data);}catch{body.innerHTML='<p style="color:var(--text-muted)">Package details are temporarily unavailable.</p>';}}
    function closeDetail(){document.getElementById('cp-detail').classList.remove('open');} function renderDetail(d){const rows=[['Package ID',d.packageId],['Name',d.name],['Description',d.description || '-'],['Base credits',d.credits],['Bonus credits',d.bonusCredits],['Total credits',(d.credits || 0)+(d.bonusCredits || 0)],['Price',`${moneyNumber(d.price)} ${d.currency || 'VND'}`],['Sort order',d.sortOrder],['Status',statusBadge(d.isActive)],['Created at',fmtDateTime(d.createdAt)],['Updated at',fmtDateTime(d.updatedAt)]];document.getElementById('cp-detail-body').innerHTML=rows.map(([k,v])=>`<div class="detail-row"><span class="mono detail-label">${escapeHtml(k)}</span><span class="detail-value">${typeof v==='string'&&v.includes('badge-')?v:escapeHtml(v ?? '-')}</span></div>`).join('');}
    function renderPagination(data){totalPages=Math.max(data.totalPages||1,1);const total=data.totalItems||data.totalCount||0,page=data.page||currentPage,size=data.pageSize||pageSize;currentPage=page;const start=total?(page-1)*size+1:0,end=Math.min(page*size,total);document.getElementById('cp-summary').innerText=`Showing ${start}-${end} of ${total} packages`;document.getElementById('cp-head-summary').innerText=`Page ${page} of ${totalPages} · ${total} total`;DevPrepPagination.render({container:'cp-pages',currentPage,totalPages,onPageChange:goPage});} function goPage(p){if(p>=1&&p<=totalPages&&p!==currentPage){currentPage=p;fetchList();}}
    function statusBadge(active){return active?'<span class="badge-active"><span class="material-symbols-outlined">circle</span>Active</span>':'<span class="badge-inactive"><span class="material-symbols-outlined">circle</span>Inactive</span>';} function moneyNumber(v){return new Intl.NumberFormat('vi-VN',{maximumFractionDigits:0}).format(v||0);} function fmtDateTime(d){return d?new Date(d).toLocaleString('vi-VN'):'-';} function escapeHtml(v){return String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');}
</script>
    <script src="~/js/components/pagination.js" asp-append-version="true"></script>
</body>
</html>
