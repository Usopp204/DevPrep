@{
    var token = Context.Request.Cookies["access_token"];
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manager Credit Packages - DevPrep AI</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700;800;900&family=JetBrains+Mono:wght@@500&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@@100..700,0..1&display=swap" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#e2dfff", "on-primary-container": "#4e4c83", "primary-container": "#c3c0ff",
                        "success": "#10B981", "warning": "#F9D949",
                        "surface-container": "#201f23", "surface-container-high": "#2a292d", "surface-container-highest": "#353438",
                        "on-surface": "#e5e1e7", "on-surface-variant": "#c8c5d0",
                        "border-subtle": "rgba(255,255,255,0.08)", "background": "#0e1323"
                    },
                    spacing: { "xs": "8px", "sm": "12px", "md": "16px", "lg": "24px", "max-width": "1280px" },
                    fontFamily: { "display-lg": ["Inter"], "code-label": ["JetBrains Mono"], "headline-md": ["Inter"], "body-sm": ["Inter"], "body-md": ["Inter"] }
                }
            }
        }
    </script>
    <style>
        body { background-color: #0e1323; color: #e5e1e7; }
        .glass-card { background: rgba(32,31,35,0.4); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.08); border-top: 1px solid rgba(255,255,255,0.15); }
        .cp-main { margin-left: 250px; padding: 80px 24px 32px; min-height: 100vh; background: #0e1323; }
        .cp-toolbar { display: grid; grid-template-columns: minmax(180px,max-content) minmax(260px,1fr); gap: 16px; align-items: center; }
        .cp-select, .cp-input { background: #353438 !important; border: 1px solid rgba(255,255,255,.08) !important; border-radius: 10px !important; padding: 8px 12px !important; color: #e5e1e7 !important; font-size: 13px; outline: none; box-shadow: none !important; }
        .cp-search-shell { position: relative; min-width: 260px; }
        .cp-search-shell #cp-search { width: 100% !important; min-width: 0 !important; height: 40px !important; padding: 8px 14px 8px 44px !important; background: #353438 !important; color: #e5e1e7 !important; border: 1px solid rgba(255,255,255,.08) !important; border-radius: 10px !important; box-shadow: none !important; }
        .cp-search-shell #cp-search::placeholder { color: #9ca3af !important; opacity: 1 !important; }
        .cp-search-shell .material-symbols-outlined { pointer-events: none; z-index: 2; }
        .side-drawer { transition: transform .3s cubic-bezier(.4,0,.2,1); }
        .drawer-hidden { transform: translateX(100%); }
        .ad-sidebar h2, .ad-sidebar p, .ad-sidebar a { margin-bottom: 0; }
        button:disabled { opacity: .45; cursor: not-allowed; }
        @@media (max-width: 900px) {
            .cp-main { margin-left: 0; padding-left: 16px; padding-right: 16px; }
            .cp-toolbar { grid-template-columns: 1fr; }
            .cp-search-shell { min-width: 0; }
        }
    </style>
</head>
<body class="font-body-md overflow-x-hidden">
    @await Html.PartialAsync("_ManagerTopbar")
    @await Html.PartialAsync("_ManagerSidebar")

    <main class="cp-main">
        <div class="mb-6">
            <h1 class="font-display-lg text-[24px] font-bold text-primary tracking-tight">Credit Package Monitoring</h1>
        </div>

        <div class="max-w-max-width mx-auto">
            <section class="glass-card rounded-2xl p-md mb-lg cp-toolbar">
                <select id="cp-active" class="cp-select">
                    <option value="">All status</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
                <div class="cp-search-shell">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
                    <input id="cp-search" placeholder="Search package name..." type="text" />
                </div>
            </section>

            <section class="glass-card rounded-2xl overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse min-w-[900px]">
                        <thead>
                            <tr class="bg-surface-container-high/50 border-b border-border-subtle">
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Package</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Credits</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Bonus</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Price</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Sort</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Status</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Updated</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="cp-table-body" class="font-body-sm text-on-surface">
                            <tr><td colspan="8" class="text-center py-4">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="px-lg py-md flex items-center justify-between border-t border-border-subtle bg-surface-container/20">
                    <p id="cp-summary" class="font-code-label text-[11px] text-on-surface-variant uppercase">Loading...</p>
                    <div class="flex gap-xs items-center">
                        <button id="cp-prev" class="p-1 rounded bg-surface-container border border-border-subtle text-on-surface-variant hover:text-primary" type="button"><span class="material-symbols-outlined">chevron_left</span></button>
                        <span id="cp-page" class="px-3 py-1 rounded bg-primary-container text-on-primary-container font-code-label text-[11px] font-bold">1</span>
                        <button id="cp-next" class="p-1 rounded bg-surface-container border border-border-subtle text-on-surface-variant hover:text-primary" type="button"><span class="material-symbols-outlined">chevron_right</span></button>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <div class="fixed inset-0 bg-black/40 backdrop-blur-sm z-[60] hidden opacity-0 transition-opacity duration-300" id="drawer-overlay" onclick="toggleDrawer(false)"></div>
    <aside class="fixed top-0 right-0 h-full w-[560px] max-w-full z-[70] glass-card drawer-hidden side-drawer shadow-2xl flex flex-col" id="cp-drawer">
        <div class="p-lg border-b border-border-subtle flex items-center justify-between">
            <h2 class="font-headline-md text-primary">Credit Package Details</h2>
            <button class="p-2 rounded-full hover:bg-surface-container-high text-on-surface-variant" onclick="toggleDrawer(false)"><span class="material-symbols-outlined">close</span></button>
        </div>
        <div id="cp-detail-body" class="flex-1 overflow-y-auto p-lg space-y-lg">
            <p class="text-on-surface-variant">Loading...</p>
        </div>
    </aside>

    <script>
        const API_BASE = '@ViewData["ApiBaseUrl"]/api/admin/manager/credit-packages';
        const token = '@token';
        let currentPage = 1, pageSize = 10, totalPages = 1, searchTimer = null;

        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('cp-active').addEventListener('change', () => { currentPage = 1; fetchList(); });
            document.getElementById('cp-search').addEventListener('input', () => { clearTimeout(searchTimer); searchTimer = setTimeout(() => { currentPage = 1; fetchList(); }, 300); });
            document.getElementById('cp-prev').addEventListener('click', () => { if (currentPage > 1) { currentPage--; fetchList(); } });
            document.getElementById('cp-next').addEventListener('click', () => { if (currentPage < totalPages) { currentPage++; fetchList(); } });
            fetchList();
        });

        async function fetchList() {
            const tbody = document.getElementById('cp-table-body');
            tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4">Loading...</td></tr>`;
            try {
                const q = new URLSearchParams({ page: currentPage, pageSize });
                const keyword = document.getElementById('cp-search').value.trim();
                const active = document.getElementById('cp-active').value;
                if (keyword) q.set('keyword', keyword);
                if (active) q.set('isActive', active);
                const res = await fetch(`${API_BASE}?${q}`, { headers: { 'Authorization': `Bearer ${token}` } });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const json = await res.json();
                if (!json.success) throw new Error(json.message || 'Failed');
                const data = json.data || {};
                const items = data.items || [];
                renderTable(items);
                renderPagination(data);
            } catch (e) {
                console.error(e);
                tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-on-surface-variant">Credit packages are temporarily unavailable.</td></tr>`;
                renderPagination({ page: currentPage, pageSize, totalItems: 0, totalPages: 1 });
            }
        }

        function renderTable(items) {
            const tbody = document.getElementById('cp-table-body');
            if (!items.length) {
                tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-on-surface-variant">No credit packages found.</td></tr>`;
                return;
            }
            tbody.innerHTML = items.map(item => `
                <tr class="border-b border-border-subtle/50 hover:bg-surface-container-high/30 cursor-pointer" onclick="openDetail('${item.packageId}')">
                    <td class="px-lg py-md">
                        <div class="font-semibold text-primary">${escapeHtml(item.name)}</div>
                        <div class="text-[12px] text-on-surface-variant max-w-[360px] truncate">${escapeHtml(item.description || '-')}</div>
                    </td>
                    <td class="px-lg py-md font-code-label">${item.credits || 0}</td>
                    <td class="px-lg py-md font-code-label text-on-surface-variant">${item.bonusCredits || 0}</td>
                    <td class="px-lg py-md font-semibold">${money(item.price)}</td>
                    <td class="px-lg py-md font-code-label text-on-surface-variant">${item.sortOrder ?? '-'}</td>
                    <td class="px-lg py-md">${statusBadge(item.isActive)}</td>
                    <td class="px-lg py-md font-code-label text-on-surface-variant">${fmtDate(item.updatedAt)}</td>
                    <td class="px-lg py-md text-right">
                        <button class="text-on-surface-variant hover:text-primary" onclick="event.stopPropagation(); openDetail('${item.packageId}')" title="View"><span class="material-symbols-outlined text-[20px]">visibility</span></button>
                    </td>
                </tr>`).join('');
        }

        async function openDetail(id) {
            toggleDrawer(true);
            const body = document.getElementById('cp-detail-body');
            body.innerHTML = `<p class="text-on-surface-variant">Loading...</p>`;
            try {
                const res = await fetch(`${API_BASE}/${id}`, { headers: { 'Authorization': `Bearer ${token}` } });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const json = await res.json();
                if (!json.success || !json.data) throw new Error(json.message || 'Failed');
                renderDetail(json.data);
            } catch (e) {
                console.error(e);
                body.innerHTML = `<p class="text-on-surface-variant">Package details are temporarily unavailable.</p>`;
            }
        }

        function renderDetail(d) {
            const rows = [
                ['Package id', d.packageId],
                ['Name', d.name],
                ['Description', d.description || '-'],
                ['Credits', d.credits],
                ['Bonus credits', d.bonusCredits],
                ['Price', money(d.price)],
                ['Currency', d.currency],
                ['Sort order', d.sortOrder],
                ['Status', statusBadge(d.isActive)],
                ['Created at', fmtDateTime(d.createdAt)],
                ['Updated at', fmtDateTime(d.updatedAt)]
            ];
            document.getElementById('cp-detail-body').innerHTML = `
                <div class="glass-card rounded-xl p-md">
                    <div class="flex items-center justify-between mb-3">
                        <div>
                            <p class="font-code-label text-[11px] uppercase text-on-surface-variant">Package</p>
                            <h3 class="text-[22px] font-bold text-primary">${escapeHtml(d.name)}</h3>
                        </div>
                        ${statusBadge(d.isActive)}
                    </div>
                    ${rows.map(detailRow).join('')}
                </div>`;
        }

        function renderPagination(data) {
            totalPages = Math.max(data.totalPages || 1, 1);
            const total = data.totalItems || data.totalCount || 0, page = data.page || currentPage, size = data.pageSize || pageSize;
            const start = total === 0 ? 0 : ((page - 1) * size) + 1, end = Math.min(page * size, total);
            document.getElementById('cp-summary').innerText = `Showing ${start}-${end} of ${total} packages`;
            document.getElementById('cp-page').innerText = `${page}`;
            document.getElementById('cp-prev').disabled = page <= 1;
            document.getElementById('cp-next').disabled = page >= totalPages;
        }

        function detailRow([label, value]) {
            return `<div class="flex justify-between gap-4 py-2 border-b border-border-subtle/60 last:border-b-0">
                <span class="text-on-surface-variant text-[13px]">${escapeHtml(label)}</span>
                <span class="text-right text-on-surface text-[13px] break-all">${typeof value === 'string' && value.includes('<span') ? value : escapeHtml(value ?? '-')}</span>
            </div>`;
        }
        function money(value) { return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND', maximumFractionDigits: 0 }).format(value || 0); }
        function statusBadge(isActive) {
            return isActive
                ? `<span class="px-xs py-1 rounded-full border text-[10px] font-bold uppercase bg-success/10 border-success/30 text-success">Active</span>`
                : `<span class="px-xs py-1 rounded-full border text-[10px] font-bold uppercase bg-warning/10 border-warning/30 text-warning">Inactive</span>`;
        }
        function fmtDate(d) { if (!d) return '-'; const x = new Date(d); const m = ["JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"]; return `${m[x.getMonth()]} ${x.getDate().toString().padStart(2,'0')}`; }
        function fmtDateTime(d) { if (!d) return '-'; return new Date(d).toLocaleString(); }
        function escapeHtml(v) { return String(v ?? '').replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;"); }
        function toggleDrawer(show) {
            const drawer = document.getElementById('cp-drawer'), overlay = document.getElementById('drawer-overlay');
            if (show) { drawer.classList.remove('drawer-hidden'); overlay.classList.remove('hidden'); setTimeout(() => overlay.classList.add('opacity-100'), 10); document.body.style.overflow = 'hidden'; }
            else { drawer.classList.add('drawer-hidden'); overlay.classList.remove('opacity-100'); setTimeout(() => { overlay.classList.add('hidden'); document.body.style.overflow = 'auto'; }, 300); }
        }
    </script>
</body>
</html>
