@{
    var token = Context.Request.Cookies["access_token"];
    var sessionId = (System.Guid)ViewBag.SessionId;
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Session Detail - DevPrep AI</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700;800;900&family=JetBrains+Mono:wght@@500&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@@100..700,0..1&display=swap" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#e2dfff", "on-primary": "#2c2a5e", "primary-container": "#c3c0ff",
                        "on-primary-container": "#4e4c83", "secondary": "#4cd7f6", "secondary-container": "#03b5d4",
                        "on-secondary-container": "#00424e", "tertiary": "#e9ddff", "tertiary-container": "#d0bcff",
                        "success": "#10B981", "warning": "#F9D949", "error": "#ffb4ab",
                        "surface": "#131317", "surface-container": "#201f23", "surface-container-low": "#1c1b1f",
                        "surface-container-high": "#2a292d", "surface-container-highest": "#353438",
                        "on-surface": "#e5e1e7", "on-surface-variant": "#c8c5d0",
                        "border-subtle": "rgba(255,255,255,0.08)", "background": "#0e1323", "outline": "#928f9a"
                    },
                    borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                    spacing: { "sm": "12px", "md": "16px", "lg": "24px", "xl": "32px", "gutter": "24px", "xs": "8px", "max-width": "1280px" },
                    fontFamily: { "display-lg": ["Inter"], "code-label": ["JetBrains Mono"], "headline-md": ["Inter"], "body-sm": ["Inter"], "body-md": ["Inter"] }
                }
            }
        }
    </script>
    <style>
        body { background-color: #0e1323; color: #e5e1e7; }
        .glass-card { background: rgba(32,31,35,0.4); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.08); border-top: 1px solid rgba(255,255,255,0.15); }
        .ad-sidebar h2, .ad-sidebar p, .ad-sidebar a { margin-bottom: 0; }
        .iv-main { margin-left: 250px; padding-top: 80px; padding-left: 24px; padding-right: 24px; min-height: 100vh; background: #0e1323; }
    </style>
</head>
<body class="font-body-md overflow-x-hidden">
    @await Html.PartialAsync("_ManagerTopbar")
    @await Html.PartialAsync("_ManagerSidebar")

    <main class="iv-main">
        <div class="max-w-[1100px] mx-auto">
            <div class="mb-6 flex items-center gap-md">
                <a href="/Manager/InterviewSessions" class="p-2 rounded-full bg-surface-container border border-border-subtle text-on-surface-variant hover:text-on-surface transition-all" title="Back to Sessions">
                    <span class="material-symbols-outlined align-middle">arrow_back</span>
                </a>
                <h1 class="font-display-lg text-[24px] font-bold text-primary tracking-tight">Session Detail</h1>
            </div>

            <div id="iv-detail-body" class="space-y-lg pb-10">
                <p class="text-on-surface-variant">Loading...</p>
            </div>
        </div>
    </main>

    <script>
        const API_BASE = '@ViewData["ApiBaseUrl"]/api/admin/manager/sessions';
        const token = '@token';
        const SESSION_ID = '@sessionId';

        document.addEventListener("DOMContentLoaded", () => {
            loadDetail();
        });

        async function loadDetail() {
            const body = document.getElementById('iv-detail-body');
            body.innerHTML = `<p class="text-on-surface-variant">Loading...</p>`;
            try {
                const res = await fetch(`${API_BASE}/${SESSION_ID}/log`, { headers: { 'Authorization': `Bearer ${token}` } });
                if (res.status === 404) { body.innerHTML = `<p class="text-error">Session not found.</p>`; return; }
                if (res.status === 401 || res.status === 403) { window.location.href = '/Auth/Login'; return; }
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const json = await res.json();
                if (json.success && json.data) renderDetail(json.data);
                else body.innerHTML = `<p class="text-error">Failed to load details.</p>`;
            } catch (e) { body.innerHTML = `<p class="text-error">Data is temporarily unavailable.</p>`; }
        }

        function renderDetail(d) {
            const meta = [
                ['Level', badge(d.level)], ['Mode', badge(d.interactionMode)], ['Type', badge(d.questionType)],
                ['Planned', `${d.durationMinutes} min`], ['Started', fmtDateTime(d.startedAt)], ['Ended', fmtDateTime(d.endedAt)],
                ['Actual', actualDuration(d.startedAt, d.endedAt)], ['Credit', String(d.creditCost)],
                ['Questions', `${d.answeredQuestions}/${d.totalQuestions}`], ['Avg response', msToSec(d.avgResponseTimeMs)],
                ['CV / JD', `${d.cvId ? 'CV' : '-'} / ${d.jdId ? 'JD' : '-'}`], ['Created', fmtDateTime(d.createdAt)]
            ];
            const metaHtml = meta.map(m => `<div class="flex justify-between gap-sm py-1 border-b border-border-subtle/40"><span class="font-code-label text-[11px] uppercase text-on-surface-variant">${m[0]}</span><span class="font-body-sm text-on-surface text-right">${m[1]}</span></div>`).join('');

            const questions = (d.questions || []);
            const transcriptHtml = questions.length ? questions.map(qz => `
                <div class="glass-card rounded-xl p-md">
                    <div class="flex items-start gap-sm mb-2">
                        <span class="font-code-label text-[11px] text-primary uppercase whitespace-nowrap">Q ${qz.orderIndex}</span>
                        <span class="px-xs py-0.5 rounded text-[9px] uppercase font-code-label ${qz.isAiGenerated ? 'bg-secondary-container/20 text-secondary' : 'bg-tertiary-container/20 text-tertiary'}">${qz.isAiGenerated ? 'AI' : 'Bank'}</span>
                        <span class="text-on-surface-variant text-[10px] ml-auto whitespace-nowrap">${fmtDateTime(qz.askedAt)}</span>
                    </div>
                    <p class="font-body-sm text-on-surface mb-3">${escapeHtml(qz.content || '')}</p>
                    <div class="space-y-2">${(qz.messages || []).map(msgBubble).join('') || '<p class="text-on-surface-variant text-[12px] italic">No messages yet.</p>'}</div>
                </div>`).join('') : '<p class="text-on-surface-variant text-[13px] italic">No questions / transcript yet.</p>';

            document.getElementById('iv-detail-body').innerHTML = `
                <div class="glass-card rounded-2xl p-lg flex items-start justify-between gap-md flex-wrap">
                    <div class="flex items-start gap-md">
                        <div class="w-14 h-14 rounded-2xl bg-primary/20 text-primary flex items-center justify-center font-bold text-xl">${initial(d.userFullName)}</div>
                        <div>
                            <h3 class="text-headline-md font-bold">${escapeHtml(userLabel(d))}</h3>
                            <p class="text-on-surface-variant font-code-label text-[12px]">${escapeHtml(d.userEmail || '-')}</p>
                            <p class="font-body-sm text-on-surface mt-1">${statusBadge(d.status)}</p>
                        </div>
                    </div>
                </div>
                <div class="glass-card rounded-xl p-md grid grid-cols-1 md:grid-cols-2 gap-x-xl">${metaHtml}</div>
                <div>
                    <div class="flex items-center justify-between mb-2"><span class="font-code-label text-[11px] uppercase text-on-surface-variant">Transcript</span></div>
                    <div class="space-y-md">${transcriptHtml}</div>
                </div>`;
        }

        function msgBubble(m) {
            const s = m.senderType;
            const align = s === 'User' ? 'items-end' : (s === 'System' ? 'items-center' : 'items-start');
            const color = s === 'User' ? 'bg-primary-container/20 text-on-surface' : (s === 'System' ? 'bg-surface-container-highest/40 text-on-surface-variant italic' : 'bg-secondary-container/15 text-on-surface');
            const audio = (m.messageType === 'Audio' && m.audioUrl) ? `<audio controls src="${escapeHtml(m.audioUrl)}" class="mt-1 h-8"></audio>` : '';
            const rt = (s === 'User' && m.responseTimeMs) ? `<span class="text-on-surface-variant text-[9px]">${msToSec(m.responseTimeMs)}</span>` : '';
            return `<div class="flex flex-col ${align}">
                <div class="max-w-[85%] rounded-xl px-3 py-2 ${color}">
                    <div class="flex items-center gap-xs mb-0.5"><span class="text-[9px] font-code-label uppercase opacity-70">${s}</span>${rt}</div>
                    <p class="font-body-sm whitespace-pre-wrap">${escapeHtml(m.content || '')}</p>${audio}
                </div>
            </div>`;
        }

        function userLabel(it) { return cleanText(it.userFullName) || (it.userId ? 'User ' + String(it.userId).substring(0, 5) : 'Unknown'); }
        function initial(n) { const clean = cleanText(n); return clean && clean.trim() ? clean.trim()[0].toUpperCase() : 'U'; }
        function badge(t) { return t ? `<span class="px-xs py-0.5 rounded bg-surface-container-highest text-on-surface-variant text-[10px] uppercase font-code-label">${escapeHtml(t)}</span>` : '-'; }
        function statusBadge(s) {
            const map = { InProgress: 'bg-secondary/15 border-secondary/40 text-secondary', Completed: 'bg-success/10 border-success/30 text-success', Configured: 'bg-warning/10 border-warning/30 text-warning', Initialized: 'bg-warning/10 border-warning/30 text-warning', Expired: 'bg-tertiary-container/15 border-tertiary/30 text-tertiary', Cancelled: 'bg-error/10 border-error/30 text-error' };
            return `<span class="px-xs py-1 rounded-full border text-[10px] font-bold uppercase ${map[s] || 'bg-surface-container-highest border-border-subtle text-on-surface-variant'}">${escapeHtml(s || '')}</span>`;
        }
        function fmtDateTime(d) { if (!d) return '-'; const x = new Date(d); return x.toLocaleString(); }
        function msToSec(ms) { if (!ms && ms !== 0) return '-'; return (ms / 1000).toFixed(1) + 's'; }
        function actualDuration(a, b) { if (!a || !b) return '-'; const ms = new Date(b) - new Date(a); if (ms < 0) return '-'; const min = Math.floor(ms / 60000), sec = Math.floor((ms % 60000) / 1000); return `${min}m ${sec}s`; }
        function cleanText(value) {
            let text = String(value || '');
            for (let i = 0; i < 2; i++) {
                if (!/[\u00C3\u00C2\u00E2\u00C4\u00C5\uFFFD]/.test(text)) break;
                try {
                    const windows1252 = {
                        0x20AC: 0x80, 0x201A: 0x82, 0x0192: 0x83, 0x201E: 0x84,
                        0x2026: 0x85, 0x2020: 0x86, 0x2021: 0x87, 0x02C6: 0x88,
                        0x2030: 0x89, 0x0160: 0x8A, 0x2039: 0x8B, 0x0152: 0x8C,
                        0x017D: 0x8E, 0x2018: 0x91, 0x2019: 0x92, 0x201C: 0x93,
                        0x201D: 0x94, 0x2022: 0x95, 0x2013: 0x96, 0x2014: 0x97,
                        0x02DC: 0x98, 0x2122: 0x99, 0x0161: 0x9A, 0x203A: 0x9B,
                        0x0153: 0x9C, 0x017E: 0x9E, 0x0178: 0x9F
                    };
                    const bytes = Uint8Array.from([...text].map(ch => {
                        const code = ch.charCodeAt(0);
                        return windows1252[code] || (code <= 255 ? code : 63);
                    }));
                    const fixed = new TextDecoder('utf-8', { fatal: false }).decode(bytes);
                    if (!fixed || fixed === text) break;
                    text = fixed;
                } catch {
                    break;
                }
            }
            return text;
        }
        function escapeHtml(u) { return cleanText(u).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;"); }
    </script>
</body>
</html>
