@{
    var token = Context.Request.Cookies["access_token"];
    var feedbackTitle = ViewData["FeedbackTitle"] as string ?? "System Feedback";
    var feedbackKind = ViewData["FeedbackKind"] as string ?? "system";
    var feedbackApiBase = ViewData["FeedbackApiBase"] as string ?? "http://localhost:7007/api/admin/manager/feedbacks";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@feedbackTitle - DevPrep AI</title>

    <!-- Include admin.css for Topbar and Sidebar -->
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    <!-- Extract Tailwind and Fonts from code.html -->

<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>DevPrep AI | @feedbackTitle</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;family=JetBrains+Mono:wght@500&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "on-secondary-container": "#00424e",
                    "surface": "#131317",
                    "surface-container-high": "#2a292d",
                    "tertiary-fixed-dim": "#d0bcff",
                    "surface-bright": "#34394a",
                    "on-primary": "#2c2a5e",
                    "outline-variant": "#47464f",
                    "primary-container": "#c3c0ff",
                    "on-primary-container": "#4e4c83",
                    "glass-fill": "rgba(17, 24, 39, 0.6)",
                    "on-secondary-fixed-variant": "#004e5c",
                    "tertiary": "#e9ddff",
                    "warning": "#F9D949",
                    "secondary-fixed": "#acedff",
                    "success": "#10B981",
                    "error-container": "#93000a",
                    "error": "#ffb4ab",
                    "on-primary-fixed": "#161349",
                    "surface-dim": "#131317",
                    "on-secondary-fixed": "#001f26",
                    "inverse-surface": "#e5e1e7",
                    "inverse-on-surface": "#313034",
                    "secondary-container": "#03b5d4",
                    "on-tertiary-fixed-variant": "#4d3d76",
                    "primary": "#e2dfff",
                    "on-tertiary-fixed": "#210f48",
                    "secondary-fixed-dim": "#4cd7f6",
                    "secondary": "#4cd7f6",
                    "primary-fixed-dim": "#c3c0ff",
                    "on-surface-variant": "#c8c5d0",
                    "on-secondary": "#003640",
                    "border-subtle": "rgba(255, 255, 255, 0.08)",
                    "background": "#0e1323",
                    "outline": "#928f9a",
                    "on-tertiary-container": "#594983",
                    "surface-container": "#201f23",
                    "surface-container-low": "#1c1b1f",
                    "on-primary-fixed-variant": "#434176",
                    "surface-variant": "#353438",
                    "surface-tint": "#c3c0ff",
                    "tertiary-fixed": "#e9ddff",
                    "on-tertiary": "#37265e",
                    "on-error-container": "#ffdad6",
                    "on-error": "#690005",
                    "on-background": "#e5e1e7",
                    "surface-container-highest": "#353438",
                    "inverse-primary": "#5a5890",
                    "tertiary-container": "#d0bcff",
                    "surface-container-lowest": "#0e0e11",
                    "primary-fixed": "#e3dfff"
            },
            "borderRadius": {
                    "DEFAULT": "0.125rem",
                    "lg": "0.25rem",
                    "xl": "0.5rem",
                    "full": "0.75rem"
            },
            "spacing": {
                    "sm": "12px",
                    "unit": "4px",
                    "md": "16px",
                    "gutter": "24px",
                    "xl": "32px",
                    "max-width": "1200px",
                    "2xl": "48px",
