</select>
</div>
<div class="flex items-center gap-sm">
<span class="font-code-label text-[11px] uppercase text-on-surface-variant">Type</span>
<div class="flex gap-xs">
<button class="px-md py-1 rounded-full bg-primary-container/10 border border-primary-container text-primary-container font-code-label text-[10px] uppercase">All</button>
