<span id="feedback-page" class="px-3 py-1 rounded bg-primary-container text-on-primary-container font-code-label text-[11px] font-bold">1</span>
<button id="feedback-next" class="p-1 rounded bg-surface-container border border-border-subtle text-on-surface-variant hover:text-primary transition-colors" type="button"><span class="material-symbols-outlined">chevron_right</span></button>
</div>
</div>
