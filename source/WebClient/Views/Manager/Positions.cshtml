@{
    var token = Context.Request.Cookies["access_token"];
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Positions - DevPrep AI</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700;800;900&family=JetBrains+Mono:wght@@500&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@@100..700,0..1&display=swap" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#e2dfff", "on-primary": "#2c2a5e", "primary-container": "#c3c0ff",
                        "on-primary-container": "#4e4c83", "secondary": "#4cd7f6", "secondary-container": "#03b5d4",
                        "on-secondary-container": "#00424e", "tertiary": "#e9ddff", "tertiary-container": "#d0bcff",
                        "success": "#10B981", "warning": "#F9D949", "error": "#ffb4ab",
                        "surface": "#131317", "surface-container": "#201f23", "surface-container-low": "#1c1b1f",
                        "surface-container-high": "#2a292d", "surface-container-highest": "#353438",
                        "on-surface": "#e5e1e7", "on-surface-variant": "#c8c5d0",
                        "border-subtle": "rgba(255,255,255,0.08)", "background": "#0e1323", "outline": "#928f9a"
                    },
                    borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                    spacing: { "sm": "12px", "md": "16px", "lg": "24px", "xl": "32px", "gutter": "24px", "xs": "8px", "max-width": "1280px" },
                    fontFamily: { "display-lg": ["Inter"], "code-label": ["JetBrains Mono"], "headline-md": ["Inter"], "body-sm": ["Inter"], "body-md": ["Inter"] }
                }
            }
        }
    </script>
    <style>
        body { background-color: #0e1323; color: #e5e1e7; }
        .glass-card { background: rgba(32,31,35,0.4); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.08); border-top: 1px solid rgba(255,255,255,0.15); }
        .ad-sidebar h2, .ad-sidebar p, .ad-sidebar a { margin-bottom: 0; }
        .pos-main { margin-left: 250px; padding-top: 80px; padding-left: 24px; padding-right: 24px; min-height: 100vh; background: #0e1323; }
    </style>
    <link rel="stylesheet" href="~/css/components/pagination.css" asp-append-version="true" />
</head>
<body class="font-body-md overflow-x-hidden">
    @await Html.PartialAsync("_ManagerTopbar")
    @await Html.PartialAsync("_ManagerSidebar")

    <main class="pos-main">
        <div class="mb-6">
            <h1 class="font-display-lg text-[24px] font-bold text-primary tracking-tight">Positions</h1>
            <p class="text-on-surface-variant text-[13px] mt-1">Read only - position management is available to administrators.</p>
        </div>

        <div class="max-w-max-width mx-auto">
            <!-- Filter Bar -->
            <section class="glass-card rounded-2xl p-md mb-lg flex flex-wrap items-center gap-md">
                <div class="ml-auto relative flex-1 min-w-[160px] max-w-[320px]">
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
                    <input id="pos-search" class="w-full bg-surface-container border-border-subtle border rounded-xl pl-4 pr-10 py-1.5 font-body-sm focus:ring-1 focus:ring-primary-container" placeholder="Search name..." type="text" />
                </div>
            </section>

            <!-- Table -->
            <section class="glass-card rounded-2xl overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse min-w-[760px]">
                        <thead>
                            <tr class="bg-surface-container-high/50 border-b border-border-subtle">
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Name</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Questions</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Created</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Status</th>
                            </tr>
                        </thead>
                        <tbody id="pos-table-body" class="font-body-sm text-on-surface">
                            <tr><td colspan="4" class="text-center py-4">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="px-lg py-md flex items-center justify-between border-t border-border-subtle bg-surface-container/20">
                    <span id="pos-total" class="font-code-label text-[11px] text-on-surface-variant"></span>
                    <div class="flex gap-xs items-center">
                        <nav id="pos-pages" class="devprep-pagination devprep-pagination-inline" aria-label="Pagination"></nav>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <script>
        const API_BASE = '@ViewData["ApiBaseUrl"]/api/admin/manager/positions';
        const token = '@token';
        let currentPage = 1, pageSize = 10, totalPages = 1, searchTimer = null;

        document.addEventListener("DOMContentLoaded", () => {
            document.getElementById('pos-search').addEventListener('input', () => { clearTimeout(searchTimer); searchTimer = setTimeout(() => { currentPage = 1; fetchList(); }, 300); });
            fetchList();
        });

        function escapeHtml(s) { return (s ?? '').toString().replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
        function fmtDate(s) { if (!s) return '-'; const d = new Date(s); return d.toLocaleDateString('en-GB') + ' ' + d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }); }

        async function fetchList() {
            const tbody = document.getElementById('pos-table-body');
            try {
                const q = new URLSearchParams({ pageIndex: currentPage, pageSize, status: 'Active' });
                const kw = document.getElementById('pos-search').value.trim(); if (kw) q.set('search', kw);
                const res = await fetch(`${API_BASE}?${q}`, { headers: { 'Authorization': `Bearer ${token}` } });
                if (res.status === 401 || res.status === 403) { window.location.href = '/Auth/Login'; return; }
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const json = await res.json();
                if (json.success) { renderTable(json.data.items || []); renderPagination(json.data); }
                else tbody.innerHTML = `<tr><td colspan="4" class="text-center py-4 text-error">Data is temporarily unavailable.</td></tr>`;
            } catch (e) { tbody.innerHTML = `<tr><td colspan="4" class="text-center py-4 text-error">Data is temporarily unavailable.</td></tr>`; }
        }

        function renderTable(items) {
            const tbody = document.getElementById('pos-table-body');
            if (!items.length) { tbody.innerHTML = `<tr><td colspan="4" class="text-center py-4 text-on-surface-variant">No positions found.</td></tr>`; return; }
            tbody.innerHTML = items.map(it => `
                <tr class="border-b border-border-subtle/50 hover:bg-surface-container-high/30">
                    <td class="px-lg py-md font-semibold text-on-surface">${escapeHtml(it.name)}</td>
                    <td class="px-lg py-md font-code-label text-on-surface-variant">${it.questionCount}</td>
                    <td class="px-lg py-md font-code-label text-on-surface-variant">${fmtDate(it.createdAt)}</td>
                    <td class="px-lg py-md"><span class="px-xs py-0.5 rounded text-[9px] uppercase font-code-label bg-success/20 text-success">Active</span></td>
                </tr>`).join('');
        }

        function renderPagination(data) {
            totalPages = Math.max(data.totalPages || 1, 1);
            if (currentPage > totalPages) currentPage = totalPages;
            document.getElementById('pos-total').innerText = `${data.totalRecords || 0} position(s)`;
            DevPrepPagination.render({ container: 'pos-pages', currentPage, totalPages, onPageChange: pageNumber => { currentPage = pageNumber; fetchList(); } });
        }
    </script>
    <script src="~/js/components/pagination.js" asp-append-version="true"></script>
</body>
</html>
