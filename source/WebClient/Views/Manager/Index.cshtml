@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DevPrep AI Manager Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@100..900&family=JetBrains+Mono:wght@@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-page">
    @await Html.PartialAsync("_ManagerTopbar")
    @await Html.PartialAsync("_ManagerSidebar")

    <main class="ad-main">
        <header class="mb-4">
            <h1 class="ad-page-title">System Overview</h1>
            <p class="ad-page-date">Manager read-only workspace</p>
        </header>

        <section class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mb-4">
            <div class="col">
                <a class="glass-card ad-stat text-decoration-none d-block h-100" href="/Manager/Users">
                    <div class="ad-stat-top">
                        <span class="ad-stat-label">User Profiles</span>
                        <span class="material-symbols-outlined" style="color:#e2dfff; opacity:.6;">group</span>
                    </div>
                    <div>
                        <div class="ad-stat-value">Audit</div>
                        <div class="ad-stat-delta"><span class="material-symbols-outlined" style="font-size:16px;">visibility</span> Read-only user monitoring</div>
                    </div>
                </a>
            </div>
            <div class="col">
                <a class="glass-card ad-stat text-decoration-none d-block h-100" href="/Manager/QuestionBank">
                    <div class="ad-stat-top">
                        <span class="ad-stat-label">Question Bank</span>
                        <span class="material-symbols-outlined" style="color:#4cd7f6; opacity:.6;">database</span>
                    </div>
                    <div>
                        <div class="ad-stat-value">Review</div>
                        <div class="ad-spark">
                            <span style="height:16px; opacity:.3;"></span>
                            <span style="height:24px; opacity:.5;"></span>
                            <span style="height:11px; opacity:.4;"></span>
                            <span style="height:21px; opacity:.7;"></span>
                            <span style="height:32px; opacity:.9;"></span>
                            <span style="height:26px;"></span>
                            <span style="height:16px; opacity:.6;"></span>
                            <span style="height:32px;"></span>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col">
                <a class="glass-card ad-stat text-decoration-none d-block h-100" href="/Manager/Feedback">
                    <div class="ad-stat-top">
                        <span class="ad-stat-label">System Feedback</span>
                        <span class="material-symbols-outlined" style="color:#c3c0ff; opacity:.6;">forum</span>
                    </div>
                    <div>
                        <div class="ad-stat-value" style="font-size:24px; color:#c3c0ff; line-height:1.2;">Quality</div>
                        <div class="ad-stat-label" style="text-transform:none; margin-top:8px;">Complaints and suggestions</div>
                    </div>
                </a>
            </div>
            <div class="col">
                <a class="glass-card ad-stat text-decoration-none d-block h-100" href="/Manager/News">
                    <div class="ad-stat-top">
                        <span class="ad-stat-label">News Tracker</span>
                        <span class="material-symbols-outlined" style="color:#F9D949; opacity:.6;">newspaper</span>
                    </div>
                    <div>
                        <div class="ad-stat-value">Content</div>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <span style="width:8px; height:8px; border-radius:9999px; background:#10B981; display:inline-block;" class="active-pulse"></span>
                            <span style="color:#10B981; font-size:14px; font-weight:500;">Read-only</span>
                        </div>
                    </div>
                </a>
            </div>
        </section>

        <section class="glass-card ad-section">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="ad-section-title">Monthly Activity Snapshot</h3>
                <div class="ad-legend">
                    <div><span style="width:12px; height:12px; background:#e2dfff; border-radius:2px; display:inline-block;"></span><span class="k">Profiles</span></div>
                    <div><span style="width:12px; height:2px; background:#4cd7f6; display:inline-block;"></span><span class="k">Sessions</span></div>
                </div>
            </div>
            <div class="ad-chart">
                <div class="ad-chart-grid">
                    <div></div><div></div><div></div><div></div>
                </div>
                <div class="ad-chart-bar"><div class="bar" style="height:96px;"></div><span>JAN</span></div>
                <div class="ad-chart-bar"><div class="bar" style="height:128px;"></div><span>FEB</span></div>
                <div class="ad-chart-bar"><div class="bar" style="height:192px;"></div><span>MAR</span></div>
                <div class="ad-chart-bar"><div class="bar" style="height:160px;"></div><span>APR</span></div>
                <div class="ad-chart-bar"><div class="bar" style="height:224px;"></div><span>MAY</span></div>
                <div class="ad-chart-bar"><div class="bar" style="height:176px;"></div><span>JUN</span></div>
                <svg style="position:absolute; bottom:44px; left:0; width:100%; height:192px; pointer-events:none; overflow:visible; padding:0 24px;" preserveAspectRatio="none">
                    <path d="M 0 150 Q 100 120 200 80 T 400 40 T 600 90 T 800 30" fill="none" stroke="#4cd7f6" stroke-width="3"></path>
                    <circle cx="20" cy="150" fill="#4cd7f6" r="4"></circle>
                    <circle cx="180" cy="100" fill="#4cd7f6" r="4"></circle>
                    <circle cx="350" cy="50" fill="#4cd7f6" r="4"></circle>
                    <circle cx="520" cy="70" fill="#4cd7f6" r="4"></circle>
                    <circle cx="700" cy="110" fill="#4cd7f6" r="4"></circle>
                </svg>
            </div>
        </section>

        <div class="ad-lower">
            <section class="glass-card ad-panel ad-lower-main">
                <div class="ad-panel-head">
                    <h3><span class="material-symbols-outlined" style="font-size:16px;">list_alt</span> Manager Work Queue</h3>
                </div>
                <div class="ad-panel-body">
                    <a class="ad-activity text-decoration-none" href="/Manager/QuestionBank">
                        <div class="ad-activity-left">
                            <div class="ad-activity-icon"><span class="material-symbols-outlined" style="color:#4cd7f6;">database</span></div>
                            <div><p class="ad-activity-title">Audit system question bank</p><p class="ad-activity-meta">READ_ONLY_CONTENT</p></div>
                        </div>
                        <span class="material-symbols-outlined chev">chevron_right</span>
                    </a>
                    <a class="ad-activity text-decoration-none" href="/Manager/Users">
                        <div class="ad-activity-left">
                            <div class="ad-activity-icon"><span class="material-symbols-outlined" style="color:#e2dfff;">group</span></div>
                            <div><p class="ad-activity-title">Review candidate profile activity</p><p class="ad-activity-meta">USER_MONITORING</p></div>
                        </div>
                        <span class="material-symbols-outlined chev">chevron_right</span>
                    </a>
                    <a class="ad-activity text-decoration-none" href="/Manager/Feedback">
                        <div class="ad-activity-left">
                            <div class="ad-activity-icon"><span class="material-symbols-outlined" style="color:#c3c0ff;">forum</span></div>
                            <div><p class="ad-activity-title">Check system feedback metrics</p><p class="ad-activity-meta">SERVICE_QUALITY</p></div>
                        </div>
                        <span class="material-symbols-outlined chev">chevron_right</span>
                    </a>
                    <a class="ad-activity text-decoration-none" href="/Manager/AiFeedback">
                        <div class="ad-activity-left">
                            <div class="ad-activity-icon"><span class="material-symbols-outlined" style="color:#F9D949;">smart_toy</span></div>
                            <div><p class="ad-activity-title">Inspect AI interview feedback</p><p class="ad-activity-meta">AI_QUALITY_SIGNAL</p></div>
                        </div>
                        <span class="material-symbols-outlined chev">chevron_right</span>
                    </a>
                    <a class="ad-activity text-decoration-none" href="/Manager/News">
                        <div class="ad-activity-left">
                            <div class="ad-activity-icon"><span class="material-symbols-outlined" style="color:#10B981;">newspaper</span></div>
                            <div><p class="ad-activity-title">Review published news and updates</p><p class="ad-activity-meta">CONTENT_TRACKER</p></div>
                        </div>
                        <span class="material-symbols-outlined chev">chevron_right</span>
                    </a>
                </div>
            </section>

            <section class="ad-lower-side d-flex flex-column gap-4">
                <div class="glass-card ad-panel" style="padding:24px;">
                    <h3 style="display:flex; align-items:center; gap:8px; margin:0 0 32px; font-family:'JetBrains Mono',monospace; font-size:13px; letter-spacing:.05em; text-transform:uppercase; color:#c8c5d0;">
                        <span class="material-symbols-outlined" style="font-size:16px;">bolt</span> Quick Access
                    </h3>
                    <div class="d-flex flex-column gap-3">
                        <a class="ad-action ad-action-primary primary-gradient text-decoration-none" href="/Manager/QuestionBank"><span class="material-symbols-outlined">visibility</span> View Question Bank</a>
                        <a class="ad-action ad-action-secondary text-decoration-none" href="/Manager/Feedback"><span class="material-symbols-outlined" style="color:#e2dfff;">feedback</span> System Feedback</a>
                        <a class="ad-action ad-action-secondary text-decoration-none" href="/Manager/News"><span class="material-symbols-outlined" style="color:#4cd7f6;">article</span> News Tracker</a>
                    </div>
                </div>
                <div class="glass-card ad-panel" style="padding:24px;">
                    <h3 style="margin:0 0 24px; font-family:'JetBrains Mono',monospace; font-size:13px; letter-spacing:.05em; text-transform:uppercase; color:#c8c5d0;">Access Status</h3>
                    <div class="d-flex flex-column gap-2">
                        <div class="ad-status-row"><div class="left"><span class="material-symbols-outlined" style="color:#10B981;">check_circle</span><span style="font-size:14px;">Manager Workspace</span></div><span class="ok">Separated</span></div>
                        <div class="ad-status-row"><div class="left"><span class="material-symbols-outlined" style="color:#10B981;">check_circle</span><span style="font-size:14px;">CRUD Controls</span></div><span class="ok">Hidden</span></div>
                        <div class="ad-status-row"><div class="left"><span class="material-symbols-outlined" style="color:#10B981;">check_circle</span><span style="font-size:14px;">Admin Screens</span></div><span class="ok">Untouched</span></div>
                    </div>
                </div>
            </section>
        </div>
    </main>
</body>
</html>
