@{
    var token = Context.Request.Cookies["access_token"];
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Interview Sessions - DevPrep AI</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700;800;900&family=JetBrains+Mono:wght@@500&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@@100..700,0..1&display=swap" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#e2dfff", "on-primary": "#2c2a5e", "primary-container": "#c3c0ff",
                        "on-primary-container": "#4e4c83", "secondary": "#4cd7f6", "secondary-container": "#03b5d4",
                        "on-secondary-container": "#00424e", "tertiary": "#e9ddff", "tertiary-container": "#d0bcff",
                        "success": "#10B981", "warning": "#F9D949", "error": "#ffb4ab",
                        "surface": "#131317", "surface-container": "#201f23", "surface-container-low": "#1c1b1f",
                        "surface-container-high": "#2a292d", "surface-container-highest": "#353438",
                        "on-surface": "#e5e1e7", "on-surface-variant": "#c8c5d0",
                        "border-subtle": "rgba(255,255,255,0.08)", "background": "#0e1323", "outline": "#928f9a"
                    },
                    borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                    spacing: { "sm": "12px", "md": "16px", "lg": "24px", "xl": "32px", "gutter": "24px", "xs": "8px", "max-width": "1280px" },
                    fontFamily: { "display-lg": ["Inter"], "code-label": ["JetBrains Mono"], "headline-md": ["Inter"], "body-sm": ["Inter"], "body-md": ["Inter"] }
                }
            }
        }
    </script>
    <style>
        body { background-color: #0e1323; color: #e5e1e7; }
        .glass-card { background: rgba(32,31,35,0.4); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.08); border-top: 1px solid rgba(255,255,255,0.15); }
        .side-drawer { transition: transform .3s cubic-bezier(.4,0,.2,1); }
        .drawer-hidden { transform: translateX(100%); }
        .ad-sidebar h2, .ad-sidebar p, .ad-sidebar a { margin-bottom: 0; }
        .iv-main { margin-left: 250px; padding-top: 80px; padding-left: 24px; padding-right: 24px; min-height: 100vh; background: #0e1323; }
        .iv-select { background: #11121a !important; border: 1px solid #292c3d !important; border-radius: 10px; padding: 6px 12px; color: #ffffff !important; font-size: 13px; }
        .iv-select option { background-color: #11121a !important; color: #ffffff !important; }
    </style>
    <link rel="stylesheet" href="~/css/components/pagination.css" asp-append-version="true" />
</head>
<body class="font-body-md overflow-x-hidden">
    @await Html.PartialAsync("_ManagerTopbar")
    @await Html.PartialAsync("_ManagerSidebar")

    <main class="iv-main">
        <div class="mb-6"><h1 class="font-display-lg text-[24px] font-bold text-primary tracking-tight">Interview Sessions</h1></div>

        <div class="max-w-max-width mx-auto">
            <!-- Filter Bar -->
            <section class="glass-card rounded-2xl p-md mb-lg flex flex-wrap items-center gap-md">
                <select id="iv-status" class="iv-select"><option value="">All status</option></select>
                <select id="iv-level" class="iv-select"><option value="">All level</option></select>
                <select id="iv-mode" class="iv-select"><option value="">All mode</option></select>
                <select id="iv-type" class="iv-select"><option value="">All type</option></select>
                <div class="ml-auto relative min-w-[280px]">
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
                    <input id="iv-search" class="w-full bg-surface-container border-border-subtle border rounded-xl pl-4 pr-10 py-1.5 font-body-sm focus:ring-1 focus:ring-primary-container" placeholder="Search title / user..." type="text" />
                </div>
            </section>

            <!-- Table -->
            <section class="glass-card rounded-2xl overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse min-w-[900px]">
                        <thead>
                            <tr class="bg-surface-container-high/50 border-b border-border-subtle">
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">User</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Title</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Level</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Mode</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Type</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Progress</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Status</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant">Date</th>
                                <th class="px-lg py-md font-code-label text-[11px] uppercase text-on-surface-variant text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="iv-table-body" class="font-body-sm text-on-surface">
                            <tr><td colspan="9" class="text-center py-4">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="px-lg py-md flex items-center justify-between border-t border-border-subtle bg-surface-container/20">
                    <p id="iv-summary" class="font-code-label text-[11px] text-on-surface-variant uppercase">Loading...</p>
                    <div class="flex gap-xs items-center">
                        <nav id="iv-pages" class="devprep-pagination devprep-pagination-inline" aria-label="Pagination"></nav>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <!-- Detail Drawer (transcript) -->
    <div class="fixed inset-0 bg-black/40 backdrop-blur-sm z-[60] hidden opacity-0 transition-opacity duration-300" id="drawer-overlay" onclick="toggleDrawer(false)"></div>
    <aside class="fixed top-0 right-0 h-full w-[680px] max-w-full z-[70] glass-card drawer-hidden side-drawer shadow-2xl flex flex-col" id="iv-drawer">
        <div class="p-lg border-b border-border-subtle flex items-center justify-between">
            <h2 class="font-headline-md text-primary">Session Detail</h2>
            <button class="p-2 rounded-full hover:bg-surface-container-high text-on-surface-variant" onclick="toggleDrawer(false)"><span class="material-symbols-outlined">close</span></button>
        </div>
        <div id="iv-detail-body" class="flex-1 overflow-y-auto p-lg space-y-lg">
            <p class="text-on-surface-variant">Loading...</p>
        </div>
    </aside>

    <script>
        const API_BASE = '@ViewData["ApiBaseUrl"]/api/admin/manager/sessions';
        const token = '@token';
        const STATUSES = ['Configured', 'Initialized', 'InProgress', 'Completed', 'Expired', 'Cancelled'];
        const LEVELS = ['Intern', 'Junior', 'Middle', 'Senior', 'Lead'];
        const MODES = ['Text', 'Voice', 'Video'];
        const TYPES = ['Theory', 'Coding', 'Behavioral', 'Mixed'];
        let currentPage = 1, pageSize = 10, totalPages = 1, searchTimer = null;

        document.addEventListener("DOMContentLoaded", () => {
            fillSelect('iv-status', STATUSES); fillSelect('iv-level', LEVELS); fillSelect('iv-mode', MODES); fillSelect('iv-type', TYPES);
            ['iv-status', 'iv-level', 'iv-mode', 'iv-type'].forEach(id => document.getElementById(id).addEventListener('change', () => { currentPage = 1; fetchList(); }));
            document.getElementById('iv-search').addEventListener('input', () => { clearTimeout(searchTimer); searchTimer = setTimeout(() => { currentPage = 1; fetchList(); }, 300); });
            fetchList();
        });

        function fillSelect(id, values) { const s = document.getElementById(id); values.forEach(v => { const o = document.createElement('option'); o.value = v; o.textContent = v; s.appendChild(o); }); }

        async function fetchList() {
            const tbody = document.getElementById('iv-table-body');
            try {
                const q = new URLSearchParams({ page: currentPage, pageSize });
                const kw = document.getElementById('iv-search').value.trim(); if (kw) q.set('keyword', kw);
                const st = document.getElementById('iv-status').value; if (st) q.set('status', st);
                const lv = document.getElementById('iv-level').value; if (lv) q.set('level', lv);
                const md = document.getElementById('iv-mode').value; if (md) q.set('interactionMode', md);
                const tp = document.getElementById('iv-type').value; if (tp) q.set('questionType', tp);
                const res = await fetch(`${API_BASE}?${q}`, { headers: { 'Authorization': `Bearer ${token}` } });
                if (res.status === 401 || res.status === 403) {
                    window.location.href = '/Auth/Login';
                    return;
                }
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const json = await res.json();
                if (json.success) { renderTable(json.data.items || []); renderPagination(json.data); }
                else tbody.innerHTML = `<tr><td colspan="9" class="text-center py-4 text-error">Failed: ${escapeHtml(json.message)}</td></tr>`;
            } catch (e) { tbody.innerHTML = `<tr><td colspan="9" class="text-center py-4 text-error">Unable to load interview sessions. Please sign in again or check InterviewAPI/Gateway.</td></tr>`; }
        }

        function renderTable(items) {
            const tbody = document.getElementById('iv-table-body');
            if (!items.length) { tbody.innerHTML = `<tr><td colspan="9" class="text-center py-4 text-on-surface-variant">No sessions found.</td></tr>`; return; }
            tbody.innerHTML = items.map(it => `
                <tr class="border-b border-border-subtle/50 hover:bg-surface-container-high/30 cursor-pointer" onclick="openDetail('${it.sessionId}')">
                    <td class="px-lg py-md">
                        <div class="flex items-center gap-sm">
                            <div class="w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center font-bold text-primary font-code-label">${initial(it.userFullName)}</div>
                            <span class="font-semibold text-on-surface">${escapeHtml(userLabel(it))}</span>
                        </div>
                    </td>
                    <td class="px-lg py-md max-w-[200px]"><p class="truncate">${escapeHtml(it.title || '(no title)')}</p></td>
                    <td class="px-lg py-md">${badge(it.level)}</td>
                    <td class="px-lg py-md">${badge(it.interactionMode)}</td>
                    <td class="px-lg py-md">${badge(it.questionType)}</td>
                    <td class="px-lg py-md font-code-label text-on-surface-variant">${it.answeredQuestions}/${it.totalQuestions}</td>
                    <td class="px-lg py-md">${statusBadge(it.status)}</td>
                    <td class="px-lg py-md font-code-label text-on-surface-variant">${fmtDate(it.createdAt)}</td>
                    <td class="px-lg py-md text-right">
                        <button class="text-on-surface-variant hover:text-primary" onclick="event.stopPropagation(); openDetail('${it.sessionId}')" title="View"><span class="material-symbols-outlined text-[20px]">visibility</span></button>
                    </td>
                </tr>`).join('');
        }

        async function openDetail(id) {
            toggleDrawer(true);
            const body = document.getElementById('iv-detail-body');
            body.innerHTML = `<p class="text-on-surface-variant">Loading...</p>`;
            try {
                const res = await fetch(`${API_BASE}/${id}/log`, { headers: { 'Authorization': `Bearer ${token}` } });
                if (res.status === 401 || res.status === 403) {
                    window.location.href = '/Auth/Login';
                    return;
                }
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const json = await res.json();
                if (json.success && json.data) renderDetail(json.data);
                else body.innerHTML = `<p class="text-error">Unable to load session details.</p>`;
            } catch (e) { body.innerHTML = `<p class="text-error">Unable to load session details. Check permission or connection.</p>`; }
        }

        function renderDetail(d) {
            const meta = [
                ['Level', badge(d.level)], ['Mode', badge(d.interactionMode)], ['Type', badge(d.questionType)],
                ['Planned', `${d.durationMinutes} min`], ['Started', fmtDateTime(d.startedAt)], ['Ended', fmtDateTime(d.endedAt)],
                ['Actual', actualDuration(d.startedAt, d.endedAt)], ['Credit', String(d.creditCost)],
                ['Questions', `${d.answeredQuestions}/${d.totalQuestions}`], ['Avg response', msToSec(d.avgResponseTimeMs)],
                ['CV / JD', `${d.cvId ? 'CV' : '-'} / ${d.jdId ? 'JD' : '-'}`], ['Created', fmtDateTime(d.createdAt)]
            ];
            const metaHtml = meta.map(m => `<div class="flex justify-between gap-sm py-1 border-b border-border-subtle/40"><span class="font-code-label text-[11px] uppercase text-on-surface-variant">${m[0]}</span><span class="font-body-sm text-on-surface text-right">${m[1]}</span></div>`).join('');

            const questions = (d.questions || []);
            const transcriptHtml = questions.length ? questions.map(qz => `
                <div class="glass-card rounded-xl p-md">
                    <div class="flex items-start gap-sm mb-2">
                        <span class="font-code-label text-[11px] text-primary uppercase whitespace-nowrap">Question ${qz.orderIndex}</span>
                        <span class="px-xs py-0.5 rounded text-[9px] uppercase font-code-label ${qz.isAiGenerated ? 'bg-secondary-container/20 text-secondary' : 'bg-tertiary-container/20 text-tertiary'}">${qz.isAiGenerated ? 'AI' : 'Bank'}</span>
                        <span class="text-on-surface-variant text-[10px] ml-auto whitespace-nowrap">${fmtDateTime(qz.askedAt)}</span>
                    </div>
                    <p class="font-body-sm text-on-surface mb-3">${escapeHtml(qz.content || '')}</p>
                    <div class="space-y-2">${(qz.messages || []).map(msgBubble).join('') || '<p class="text-on-surface-variant text-[12px] italic">No messages yet.</p>'}</div>
                </div>`).join('') : '<p class="text-on-surface-variant text-[13px] italic">This session has no questions or chat log yet.</p>';

            document.getElementById('iv-detail-body').innerHTML = `
                <div class="flex items-start gap-md">
                    <div class="w-14 h-14 rounded-2xl bg-primary/20 text-primary flex items-center justify-center font-bold text-xl">${initial(d.userFullName)}</div>
                    <div>
                        <h3 class="text-headline-md font-bold">${escapeHtml(userLabel(d))}</h3>
                        <p class="text-on-surface-variant font-code-label text-[12px]">${escapeHtml(d.userEmail || '-')}</p>
                        <p class="font-body-sm text-on-surface mt-1">${escapeHtml(d.title || '(no title)')} ${statusBadge(d.status)}</p>
                    </div>
                </div>
                <div class="glass-card rounded-xl p-md">${metaHtml}</div>
                <div>
                    <div class="flex items-center justify-between mb-2"><span class="font-code-label text-[11px] uppercase text-on-surface-variant">Transcript</span></div>
                    <div class="space-y-md">${transcriptHtml}</div>
                </div>
                `;
        }

        function msgBubble(m) {
            const s = m.senderType;
            const align = s === 'User' ? 'items-end' : (s === 'System' ? 'items-center' : 'items-start');
            const color = s === 'User' ? 'bg-primary-container/20 text-on-surface' : (s === 'System' ? 'bg-surface-container-highest/40 text-on-surface-variant italic' : 'bg-secondary-container/15 text-on-surface');
            const audio = (m.messageType === 'Audio' && m.audioUrl) ? `<audio controls src="${escapeHtml(m.audioUrl)}" class="mt-1 h-8"></audio>` : '';
            const rt = (s === 'User' && m.responseTimeMs) ? `<span class="text-on-surface-variant text-[9px]">${msToSec(m.responseTimeMs)}</span>` : '';
            return `<div class="flex flex-col ${align}">
                <div class="max-w-[85%] rounded-xl px-3 py-2 ${color}">
                    <div class="flex items-center gap-xs mb-0.5"><span class="text-[9px] font-code-label uppercase opacity-70">${s}</span>${rt}</div>
                    <p class="font-body-sm whitespace-pre-wrap">${escapeHtml(m.content || '')}</p>${audio}
                </div>
            </div>`;
        }

        function userLabel(it) { return cleanText(it.userFullName) || (it.userId ? 'User ' + String(it.userId).substring(0, 5) : 'Unknown'); }
        function initial(n) { const clean = cleanText(n); return clean && clean.trim() ? clean.trim()[0].toUpperCase() : 'U'; }
        function badge(t) { return t ? `<span class="px-xs py-0.5 rounded bg-surface-container-highest text-on-surface-variant text-[10px] uppercase font-code-label">${escapeHtml(t)}</span>` : 'ΓÇö'; }
        function statusBadge(s) {
            const map = { InProgress: 'bg-secondary/15 border-secondary/40 text-secondary', Completed: 'bg-success/10 border-success/30 text-success', Configured: 'bg-warning/10 border-warning/30 text-warning', Initialized: 'bg-warning/10 border-warning/30 text-warning', Expired: 'bg-tertiary-container/15 border-tertiary/30 text-tertiary', Cancelled: 'bg-error/10 border-error/30 text-error' };
            return `<span class="px-xs py-1 rounded-full border text-[10px] font-bold uppercase ${map[s] || 'bg-surface-container-highest border-border-subtle text-on-surface-variant'}">${escapeHtml(s || '')}</span>`;
        }
        function renderPagination(data) {
            totalPages = Math.max(data.totalPages || 1, 1);
            const ti = data.totalItems || data.totalCount || 0, pg = data.page || currentPage, sz = data.pageSize || pageSize;
            const start = ti === 0 ? 0 : ((pg - 1) * sz) + 1, end = Math.min(pg * sz, ti);
            currentPage = pg;
            document.getElementById('iv-summary').innerText = `Showing ${start}-${end} of ${ti} sessions`;
            DevPrepPagination.render({ container: 'iv-pages', currentPage, totalPages, onPageChange: pageNumber => { currentPage = pageNumber; fetchList(); } });
        }
        function fmtDate(d) { if (!d) return 'ΓÇö'; const x = new Date(d); const m = ["JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"]; return `${m[x.getMonth()]} ${x.getDate().toString().padStart(2,'0')}`; }
        function fmtDateTime(d) { if (!d) return 'ΓÇö'; const x = new Date(d); return x.toLocaleString(); }
        function msToSec(ms) { if (!ms && ms !== 0) return 'ΓÇö'; return (ms / 1000).toFixed(1) + 's'; }
        function actualDuration(a, b) { if (!a || !b) return 'ΓÇö'; const ms = new Date(b) - new Date(a); if (ms < 0) return 'ΓÇö'; const min = Math.floor(ms / 60000), sec = Math.floor((ms % 60000) / 1000); return `${min}m ${sec}s`; }
        function cleanText(value) {
            let text = String(value || '');
            for (let i = 0; i < 2; i++) {
                if (!/[├â├é├ó]|├í┬║|├í┬╗|├ä|├å|∩┐╜/.test(text)) break;
                try {
                    const windows1252 = {
                        0x20AC: 0x80, 0x201A: 0x82, 0x0192: 0x83, 0x201E: 0x84,
                        0x2026: 0x85, 0x2020: 0x86, 0x2021: 0x87, 0x02C6: 0x88,
                        0x2030: 0x89, 0x0160: 0x8A, 0x2039: 0x8B, 0x0152: 0x8C,
                        0x017D: 0x8E, 0x2018: 0x91, 0x2019: 0x92, 0x201C: 0x93,
                        0x201D: 0x94, 0x2022: 0x95, 0x2013: 0x96, 0x2014: 0x97,
                        0x02DC: 0x98, 0x2122: 0x99, 0x0161: 0x9A, 0x203A: 0x9B,
                        0x0153: 0x9C, 0x017E: 0x9E, 0x0178: 0x9F
                    };
                    const bytes = Uint8Array.from([...text].map(ch => {
                        const code = ch.charCodeAt(0);
                        return windows1252[code] || (code <= 255 ? code : 63);
                    }));
                    const fixed = new TextDecoder('utf-8', { fatal: false }).decode(bytes);
                    if (!fixed || fixed === text) break;
                    text = fixed;
                } catch {
                    break;
                }
            }
            return text;
        }
        function escapeHtml(u) { return cleanText(u).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;"); }
        function toggleDrawer(show) {
            const drawer = document.getElementById('iv-drawer'), overlay = document.getElementById('drawer-overlay');
            if (show) { drawer.classList.remove('drawer-hidden'); overlay.classList.remove('hidden'); setTimeout(() => overlay.classList.add('opacity-100'), 10); document.body.style.overflow = 'hidden'; }
            else { drawer.classList.add('drawer-hidden'); overlay.classList.remove('opacity-100'); setTimeout(() => { overlay.classList.add('hidden'); document.body.style.overflow = 'auto'; }, 300); }
        }
    </script>
    <script src="~/js/components/pagination.js" asp-append-version="true"></script>
</body>
</html>
