@{
    var token = Context.Request.Cookies["access_token"];
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Interview Sessions - DevPrep Manager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@300;400;500;600;700&family=JetBrains+Mono:wght@@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/tech-stack-list.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin-tech-stacks.css" asp-append-version="true" />
    <style>
        .iv-avatar { display:inline-flex; width:30px; height:30px; border-radius:50%; align-items:center; justify-content:center; background:rgba(129,140,248,.18); color:#a5b4fc; font:700 12px 'JetBrains Mono',monospace; flex:0 0 30px; }
        .iv-badge { display:inline-block; padding:3px 9px; border-radius:6px; background:rgba(148,163,184,.14); color:#cbd5e1; font:600 10px 'JetBrains Mono',monospace; text-transform:uppercase; }
        .tech-stacks-table tbody tr.iv-row { cursor:pointer; }
    </style>
</head>
<body class="admin-page">
    @await Html.PartialAsync("_ManagerTopbar")
    @await Html.PartialAsync("_ManagerSidebar")

    <main class="ad-main tech-stacks-page">
        <header class="tech-stacks-header">
            <div>
                <p class="tech-stacks-eyebrow">Interview Administration</p>
                <h1 class="ad-page-title">Interview Sessions</h1>
                <p class="tech-stacks-subtitle">Review interview sessions and their transcripts.</p>
            </div>
        </header>

        <section class="tech-stacks-card tech-stacks-filters" aria-label="Session filters">
            <div class="tech-stacks-filter-form" style="grid-template-columns: minmax(220px,1fr) 180px 180px;">
                <div class="tech-stacks-filter-field">
                    <label for="iv-search">Search</label>
                    <div class="tech-stacks-search">
                        <button type="button" class="tech-stacks-search-button" aria-label="Search" title="Search">
                            <span class="material-symbols-outlined" aria-hidden="true">search</span>
                        </button>
                        <input id="iv-search" type="search" placeholder="Search by user" />
                    </div>
                </div>
                <div class="tech-stacks-filter-field tech-stacks-status-filter">
                    <label for="iv-status">Status</label>
                    <select id="iv-status"><option value="">All status</option></select>
                </div>
                <div class="tech-stacks-filter-field tech-stacks-status-filter">
                    <label for="iv-level">Level</label>
                    <select id="iv-level"><option value="">All level</option></select>
                </div>
            </div>
        </section>

        <section class="tech-stacks-card tech-stacks-results">
            <div class="tech-stacks-card-header">
                <div><h2>Sessions</h2><p id="iv-count">Loading...</p></div>
                <span class="tech-stacks-page-count" id="iv-page-count"></span>
            </div>
            <div class="table-responsive">
                <table class="tech-stacks-table">
                    <thead>
                        <tr>
                            <th scope="col">User</th>
                            <th scope="col" class="tech-stack-status-column">Level</th>
                            <th scope="col" class="tech-stack-status-column">Progress</th>
                            <th scope="col" class="tech-stack-status-column">Status</th>
                            <th scope="col">Date</th>
                            <th scope="col" class="tech-stack-actions-column">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="iv-table-body">
                        <tr><td colspan="6" class="text-center" style="padding:40px; color:var(--ts-muted);">Loading...</td></tr>
                    </tbody>
                </table>
            </div>
            <nav class="tech-stacks-pagination" id="iv-pages" aria-label="Session pages" style="display:none;"></nav>
        </section>
    </main>

    <script>
        const API_BASE = '@ViewData["ApiBaseUrl"]/api/admin/manager/sessions';
        const token = '@token';
        // InProgress and Paused are real InterviewSessions.Status values but are deliberately
        // left out of this dropdown — not user-selectable in the UI.
        // 'Configured' is kept here for consistency with Admin's dropdown, even though it will
        // always return zero results on this screen: GetManagerSessionListAsync filters on
        // InterviewRoom.Status, and no room exists until a session leaves "Configured". This is
        // a deliberate choice (consistency over hiding an always-empty option) — do not remove
        // it thinking it's a bug.
        const STATUSES = ['Configured', 'Initialized', 'Completed', 'Expired', 'Cancelled'];
        // Lead exists in SessionService.ValidLevels but is deliberately left out of this
        // dropdown — reserved for future development, not yet selectable in the UI.
        const LEVELS = ['Intern', 'Fresher', 'Junior', 'Middle', 'Senior'];
        let currentPage = 1, pageSize = 10, totalPages = 1, searchTimer = null;

        document.addEventListener("DOMContentLoaded", () => {
            fillSelect('iv-status', STATUSES);
            fillSelect('iv-level', LEVELS);
            ['iv-status', 'iv-level'].forEach(id => document.getElementById(id).addEventListener('change', () => {
                currentPage = 1;
                fetchList();
            }));
            document.getElementById('iv-search').addEventListener('input', () => {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(() => {
                    currentPage = 1;
                    fetchList();
                }, 300);
            });
            fetchList();
        });

        function fillSelect(id, values) {
            const select = document.getElementById(id);
            values.forEach(value => {
                const option = document.createElement('option');
                option.value = value;
                option.textContent = value;
                select.appendChild(option);
            });
        }

        function openDetail(id) {
            window.location.href = '/Manager/InterviewSessionDetail/' + id;
        }

        async function fetchList() {
            const tbody = document.getElementById('iv-table-body');
            try {
                const query = new URLSearchParams({ page: currentPage, pageSize });
                const keyword = document.getElementById('iv-search').value.trim();
                const status = document.getElementById('iv-status').value;
                const level = document.getElementById('iv-level').value;
                if (keyword) query.set('keyword', keyword);
                if (status) query.set('status', status);
                if (level) query.set('level', level);

                const response = await fetch(`${API_BASE}?${query}`, {
                    headers: { Authorization: `Bearer ${token}` }
                });
                if (response.status === 401 || response.status === 403) {
                    window.location.href = '/Auth/Login';
                    return;
                }
                if (!response.ok) throw new Error(`HTTP ${response.status}`);

                const json = await response.json();
                if (!json.success) throw new Error(json.message || 'Failed');
                renderTable(json.data.items || []);
                renderPagination(json.data);
            } catch (error) {
                console.error(error);
                tbody.innerHTML = '<tr><td colspan="6" class="text-center" style="padding:40px; color:var(--ts-danger);">Interview sessions are temporarily unavailable.</td></tr>';
                renderPagination({ totalItems: 0, totalPages: 1, page: 1 });
            }
        }

        function renderTable(items) {
            const tbody = document.getElementById('iv-table-body');
            if (!items.length) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center" style="padding:48px; color:var(--ts-muted);">No sessions found.</td></tr>';
                return;
            }

            tbody.innerHTML = items.map(item => `
                <tr class="iv-row" onclick="openDetail('${item.sessionId}')">
                    <td>
                        <div style="display:flex; align-items:center; gap:9px;">
                            <span class="iv-avatar">${initial(item.userFullName)}</span>
                            <span class="tech-stack-name">${escapeHtml(userLabel(item))}</span>
                        </div>
                    </td>
                    <td class="tech-stack-status-column">${badge(item.level)}</td>
                    <td class="tech-stack-status-column"><span style="font:600 12px 'JetBrains Mono',monospace; color:#cbd5e1;">${item.answeredQuestions}/${item.totalQuestions}</span></td>
                    <td class="tech-stack-status-column">${statusBadge(item.status)}</td>
                    <td>${fmtDate(item.createdAt)}</td>
                    <td class="tech-stack-actions-column">
                        <div class="tech-stack-actions">
                            <button type="button" class="ts-button ts-button-small ts-button-secondary tech-stack-icon-action" title="View" onclick="event.stopPropagation(); openDetail('${item.sessionId}')">
                                <span class="material-symbols-outlined">visibility</span>
                            </button>
                        </div>
                    </td>
                </tr>`).join('');
        }

        function renderPagination(data) {
            totalPages = Math.max(1, data.totalPages || 1);
            const totalItems = data.totalItems || 0;
            currentPage = data.page || currentPage;
            document.getElementById('iv-count').innerText = `${totalItems} result${totalItems === 1 ? '' : 's'}`;
            document.getElementById('iv-page-count').innerText = totalItems > 0 ? `Page ${currentPage} of ${totalPages}` : '';

            const nav = document.getElementById('iv-pages');
            if (totalPages <= 1) {
                nav.style.display = 'none';
                nav.innerHTML = '';
                return;
            }

            nav.style.display = 'flex';
            let html = `<a class="tech-stacks-page-link ${currentPage <= 1 ? 'disabled' : ''}" onclick="gotoPage(${currentPage - 1})">Previous</a>`;
            for (let page = 1; page <= totalPages; page++) {
                html += `<a class="tech-stacks-page-link ${page === currentPage ? 'active' : ''}" onclick="gotoPage(${page})">${page}</a>`;
            }
            html += `<a class="tech-stacks-page-link ${currentPage >= totalPages ? 'disabled' : ''}" onclick="gotoPage(${currentPage + 1})">Next</a>`;
            nav.innerHTML = html;
        }

        function gotoPage(page) {
            if (page < 1 || page > totalPages || page === currentPage) return;
            currentPage = page;
            fetchList();
        }

        function badge(value) {
            return value ? `<span class="iv-badge">${escapeHtml(value)}</span>` : '-';
        }

        function statusBadge(status) {
            const completed = status === 'Completed';
            const icon = completed ? 'check_circle' : 'pause_circle';
            return `<span class="tech-stack-status ${completed ? 'is-active' : 'is-inactive'}"><span class="material-symbols-outlined">${icon}</span>${escapeHtml(status || '-')}</span>`;
        }

        function fmtDate(value) {
            if (!value) return '-';
            const date = new Date(value);
            return `<time>${date.toLocaleDateString('en-GB')}<br><span>${date.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })}</span></time>`;
        }

        function userLabel(item) {
            return cleanText(item.userFullName) || (item.userId ? 'User ' + String(item.userId).substring(0, 5) : 'Unknown');
        }

        function initial(name) {
            const clean = cleanText(name);
            return clean && clean.trim() ? clean.trim()[0].toUpperCase() : 'U';
        }

        function cleanText(value) {
            return String(value || '');
        }

        function escapeHtml(value) {
            return cleanText(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }
    </script>
</body>
</html>
