@using WebClient.Models.Feedback
@using WebClient.Models.Evaluation
@model WebClient.Models.Evaluation.ReportViewModel

@{
    Layout = null;
    var report = Model.Report;
    var isScored = Model.DisplayState == EvaluationReportState.Scored && report is not null;
    var showFeedbackSection = Model.CanSubmitInterviewFeedback
        || Model.MyInterviewFeedback is not null
        || Model.FeedbackFormWasSubmitted
        || !string.IsNullOrWhiteSpace(Model.FeedbackMessage);
    var stateIcon = Model.DisplayState switch
    {
        EvaluationReportState.EvaluationIncomplete => "rule",
        // EvaluationUnavailable covers two situations. When grading has been restarted
        // (RecoveryInProgress) the user is told to refresh shortly, so a cloud-off glyph would
        // contradict the text and read as permanently broken — use the same icon as the
        // Incomplete state, which is the same situation from the user's side. The terminal
        // bail-outs keep cloud_off.
        EvaluationReportState.EvaluationUnavailable => Model.RecoveryInProgress ? "rule" : "cloud_off",
        _ => "bar_chart"
    };
    const double circumference = 2 * Math.PI * 45; // gauge radius 45

    string Band(decimal score) =>
        score >= 80 ? "var(--color-success)" : score >= 60 ? "var(--color-warning)" : "var(--color-primary)";

    void CategoryCard(string name, string icon, decimal score, string comment)
    {
        var color = Band(score);
        <div class="glass-card report-cat-card">
            <div class="report-cat-head">
                <span class="report-cat-name"><span class="material-symbols-outlined">@icon</span>@name</span>
                <span class="report-cat-score" style="color:@color">@Math.Round(score)/100</span>
            </div>
            <div class="report-bar-track">
                <div class="report-bar-fill" style="width:@(Math.Round(score))%; background:@color"></div>
            </div>
            <p class="report-cat-comment">@comment</p>
        </div>
    }

    string CommentFor(decimal score) =>
        score >= 85 ? "Strong" : score >= 70 ? "Solid" : "Needs improvement";

    // Honest hero title that follows the actual score band (no fixed "Great performance!").
    string HeroTitle(decimal score) =>
        score >= 80 ? "Great performance! 🎉" : score >= 60 ? "Good effort! 💪" : "Keep practicing! 📈";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Interview Report - DevPrep</title>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme-session.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/report.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/safe-text.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/star-rating.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/feedback-report.css" asp-append-version="true" />
</head>
<body class="report-page">
    @await Html.PartialAsync("_Navbar")

    <main class="report-main">
        <div class="report-topbar">
            <a class="btn-ghost" asp-controller="Interview" asp-action="Details" asp-route-id="@Model.SessionId">
                <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
                View Session Details
            </a>
            <a class="btn-primary-solid" asp-controller="Interview" asp-action="Index">＋ New Interview</a>
        </div>

        @if (TempData["ReportInfoMessage"] is string reportInfoMessage)
        {
            <div class="report-feedback-alert" role="status">@reportInfoMessage</div>
        }

        @if (isScored && report is not null)
        {
            var overall = report.OverallScore;
            var color = Band(overall);
            var dashOffset = circumference * (1 - (double)overall / 100);

            <!-- Hero -->
            <div class="glass-card report-hero">
                <div>
                    <h1 class="report-hero-title">@(string.Equals(Model.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) ? "Cancelled interview results" : HeroTitle(overall))</h1>
                    <p class="report-hero-sub safe-long-text">@Model.Position &mdash; @Model.Level level</p>
                    <div class="report-chips">
                        <span class="report-chip"><span class="material-symbols-outlined" style="font-size:16px">forum</span>@Model.Questions.Count Questions</span>
                        <span class="report-chip"><span class="material-symbols-outlined" style="font-size:16px">flag</span>@Model.Status</span>
                        @if (!string.IsNullOrEmpty(report.Grade))
                        {
                            <span class="report-chip"><span class="material-symbols-outlined" style="font-size:16px">grade</span>Grade @report.Grade</span>
                        }
                    </div>
                </div>
                <div class="gauge">
                    <svg viewBox="0 0 100 100">
                        <circle class="gauge-track" cx="50" cy="50" r="45" fill="none" stroke-width="8"></circle>
                        <circle cx="50" cy="50" r="45" fill="none" stroke="@color" stroke-width="8"
                                stroke-linecap="round"
                                stroke-dasharray="@circumference.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                stroke-dashoffset="@dashOffset.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"></circle>
                    </svg>
                    <div class="gauge-value-inner">
                        <span class="gauge-score" style="color:@color">@Math.Round(overall)</span>
                        <span class="gauge-denom">/100</span>
                    </div>
                </div>
            </div>

            <!-- Performance by Category -->
            <h2 class="report-section-title">Performance by Category</h2>
            <div class="report-cat-grid">
                @if (report.TechnicalScore is not null) { CategoryCard("Technical", "code", report.TechnicalScore.Value, CommentFor(report.TechnicalScore.Value)); }                @if (report.CommunicationScore is not null) { CategoryCard("Communication", "record_voice_over", report.CommunicationScore.Value, CommentFor(report.CommunicationScore.Value)); }
                @if (report.ProblemSolvingScore is not null) { CategoryCard("Problem Solving", "psychology", report.ProblemSolvingScore.Value, CommentFor(report.ProblemSolvingScore.Value)); }
            </div>
        }
        else
        {
            <div class="glass-card report-empty-state" data-report-state="@Model.DisplayState">
                <span class="material-symbols-outlined">@stateIcon</span>
                <h2>@Model.StateTitle</h2>
                <p class="safe-long-text">@Model.StateMessage</p>
            </div>
        }

        @if (isScored || Model.DisplayState == EvaluationReportState.EvaluationIncomplete)
        {
        <!-- Question-by-Question Review -->
        <h2 class="report-section-title">Question-by-Question Review</h2>
        @if (Model.QuestionEvaluationsUnavailable)
        {
            <div class="glass-card report-empty" role="status">
                Question-level evaluation details cannot be loaded right now.
            </div>
        }
        else if (Model.Questions.Count == 0)
        {
            <div class="glass-card report-empty">No questions found for this session.</div>
        }
        else
        {
            <div class="report-questions">
                @foreach (var q in Model.Questions)
                {
                    var qColor = q.Score is not null ? Band(q.Score.Value) : "var(--color-text-secondary)";
                    <details class="glass-card report-q">
                        <summary>
                            <span class="report-q-left">
                                <span class="report-q-num">@q.OrderIndex</span>
                                <span class="report-q-text safe-long-text">@q.Content</span>
                            </span>
                            @if (!q.HasSubstantiveAnswer)
                            {
                                <span class="report-q-score" style="color:var(--color-text-secondary); border:1px solid var(--color-border)">No answer recorded</span>
                            }
                            else if (q.Score is not null)
                            {
                                <span class="report-q-score" style="color:@qColor; border:1px solid @qColor">@Math.Round(q.Score.Value)/100</span>
                            }
                            else
                            {
                                <span class="report-q-score" style="color:var(--color-text-secondary); border:1px solid var(--color-border)">Not evaluated</span>
                            }
                        </summary>
                        <div class="report-q-body safe-text-container">
                            <div class="report-q-block safe-text-container">
                                <span class="label">Your answer</span>
                                <p class="safe-long-text">@(q.HasSubstantiveAnswer ? q.Answer : "No answer recorded")</p>
                            </div>
                            @if (q.Score is not null || q.CriteriaScores.Count > 0)
                            {
                                <dl class="report-q-metrics" aria-label="Question score and criteria">
                                    @if (q.Score is not null)
                                    {
                                        <div>
                                            <dt>Score</dt>
                                            <dd aria-label="Question score @Math.Round(q.Score.Value) out of 100">@Math.Round(q.Score.Value)/100</dd>
                                        </div>
                                    }
                                    @foreach (var criterion in q.CriteriaScores)
                                    {
                                        <div>
                                            <dt>@criterion.Label</dt>
                                            <dd aria-label="@criterion.Label score @Math.Round(criterion.Score) out of 100">@Math.Round(criterion.Score)/100</dd>
                                        </div>
                                    }
                                </dl>
                            }
                            @if (!string.IsNullOrWhiteSpace(q.AiFeedback))
                            {
                                <div class="report-q-block safe-text-container">
                                    <span class="label">AI Analysis</span>
                                    <p class="safe-long-text">@q.AiFeedback</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(q.Strengths))
                            {
                                <div class="report-q-block strengths safe-text-container">
                                    <span class="label">Strengths</span>
                                    <p class="safe-long-text">@q.Strengths</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(q.AreasToImprove))
                            {
                                <div class="report-q-block improve safe-text-container">
                                    <span class="label">Areas to Improve</span>
                                    <p class="safe-long-text">@q.AreasToImprove</p>
                                </div>
                            }
                            @if (q.Score is null)
                            {
                                <div class="report-q-none">This answer has not been evaluated yet.</div>
                            }
                        </div>
                    </details>
                }
            </div>
        }
        }

        <!-- AI Coach Summary -->
        @if (isScored && report is not null && (report.Strengths?.Count > 0 || report.Improvements?.Count > 0 || !string.IsNullOrWhiteSpace(report.Summary)))
        {
            <div class="glass-card report-summary safe-text-container">
                <h3 class="report-summary-title"><span class="material-symbols-outlined">auto_awesome</span> AI Coach Summary</h3>
                @if (!string.IsNullOrEmpty(report.Summary))
                {
                    <p class="safe-long-text" style="color:var(--color-text-secondary); margin-top:0">@report.Summary</p>
                }
                <div class="report-summary-grid safe-text-container">
                    <div class="report-summary-col strengths safe-text-container">
                        <h4>Key Strengths</h4>
                        <ul>
                            @foreach (var item in report.Strengths ?? new System.Collections.Generic.List<string>())
                            {
                                <li class="safe-text-container"><span class="material-symbols-outlined">check_circle</span><span class="safe-long-text">@item</span></li>
                            }
                        </ul>
                    </div>
                    <div class="report-summary-col improve safe-text-container">
                        <h4>Areas to Improve</h4>
                        <ul>
                            @foreach (var item in report.Improvements ?? new System.Collections.Generic.List<string>())
                            {
                                <li class="safe-text-container"><span class="material-symbols-outlined">arrow_upward</span><span class="safe-long-text">@item</span></li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

        @if (showFeedbackSection)
        {
            <div class="glass-card report-feedback safe-text-container">
                <h3 class="report-feedback-title">How was this session?</h3>
                <p class="report-feedback-sub">Help us improve the AI coaching experience.</p>

                @if (!string.IsNullOrWhiteSpace(Model.FeedbackMessage))
                {
                    var alertClass = Model.FeedbackMessage.StartsWith("Interview feedback submitted", StringComparison.OrdinalIgnoreCase)
                        || Model.FeedbackMessage.StartsWith("Interview feedback updated", StringComparison.OrdinalIgnoreCase)
                        || Model.FeedbackMessage.StartsWith("Your interview feedback has been deleted", StringComparison.OrdinalIgnoreCase)
                        ? "success"
                        : "warning";
                    <div class="report-feedback-alert @alertClass" role="status">@Model.FeedbackMessage</div>
                }

                @if (Model.MyInterviewFeedback is not null)
                {
                    var submitted = Model.MyInterviewFeedback;
                    <div class="report-feedback-submitted safe-text-container">
                        <div class="report-feedback-submitted-head">
                            <div>
                                <strong>Your submitted feedback</strong>
                                <span>Submitted @submitted.CreatedAt.ToLocalTime().ToString("MMM d, yyyy", DisplayCulture.Neutral)</span>
                            </div>
                        </div>
                        <div class="report-feedback-scores">
                            @foreach (var metric in new[]
                            {
                                new { Label = "Overall", Rating = (byte?)submitted.OverallRating },
                                new { Label = "Question quality", Rating = submitted.QuestionQualityRating },
                                new { Label = "AI accuracy", Rating = submitted.AiAccuracyRating },
                                new { Label = "Scoring fairness", Rating = submitted.ScoringFairnessRating },
                                new { Label = "Feedback usefulness", Rating = submitted.FeedbackUsefulnessRating }
                            })
                            {
                                <div class="report-feedback-score">
                                    <span>@metric.Label</span>
                                    @await Html.PartialAsync("_StarRating", new WebClient.Models.Shared.StarRatingViewModel
                                    {
                                        Label = metric.Label,
                                        Value = metric.Rating,
                                        Compact = true
                                    })
                                </div>
                            }
                        </div>
                        @if (submitted.IsHelpful is not null)
                        {
                            <p class="report-feedback-helpful">
                                <span class="material-symbols-outlined" aria-hidden="true">@(submitted.IsHelpful == true ? "thumb_up" : "thumb_down")</span>
                                <span>You marked this session as @(submitted.IsHelpful == true ? "helpful" : "not helpful").</span>
                            </p>
                        }
                        @if (!string.IsNullOrWhiteSpace(submitted.Comment))
                        {
                            <blockquote class="report-feedback-comment safe-long-text">@submitted.Comment</blockquote>
                        }
                        <div class="feedback-owner-actions">
                            <button type="button" class="feedback-owner-action feedback-owner-action-edit" data-edit-interview-trigger data-feedback-id="@submitted.FeedbackId" data-overall="@submitted.OverallRating" data-question="@submitted.QuestionQualityRating" data-ai="@submitted.AiAccuracyRating" data-scoring="@submitted.ScoringFairnessRating" data-usefulness="@submitted.FeedbackUsefulnessRating" data-comment="@submitted.Comment" aria-label="Edit interview feedback">
                                <span class="material-symbols-outlined" aria-hidden="true">edit</span>
                                <span>Edit</span>
                            </button>
                            <button type="button" class="feedback-owner-action feedback-owner-action-delete" data-delete-interview-trigger data-feedback-id="@submitted.FeedbackId" aria-label="Delete interview feedback">
                                <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                                <span>Delete</span>
                            </button>
                        </div>
                    </div>
                }
                else if (Model.CanSubmitInterviewFeedback)
                {
                    <form method="post" asp-controller="Interview" asp-action="SubmitInterviewFeedback" asp-route-id="@Model.SessionId" class="report-feedback-form safe-text-container" data-feedback-form>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="SessionId" value="@Model.SessionId" />
                        <input type="hidden" name="source" value="Evaluation" />
                        <input type="hidden" name="durationActualSec" value="@Model.DurationActualSec" />
                        <p class="report-rating-help">1 star = poor, 5 stars = excellent</p>

                        @foreach (var field in new[]
                        {
                            new { Name = "OverallRating", Label = "Overall", Value = Model.FeedbackForm.OverallRating },
                            new { Name = "QuestionQualityRating", Label = "Question quality", Value = Model.FeedbackForm.QuestionQualityRating },
                            new { Name = "AiAccuracyRating", Label = "AI accuracy", Value = Model.FeedbackForm.AiAccuracyRating },
                            new { Name = "ScoringFairnessRating", Label = "Scoring fairness", Value = Model.FeedbackForm.ScoringFairnessRating },
                            new { Name = "FeedbackUsefulnessRating", Label = "Feedback usefulness", Value = Model.FeedbackForm.FeedbackUsefulnessRating }
                        })
                        {
                            @await Html.PartialAsync("_StarRating", new WebClient.Models.Shared.StarRatingViewModel
                            {
                                Name = field.Name,
                                Label = field.Label,
                                Value = Model.FeedbackFormWasSubmitted ? field.Value : 5,
                                InstancePrefix = "evaluation-feedback-submit",
                                Editable = true,
                                Required = true,
                                CssClass = "report-star-rating"
                            })
                        }

                        @* Thumbs up/down kept separate from the 1-5 ratings: it is the single flag the
                           administration and manager feedback lists filter on. Optional, so a candidate
                           who skips it stores NULL rather than a misleading "not helpful". *@
                        <fieldset class="report-helpful-field">
                            <legend>Was this session helpful? <span>(optional)</span></legend>
                            <div class="report-helpful-options">
                                <label class="report-helpful-option">
                                    <input type="radio" name="IsHelpful" value="true" checked="@(Model.FeedbackForm.IsHelpful == true)" />
                                    <span><span class="material-symbols-outlined" aria-hidden="true">thumb_up</span> Helpful</span>
                                </label>
                                <label class="report-helpful-option">
                                    <input type="radio" name="IsHelpful" value="false" checked="@(Model.FeedbackForm.IsHelpful == false)" />
                                    <span><span class="material-symbols-outlined" aria-hidden="true">thumb_down</span> Not helpful</span>
                                </label>
                            </div>
                        </fieldset>

                        <label class="report-feedback-label" for="report-feedback-comment">Comment <span>(optional)</span></label>
                        <textarea class="report-feedback-textarea feedback-comment-input @(string.IsNullOrWhiteSpace(Model.FeedbackValidationMessage) ? null : "is-invalid")"
                                  id="report-feedback-comment"
                                  name="Comment"
                                  maxlength="@InterviewFeedbackRules.MaxCommentLength"
                                  aria-describedby="report-feedback-comment-error report-feedback-comment-counter"
                                  aria-invalid="@(!string.IsNullOrWhiteSpace(Model.FeedbackValidationMessage)).ToString().ToLowerInvariant()"
                                  data-feedback-comment
                                  data-server-invalid="@(!string.IsNullOrWhiteSpace(Model.FeedbackValidationMessage)).ToString().ToLowerInvariant()"
                                  placeholder="Any additional thoughts?">@Model.FeedbackForm.Comment</textarea>
                        <div class="feedback-field-meta">
                            <span id="report-feedback-comment-error" class="feedback-field-error" data-feedback-error>@Model.FeedbackValidationMessage</span>
                            <span id="report-feedback-comment-counter" class="feedback-character-counter" data-feedback-counter>@(Model.FeedbackForm.Comment?.Length ?? 0) / @InterviewFeedbackRules.MaxCommentLength</span>
                        </div>
                        <div class="feedback-submit-row">
                            <button type="submit" class="report-feedback-submit" data-feedback-submit data-pending-text="Submitting..."><span class="material-symbols-outlined" aria-hidden="true">send</span> Submit Feedback</button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="report-feedback-unavailable">Interview feedback is unavailable for this session.</p>
                }
            </div>
        }
    </main>

    @if (Model.MyInterviewFeedback is not null)
    {
        <div class="feedback-report-modal" data-edit-interview-modal data-open-on-load="@Model.FeedbackEditFormWasSubmitted.ToString().ToLowerInvariant()" hidden>
            <div class="feedback-report-backdrop" data-edit-interview-close></div>
            <section class="feedback-report-dialog" role="dialog" aria-modal="true" aria-labelledby="edit-interview-title">
                <header class="feedback-report-dialog-header">
                    <div>
                        <p>Interview Feedback</p>
                        <h2 id="edit-interview-title">Edit feedback</h2>
                    </div>
                    <button type="button" class="feedback-report-close" data-edit-interview-close aria-label="Close dialog">
                        <span class="material-symbols-outlined" aria-hidden="true">close</span>
                    </button>
                </header>
                <form method="post" asp-controller="Interview" asp-action="EditInterviewFeedback" asp-route-id="@Model.SessionId" class="feedback-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="feedbackId" value="@Model.MyInterviewFeedback.FeedbackId" />
                    <input type="hidden" name="source" value="Evaluation" />
                    <input type="hidden" name="durationActualSec" value="@Model.DurationActualSec" />
                    @foreach (var field in new[]
                    {
                        new { Name = "OverallRating", Label = "Overall rating", Value = Model.FeedbackEditFormWasSubmitted ? (int?)Model.EditFeedbackForm.OverallRating : (int?)Model.MyInterviewFeedback.OverallRating },
                        new { Name = "QuestionQualityRating", Label = "Question quality", Value = Model.FeedbackEditFormWasSubmitted ? (int?)Model.EditFeedbackForm.QuestionQualityRating : (int?)Model.MyInterviewFeedback.QuestionQualityRating },
                        new { Name = "AiAccuracyRating", Label = "AI accuracy", Value = Model.FeedbackEditFormWasSubmitted ? (int?)Model.EditFeedbackForm.AiAccuracyRating : (int?)Model.MyInterviewFeedback.AiAccuracyRating },
                        new { Name = "ScoringFairnessRating", Label = "Scoring fairness", Value = Model.FeedbackEditFormWasSubmitted ? (int?)Model.EditFeedbackForm.ScoringFairnessRating : (int?)Model.MyInterviewFeedback.ScoringFairnessRating },
                        new { Name = "FeedbackUsefulnessRating", Label = "Feedback usefulness", Value = Model.FeedbackEditFormWasSubmitted ? (int?)Model.EditFeedbackForm.FeedbackUsefulnessRating : (int?)Model.MyInterviewFeedback.FeedbackUsefulnessRating }
                    })
                    {
                        @await Html.PartialAsync("_StarRating", new WebClient.Models.Shared.StarRatingViewModel
                        {
                            Name = field.Name,
                            Label = field.Label,
                            Value = field.Value,
                            InstancePrefix = "evaluation-feedback-edit",
                            Editable = true,
                            Required = true
                        })
                    }
                    <label for="edit-interview-comment" class="feedback-dialog-label">Comment <span>(optional)</span></label>
                    <textarea id="edit-interview-comment" class="feedback-comment-input" name="Comment" rows="4" maxlength="@InterviewFeedbackRules.MaxCommentLength">@(Model.FeedbackEditFormWasSubmitted ? Model.EditFeedbackForm.Comment : Model.MyInterviewFeedback.Comment)</textarea>
                    <div class="feedback-report-actions">
                        <button type="button" class="feedback-report-cancel" data-edit-interview-close>Cancel</button>
                        <button type="submit" class="feedback-report-submit">Save Changes</button>
                    </div>
                </form>
            </section>
        </div>

        <div class="feedback-report-modal" data-delete-interview-modal hidden>
            <div class="feedback-report-backdrop" data-delete-interview-close></div>
            <section class="feedback-report-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-interview-title">
                <header class="feedback-report-dialog-header">
                    <div>
                        <p>Confirmation</p>
                        <h2 id="delete-interview-title">Delete interview feedback?</h2>
                    </div>
                    <button type="button" class="feedback-report-close" data-delete-interview-close aria-label="Close dialog">
                        <span class="material-symbols-outlined" aria-hidden="true">close</span>
                    </button>
                </header>
                <p class="feedback-report-description">Are you sure you want to delete your interview feedback? After deletion, you will be able to submit new feedback for this session.</p>
                <form method="post" asp-controller="Interview" asp-action="DeleteInterviewFeedback" asp-route-id="@Model.SessionId">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="feedbackId" value="@Model.MyInterviewFeedback.FeedbackId" />
                    <input type="hidden" name="source" value="Evaluation" />
                    <input type="hidden" name="durationActualSec" value="@Model.DurationActualSec" />
                    <div class="feedback-report-actions">
                        <button type="button" class="feedback-report-cancel" data-delete-interview-close>Cancel</button>
                        <button type="submit" class="feedback-report-submit feedback-report-submit-danger">Delete</button>
                    </div>
                </form>
            </section>
        </div>
    }

    <script src="~/js/components/feedback-content.js" asp-append-version="true"></script>
    <script src="~/js/components/star-rating.js" asp-append-version="true"></script>
</body>
</html>
