@model WebClient.Models.Evaluation.ReportViewModel

@{
    Layout = null;
    var report = Model.Report;
    const double circumference = 2 * Math.PI * 45; // gauge radius 45

    string Band(decimal score) =>
        score >= 80 ? "var(--color-success)" : score >= 60 ? "var(--color-warning)" : "var(--color-primary)";

    void CategoryCard(string name, string icon, decimal score, string comment)
    {
        var color = Band(score);
        <div class="glass-card report-cat-card">
            <div class="report-cat-head">
                <span class="report-cat-name"><span class="material-symbols-outlined">@icon</span>@name</span>
                <span class="report-cat-score" style="color:@color">@Math.Round(score)/100</span>
            </div>
            <div class="report-bar-track">
                <div class="report-bar-fill" style="width:@(Math.Round(score))%; background:@color"></div>
            </div>
            <p class="report-cat-comment">@comment</p>
        </div>
    }

    string CommentFor(decimal score) =>
        score >= 85 ? "Strong" : score >= 70 ? "Solid" : "Needs improvement";

    // Honest hero title that follows the actual score band (no fixed "Great performance!").
    string HeroTitle(decimal score) =>
        score >= 80 ? "Great performance! 🎉" : score >= 60 ? "Good effort! 💪" : "Keep practicing! 📈";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Interview Report - DevPrep</title>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme-session.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/report.css" asp-append-version="true" />
</head>
<body class="report-page">
    <main class="report-main">
        <div class="report-topbar">
            <span class="report-brand"><span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1;">auto_awesome</span> DevPrep</span>
            <a class="btn-primary-solid" asp-controller="Interview" asp-action="Index">＋ New Interview</a>
        </div>

        @if (report is not null)
        {
            var overall = report.OverallScore;
            var color = Band(overall);
            var dashOffset = circumference * (1 - (double)overall / 100);

            <!-- Hero -->
            <div class="glass-card report-hero">
                <div>
                    <h1 class="report-hero-title">@HeroTitle(overall)</h1>
                    <p class="report-hero-sub">@Model.Position &mdash; @Model.Level level</p>
                    <div class="report-chips">
                        <span class="report-chip"><span class="material-symbols-outlined" style="font-size:16px">forum</span>@Model.Questions.Count Questions</span>
                        @if (!string.IsNullOrEmpty(report.Grade))
                        {
                            <span class="report-chip"><span class="material-symbols-outlined" style="font-size:16px">grade</span>Grade @report.Grade</span>
                        }
                    </div>
                </div>
                <div class="gauge">
                    <svg viewBox="0 0 100 100">
                        <circle class="gauge-track" cx="50" cy="50" r="45" fill="none" stroke-width="8"></circle>
                        <circle cx="50" cy="50" r="45" fill="none" stroke="@color" stroke-width="8"
                                stroke-linecap="round"
                                stroke-dasharray="@circumference.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                stroke-dashoffset="@dashOffset.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"></circle>
                    </svg>
                    <div class="gauge-value-inner">
                        <span class="gauge-score" style="color:@color">@Math.Round(overall)</span>
                        <span class="gauge-denom">/100</span>
                    </div>
                </div>
            </div>

            <!-- Performance by Category -->
            <h2 class="report-section-title">Performance by Category</h2>
            <div class="report-cat-grid">
                @if (report.TechnicalScore is not null) { CategoryCard("Technical", "code", report.TechnicalScore.Value, CommentFor(report.TechnicalScore.Value)); }
                @if (report.TheoryScore is not null) { CategoryCard("Theory", "menu_book", report.TheoryScore.Value, CommentFor(report.TheoryScore.Value)); }
                @if (report.CommunicationScore is not null) { CategoryCard("Communication", "record_voice_over", report.CommunicationScore.Value, CommentFor(report.CommunicationScore.Value)); }
                @if (report.ProblemSolvingScore is not null) { CategoryCard("Problem Solving", "psychology", report.ProblemSolvingScore.Value, CommentFor(report.ProblemSolvingScore.Value)); }
            </div>
        }
        else
        {
            <!-- Empty state: no answer has been graded, so there is no report to show. -->
            <div class="glass-card report-empty-state">
                <span class="material-symbols-outlined">bar_chart</span>
                <h2>No evaluation yet</h2>
                <p>This session hasn't been graded yet. Answer the questions and finish the interview to get your scored report.</p>
                @if (!string.IsNullOrEmpty(Model.EmptyReason))
                {
                    <p class="report-empty-reason">@Model.EmptyReason</p>
                }
                <a class="btn-primary-solid" asp-controller="Interview" asp-action="Index">Start a new interview</a>
            </div>
        }

        @if (report is not null)
        {
        <!-- Question-by-Question Review -->
        <h2 class="report-section-title">Question-by-Question Review</h2>
        @if (Model.Questions.Count == 0)
        {
            <div class="glass-card report-empty">No questions found for this session.</div>
        }
        else
        {
            <div class="report-questions">
                @foreach (var q in Model.Questions)
                {
                    var qColor = q.Score is not null ? Band(q.Score.Value) : "var(--color-text-secondary)";
                    <details class="glass-card report-q">
                        <summary>
                            <span class="report-q-left">
                                <span class="report-q-num">@q.OrderIndex</span>
                                <span class="report-q-text">@q.Content</span>
                            </span>
                            @if (q.Score is not null)
                            {
                                <span class="report-q-score" style="color:@qColor; border:1px solid @qColor">@Math.Round(q.Score.Value)/100</span>
                            }
                            else
                            {
                                <span class="report-q-score" style="color:var(--color-text-secondary); border:1px solid var(--color-border)">Not evaluated</span>
                            }
                        </summary>
                        <div class="report-q-body">
                            @if (!string.IsNullOrEmpty(q.AiFeedback))
                            {
                                <div class="report-q-block">
                                    <span class="label">AI Analysis</span>
                                    <p>@q.AiFeedback</p>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(q.Strengths))
                            {
                                <div class="report-q-block strengths">
                                    <span class="label">Strengths</span>
                                    <p>@q.Strengths</p>
                                </div>
                            }
                            @if (q.Score is null)
                            {
                                <div class="report-q-none">This answer has not been evaluated yet.</div>
                            }
                        </div>
                    </details>
                }
            </div>
        }
        }

        <!-- AI Coach Summary -->
        @if (report is not null && (!string.IsNullOrEmpty(report.Strengths) || !string.IsNullOrEmpty(report.Improvements) || !string.IsNullOrEmpty(report.Summary)))
        {
            <div class="glass-card report-summary">
                <h3 class="report-summary-title"><span class="material-symbols-outlined">auto_awesome</span> AI Coach Summary</h3>
                @if (!string.IsNullOrEmpty(report.Summary))
                {
                    <p style="color:var(--color-text-secondary); margin-top:0">@report.Summary</p>
                }
                <div class="report-summary-grid">
                    <div class="report-summary-col strengths">
                        <h4>Key Strengths</h4>
                        <ul>
                            @foreach (var item in (report.Strengths ?? "").Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                            {
                                <li><span class="material-symbols-outlined">check_circle</span>@item</li>
                            }
                        </ul>
                    </div>
                    <div class="report-summary-col improve">
                        <h4>Areas to Improve</h4>
                        <ul>
                            @foreach (var item in (report.Improvements ?? "").Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                            {
                                <li><span class="material-symbols-outlined">arrow_upward</span>@item</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

        <!-- UI PLACEHOLDER (session feedback): markup/style only, per the interviewfeedback mockup.
             The submit logic is owned by another team member (FeedbackAPI) — do NOT wire real
             submission here. Stars/tags toggle visually; Submit shows a "Coming soon" note. -->
        @if (report is not null)
        {
            <div class="glass-card report-feedback">
                <h3 class="report-feedback-title">How was this session?</h3>
                <p class="report-feedback-sub">Help us improve the AI coaching experience.</p>
                <div class="star-rating">
                    @for (var i = 0; i < 5; i++)
                    {
                        <button type="button" class="star-btn"><span class="material-symbols-outlined">star</span></button>
                    }
                </div>
                <div class="feedback-tags">
                    <button type="button" class="feedback-tag">Questions too easy</button>
                    <button type="button" class="feedback-tag">Spot on analysis</button>
                    <button type="button" class="feedback-tag">Audio issues</button>
                </div>
                <textarea class="feedback-textarea" placeholder="Any additional thoughts?"></textarea>
                <div class="feedback-submit-row">
                    <span class="coming-soon-note" id="feedback-note" hidden>Coming soon — this feature is being built.</span>
                    <button type="button" class="btn-submit" data-coming-soon="feedback-note">Submit Feedback</button>
                </div>
            </div>
        }
    </main>

    <div class="report-bottom">
        <div class="report-bottom-inner">
            <a class="btn-ghost" asp-controller="Home" asp-action="Index"><span class="material-symbols-outlined" style="font-size:18px">arrow_back</span> Back to Dashboard</a>
            <div class="report-bottom-actions">
                <!-- UI PLACEHOLDER: Share/Download are mockup-parity buttons; the real export logic
                     is owned by another team member. Clicking shows a "Coming soon" note. -->
                <span class="coming-soon-note" id="share-note" hidden>Coming soon — this feature is being built.</span>
                <button type="button" class="btn-outline" data-coming-soon="share-note"><span class="material-symbols-outlined" style="font-size:18px">share</span> Share</button>
                <button type="button" class="btn-outline" data-coming-soon="share-note"><span class="material-symbols-outlined" style="font-size:18px">download</span> Download</button>
                <a class="btn-primary-solid" asp-controller="Interview" asp-action="Index">Start New Interview <span class="material-symbols-outlined" style="font-size:18px">play_arrow</span></a>
            </div>
        </div>
    </div>

    <script>
        // UI placeholder wiring only: stars/tags toggle visually (nothing is sent anywhere);
        // Submit/Share/Download reveal a "Coming soon" note instead of doing anything.
        (function () {
            document.querySelectorAll("[data-coming-soon]").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    var note = document.getElementById(btn.dataset.comingSoon);
                    if (note) note.hidden = false;
                });
            });

            var stars = Array.prototype.slice.call(document.querySelectorAll(".star-btn"));
            stars.forEach(function (star, index) {
                star.addEventListener("click", function () {
                    stars.forEach(function (s, i) { s.classList.toggle("active", i <= index); });
                });
            });

            document.querySelectorAll(".feedback-tag").forEach(function (tag) {
                tag.addEventListener("click", function () { tag.classList.toggle("active"); });
            });
        })();
    </script>
</body>
</html>
