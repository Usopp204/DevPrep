@model WebClient.Models.Admin.AdminPaymentsViewModel
@{
    ViewData["Title"] = "Transaction Audit";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Transaction Audit – DevPrep Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <style>
        /* ── Page-specific only — structural layout handled by admin.css ── */
        :root {
            --border-m: rgba(255,255,255,.04);
            --primary:  #818cf8; --primary-dim:  rgba(129,140,248,.12);
            --success:  #10B981; --success-dim:  rgba(16,185,129,.12);
            --error:    #f87171; --error-dim:    rgba(248,113,113,.12);
            --warning:  #fbbf24; --warning-dim:  rgba(251,191,36,.12);
            --text:     #e5e1e7; --text-muted:   #9ca3af; --text-dim: #6b7280;
            --r-sm: 8px; --r-md: 12px; --r-lg: 16px;
        }
        .page-head  { margin-bottom: 28px; }
        .page-label { font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 600;
                      letter-spacing: .12em; text-transform: uppercase; color: var(--primary); margin-bottom: 6px; }

        /* Card (renamed to avoid Bootstrap .card conflict) */
        .data-card      { background: rgba(17,24,39,.4); backdrop-filter: blur(12px);
                          border-top: 1px solid rgba(255,255,255,.1); border-left: 1px solid rgba(255,255,255,.1);
                          border-right: .5px solid rgba(255,255,255,.05); border-bottom: .5px solid rgba(255,255,255,.05);
                          border-radius: var(--r-lg); overflow: hidden; }
        .data-card-head { display: flex; align-items: center; justify-content: space-between;
                          padding: 16px 20px; border-bottom: 1px solid var(--ad-border); }
        .data-card-title { font-size: 15px; font-weight: 600; color: var(--text); }

        /* Status badges */
        .badge-pill { display: inline-flex; align-items: center; gap: 4px; padding: 4px 12px;
                      border-radius: 20px; font-family: 'JetBrains Mono', monospace;
                      font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
        .badge-pill .material-symbols-outlined { font-size: 13px; }
        .badge-paid    { background: var(--success-dim); color: var(--success); }
        .badge-failed  { background: var(--error-dim);   color: var(--error); }
        .badge-pending { background: var(--warning-dim); color: var(--warning); }

        /* Table */
        .tx-table { width: 100%; border-collapse: collapse; }
        .tx-table th { text-align: left; padding: 12px 18px;
                       font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 600;
                       letter-spacing: .1em; text-transform: uppercase;
                       color: var(--text-dim); border-bottom: 1px solid var(--ad-border); }
        .tx-table td { padding: 15px 18px; border-bottom: 1px solid var(--border-m);
                       font-size: 14px; vertical-align: middle; color: var(--text); }
        .tx-table tbody tr:hover { background: rgba(255,255,255,.03); }
        .tx-table tbody tr:last-child td { border-bottom: none; }
        .mono  { font-family: 'JetBrains Mono', monospace; font-size: 12px; }
        .muted { color: var(--text-muted); }
        .order-code { display: inline-block; max-width: 180px; overflow: hidden;
                      text-overflow: ellipsis; white-space: nowrap; vertical-align: middle; }

        /* Pagination */
        .pager      { display: flex; align-items: center; justify-content: space-between;
                      padding: 14px 20px; border-top: 1px solid var(--ad-border); }
        .pager-info { font-size: 13px; color: var(--text-muted); }
        .pager-nav  { display: flex; gap: 5px; }
        .pager-btn  { display: inline-flex; align-items: center; gap: 4px; padding: 6px 12px;
                      border-radius: var(--r-sm); border: 1px solid var(--ad-border);
                      background: rgba(255,255,255,.03); color: var(--text-muted);
                      font-size: 13px; font-weight: 600; text-decoration: none;
                      transition: background .15s, color .15s; }
        .pager-btn:hover { background: rgba(255,255,255,.06); color: var(--text); }
        .pager-btn.now   { background: var(--primary-dim); color: var(--primary);
                           border-color: rgba(129,140,248,.25); }
        .pager-btn .material-symbols-outlined { font-size: 13px; }

        .empty-msg { text-align: center; padding: 48px; color: var(--text-muted); font-size: 14px; }
        .err-box   { margin-bottom: 20px; background: var(--error-dim);
                     border: 1px solid rgba(248,113,113,.2); border-radius: var(--r-md);
                     padding: 14px 18px; font-size: 14px; color: var(--error); }

        /* Filter toolbar */
        .filter-bar   { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end;
                        padding: 16px 20px; margin-bottom: 20px; }
        .filter-field { display: flex; flex-direction: column; gap: 4px; }
        .filter-field label { font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 600;
                               letter-spacing: .08em; text-transform: uppercase; color: var(--text-dim); }
        .filter-field input, .filter-field select {
            background: #11121a !important; border: 1px solid #292c3d !important; border-radius: var(--r-sm);
            color: #ffffff !important; font-size: 13px; padding: 7px 10px; min-width: 130px;
        }
        .filter-field select option { background-color: #11121a !important; color: #ffffff !important; }
        input[type="date"] { color-scheme: dark !important; }
        .filter-field input:focus, .filter-field select:focus { outline: none; border-color: var(--primary); background: #161824 !important; }
        .filter-actions { display: flex; gap: 8px; }
        .btn-filter   { background: var(--primary-dim); color: var(--primary); border: 1px solid rgba(129,140,248,.25);
                        border-radius: var(--r-sm); padding: 8px 16px; font-size: 13px; font-weight: 600; cursor: pointer; }
        .btn-filter:hover { background: rgba(129,140,248,.2); }
        .btn-clear    { background: rgba(255,255,255,.03); color: var(--text-muted); border: 1px solid var(--ad-border);
                        border-radius: var(--r-sm); padding: 8px 16px; font-size: 13px; font-weight: 600;
                        text-decoration: none; display: inline-flex; align-items: center; }
        .btn-clear:hover { background: rgba(255,255,255,.06); color: var(--text); }

        /* Revenue report card */
        .revenue-card  { padding: 18px 20px; margin-bottom: 20px; }
        .revenue-head  { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
        .period-tabs   { display: flex; gap: 6px; }
        .period-tab    { padding: 6px 14px; border-radius: 20px; border: 1px solid var(--ad-border);
                          background: rgba(255,255,255,.03); color: var(--text-muted);
                          font-size: 12px; font-weight: 600; text-decoration: none; }
        .period-tab:hover { color: var(--text); }
        .period-tab.now { background: var(--primary-dim); color: var(--primary); border-color: rgba(129,140,248,.25); }
        .custom-range  { display: flex; gap: 8px; align-items: flex-end; flex-wrap: wrap; }
        .revenue-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; }
        .revenue-stat-label { font-size: 11px; color: var(--text-dim); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 4px; }
        .revenue-stat-value { font-size: 22px; font-weight: 700; color: var(--text); }
        .revenue-range { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
    </style>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-page">
@await Html.PartialAsync("_AdminTopbar")
@await Html.PartialAsync("_AdminSidebar")

<main class="ad-main">
    <header class="page-head">
        <div>
            <p class="page-label">Payment Admin</p>
            <h1 class="ad-page-title">Transaction Audit</h1>
        </div>
    </header>

    @{
        var period = Model.Revenue?.Period ?? "today";
    }
    <!-- Filter & search toolbar -->
    <form class="data-card filter-bar" method="get" asp-controller="PaymentAdmin" asp-action="Payments">
        <input type="hidden" name="period" value="@period" />
        @if (period == "custom")
        {
            <input type="hidden" name="from" value="@(Model.Revenue?.From.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="to" value="@(Model.Revenue?.To.ToString("yyyy-MM-dd"))" />
        }
        <div class="filter-field">
            <label>Search order code</label>
            <input type="text" name="keyword" value="@Model.Keyword" placeholder="ORD-..." />
        </div>
        <div class="filter-field">
            <label>Status</label>
            <select name="status">
                <option value="">All</option>
                <option value="Paid" selected="@(Model.Status == "Paid")">Paid</option>
                <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                <option value="Failed" selected="@(Model.Status == "Failed")">Failed</option>
            </select>
        </div>
        <div class="filter-field">
            <label>Method</label>
            <select name="paymentMethod">
                <option value="">All</option>
                <option value="VNPay" selected="@(Model.PaymentMethod == "VNPay")">VNPay</option>
            </select>
        </div>
        <div class="filter-field">
            <label>From date</label>
            <input type="date" name="dateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="filter-field">
            <label>To date</label>
            <input type="date" name="dateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="filter-field">
            <label>Min amount</label>
            <input type="number" name="minAmount" value="@Model.MinAmount" placeholder="0" min="0" />
        </div>
        <div class="filter-field">
            <label>Max amount</label>
            <input type="number" name="maxAmount" value="@Model.MaxAmount" placeholder="0" min="0" />
        </div>
        <div class="filter-actions">
            <button type="submit" class="btn-filter">Apply</button>
            <a class="btn-clear" asp-controller="PaymentAdmin" asp-action="Payments" asp-route-period="@period">Clear</a>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="err-box">@Model.ErrorMessage</div>
    }
    else
    {
        <!-- Revenue report -->
        <div class="data-card revenue-card">
            <div class="revenue-head">
                <span class="data-card-title">Revenue Report</span>
                <div class="period-tabs">
                    <a class="period-tab @(period == "today" ? "now" : "")"
                       asp-controller="PaymentAdmin" asp-action="Payments"
                       asp-route-period="today" asp-route-keyword="@Model.Keyword" asp-route-status="@Model.Status"
                       asp-route-paymentMethod="@Model.PaymentMethod" asp-route-dateFrom="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" asp-route-dateTo="@(Model.DateTo?.ToString("yyyy-MM-dd"))"
                       asp-route-minAmount="@Model.MinAmount" asp-route-maxAmount="@Model.MaxAmount">Today</a>
                    <a class="period-tab @(period == "month" ? "now" : "")"
                       asp-controller="PaymentAdmin" asp-action="Payments"
                       asp-route-period="month" asp-route-keyword="@Model.Keyword" asp-route-status="@Model.Status"
                       asp-route-paymentMethod="@Model.PaymentMethod" asp-route-dateFrom="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" asp-route-dateTo="@(Model.DateTo?.ToString("yyyy-MM-dd"))"
                       asp-route-minAmount="@Model.MinAmount" asp-route-maxAmount="@Model.MaxAmount">This Month</a>
                    <a class="period-tab @(period == "year" ? "now" : "")"
                       asp-controller="PaymentAdmin" asp-action="Payments"
                       asp-route-period="year" asp-route-keyword="@Model.Keyword" asp-route-status="@Model.Status"
                       asp-route-paymentMethod="@Model.PaymentMethod" asp-route-dateFrom="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" asp-route-dateTo="@(Model.DateTo?.ToString("yyyy-MM-dd"))"
                       asp-route-minAmount="@Model.MinAmount" asp-route-maxAmount="@Model.MaxAmount">This Year</a>
                </div>
                <form class="custom-range" method="get" asp-controller="PaymentAdmin" asp-action="Payments">
                    <input type="hidden" name="period" value="custom" />
                    <input type="hidden" name="keyword" value="@Model.Keyword" />
                    <input type="hidden" name="status" value="@Model.Status" />
                    <input type="hidden" name="paymentMethod" value="@Model.PaymentMethod" />
                    <input type="hidden" name="dateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" />
                    <input type="hidden" name="dateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" />
                    <input type="hidden" name="minAmount" value="@Model.MinAmount" />
                    <input type="hidden" name="maxAmount" value="@Model.MaxAmount" />
                    <div class="filter-field">
                        <label>From</label>
                        <input type="date" name="from" value="@(period == "custom" ? Model.Revenue?.From.ToString("yyyy-MM-dd") : null)" />
                    </div>
                    <div class="filter-field">
                        <label>To</label>
                        <input type="date" name="to" value="@(period == "custom" ? Model.Revenue?.To.AddDays(-1).ToString("yyyy-MM-dd") : null)" />
                    </div>
                    <button type="submit" class="btn-filter">View</button>
                </form>
            </div>
            @if (!string.IsNullOrEmpty(Model.Revenue?.ErrorMessage))
            {
                <div class="err-box">@Model.Revenue.ErrorMessage</div>
            }
            else
            {
                <div class="revenue-stats">
                    <div>
                        <div class="revenue-stat-label">Packages Sold</div>
                        <div class="revenue-stat-value">@Model.Revenue?.PackagesSold</div>
                    </div>
                    <div>
                        <div class="revenue-stat-label">Total Revenue</div>
                        <div class="revenue-stat-value" style="color:var(--success);">@Model.Revenue?.TotalRevenue.ToString("N0") VND</div>
                    </div>
                    <div>
                        <div class="revenue-stat-label">Total Credits</div>
                        <div class="revenue-stat-value">@Model.Revenue?.TotalCredits</div>
                    </div>
                </div>
                <div class="revenue-range">@Model.Revenue?.From.ToString("dd/MM/yyyy") &ndash; @Model.Revenue?.To.AddDays(-1).ToString("dd/MM/yyyy")</div>
            }
        </div>

        <!-- Stat bar — same glass-card ad-stat structure as Dashboard -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mb-4">
            <div class="col">
                <div class="glass-card ad-stat">
                    <div class="ad-stat-top">
                        <span class="ad-stat-label">Total Transactions</span>
                        <span class="material-symbols-outlined" style="color:var(--ad-primary);opacity:.6;font-variation-settings:'FILL' 1;">receipt_long</span>
                    </div>
                    <div><div class="ad-stat-value">@Model.TotalCount</div></div>
                </div>
            </div>
            <div class="col">
                <div class="glass-card ad-stat">
                    <div class="ad-stat-top">
                        <span class="ad-stat-label">Paid Transactions</span>
                        <span class="material-symbols-outlined" style="color:var(--ad-success);opacity:.6;font-variation-settings:'FILL' 1;">check_circle</span>
                    </div>
                    <div><div class="ad-stat-value" style="color:var(--ad-success);">@Model.PaidCount</div></div>
                </div>
            </div>
            <div class="col">
                <div class="glass-card ad-stat">
                    <div class="ad-stat-top">
                        <span class="ad-stat-label">Total Amount</span>
                        <span class="material-symbols-outlined" style="color:var(--ad-primary);opacity:.6;font-variation-settings:'FILL' 1;">payments</span>
                    </div>
                    <div><div class="ad-stat-value">@Model.TotalAmount.ToString("N0")</div></div>
                </div>
            </div>
            <div class="col">
                <div class="glass-card ad-stat">
                    <div class="ad-stat-top">
                        <span class="ad-stat-label">Paid Amount</span>
                        <span class="material-symbols-outlined" style="color:var(--ad-success);opacity:.6;font-variation-settings:'FILL' 1;">account_balance_wallet</span>
                    </div>
                    <div><div class="ad-stat-value" style="color:var(--ad-success);">@Model.PaidAmount.ToString("N0")</div></div>
                </div>
            </div>
        </div>

        <!-- Transactions table -->
        <div class="data-card">
            <div class="data-card-head">
                <span class="data-card-title">All Transactions</span>
                <span style="font-size:13px;color:var(--text-muted);">Page @Model.Page of @Model.TotalPages · @Model.TotalCount total</span>
            </div>

            @if (Model.Items.Count == 0)
            {
                <div class="empty-msg">No transactions yet.</div>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table class="tx-table">
                        <colgroup>
                            <col style="width:200px;" />
                            <col style="width:120px;" />
                            <col style="width:90px;" />
                            <col style="width:150px;" />
                            <col style="width:90px;" />
                            <col style="width:130px;" />
                            <col style="width:100px;" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Order Code</th>
                                <th>User ID</th>
                                <th style="text-align:right;">Credits</th>
                                <th style="text-align:right;">Amount</th>
                                <th>Method</th>
                                <th>Date</th>
                                <th style="text-align:center;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model.Items)
                            {
                                var badgeCls  = o.Status == "Paid" ? "badge-paid" : (o.Status == "Failed" ? "badge-failed" : "badge-pending");
                                var badgeIcon = o.Status == "Paid" ? "check_circle" : (o.Status == "Failed" ? "cancel" : "schedule");
                                var txDate    = (o.PaidAt ?? o.CreatedAt);
                                <tr>
                                    <td><span class="mono order-code" title="@o.OrderCode">@o.OrderCode</span></td>
                                    <td><span class="mono muted">@o.UserId.ToString()[..8]…</span></td>
                                    <td style="text-align:right;"><strong>@o.Credits</strong></td>
                                    <td style="text-align:right;">
                                        <span class="mono">@o.Amount.ToString("N0")</span>
                                        <span class="muted" style="font-size:11px;"> @o.Currency</span>
                                    </td>
                                    <td class="muted">@o.PaymentMethod</td>
                                    <td><span class="mono muted">@txDate.ToString("dd/MM/yy HH:mm")</span></td>
                                    <td style="text-align:center;">
                                        <span class="badge-pill @badgeCls">
                                            <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1;">@badgeIcon</span>
                                            @o.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="pager">
                        <span class="pager-info">
                            @((Model.Page - 1) * Model.PageSize + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount)) of @Model.TotalCount
                        </span>
                        <nav class="pager-nav">
                            @if (Model.Page > 1)
                            {
                                <a asp-controller="PaymentAdmin" asp-action="Payments" asp-route-page="@(Model.Page - 1)"
                                   asp-route-keyword="@Model.Keyword" asp-route-status="@Model.Status" asp-route-paymentMethod="@Model.PaymentMethod"
                                   asp-route-dateFrom="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" asp-route-dateTo="@(Model.DateTo?.ToString("yyyy-MM-dd"))"
                                   asp-route-minAmount="@Model.MinAmount" asp-route-maxAmount="@Model.MaxAmount" asp-route-period="@period"
                                   class="pager-btn">
                                    <span class="material-symbols-outlined">chevron_left</span>
                                </a>
                            }
                            @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                            {
                                <a asp-controller="PaymentAdmin" asp-action="Payments" asp-route-page="@p"
                                   asp-route-keyword="@Model.Keyword" asp-route-status="@Model.Status" asp-route-paymentMethod="@Model.PaymentMethod"
                                   asp-route-dateFrom="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" asp-route-dateTo="@(Model.DateTo?.ToString("yyyy-MM-dd"))"
                                   asp-route-minAmount="@Model.MinAmount" asp-route-maxAmount="@Model.MaxAmount" asp-route-period="@period"
                                   class="pager-btn @(p == Model.Page ? "now" : "")">@p</a>
                            }
                            @if (Model.Page < Model.TotalPages)
                            {
                                <a asp-controller="PaymentAdmin" asp-action="Payments" asp-route-page="@(Model.Page + 1)"
                                   asp-route-keyword="@Model.Keyword" asp-route-status="@Model.Status" asp-route-paymentMethod="@Model.PaymentMethod"
                                   asp-route-dateFrom="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" asp-route-dateTo="@(Model.DateTo?.ToString("yyyy-MM-dd"))"
                                   asp-route-minAmount="@Model.MinAmount" asp-route-maxAmount="@Model.MaxAmount" asp-route-period="@period"
                                   class="pager-btn">
                                    <span class="material-symbols-outlined">chevron_right</span>
                                </a>
                            }
                        </nav>
                    </div>
                }
            }
        </div>
    }
</main>
</body>
</html>
