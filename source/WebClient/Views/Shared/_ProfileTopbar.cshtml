@*
    Topbar dùng chung cho khu vực Profile. Include:  @await Html.PartialAsync("_ProfileTopbar")
    Cần nạp ~/css/profile.css. Hiện avatar (chữ đầu email) + dropdown View Profile / Logout.
*@
@{
    var tbEmail = Context.Request.Cookies["user_email"];
    var tbInitial = string.IsNullOrWhiteSpace(tbEmail) ? "U" : tbEmail.Trim().Substring(0, 1).ToUpper();
}
<header class="pf-topbar">
    <a class="pf-brand" asp-controller="Home" asp-action="Index">DevPrep AI</a>
    <div class="pf-topbar-actions">
        <div class="pf-user-menu" id="pf-user-menu">
            <button class="pf-avatar-btn" id="pf-avatar-btn" type="button" aria-haspopup="true" aria-expanded="false" title="@tbEmail">@tbInitial</button>
            <div class="pf-dropdown" role="menu">
                <div class="pf-dropdown-head">
                    <span class="pf-dropdown-email">@tbEmail</span>
                </div>
                <a class="pf-dropdown-item" asp-controller="Profile" asp-action="Index" role="menuitem">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                    View Profile
                </a>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="pf-dropdown-item pf-dropdown-logout" role="menuitem">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                        Logout
                    </button>
                </form>
            </div>
        </div>
    </div>
</header>

<script>
    (function () {
        var menu = document.getElementById('pf-user-menu');
        var btn = document.getElementById('pf-avatar-btn');
        if (!menu || !btn) return;
        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            var open = menu.classList.toggle('open');
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        document.addEventListener('click', function (e) {
            if (!menu.contains(e.target)) { menu.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); }
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') { menu.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); }
        });
    })();
</script>
