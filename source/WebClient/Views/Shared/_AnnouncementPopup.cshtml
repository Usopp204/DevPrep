@*
    Popup thông báo hệ thống — hiển thị trên MỌI trang có include partial này (guest + user).
    Fetch same-origin /Home/Announcements. Logic hiển thị:
      - Nếu người dùng tick "không hiển thị nữa" rồi bấm Got it -> lưu sessionStorage,
        không hiện lại cho tới khi họ MỞ LẠI trang web (đóng/mở trình duyệt xoá sessionStorage).
      - Nếu KHÔNG tick mà bấm Got it -> lần vào trang nào cũng hiện lại.
    Style self-contained (inline) để không phụ thuộc CSS riêng của từng trang.
*@
<div id="devprep-ann-overlay" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(4,7,18,.62); backdrop-filter:blur(4px); align-items:center; justify-content:center; padding:16px;">
    <div style="width:100%; max-width:460px; background:#1a1f30; border:1px solid rgba(255,255,255,.1); border-top:1px solid rgba(255,255,255,.18); border-radius:16px; box-shadow:0 30px 70px rgba(0,0,0,.6); overflow:hidden; font-family:Inter,system-ui,sans-serif; color:#e5e1e7;">
        <div style="display:flex; align-items:center; justify-content:space-between; padding:18px 20px 12px;">
            <div>
                <p style="margin:0 0 2px; font:600 10px/1.2 'JetBrains Mono',monospace; letter-spacing:.14em; text-transform:uppercase; color:#8b5cf6;">Announcement</p>
                <h2 style="margin:0; font-size:18px; font-weight:800;">📢 DevPrep News</h2>
            </div>
            <button type="button" id="devprep-ann-x" aria-label="Close" style="background:none; border:none; color:#9ca3af; font-size:26px; line-height:1; cursor:pointer;">&times;</button>
        </div>
        <div id="devprep-ann-list" style="display:flex; flex-direction:column; gap:12px; max-height:48vh; overflow-y:auto; padding:0 20px 4px;"></div>
        <div style="padding:14px 20px 18px;">
            <label style="display:flex; align-items:center; gap:9px; margin-bottom:14px; cursor:pointer; font-size:13px; color:#c8c5d0;">
                <input type="checkbox" id="devprep-ann-hide" style="width:16px; height:16px; accent-color:#6366f1; cursor:pointer;" />
                Don't show this announcement again
            </label>
            <button type="button" id="devprep-ann-ok" style="width:100%; padding:11px; border:none; border-radius:10px; background:linear-gradient(135deg,#6366f1,#8b5cf6); color:#fff; font-weight:700; font-size:14px; cursor:pointer;">Got it</button>
        </div>
    </div>
</div>
<script>
    (function () {
        var overlay = document.getElementById('devprep-ann-overlay');
        if (!overlay || overlay.dataset.annInit === '1') return;
        overlay.dataset.annInit = '1';

        var HIDE_KEY = 'devprep-ann-hidden';   // sessionStorage: chỉ sống trong phiên trình duyệt
        function esc(s) { return (s == null ? '' : String(s)).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }

        // Đã tick "không hiển thị nữa" trong phiên này -> bỏ qua hoàn toàn (không cần fetch).
        try { if (sessionStorage.getItem(HIDE_KEY) === '1') return; } catch (e) { }

        function close() {
            try { if (document.getElementById('devprep-ann-hide').checked) sessionStorage.setItem(HIDE_KEY, '1'); } catch (e) { }
            overlay.style.display = 'none';
        }

        fetch('/Home/Announcements', { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
            .then(function (items) {
                if (!items || !items.length) return;
                document.getElementById('devprep-ann-list').innerHTML = items.map(function (a) {
                    return '<div style="border:1px solid rgba(255,255,255,.08); border-radius:12px; padding:13px 15px; background:rgba(255,255,255,.03);">'
                        + '<div style="display:flex; align-items:baseline; justify-content:space-between; gap:12px; margin-bottom:5px;">'
                        + '<strong style="font-size:14.5px;">' + esc(a.title) + '</strong>'
                        + '<span style="font-size:11px; opacity:.6; white-space:nowrap;">' + esc(a.createdAt) + '</span></div>'
                        + '<p style="margin:0; font-size:13px; line-height:1.55; opacity:.85; white-space:pre-wrap;">' + esc(a.content) + '</p></div>';
                }).join('');
                overlay.style.display = 'flex';
                document.getElementById('devprep-ann-ok').addEventListener('click', close);
                document.getElementById('devprep-ann-x').addEventListener('click', close);
            })
            .catch(function () { /* best-effort: lỗi thì không hiện popup */ });
    })();
</script>
