@model WebClient.Models.Shared.PaginationViewModel
@{
    var currentPage = Math.Clamp(Model.CurrentPage, 1, Math.Max(1, Model.TotalPages));
    var pagination = WebClient.Models.Shared.PaginationWindow.Create(currentPage, Model.TotalPages);
}
@if (Model.TotalPages > 1)
{
    <nav class="devprep-pagination" aria-label="Pagination">
        @if (pagination.HasPreviousPage)
        {
            <a class="devprep-page-link devprep-page-direction" href="@Model.PageUrl(currentPage - 1)" aria-label="Go to previous page">Previous</a>
        }
        else
        {
            <span class="devprep-page-link devprep-page-direction disabled" aria-disabled="true">Previous</span>
        }

        @if (pagination.FirstPage is int firstPage)
        {
            <a class="devprep-page-link" href="@Model.PageUrl(firstPage)" aria-label="Go to page @firstPage">@firstPage</a>
        }
        @if (pagination.HasLeadingEllipsis)
        {
            <span class="devprep-page-ellipsis" aria-hidden="true">&hellip;</span>
        }

        @foreach (var pageNumber in pagination.Pages)
        {
            <a class="devprep-page-link @(pageNumber == currentPage ? "active" : string.Empty)"
               href="@Model.PageUrl(pageNumber)"
               aria-label="Go to page @pageNumber"
               aria-current="@(pageNumber == currentPage ? "page" : null)">@pageNumber</a>
        }

        @if (pagination.HasTrailingEllipsis)
        {
            <span class="devprep-page-ellipsis" aria-hidden="true">&hellip;</span>
        }
        @if (pagination.LastPage is int lastPage)
        {
            <a class="devprep-page-link" href="@Model.PageUrl(lastPage)" aria-label="Go to page @lastPage">@lastPage</a>
        }

        @if (pagination.HasNextPage)
        {
            <a class="devprep-page-link devprep-page-direction" href="@Model.PageUrl(currentPage + 1)" aria-label="Go to next page">Next</a>
        }
        else
        {
            <span class="devprep-page-link devprep-page-direction disabled" aria-disabled="true">Next</span>
        }
    </nav>
}
