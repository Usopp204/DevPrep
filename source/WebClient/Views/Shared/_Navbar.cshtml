@*
    Shared Home navbar. Pages including this partial should load ~/css/home.css.
    Logged-in users see the profile dropdown; guests see Login/Register.
*@
@{
    var navLoggedIn = !string.IsNullOrEmpty(Context.Request.Cookies["access_token"]);
    var navRole = Context.Request.Cookies["user_role"] ?? string.Empty;
    var navIsAdmin = string.Equals(navRole, "Admin", StringComparison.OrdinalIgnoreCase)
                  || string.Equals(navRole, "Manager", StringComparison.OrdinalIgnoreCase);
    var activeController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    bool IsActive(string controller) => string.Equals(activeController, controller, StringComparison.OrdinalIgnoreCase);
    string NavClass(string controller) => IsActive(controller) ? "active" : string.Empty;
    string? AriaCurrent(string controller) => IsActive(controller) ? "page" : null;
}
<nav class="hm-navbar" id="hm-navbar">
    <div class="hm-navbar-inner">
        <a class="hm-brand" asp-controller="Home" asp-action="Index">DevPrep AI</a>

        <div class="hm-nav-links">
            @if (!navLoggedIn)
            {
                <a class="@NavClass("Home")" aria-current="@AriaCurrent("Home")" asp-controller="Home" asp-action="Index">Home</a>
                @* Guest chưa đăng nhập: bấm Interview -> chuyển sang trang Login. *@
                <a asp-controller="Auth" asp-action="Login">Interview</a>
                <a class="@NavClass("Payment")" aria-current="@AriaCurrent("Payment")" asp-controller="Payment" asp-action="Index">Payment</a>
                <a class="@NavClass("News")" aria-current="@AriaCurrent("News")" asp-controller="News" asp-action="Index">News</a>
                <a class="@NavClass("Feedback")" aria-current="@AriaCurrent("Feedback")" asp-controller="Feedback" asp-action="System">Feedback</a>
            }
            else if (navIsAdmin)
            {
                <a class="@NavClass("Admin")" aria-current="@AriaCurrent("Admin")" asp-controller="Admin" asp-action="Index">Admin Dashboard</a>
            }
            else
            {
                <a class="@NavClass("Home")" aria-current="@AriaCurrent("Home")" asp-controller="Home" asp-action="Index">Home</a>
                <a class="@NavClass("Interview")" aria-current="@AriaCurrent("Interview")" asp-controller="Interview" asp-action="Index">Interview</a>
                <a class="@NavClass("Payment")" aria-current="@AriaCurrent("Payment")" asp-controller="Payment" asp-action="Index">Payment</a>
                <a class="@NavClass("News")" aria-current="@AriaCurrent("News")" asp-controller="News" asp-action="Index">News</a>
                <a class="@NavClass("Feedback")" aria-current="@AriaCurrent("Feedback")" asp-controller="Feedback" asp-action="System">Feedback</a>
            }
        </div>

        <div class="hm-nav-actions">
            @if (navLoggedIn)
            {
                <partial name="_AuthenticatedAccountMenu" />            }
            else
            {
                <a class="hm-btn-login" asp-controller="Auth" asp-action="Login">Login</a>
                <a class="hm-btn-register primary-btn-gradient" asp-controller="Auth" asp-action="Register">Register</a>
            }
        </div>
    </div>
</nav>

<partial name="_AnnouncementPopup" />

<script>
    (function () {
        const nav = document.getElementById('hm-navbar');
        if (!nav || nav.dataset.navbarInitialized === 'true') return;
        nav.dataset.navbarInitialized = 'true';

        const syncNavbar = function () {
            if (window.scrollY > 50) {
                nav.style.backgroundColor = 'rgba(14, 19, 35, 0.9)';
                nav.style.boxShadow = '0 20px 25px -5px rgba(0,0,0,0.35)';
            } else {
                nav.style.backgroundColor = 'rgba(17, 24, 39, 0.6)';
                nav.style.boxShadow = '0 4px 6px -1px rgba(0,0,0,0.2)';
            }
        };

        window.addEventListener('scroll', syncNavbar, { passive: true });
        window.addEventListener('pageshow', syncNavbar);
        syncNavbar();    })();
</script>
