@*
    Sidebar Admin (dùng chung) — các trang admin khác include:
        @await Html.PartialAsync("_AdminSidebar")
    Cần nạp ~/css/admin.css. Mục "active" (xanh) tự bám theo URL trang hiện tại.
*@
@{
    var currentPath = (Context.Request.Path.Value ?? string.Empty).TrimEnd('/');
    if (currentPath.Length == 0 || currentPath.Equals("/Admin", StringComparison.OrdinalIgnoreCase))
    {
        currentPath = "/Admin/Index";
    }
    // Thêm class " active" nếu URL hiện tại khớp tiền tố của mục (không phân biệt hoa thường).
    string ActiveIf(string prefix) =>
        currentPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? " active" : string.Empty;
}
<aside class="ad-sidebar">
    <div class="ad-sidebar-head">
        <div class="ad-console">
            <div>
                <h2>Admin Dashboard</h2>
            </div>
        </div>
    </div>

    <nav class="ad-nav">
        <a class="ad-nav-item@(ActiveIf("/Admin/Index"))" href="/Admin/Index"><span class="material-symbols-outlined">dashboard</span><span class="label">Dashboard</span></a>
        <a class="ad-nav-item@(ActiveIf("/admin/questions"))" href="/admin/questions"><span class="material-symbols-outlined">quiz</span><span class="label">Question Bank</span></a>
        <a class="ad-nav-item@(ActiveIf("/Admin/TechStacks"))" href="/Admin/TechStacks"><span class="material-symbols-outlined">stacks</span><span class="label">Tech Stacks</span></a>
        <a class="ad-nav-item@(ActiveIf("/Admin/Positions"))" href="/Admin/Positions"><span class="material-symbols-outlined">work</span><span class="label">Positions</span></a>
        <a class="ad-nav-item@(ActiveIf("/Admin/User"))" href="/Admin/User"><span class="material-symbols-outlined">group</span><span class="label">Users</span></a>
        <a class="ad-nav-item@(ActiveIf("/Admin/InterviewSessions"))" href="/Admin/InterviewSessions"><span class="material-symbols-outlined">history</span><span class="label">Interview Sessions</span></a>
        <a class="ad-nav-item@(ActiveIf("/Admin/Payment/Payments"))" asp-controller="PaymentAdmin" asp-action="Payments"><span class="material-symbols-outlined">payments</span><span class="label">Payments</span></a>
        <a class="ad-nav-item@(ActiveIf("/Admin/Payment/Packages"))" asp-controller="PaymentAdmin" asp-action="Packages"><span class="material-symbols-outlined">account_balance_wallet</span><span class="label">Credit Packages</span></a>
        <a class="ad-nav-item@(ActiveIf("/Admin/AiFeedback"))" href="/Admin/AiFeedback"><span class="material-symbols-outlined">smart_toy</span><span class="label">AI Feedback</span></a>
        <a class="ad-nav-item@(ActiveIf("/Admin/SystemFeedback"))" href="/Admin/SystemFeedback"><span class="material-symbols-outlined">forum</span><span class="label">System Feedback</span></a>
        <a class="ad-nav-item@(ActiveIf("/Admin/ReportedFeedback"))" href="/Admin/ReportedFeedback"><span class="material-symbols-outlined">flag</span><span class="label">Reported Feedback</span></a>
        <a class="ad-nav-item@(ActiveIf("/Admin/News"))" href="/Admin/News"><span class="material-symbols-outlined">newspaper</span><span class="label">News</span></a>
    </nav>
</aside>
