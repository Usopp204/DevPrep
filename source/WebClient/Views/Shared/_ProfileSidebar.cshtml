@*
    Sidebar dùng chung cho khu vực Profile (Profile/Index + Profile/Edit).
    Cách dùng:  @await Html.PartialAsync("_ProfileSidebar")
    Trang include cần nạp ~/css/profile.css để có style.
    Đánh dấu mục đang mở bằng:  ViewData["ProfileActive"] = "information" | "cvjd" | "identity" | "transactions" | "password";
    (mặc định "information").
*@
@{
    var active = (ViewData["ProfileActive"] as string) ?? "information";
    string Cls(string key) => "pf-nav-link" + (active == key ? " active" : string.Empty);
}
<aside class="pf-sidebar">
    <ul class="pf-nav">
        <li>
            <a class="@Cls("information")" asp-controller="Profile" asp-action="Index">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                <span>Information</span>
            </a>
        </li>
        <li>
            <a class="@Cls("cvjd")" asp-controller="Profile" asp-action="CvJd">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                <span>CV &amp; JD</span>
            </a>
        </li>
        <li>
            <a class="@Cls("identity")" href="#">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                <span>Identity Verification</span>
            </a>
        </li>
        <li>
            <a class="@Cls("transactions")" href="#">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                <span>Transaction History</span>
            </a>
        </li>
        <li>
            <a class="@Cls("password")" asp-controller="Profile" asp-action="ChangePassword">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                <span>Change Password</span>
            </a>
        </li>
    </ul>
</aside>
