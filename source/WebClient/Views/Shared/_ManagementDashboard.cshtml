@using System.Text.Json
@model WebClient.Models.Dashboard.ManagementDashboardViewModel
@{
    const string unavailable = "—";
    var dashboard = Model.Dashboard;
    var today = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7));
    var minimumDate = today.AddDays(-365);
    string Number(long? value) => value.HasValue ? value.Value.ToString("N0", DisplayCulture.Neutral) : unavailable;
    string Vnd(decimal? value) => value.HasValue ? value.Value.ToString("N0", DisplayCulture.Money) + " VND" : unavailable;
    var initialJson = JsonSerializer.Serialize(dashboard, new JsonSerializerOptions(JsonSerializerDefaults.Web));
}
<div data-management-dashboard data-dashboard-url="@Model.DashboardDataUrl">
    <script type="application/json" data-dashboard-initial>@Html.Raw(initialJson)</script>

    <div class="alert alert-warning @(dashboard.Available ? "d-none" : "")" data-dashboard-unavailable role="status">
        Dashboard statistics are unavailable.
    </div>
    <div class="alert alert-warning @(!dashboard.Available || !dashboard.Stale ? "d-none" : "")" data-dashboard-stale role="status">
        Dashboard statistics are stale.
    </div>
    <div class="alert alert-danger d-none" data-dashboard-error role="alert"></div>

    <section class="ad-kpi-grid row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4 mb-4" aria-label="System statistics">
        <div class="col"><div class="glass-card ad-stat"><div class="ad-stat-top"><span class="ad-stat-label">Total Candidates</span><span class="material-symbols-outlined" aria-hidden="true">group</span></div><div><div class="ad-stat-value" data-field="totalCandidates">@Number(dashboard.TotalCandidates)</div><div class="ad-stat-label ad-stat-caption">All time</div></div></div></div>
        <div class="col"><div class="glass-card ad-stat"><div class="ad-stat-top"><span class="ad-stat-label">New Candidates This Month</span><span class="material-symbols-outlined" aria-hidden="true">person_add</span></div><div><div class="ad-stat-value" data-field="newCandidatesThisMonth">@Number(dashboard.NewCandidatesThisMonth)</div><div class="ad-stat-label ad-stat-caption">This month</div></div></div></div>
        <div class="col"><div class="glass-card ad-stat"><div class="ad-stat-top"><span class="ad-stat-label">Total Interview Sessions</span><span class="material-symbols-outlined" aria-hidden="true">forum</span></div><div><div class="ad-stat-value" data-field="totalInterviewSessions">@Number(dashboard.TotalInterviewSessions)</div><div class="ad-stat-label ad-stat-caption">All time</div></div></div></div>
        <div class="col"><div class="glass-card ad-stat"><div class="ad-stat-top"><span class="ad-stat-label">Interview Sessions This Month</span><span class="material-symbols-outlined" aria-hidden="true">calendar_month</span></div><div><div class="ad-stat-value" data-field="interviewSessionsThisMonth">@Number(dashboard.InterviewSessionsThisMonth)</div><div class="ad-stat-label ad-stat-caption">This month</div></div></div></div>
        <div class="col"><div class="glass-card ad-stat"><div class="ad-stat-top"><span class="ad-stat-label">Completed Interview Sessions</span><span class="material-symbols-outlined" aria-hidden="true">task_alt</span></div><div><div class="ad-stat-value" data-field="completedInterviewSessions">@Number(dashboard.CompletedInterviewSessions)</div><div class="ad-stat-label ad-stat-caption">All time</div></div></div></div>
        <div class="col"><div class="glass-card ad-stat"><div class="ad-stat-top"><span class="ad-stat-label">Gross VNPay Revenue This Month</span><span class="material-symbols-outlined" aria-hidden="true">payments</span></div><div><div class="ad-stat-value ad-stat-revenue" data-field="grossVnpayRevenueThisMonth">@Vnd(dashboard.GrossVnpayRevenueThisMonth)</div><div class="ad-stat-label ad-stat-caption">This month</div></div></div></div>
        <div class="col"><div class="glass-card ad-stat"><div class="ad-stat-top"><span class="ad-stat-label">Total Feedbacks</span><span class="material-symbols-outlined" aria-hidden="true">reviews</span></div><div><div class="ad-stat-value" data-field="totalFeedbacks">@Number(dashboard.TotalFeedbacks)</div><div class="ad-stat-label ad-stat-caption">All time</div></div></div></div>
        <div class="col"><div class="glass-card ad-stat"><div class="ad-stat-top"><span class="ad-stat-label">Feedbacks This Month</span><span class="material-symbols-outlined" aria-hidden="true">rate_review</span></div><div><div class="ad-stat-value" data-field="feedbacksThisMonth">@Number(dashboard.FeedbacksThisMonth)</div><div class="ad-stat-label ad-stat-caption">This month</div></div></div></div>
    </section>

    <section class="glass-card ad-section" aria-labelledby="revenue-trend-title">
        <div class="ad-dashboard-heading">
            <div>
                <h2 class="ad-section-title" id="revenue-trend-title">Revenue Trend</h2>
                <p class="ad-last-updated mb-0">Last updated: <span data-last-updated>@(dashboard.LastUpdated.HasValue ? dashboard.LastUpdated.Value.ToString("yyyy-MM-dd HH:mm") + " ICT" : unavailable)</span></p>
            </div>
            <form class="ad-range" data-dashboard-form>
                <label for="dashboard-from">From</label>
                <input type="date" id="dashboard-from" name="from" value="@dashboard.From.ToString("yyyy-MM-dd")" min="@minimumDate.ToString("yyyy-MM-dd")" max="@today.ToString("yyyy-MM-dd")" required />
                <label for="dashboard-to">To</label>
                <input type="date" id="dashboard-to" name="to" value="@dashboard.To.ToString("yyyy-MM-dd")" min="@minimumDate.ToString("yyyy-MM-dd")" max="@today.ToString("yyyy-MM-dd")" required />
                <button type="submit" class="ad-apply" data-apply-button>Apply</button>
            </form>
        </div>

        <div class="ad-rev-summary" data-revenue-summary aria-live="polite">
            @if (dashboard.Available)
            {
                <text>Selected range: @Vnd(dashboard.SelectedRangeGrossVnpayRevenue) · @Number(dashboard.SelectedRangePaidVnpayOrders) paid VNPay orders · @dashboard.Granularity granularity · @dashboard.From.ToString("yyyy-MM-dd") to @dashboard.To.ToString("yyyy-MM-dd")</text>
            }
        </div>

        <div class="ad-chart" data-revenue-chart role="img" aria-label="Revenue Trend for the selected date range">
            @if (!dashboard.Available)
            {
                <div class="ad-chart-note">Dashboard statistics are unavailable.</div>
            }
        </div>
        <ul class="visually-hidden" data-bucket-list aria-label="Revenue Trend data">
            @foreach (var bucket in dashboard.RevenueBuckets)
            {
                <li>@bucket.StartDate.ToString("dd/MM/yyyy", DisplayCulture.Neutral) to @bucket.EndDate.ToString("dd/MM/yyyy", DisplayCulture.Neutral): @Vnd(bucket.Revenue), @bucket.Orders.ToString("N0", DisplayCulture.Neutral) paid VNPay orders</li>
            }
        </ul>
    </section>
</div>