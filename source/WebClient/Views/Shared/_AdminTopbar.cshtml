@*
    Thanh trên cùng của Admin (dùng chung). Include: @await Html.PartialAsync("_AdminTopbar")
    Cần nạp ~/css/admin.css. Chỉ còn logo + avatar (bấm avatar -> dropdown có Logout).
*@
@{
    var adEmail = Context.Request.Cookies["user_email"];
    var adInitial = string.IsNullOrWhiteSpace(adEmail) ? "A" : adEmail.Trim().Substring(0, 1).ToUpper();
}
<header class="ad-topbar">
    <div class="ad-topbar-left">
        <span class="ad-brand">DevPrep AI</span>
    </div>

    <div class="ad-topbar-right">
        <div class="ad-user" id="ad-user">
            <button class="ad-avatar" id="ad-avatar-btn" type="button" title="@adEmail" aria-haspopup="true" aria-expanded="false">@adInitial</button>
            <div class="ad-dropdown" role="menu">
                <div class="ad-dropdown-head">
                    <span class="ad-dropdown-avatar">@adInitial</span>
                    <span class="ad-dropdown-email">@(string.IsNullOrWhiteSpace(adEmail) ? "Admin" : adEmail)</span>
                </div>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="ad-dropdown-item" role="menuitem">
                        <span class="material-symbols-outlined">logout</span> Logout
                    </button>
                </form>
            </div>
        </div>
    </div>
</header>

<script>
    (function () {
        const btn = document.getElementById('ad-avatar-btn');
        const menu = document.getElementById('ad-user');
        if (btn && menu) {
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                const open = menu.classList.toggle('open');
                btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            });
            document.addEventListener('click', function (e) {
                if (!menu.contains(e.target)) { menu.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); }
            });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') menu.classList.remove('open'); });
        }
    })();
</script>
