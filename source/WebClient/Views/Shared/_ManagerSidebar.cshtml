@{
    var path = Context.Request.Path.Value ?? string.Empty;
    bool IsActive(string href) => path.Equals(href, StringComparison.OrdinalIgnoreCase)
        || (href != "/Manager/Index" && path.StartsWith(href, StringComparison.OrdinalIgnoreCase));
}
<aside class="ad-sidebar">
    <div class="ad-sidebar-head">
        <div class="ad-console">
            <div>
                <h2>Manager Console</h2>
            </div>
        </div>
    </div>

    <nav class="ad-nav">
        <a class="ad-nav-item @(IsActive("/Manager/Index") ? "active" : "")" href="/Manager/Index">
            <span class="material-symbols-outlined">dashboard</span><span class="label">Dashboard</span>
        </a>
        <a class="ad-nav-item @(IsActive("/Manager/QuestionBank") ? "active" : "")" href="/Manager/QuestionBank">
            <span class="material-symbols-outlined">database</span><span class="label">Question Bank</span>
        </a>
        <a class="ad-nav-item @(IsActive("/Manager/Users") ? "active" : "")" href="/Manager/Users">
            <span class="material-symbols-outlined">group</span><span class="label">Users</span>
        </a>
        <a class="ad-nav-item @(IsActive("/Manager/Sessions") ? "active" : "")" href="/Manager/Sessions">
            <span class="material-symbols-outlined">history</span><span class="label">Sessions</span>
        </a>
        <a class="ad-nav-item @(IsActive("/Manager/Payments") ? "active" : "")" href="/Manager/Payments">
            <span class="material-symbols-outlined">payments</span><span class="label">Payments</span>
        </a>
        <a class="ad-nav-item @(IsActive("/Manager/CreditPackages") ? "active" : "")" href="/Manager/CreditPackages">
            <span class="material-symbols-outlined">account_balance_wallet</span><span class="label">Credit Packages</span>
        </a>
        <a class="ad-nav-item @(IsActive("/Manager/Feedback") ? "active" : "")" href="/Manager/Feedback">
            <span class="material-symbols-outlined">chat_bubble</span><span class="label">System Feedback</span>
        </a>
        <a class="ad-nav-item @(IsActive("/Manager/AiFeedback") ? "active" : "")" href="/Manager/AiFeedback">
            <span class="material-symbols-outlined">smart_toy</span><span class="label">AI Feedback</span>
        </a>
        <a class="ad-nav-item @(IsActive("/Manager/News") ? "active" : "")" href="/Manager/News">
            <span class="material-symbols-outlined">newspaper</span><span class="label">News</span>
        </a>
    </nav>
</aside>
