@*
    Shared footer. Include it from any view with:  @await Html.PartialAsync("_Footer")
    The including page must load ~/css/home.css for the styling.

    Kept deliberately static: the social icons, the Product/Resources link columns, the
    newsletter form and the Privacy/Terms links all pointed at "#" and did nothing, so they
    were removed rather than left as dead ends for the user to click on.
*@
<footer class="hm-footer">
    <div class="hm-footer-intro">
        <div class="hm-footer-brand">DevPrep AI</div>
        <p class="hm-footer-about">
            Sharpening the technical interview skills of Vietnamese engineers
            with the power of next-generation AI.
        </p>
    </div>

    <div class="hm-footer-bottom">
        <span>© 2026 DevPrep AI. All rights reserved.</span>
    </div>
</footer>
