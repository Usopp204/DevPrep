@model WebClient.Models.Manager.UserDetailsViewModel
@{
    Layout = null;

    string memberSinceStr = Model.RegistrationTimestamp.ToString("MMM yyyy");
    bool isActive = Model.Status == "Active";
    string initial = string.IsNullOrEmpty(Model.FullName) ? "?" : Model.FullName[0].ToString().ToUpper();
    string shortId = Model.UserId.ToString().Substring(0, 8).ToUpper();
}

<style>
    /* Drawer Scoped Styles matching the provided Tailwind design */
    .drawer-root {
        position: fixed;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        z-index: 60;
        display: flex;
        justify-content: flex-end;
        font-family: 'Inter', sans-serif;
        color: #e5e1e7;
    }

    .drawer-aside {
        width: 450px;
        background-color: #131317;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        display: flex;
        flex-direction: column;
        border-left: 1px solid rgba(255, 255, 255, 0.08);
        animation: slide-in 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @@keyframes slide-in {
        from { transform: translateX(100%); }
        to { transform: translateX(0); }
    }

    .drawer-header {
        padding: 24px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .drawer-header h2 {
        font-size: 24px;
        line-height: 32px;
        font-weight: 700;
        margin: 0;
    }

    .drawer-header p {
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        font-weight: 500;
        color: #c8c5d0;
        text-transform: uppercase;
        margin: 4px 0 0 0;
        letter-spacing: 0.05em;
    }

    .drawer-close {
        padding: 8px;
        background: transparent;
        border: none;
        color: #c8c5d0;
        border-radius: 9999px;
        cursor: pointer;
        transition: background-color 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .drawer-close:hover {
        background-color: #353438;
    }

    .drawer-content {
        flex: 1;
        overflow-y: auto;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    .drawer-profile {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .drawer-avatar {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        border: 1px solid rgba(226, 223, 255, 0.2);
        object-fit: cover;
        background-color: rgba(226, 223, 255, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: 700;
        color: #e2dfff;
    }

    .drawer-profile-info h3 {
        font-size: 24px;
        font-weight: 600;
        margin: 0;
    }

    .drawer-profile-info p {
        font-size: 14px;
        color: #c8c5d0;
        margin: 0;
    }

    .drawer-badges {
        margin-top: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .drawer-badge-tier {
        padding: 0 8px;
        background-color: rgba(226, 223, 255, 0.1);
        color: #e2dfff;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        text-transform: uppercase;
        border-radius: 4px;
        font-weight: 500;
    }
    .drawer-badge-tier.blocked {
        background-color: rgba(255, 180, 171, 0.1);
        color: #ffb4ab;
    }
    .drawer-badge-tier.active {
        background-color: rgba(16, 185, 129, 0.1);
        color: #10B981;
    }

    .drawer-badge-since {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        color: #c8c5d0;
        text-transform: uppercase;
    }

    .drawer-section-title {
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        font-weight: 500;
        color: #c8c5d0;
        text-transform: uppercase;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding-bottom: 4px;
        margin: 0 0 16px 0;
    }

    .drawer-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .drawer-grid-item {
        padding: 16px;
        background-color: #1a1f30;
        border-radius: 12px;
    }

    .drawer-grid-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: #c8c5d0;
        text-transform: uppercase;
        margin: 0;
    }

    .drawer-grid-value {
        font-size: 20px;
        font-weight: 700;
        margin: 4px 0 0 0;
        color: #e5e1e7;
    }

    .drawer-glass-card {
        padding: 16px;
        background-color: #1c1b1f;
        border-radius: 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        border-left: 1px solid rgba(255, 255, 255, 0.08);
        border-bottom: 0.5px solid rgba(255, 255, 255, 0.04);
        border-right: 0.5px solid rgba(255, 255, 255, 0.04);
    }

    .drawer-list-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .drawer-list-item:last-child {
        border-bottom: none;
    }

    .drawer-list-title {
        font-size: 14px;
        font-weight: 600;
        color: #e5e1e7;
        margin: 0 0 4px 0;
    }

    .drawer-list-date {
        font-size: 12px;
        color: #c8c5d0;
        margin: 0;
    }

    .drawer-list-amount {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 700;
        font-size: 14px;
    }
    .drawer-list-amount.pos { color: #10B981; }
    .drawer-list-amount.neg { color: #ffb4ab; }

    .drawer-notice {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px;
        background-color: rgba(249, 217, 73, 0.05);
        border: 1px solid rgba(249, 217, 73, 0.2);
        border-radius: 12px;
    }
    
    .drawer-notice-icon {
        color: #F9D949;
    }

    .drawer-notice-title {
        font-size: 14px;
        font-weight: 700;
        color: #F9D949;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin: 0 0 2px 0;
    }

    .drawer-notice-desc {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: rgba(249, 217, 73, 0.7);
        margin: 0;
    }

    .drawer-footer {
        padding: 24px;
        background-color: #2a292d;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .drawer-footer-inner {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 16px 24px;
        background-color: rgba(3, 181, 212, 0.2);
        border: 1px solid rgba(3, 181, 212, 0.4);
        border-radius: 12px;
    }

    .drawer-footer-icon {
        color: #4cd7f6;
        font-size: 20px;
    }

    .drawer-footer-text {
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        font-weight: 700;
        color: #4cd7f6;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin: 0;
    }
</style>

<div class="drawer-root" id="drawer-backdrop" onclick="closeDrawer(event)">
    <aside class="drawer-aside" onclick="event.stopPropagation()">
        <!-- Header -->
        <div class="drawer-header">
            <div>
                <h2>User Details</h2>
                <p>ID: USR-@shortId</p>
            </div>
            <button class="drawer-close" onclick="closeDrawer()">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <!-- Content -->
        <div class="drawer-content">
            <!-- Profile Info -->
            <div class="drawer-profile">
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" alt="Avatar" class="drawer-avatar" />
                }
                else
                {
                    <div class="drawer-avatar">@initial</div>
                }
                <div class="drawer-profile-info">
                    <h3>@(Model.FullName ?? "Unknown User")</h3>
                    <p>@Model.Email</p>
                    <div class="drawer-badges">
                        <span class="drawer-badge-tier @(Model.Status?.ToLower() ?? "unknown")">@(Model.Status ?? "Unknown")</span>
                        <span class="drawer-badge-since">Member since @memberSinceStr</span>
                    </div>
                </div>
            </div>

            <!-- Stats -->
            <div>
                <h4 class="drawer-section-title">Overview Stats</h4>
                <div class="drawer-grid">
                    <div class="drawer-grid-item">
                        <p class="drawer-grid-label">Credit Balance</p>
                        <p class="drawer-grid-value">@Model.CreditBalance</p>
                    </div>
                    <div class="drawer-grid-item">
                        <p class="drawer-grid-label">Total Sessions</p>
                        <p class="drawer-grid-value">@Model.CompletedSessions.Count</p>
                    </div>
                </div>
            </div>

            <!-- Recent Sessions -->
            <div>
                <h4 class="drawer-section-title">Recent Sessions</h4>
                <div class="drawer-glass-card">
                    @if (Model.CompletedSessions.Count > 0)
                    {
                        @foreach (var s in Model.CompletedSessions.Take(3))
                        {
                            <div class="drawer-list-item">
                                <div>
                                    <h5 class="drawer-list-title">@s.Title</h5>
                                    <p class="drawer-list-date">@s.StartedAt.ToString("dd MMM yyyy, HH:mm")</p>
                                </div>
                                <span class="drawer-list-amount pos">@s.AnsweredQuestions / @s.TotalQuestions</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p style="color: #c8c5d0; font-size: 13px; text-align: center; margin: 8px 0;">No sessions completed yet.</p>
                    }
                </div>
            </div>

            <!-- Recent Transactions -->
            <div>
                <h4 class="drawer-section-title">Recent Transactions</h4>
                <div class="drawer-glass-card">
                    @if (Model.CreditTransactions.Count > 0)
                    {
                        @foreach (var tx in Model.CreditTransactions.Take(3))
                        {
                            <div class="drawer-list-item">
                                <div>
                                    <h5 class="drawer-list-title">@tx.EntryType</h5>
                                    <p class="drawer-list-date">@tx.CreatedAt.ToString("dd MMM yyyy, HH:mm") • Bal: @tx.BalanceAfter</p>
                                </div>
                                <span class="drawer-list-amount @(tx.CreditChange >= 0 ? "pos" : "neg")">
                                    @(tx.CreditChange >= 0 ? "+" : "")@tx.CreditChange
                                </span>
                            </div>
                        }
                    }
                    else
                    {
                        <p style="color: #c8c5d0; font-size: 13px; text-align: center; margin: 8px 0;">No transactions recorded.</p>
                    }
                </div>
            </div>

            <!-- Lifecycle / Status Notice -->
            <div>
                <h4 class="drawer-section-title">Account Status</h4>
                <div class="drawer-notice">
                    <span class="material-symbols-outlined drawer-notice-icon">
                        @(isActive ? "check_circle" : "block")
                    </span>
                    <div>
                        <p class="drawer-notice-title">@(isActive ? "Account Active" : "Account Suspended")</p>
                        <p class="drawer-notice-desc">System Managed • Compliance Verified</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="drawer-footer">
            <div class="drawer-footer-inner">
                <span class="material-symbols-outlined drawer-footer-icon">lock</span>
                <p class="drawer-footer-text">Locked: Read-Only Environment</p>
            </div>
        </div>
    </aside>
</div>

<script>
    function closeDrawer(e) {
        // If e is passed, only close if target is the backdrop itself
        if (e && e.target !== e.currentTarget) return;
        
        var backdrop = document.getElementById('drawer-backdrop');
        if (backdrop) {
            // Apply reverse animation
            var aside = backdrop.querySelector('.drawer-aside');
            if (aside) {
                aside.style.animation = 'slide-in 0.3s cubic-bezier(0.4, 0, 0.2, 1) reverse forwards';
                setTimeout(() => {
                    document.getElementById('dp-panel-container').innerHTML = '';
                }, 250);
            } else {
                document.getElementById('dp-panel-container').innerHTML = '';
            }
        }
    }
</script>
