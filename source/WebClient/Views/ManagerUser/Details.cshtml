@model WebClient.Models.Manager.UserDetailsViewModel

@{
    Layout = null;
    ViewData["Title"] = "User Detail";

    var displayName = string.IsNullOrWhiteSpace(Model.FullName) ? "Unknown User" : Model.FullName;
    var email = string.IsNullOrWhiteSpace(Model.Email) ? "No email" : Model.Email;
    var status = Model.Status ?? "Unknown";
    var role = Model.Role ?? "User";
    var isBlocked = string.Equals(status, "Blocked", StringComparison.OrdinalIgnoreCase);
    var isActive = string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase);
    var initial = string.IsNullOrEmpty(Model.FullName) ? "?" : Model.FullName[0].ToString().ToUpper();
    var roleClass = role.ToLowerInvariant() switch
    {
        "admin" => "badge-active",
        "manager" => "badge-pending",
        _ => "badge-blocked"
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - DevPrep AI Manager Console</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    <style>
        :root {
            --bg-main: #0f1424;
            --bg-panel: #111827;
            --bg-panel-2: #151f36;
            --border-main: #252b3d;
            --text-main: #ffffff;
            --text-muted: #9ca3af;
            --text-blue: #93c5fd;
            --primary: #6366f1;
        }

        body {
            background: var(--bg-main);
            color: #fff;
            font-family: 'Inter', sans-serif;
        }

        .admin-main-wrapper {
            margin-left: 260px;
            padding-top: 78px;
            min-height: 100vh;
            background: var(--bg-main);
        }

        .admin-content {
            padding: 28px;
        }

        .card-dark {
            background: #111827;
            border: 1px solid #252b3d;
            border-radius: 14px;
            padding: 20px;
        }

        .page-title {
            font-size: 30px;
            font-weight: 800;
            margin-bottom: 4px;
        }

        .page-subtitle {
            color: #93c5fd;
            font-size: 14px;
        }

        .avatar-box {
            width: 82px;
            height: 82px;
            border-radius: 18px;
            background: #1e293b;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 34px;
            font-weight: 800;
            color: #93c5fd;
            overflow: hidden;
        }

        .avatar-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            color: #93c5fd;
            text-transform: uppercase;
            letter-spacing: .08em;
            margin-bottom: 4px;
        }

        .value {
            font-weight: 700;
            color: #ffffff;
            word-break: break-word;
        }

        .muted-text {
            color: #9ca3af;
        }

        .badge-soft {
            display: inline-flex;
            padding: 6px 10px;
            border-radius: 8px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .badge-active {
            background: rgba(16,185,129,.14);
            color: #34d399;
        }

        .badge-blocked {
            background: rgba(239,68,68,.15);
            color: #f87171;
        }

        .badge-pending {
            background: rgba(245,158,11,.16);
            color: #fbbf24;
        }

        .stat-card {
            background: #151f36;
            border: 1px solid #27324d;
            border-radius: 12px;
            padding: 16px;
        }

        .stat-value {
            font-size: 24px;
            font-weight: 900;
        }

        .table-dark-custom {
            --bs-table-bg: #111827;
            --bs-table-color: #dbeafe;
            --bs-table-border-color: #242b3e;
            margin: 0;
        }

        .table-dark-custom thead th {
            background: #171a24 !important;
            color: #a9c7f5 !important;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .08em;
            padding: 14px;
        }

        .table-dark-custom tbody td {
            background: #111827 !important;
            color: #dbeafe !important;
            padding: 14px;
            border-bottom: 1px solid #242b3e;
        }

        .btn-outline-soft {
            background: transparent;
            color: #cbd5e1;
            border: 1px solid #30384e;
            border-radius: 9px;
            padding: 10px 14px;
            text-decoration: none;
            font-weight: 800;
        }

        .btn-outline-soft:hover {
            background: rgba(255,255,255,.06);
            color: #fff;
        }

        @@media (max-width: 991.98px) {
            .admin-main-wrapper {
                margin-left: 0;
                padding-top: 70px;
            }
        }
    </style>
</head>

<body class="admin-page">
    @await Html.PartialAsync("_ManagerTopbar")
    @await Html.PartialAsync("_ManagerSidebar")

    <main class="admin-main-wrapper">
        <div class="admin-content">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                <div>
                    <h1 class="page-title">User Detail</h1>
                    <p class="page-subtitle">Full account profile, credit balance and interview session history.</p>
                </div>

                <div class="d-flex gap-2">
                    <a href="/Manager/Users" class="btn-outline-soft">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back
                    </a>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-12 col-xl-4">
                    <div class="card-dark h-100">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="avatar-box">
                                @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                                {
                                    <img src="@Model.AvatarUrl" alt="Avatar" />
                                }
                                else
                                {
                                    @initial
                                }
                            </div>

                            <div>
                                <h3 class="mb-1 fw-bold">@displayName</h3>
                                <div class="muted-text">@email</div>
                                <div class="mt-2 d-flex gap-2">
                                    <span class="badge-soft @roleClass">@role</span>
                                    @if (isBlocked)
                                    {
                                        <span class="badge-soft badge-blocked">Blocked</span>
                                    }
                                    else if (isActive)
                                    {
                                        <span class="badge-soft badge-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-soft badge-pending">@status</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12">
                                <div class="label">Account ID</div>
                                <div class="value">@Model.AccountId</div>
                            </div>

                            <div class="col-12">
                                <div class="label">User ID</div>
                                <div class="value">@Model.UserId</div>
                            </div>

                            <div class="col-6">
                                <div class="label">Credit Balance</div>
                                <div class="value">@Model.CreditBalance.ToString("N0")</div>
                            </div>

                            <div class="col-6">
                                <div class="label">Total Sessions</div>
                                <div class="value">@Model.CompletedSessions.Count</div>
                            </div>

                            <div class="col-12">
                                <div class="label">Registered At</div>
                                <div class="value">@Model.RegistrationTimestamp.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>

                            @if (Model.LastLoginAt.HasValue)
                            {
                                <div class="col-12">
                                    <div class="label">Last Login</div>
                                    <div class="value">@Model.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                            }

                            @if (Model.UpdatedAt.HasValue)
                            {
                                <div class="col-12">
                                    <div class="label">Updated At</div>
                                    <div class="value">@Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                            }

                            <div class="col-12">
                                <div class="label">Verification</div>
                                <div class="d-flex gap-3 flex-wrap">
                                    <span class="badge-soft @(Model.IsEmailVerified ? "badge-active" : "badge-blocked")">
                                        @(Model.IsEmailVerified ? "Email Verified" : "Email Not Verified")
                                    </span>
                                    <span class="badge-soft @(Model.IsFaceVerified ? "badge-active" : "badge-blocked")">
                                        @(Model.IsFaceVerified ? "Face Verified" : "Face Not Verified")
                                    </span>
                                    <span class="badge-soft @(Model.IsVoiceVerified ? "badge-active" : "badge-blocked")">
                                        @(Model.IsVoiceVerified ? "Voice Verified" : "Voice Not Verified")
                                    </span>
                                </div>
                            </div>

                            @if (isBlocked && !string.IsNullOrWhiteSpace(Model.BlockedReason))
                            {
                                <div class="col-12">
                                    <div class="label">Blocked Reason</div>
                                    <div class="value text-danger">@Model.BlockedReason</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-8">
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-6">
                            <div class="stat-card">
                                <div class="label">Current Credit Balance</div>
                                <div class="stat-value">@Model.CreditBalance.ToString("N0")</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="stat-card">
                                <div class="label">Total Sessions</div>
                                <div class="stat-value">@Model.CompletedSessions.Count</div>
                            </div>
                        </div>
                    </div>

                    <div class="card-dark mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold mb-0">Session History</h5>
                            <span class="muted-text">@Model.CompletedSessions.Count sessions</span>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-dark-custom align-middle">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Level</th>
                                        <th>Mode</th>
                                        <th>Status</th>
                                        <th>Started</th>
                                        <th>Duration</th>
                                        <th>Questions</th>
                                        <th>Credit</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.CompletedSessions.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="8" class="text-center py-5 text-secondary">
                                                No interview sessions found.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var s in Model.CompletedSessions)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-bold text-white">@(s.Title ?? "Untitled Session")</div>
                                                </td>
                                                <td>@(s.Level ?? "N/A")</td>
                                                <td>@(s.InteractionMode ?? "N/A")</td>
                                                <td>@(s.Status ?? "N/A")</td>
                                                <td>@(s.StartedAt.HasValue ? s.StartedAt.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</td>
                                                <td>@(s.DurationMinutes.HasValue ? s.DurationMinutes + " min" : "N/A")</td>
                                                <td>@s.AnsweredQuestions / @s.TotalQuestions</td>
                                                <td>@s.CreditCost</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card-dark">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold mb-0">Credit Transactions</h5>
                            <span class="muted-text">@Model.CreditTransactions.Count transactions</span>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-dark-custom align-middle">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Description</th>
                                        <th>Change</th>
                                        <th>Balance After</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.CreditTransactions.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center py-5 text-secondary">
                                                No credit transactions found.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var tx in Model.CreditTransactions)
                                        {
                                            <tr>
                                                <td>@(tx.EntryType ?? "N/A")</td>
                                                <td>@(tx.Description ?? "N/A")</td>
                                                <td style="color: @(tx.CreditChange >= 0 ? "#34d399" : "#f87171"); font-weight: 700;">@(tx.CreditChange >= 0 ? "+" : "")@tx.CreditChange</td>
                                                <td>@tx.BalanceAfter.ToString("N0")</td>
                                                <td>@tx.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
