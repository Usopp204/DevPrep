@model WebClient.Models.Shared.PagedResult<WebClient.Models.Manager.UserListItemViewModel>
@{
    Layout = null;

    var pageIndex = Model.PageIndex > 0 ? Model.PageIndex : 1;
    var pageSize = Model.PageSize > 0 ? Model.PageSize : 10;
    var totalCount = Model.TotalCount;
    var totalPages = Model.TotalPages;

    var startItem = totalCount == 0 ? 0 : ((pageIndex - 1) * pageSize) + 1;
    var endItem = totalCount == 0 ? 0 : Math.Min(pageIndex * pageSize, totalCount);

    string BuildPageUrl(int page)
    {
        var values = new Dictionary<string, string?>
        {
            ["keyword"] = ViewBag.Keyword as string,
            ["page"] = page.ToString(),
            ["pageSize"] = pageSize.ToString()
        };

        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/Manager/Users", values);
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Overview - DevPrep AI Manager</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    <style>
        :root {
            --bg-main: #0f1424;
            --bg-panel: #111827;
            --bg-table-head: #171a24;
            --border-main: #252b3d;
            --text-main: #ffffff;
            --text-muted: #9ca3af;
            --text-blue: #93c5fd;
            --primary: #6366f1;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
        }

        body {
            background: var(--bg-main);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
        }

        .admin-main-wrapper {
            margin-left: 260px;
            padding-top: 78px;
            min-height: 100vh;
            background: var(--bg-main);
        }

        .admin-content {
            padding: 28px 28px 60px;
        }

        .page-title {
            font-size: 30px;
            font-weight: 800;
            letter-spacing: -0.04em;
            margin-bottom: 4px;
        }

        .page-subtitle {
            color: var(--text-blue);
            font-size: 14px;
            margin-bottom: 24px;
        }

        .filter-card {
            border: 1px solid var(--border-main);
            background: rgba(17, 24, 39, 0.95);
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 18px;
        }

        .filter-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 800;
            color: var(--text-blue);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 7px;
        }

        .admin-input,
        .admin-select {
            height: 42px;
            border-radius: 7px;
            border: 1px solid #30384e;
            background: #0f1322;
            color: #ffffff;
            font-size: 14px;
            box-shadow: none !important;
        }

        .admin-input:focus,
        .admin-select:focus {
            border-color: var(--primary);
            background: #0f1322;
            color: #ffffff;
        }

        .admin-input::placeholder {
            color: #64748b;
        }

        .btn-filter {
            height: 42px;
            width: 100%;
            border: none;
            border-radius: 7px;
            background: #35304f;
            color: #ffffff;
            font-weight: 800;
        }

        .btn-filter:hover {
            background: #4f46e5;
            color: #ffffff;
        }

        .btn-clear {
            height: 42px;
            width: 100%;
            border-radius: 7px;
            border: 1px solid #30384e;
            background: transparent;
            color: #cbd5e1;
            font-weight: 700;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-clear:hover {
            background: rgba(255, 255, 255, 0.06);
            color: #ffffff;
        }

        .table-shell {
            border: 1px solid var(--border-main);
            background: var(--bg-panel);
            border-radius: 12px;
            overflow: hidden;
        }

        .admin-table {
            width: 100%;
            margin: 0;
            color: #dbeafe;
            --bs-table-bg: #111827;
            --bs-table-color: #dbeafe;
            --bs-table-border-color: #242b3e;
            --bs-table-hover-bg: #151f36;
            --bs-table-hover-color: #ffffff;
        }

        .admin-table thead th {
            background: #171a24 !important;
            color: #a9c7f5 !important;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            border-bottom: 1px solid var(--border-main);
            padding: 15px 14px;
            white-space: nowrap;
        }

        .admin-table tbody tr {
            background: #111827 !important;
        }

        .admin-table tbody td {
            background: #111827 !important;
            color: #dbeafe !important;
            border-bottom: 1px solid #242b3e;
            padding: 16px 14px;
            vertical-align: middle;
            font-size: 14px;
        }

        .admin-table tbody tr:hover td {
            background: #151f36 !important;
        }

        .user-name {
            color: #ffffff;
            font-weight: 800;
            margin-bottom: 3px;
        }

        .user-email {
            color: #93c5fd;
            font-size: 13px;
        }

        .metric-strong {
            color: #ffffff;
            font-weight: 700;
        }

        .muted-small {
            color: var(--text-muted);
            font-size: 12px;
        }

        .role-badge,
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 7px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .role-admin {
            background: rgba(99, 102, 241, 0.16);
            color: #c4b5fd;
        }

        .role-manager {
            background: rgba(14, 165, 233, 0.16);
            color: #7dd3fc;
        }

        .role-user {
            background: rgba(148, 163, 184, 0.14);
            color: #cbd5e1;
        }

        .status-active {
            background: rgba(16, 185, 129, 0.14);
            color: #6ee7b7;
        }

        .status-blocked {
            background: rgba(239, 68, 68, 0.14);
            color: #fca5a5;
        }

        .status-pending {
            background: rgba(245, 158, 11, 0.14);
            color: #fcd34d;
        }

        .action-btn {
            width: 34px;
            height: 34px;
            border: none;
            background: transparent;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            transition: 0.15s ease;
            text-decoration: none;
        }

        .action-btn:hover {
            background: rgba(255, 255, 255, 0.08);
        }

        .action-view {
            color: #93c5fd;
        }

        .empty-row {
            height: 140px;
            color: #cbd5e1;
            text-align: center;
            font-weight: 600;
        }

        .error-box {
            border: 1px solid rgba(239, 68, 68, 0.45);
            background: rgba(239, 68, 68, 0.08);
            color: #fecaca;
            border-radius: 10px;
            padding: 13px 16px;
            margin-bottom: 18px;
            font-weight: 700;
        }

        .table-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 14px 16px;
            color: var(--text-muted);
            font-size: 12px;
        }

        .pager {
            display: flex;
            gap: 6px;
            align-items: center;
        }

        .pager a,
        .pager span {
            min-width: 34px;
            height: 34px;
            border-radius: 7px;
            border: 1px solid #30384e;
            color: #cbd5e1;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
        }

        .pager .active-page {
            background: var(--primary);
            border-color: var(--primary);
            color: #ffffff;
        }

        .drawer-loader {
            width: 28px;
            height: 28px;
            border: 3px solid rgba(255, 255, 255, 0.08);
            border-top-color: #4cd7f6;
            border-radius: 50%;
            animation: spin 0.85s linear infinite;
            margin: 80px auto;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }

        @@media (max-width: 991.98px) {
            .admin-main-wrapper {
                margin-left: 0;
                padding-top: 70px;
            }
        }
    </style>
</head>
<body class="admin-page">
    @await Html.PartialAsync("_ManagerTopbar")
    @await Html.PartialAsync("_ManagerSidebar")

    <main class="admin-main-wrapper">
        <div class="admin-content">
            <div class="d-flex align-items-start justify-content-between gap-3 mb-4">
                <div>
                    <h1 class="page-title">User Management</h1>
                    <p class="page-subtitle">View user accounts, registration details and interview activity.</p>
                </div>
            </div>

            <form method="get" action="/Manager/Users" class="filter-card">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-lg-7">
                        <label class="filter-label">Search</label>
                        <input name="keyword"
                               value="@ViewBag.Keyword"
                               type="text"
                               class="form-control admin-input"
                               placeholder="Search users by name or email..."
                               onkeypress="if(event.key==='Enter') this.form.submit();" />
                    </div>

                    <div class="col-12 col-md-6 col-lg-2">
                        <button class="btn-filter" type="submit">Apply Filter</button>
                    </div>

                    <div class="col-12 col-md-6 col-lg-2">
                        <a class="btn-clear" href="/Manager/Users">Clear</a>
                    </div>
                </div>
            </form>

            <div class="table-shell">
                <div class="table-responsive">
                    <table class="table admin-table align-middle">
                        <thead>
                            <tr>
                                <th style="width: 32%;">User Information</th>
                                <th style="width: 18%;">Registered</th>
                                <th style="width: 12%;">Sessions</th>
                                <th style="width: 13%;">Status</th>
                                <th style="width: 12%;" class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.Items == null || !Model.Items.Any())
                            {
                                <tr>
                                    <td colspan="5" class="empty-row">
                                        <i class="fa-regular fa-folder-open d-block mb-2" style="font-size: 28px;"></i>
                                        No users found.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var user in Model.Items)
                                {
                                    var displayName = string.IsNullOrWhiteSpace(user.FullName) ? "Unknown User" : user.FullName;
                                    var statusClass = (user.Status ?? string.Empty).ToLowerInvariant() switch
                                    {
                                        "active" => "status-active",
                                        "blocked" => "status-blocked",
                                        "pending" => "status-pending",
                                        _ => "status-pending"
                                    };

                                    <tr>
                                        <td>
                                            <a class="user-name text-decoration-none"
                                               href="/Manager/Users/@user.UserId">
                                                @displayName
                                            </a>
                                            <div class="user-email">@user.Email</div>
                                        </td>

                                        <td>
                                            <div class="metric-strong">@user.RegistrationTimestamp.ToString("dd/MM/yyyy")</div>
                                            <div class="muted-small">@user.RegistrationTimestamp.ToString("HH:mm")</div>
                                        </td>

                                        <td>
                                            <span class="metric-strong">@user.TotalInterviewCount</span>
                                        </td>

                                        <td>
                                            <span class="status-badge @statusClass">
                                                <span style="font-size: 8px;">●</span>
                                                @(user.Status ?? "Unknown")
                                            </span>
                                        </td>

                                        <td class="text-end">
                                            <a class="action-btn action-view"
                                               href="/Manager/Users/@user.UserId"
                                               title="View details">
                                                <span class="material-symbols-outlined fs-5">visibility</span>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="table-footer">
                    <div>
                        Showing <strong>@startItem</strong>-<strong>@endItem</strong> of <strong>@totalCount</strong> users
                    </div>

                    @if (totalPages > 1)
                    {
                        var prevPage = pageIndex <= 1 ? 1 : pageIndex - 1;
                        var nextPage = pageIndex >= totalPages ? totalPages : pageIndex + 1;

                        <div class="pager">
                            <a href="@BuildPageUrl(prevPage)">
                                <i class="fa-solid fa-chevron-left"></i>
                            </a>

                            @for (var i = 1; i <= totalPages; i++)
                            {
                                if (i == pageIndex)
                                {
                                    <span class="active-page">@i</span>
                                }
                                else
                                {
                                    <a href="@BuildPageUrl(i)">@i</a>
                                }
                            }

                            <a href="@BuildPageUrl(nextPage)">
                                <i class="fa-solid fa-chevron-right"></i>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
