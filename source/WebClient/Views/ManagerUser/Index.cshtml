@model WebClient.Models.Shared.PagedResult<WebClient.Models.Manager.UserListItemViewModel>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Overview - DevPrep AI Manager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        /* User Overview page styles */
        .uo-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        .uo-title {
            font-size: 24px;
            font-weight: 600;
            color: var(--ad-on-surface);
            letter-spacing: -0.01em;
        }

        /* Filter bar */
        .uo-filter-bar {
            display: flex;
            align-items: flex-end;
            gap: 12px;
            padding: 16px;
            border-radius: 12px;
            margin-bottom: 20px;
        }

        .uo-search-wrap {
            flex: 1;
            position: relative;
        }

        .uo-search-wrap .material-symbols-outlined {
            position: absolute;
            left: 12px; top: 50%; transform: translateY(-50%);
            color: var(--ad-on-surface-variant);
            font-size: 20px;
        }

        .uo-input {
            width: 100%;
            background-color: var(--ad-surface-container);
            border: 1px solid var(--ad-border);
            color: var(--ad-on-surface);
            border-radius: 8px;
            padding: 10px 12px 10px 40px;
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            outline: none;
            transition: border-color 0.15s;
        }

        .uo-input:focus { border-color: var(--ad-primary); }
        .uo-input::placeholder { color: var(--ad-on-surface-variant); }

        .uo-filter-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .uo-filter-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 9px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--ad-on-surface-variant);
            padding-left: 2px;
        }

        .uo-select {
            background-color: var(--ad-surface-container);
            border: 1px solid var(--ad-border);
            color: var(--ad-on-surface);
            border-radius: 8px;
            padding: 9px 12px;
            font-size: 13px;
            font-family: 'Inter', sans-serif;
            min-width: 140px;
            outline: none;
            cursor: pointer;
            transition: border-color 0.15s;
        }

        .uo-select:focus { border-color: var(--ad-primary); }
        .uo-select option { background: var(--ad-surface-container); }

        /* Table */
        .uo-table-wrap {
            border-radius: 12px;
            overflow: hidden;
        }

        .uo-table {
            width: 100%;
            border-collapse: collapse;
        }

        .uo-table thead tr {
            background: var(--ad-surface-container-high);
            border-bottom: 1px solid var(--ad-border);
        }

        .uo-table thead th {
            padding: 13px 16px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.07em;
            text-transform: uppercase;
            color: var(--ad-on-surface-variant);
            text-align: left;
        }

        .uo-table thead th:last-child { text-align: right; }

        .uo-table tbody tr {
            border-bottom: 1px solid var(--ad-border);
            transition: background 0.12s;
            cursor: pointer;
        }

        .uo-table tbody tr:last-child { border-bottom: none; }
        .uo-table tbody tr:hover { background: var(--ad-surface-container); }

        .uo-table td {
            padding: 13px 16px;
            font-size: 14px;
            color: var(--ad-on-surface);
            vertical-align: middle;
        }

        .uo-table td:last-child { text-align: right; }

        .uo-table td.muted { color: var(--ad-on-surface-variant); font-size: 13px; }

        /* User cell */
        .uo-user-cell { display: flex; align-items: center; gap: 12px; }

        .uo-avatar {
            width: 38px; height: 38px;
            border-radius: 50%;
            flex-shrink: 0;
            background: rgba(195,192,255,0.15);
            border: 1px solid rgba(195,192,255,0.2);
            display: flex; align-items: center; justify-content: center;
            font-size: 15px; font-weight: 700;
            color: var(--ad-primary);
        }

        .uo-avatar.blocked {
            background: rgba(147,0,10,0.2);
            border-color: rgba(255,180,171,0.2);
            filter: grayscale(1);
            opacity: 0.5;
        }

        .uo-avatar img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }

        .uo-name { font-size: 14px; font-weight: 600; margin-bottom: 2px; }
        .uo-email { font-size: 12px; color: var(--ad-on-surface-variant); }

        /* Status chips */
        .uo-chip {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 3px 10px; border-radius: 999px;
            font-size: 10px; font-weight: 700;
            letter-spacing: 0.06em; text-transform: uppercase;
        }

        .uo-dot { width: 5px; height: 5px; border-radius: 50%; }

        .uo-chip-active  { background: rgba(16,185,129,0.12); color: var(--ad-success); }
        .uo-chip-active  .uo-dot { background: var(--ad-success); }
        .uo-chip-blocked { background: rgba(255,180,171,0.12); color: var(--ad-error); }
        .uo-chip-blocked .uo-dot { background: var(--ad-error); }

        /* Action button */
        .uo-action-btn {
            color: var(--ad-on-surface-variant);
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            border-radius: 4px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s, background-color 0.2s;
        }

        .uo-action-btn:hover {
            color: var(--ad-secondary, #4cd7f6);
            background-color: var(--ad-surface-container-high);
        }

        /* Pagination */
        .uo-pagination {
            display: flex; align-items: center; justify-content: space-between;
            padding: 14px 16px;
        }

        .uo-pg-text { font-size: 12px; color: var(--ad-on-surface-variant); }

        .uo-pg-btns { display: flex; gap: 4px; }

        .uo-pg-btn {
            min-width: 32px; height: 32px;
            display: flex; align-items: center; justify-content: center;
            border-radius: 6px;
            background: transparent;
            border: 1px solid var(--ad-border);
            color: var(--ad-on-surface-variant);
            font-size: 13px;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.12s;
        }

        .uo-pg-btn:hover { background: var(--ad-surface-container-high); color: var(--ad-on-surface); }
        .uo-pg-btn.cur {
            background: var(--ad-primary);
            color: var(--ad-on-primary, #1d192b);
            border-color: var(--ad-primary);
            font-weight: 700;
        }

        /* Drawer */
        .drawer-overlay {
            position: fixed; inset: 0;
            background: rgba(0,0,0,0.5);
            backdrop-filter: blur(3px);
            z-index: 200;
            opacity: 0; pointer-events: none;
            transition: opacity 0.25s;
        }
        .drawer-overlay.open { opacity: 1; pointer-events: all; }

        .user-drawer {
            position: fixed;
            top: 0; right: 0;
            width: 400px; height: 100vh;
            background: var(--ad-surface-container, #1a1f30);
            border-left: 1px solid var(--ad-border);
            box-shadow: -8px 0 32px rgba(0,0,0,0.4);
            z-index: 201;
            transform: translateX(100%);
            transition: transform 0.28s cubic-bezier(0.4,0,0.2,1);
            overflow-y: auto;
        }
        .user-drawer.open { transform: translateX(0); }

        .drawer-loader {
            width: 28px; height: 28px;
            border: 3px solid rgba(255,255,255,0.08);
            border-top-color: var(--ad-secondary, #4cd7f6);
            border-radius: 50%;
            animation: spin 0.85s linear infinite;
            margin: 80px auto;
        }
        @@keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body class="admin-page">
    @await Html.PartialAsync("_AdminTopbar")
    @await Html.PartialAsync("_AdminSidebar")

    <main class="ad-main">

        <!-- Header -->
        <div class="uo-header">
            <h1 class="uo-title">User Overview</h1>
        </div>

        <!-- Filter bar -->
        <form method="get" action="/Manager/Users" class="glass-card uo-filter-bar">
            <div class="uo-search-wrap">
                <span class="material-symbols-outlined">search</span>
                <input name="keyword" value="@ViewBag.Keyword" type="text"
                       class="uo-input" placeholder="Search users by name or email..."
                       onkeypress="if(event.key==='Enter')this.form.submit();" />
            </div>
            <div class="uo-filter-group">
                <span class="uo-filter-label">Status</span>
                <select name="status" class="uo-select" onchange="this.form.submit()">
                    <option value="">All Status</option>
                    @if (ViewBag.Status == "Active") { <option value="Active" selected>Active</option> } else { <option value="Active">Active</option> }
                    @if (ViewBag.Status == "Blocked") { <option value="Blocked" selected>Blocked</option> } else { <option value="Blocked">Blocked</option> }
                </select>
            </div>
            <div class="uo-filter-group">
                <span class="uo-filter-label">Role</span>
                <select name="role" class="uo-select" onchange="this.form.submit()">
                    <option value="">All Roles</option>
                    @if (ViewBag.Role == "Candidate") { <option value="Candidate" selected>Candidate</option> } else { <option value="Candidate">Candidate</option> }
                    @if (ViewBag.Role == "Mentor") { <option value="Mentor" selected>Mentor</option> } else { <option value="Mentor">Mentor</option> }
                </select>
            </div>
        </form>

        <!-- Table -->
        <div class="glass-card uo-table-wrap">
            <table class="uo-table">
                <thead>
                    <tr>
                        <th>User Information</th>
                        <th>Registered</th>
                        <th>Sessions</th>
                        <th>Credits</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            bool blocked = item.Status == "Blocked";
                            string initChar = string.IsNullOrEmpty(item.FullName) ? "?" : item.FullName[0].ToString().ToUpper();
                            <tr onclick="openDrawer('@item.UserId')">
                                <td>
                                    <div class="uo-user-cell" style="@(blocked ? "opacity:0.5" : "")">
                                        <div class="uo-avatar @(blocked ? "blocked" : "")">@initChar</div>
                                        <div>
                                            <div class="uo-name">@(string.IsNullOrEmpty(item.FullName) ? "N/A" : item.FullName)</div>
                                            <div class="uo-email">@item.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="muted" style="@(blocked ? "opacity:0.5" : "")">@item.RegistrationTimestamp.ToString("MMM d, yyyy")</td>
                                <td style="@(blocked ? "opacity:0.5" : "")">@item.TotalInterviewCount</td>
                                <td style="@(blocked ? "opacity:0.5" : "")">—</td>
                                <td>
                                    @if (item.Status == "Active")
                                    {
                                        <span class="uo-chip uo-chip-active"><span class="uo-dot"></span>Active</span>
                                    }
                                    else if (item.Status == "Blocked")
                                    {
                                        <span class="uo-chip uo-chip-blocked"><span class="uo-dot"></span>Blocked</span>
                                    }
                                    else
                                    {
                                        <span class="uo-chip" style="background:rgba(249,217,73,0.12);color:var(--ad-warning,#F9D949);">
                                            <span class="uo-dot" style="background:var(--ad-warning,#F9D949);"></span>@(item.Status ?? "Unknown")
                                        </span>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="uo-action-btn" title="View Details"
                                            onclick="event.stopPropagation();openDrawer('@item.UserId')">
                                        <span class="material-symbols-outlined" style="font-size:20px;">visibility</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align:center;color:var(--ad-on-surface-variant);padding:56px 16px;">
                                No users found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            <div class="uo-pagination">
                <span class="uo-pg-text">
                    @{
                        int currentPage = Model.PageIndex < 1 ? 1 : Model.PageIndex;
                        int currentPageSize = Model.PageSize < 1 ? 10 : Model.PageSize;
                        if (Model.TotalPages > 0 && currentPage > Model.TotalPages)
                        {
                            currentPage = Model.TotalPages;
                        }

                        int itemCount = Model.Items?.Count ?? 0;
                        int displayFrom = Model.TotalCount == 0 || itemCount == 0 ? 0 : (currentPage - 1) * currentPageSize + 1;
                        int displayTo = Model.TotalCount == 0 || itemCount == 0 ? 0 : Math.Min(displayFrom + itemCount - 1, Model.TotalCount);
                    }
                    Showing @displayFrom-@displayTo of @Model.TotalCount users
                </span>
                @if (Model.TotalPages > 1)
                {
                    <div class="uo-pg-btns">
                        @if (currentPage > 1)
                        {
                            <a href="?page=@(currentPage - 1)&keyword=@ViewBag.Keyword&status=@ViewBag.Status&role=@ViewBag.Role" class="uo-pg-btn">
                                <span class="material-symbols-outlined" style="font-size:17px;">chevron_left</span>
                            </a>
                        }
                        @for (int p = Math.Max(1, currentPage - 1); p <= Math.Min(Model.TotalPages, currentPage + 1); p++)
                        {
                            <a href="?page=@p&keyword=@ViewBag.Keyword&status=@ViewBag.Status&role=@ViewBag.Role"
                               class="uo-pg-btn @(p == currentPage ? "cur" : "")">@p</a>
                        }
                        @if (currentPage < Model.TotalPages)
                        {
                            <a href="?page=@(currentPage + 1)&keyword=@ViewBag.Keyword&status=@ViewBag.Status&role=@ViewBag.Role" class="uo-pg-btn">
                                <span class="material-symbols-outlined" style="font-size:17px;">chevron_right</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>

    </main>

    <!-- Drawer Overlay -->
    <div id="dOverlay" class="drawer-overlay" onclick="closeDrawer()"></div>

    <!-- User Detail Drawer -->
    <aside id="dPanel" class="user-drawer">
        <div id="dContent"><!-- loaded via AJAX --></div>
    </aside>

    <script>
        // Mark Users nav item as active
        document.addEventListener("DOMContentLoaded", function () {
            var links = document.querySelectorAll('.ad-nav-item');
            links.forEach(function (link) {
                link.classList.remove('active');
                if (link.getAttribute('href') === '/Manager/Users') {
                    link.classList.add('active');
                }
            });
        });

        function openDrawer(userId) {
            var panel   = document.getElementById('dPanel');
            var overlay = document.getElementById('dOverlay');
            var content = document.getElementById('dContent');

            content.innerHTML = '<div class="drawer-loader"></div>';
            panel.classList.add('open');
            overlay.classList.add('open');
            document.body.style.overflow = 'hidden';

            fetch('/Manager/Users/' + userId)
                .then(function (r) {
                    if (!r.ok) throw new Error('HTTP ' + r.status);
                    return r.text();
                })
                .then(function (html) { content.innerHTML = html; })
                .catch(function () {
                    content.innerHTML = '<div style="padding:32px;color:#ffb4ab;">Error loading user details.</div>';
                });
        }

        function closeDrawer() {
            document.getElementById('dPanel').classList.remove('open');
            document.getElementById('dOverlay').classList.remove('open');
            document.body.style.overflow = '';
        }
    </script>
</body>
</html>
