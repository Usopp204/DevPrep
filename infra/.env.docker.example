# ==============================================================================
# DevPrep — container environment template
# ==============================================================================
# Copy to infra/.env.docker and edit. That file is gitignored — never commit it.
#
#     cd infra
#     cp .env.docker.example .env.docker
#
# ------------------------------------------------------------------------------
# ⚠ THIS FILE IS ONLY READ IF YOU PASS --env-file. EVERY COMMAND NEEDS IT:
#
#     docker compose --env-file .env.docker -f docker-compose.yml up -d
#     docker compose --env-file .env.docker -f docker-compose.yml ps
#     docker compose --env-file .env.docker -f docker-compose.yml down
#
# Compose resolves ${VAR} from the shell environment and from a file named
# exactly `.env` in the project directory — NOT from `.env.docker`. Without the
# flag every value below is silently an empty string.
#
# You will know immediately if you forget: sqlserver refuses to start with an
# empty password, and authapi throws "Jwt:Key is missing in configuration."
#
# (One exception — linting needs no flag and no file:
#      docker compose -f docker-compose.yml config --quiet
#  Unset variables are warnings, not errors, so this validates structure only.)
# ------------------------------------------------------------------------------
#
# This file is for the CONTAINER stack only. The repo-root .env is separate and
# stays pointed at localhost\MSSQLSERVER01 so manual PowerShell startup keeps
# working unchanged. Do not merge the two.
#
# ==============================================================================
# LEGEND
#   [INVENT]  you must choose a new value; nothing to copy
#   [COPY]    copy from the repo-root .env, line number given
#   [BLOCKS]  the placeholder below is REJECTED and the stack will not start
#   [OK]      works exactly as shipped; change only if you know why
# ==============================================================================


# --- SQL Server container ---------------------------------------------------
# [INVENT] Must be 8+ characters with at least 3 of: uppercase, lowercase,
# digit, symbol. The mssql image validates this and EXITS if it fails.
#
# You cannot reuse the local password from the root .env ("12345") — it is too
# short and too simple, and the container will refuse to start.
#
# The value below does satisfy the policy, so the stack WILL come up with it —
# but it is published in this repo, so change it.
MSSQL_SA_PASSWORD=Change-Me-Str0ng!


# --- Service-to-service auth ------------------------------------------------
# [OK] Matches the root .env, which is what ai-service reads. These two MUST stay
# identical or every internal call between .NET and ai-service returns 401.
# NotificationAPI refuses to start without this key at all.
INTERNAL_API_KEY=devprep-internal-secret-2026


# --- JWT (AuthAPI signs tokens; every other service verifies them) ----------
# [COPY root .env line 53] [BLOCKS]
#
# ⚠ The placeholder below WILL PREVENT AUTHAPI FROM STARTING. It is listed
# verbatim in the `weakJwtKeys` array at source/AuthAPI/Program.cs:90-100, which
# also rejects any key shorter than 32 characters. This is deliberate: a token
# signed with a key published in the repo can be forged by anyone.
#
# Copy the real key from the repo-root .env (Jwt__Key) so containers and local
# startup issue mutually valid tokens. Or generate a fresh one — but then tokens
# from your local services will not validate in containers, and vice versa:
#   $b = New-Object byte[] 48
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)
JWT_KEY=change-me-32-chars-min-random-secret-here

# [OK] Match the root .env; no reason to change.
JWT_ISSUER=DevPrep.AuthAPI
JWT_AUDIENCE=DevPrep.Client


# --- VNPay (sandbox only — no live credentials exist in this project) --------
# [COPY root .env line 60]  Does not block startup; VNPay flows fail without it.
VNPAY_TMNCODE=your-vnpay-tmncode
# [COPY root .env line 61]  Same.
VNPAY_HASHSECRET=your-vnpay-hash-secret
# [OK] Sandbox endpoint, correct as shipped.
VNPAY_PAYMENTURL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
#
# Note VNPay__ReturnUrl is NOT set here. It is hardcoded to the gateway's HOST
# address in docker-compose.yml, because VNPay redirects the user's BROWSER —
# a compose DNS name would be unreachable from it.


# --- Hugging Face (ai-service) ----------------------------------------------
# [COPY root .env line 20]  Needed for the gated Gemma weights.
#
# ai-service also receives most AI keys (Gemini, Deepgram, HF) through
# `env_file: [../.env, ./.env]`, which is a separate mechanism. This entry exists
# because docker-compose's ${HF_TOKEN} substitution in the ai-service
# `environment:` block reads THIS file, not those.
HF_TOKEN=your-huggingface-token-here


# SAMPLE-DATA: remove before production — start
# --- Sample data (dev convenience) -------------------------------------------
# Seeds two sign-in accounts, three credit packages, and starting credits so a
# fresh clone is usable without manual setup. Leave FALSE for anything real: the
# accounts use a password that is documented publicly in db/seed/README.md.
# Requires generating the BCrypt hashes first — the seed aborts loudly otherwise.
SEED_SAMPLE_DATA=false
# SAMPLE-DATA: remove before production — end


# DEMO-SESSION: remove after defence — start
# --- Demo session (temporary, for the defence presentation) -------------------
# Adds a 5-minute / 3-question / 6-credit interview option so the full flow can be
# shown to a review board quickly. Leave FALSE for normal operation: at 6 credits it
# undercuts every real duration (15 min = 30 credits) and users would always pick it.
# Set to true on the presentation machine only, then remove per
# docs/architecture/demo-session-removal.md.
DEMO_SESSION_ENABLED=false
# DEMO-SESSION: remove after defence — end


# ==============================================================================
# SUMMARY — 5 values need your attention, 4 work as-is
#   MSSQL_SA_PASSWORD  invent a new one (local "12345" will not work)
#   JWT_KEY            copy from root .env:53 — BLOCKS STARTUP otherwise
#   VNPAY_TMNCODE      copy from root .env:60
#   VNPAY_HASHSECRET   copy from root .env:61
#   HF_TOKEN           copy from root .env:20
#   INTERNAL_API_KEY / JWT_ISSUER / JWT_AUDIENCE / VNPAY_PAYMENTURL — leave alone
# ==============================================================================
