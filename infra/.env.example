# DevPrep ai-service — Docker-only overrides (template).
# Copy to infra/.env and fill in the token. The repo-root .env is the single source
# of truth for API keys / model ids / tuning vars; docker-compose loads it first
# (env_file: ../.env) and this file second, so values here override the root value
# INSIDE the container. Keep ONLY container-specific values here.

# Hugging Face token. Must also live here (not only in the root .env) because
# docker-compose's ${HF_TOKEN} substitution reads infra/.env, not the root file.
# Use a token that can access the private CV-parser repo (DuongNTCE/devprep-cv-parser).
HF_TOKEN=your-huggingface-token-here

# Container path of the Gemma LoRA adapter (root .env holds the host path).
GEMMA_MODEL_DIR=/app/models/gemma-2b-devprep-sft

# Container path of the Chroma index. Mounted from ../ai-service/chroma_data_docker —
# kept separate from the venv mode's ./chroma_data so the two modes never share one store.
CHROMA_DIR=/app/chroma_data
