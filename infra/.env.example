# DevPrep ai-service — environment variables.
# Copy to a real .env and fill in the secrets.
#   - Docker: place the filled file where docker-compose expects it (infra/.env).
#   - Local uvicorn: export these before running, e.g. `export $(grep -v '^#' .env | xargs)`.

# --- Interviewer model: local Gemma 2B ---
HF_TOKEN=your-huggingface-token-here    # Hugging Face token (gated Gemma weights)
GEMMA_MODEL_DIR=/app/models/gemma-2b-devprep-sft
# HF_HOME is set by docker-compose to cache weights; no need to set it for local runs.

# --- Retrieval / embeddings ---
CHROMA_DIR=./chroma_data                    # /app/chroma_data inside Docker
EMBED_MODEL=BAAI/bge-m3                     # lighter option: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Evaluator judge (Gemini) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_JUDGE_MODEL=gemini-3.1-flash-lite     # set to the exact model string your account can call
SELF_CONSISTENCY_RUNS=3

# --- Voice: STT (Deepgram) ---
DEEPGRAM_API_KEY=your-deepgram-api-key-here
DEEPGRAM_STT_MODEL=nova-3

# --- Voice: TTS (ElevenLabs) ---
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id-here
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

INTERNAL_API_KEY=devprep-internal-secret-2026

# --- API ---
ALLOWED_ORIGINS=*                           # comma-separated origins; "*" is fine for local testing