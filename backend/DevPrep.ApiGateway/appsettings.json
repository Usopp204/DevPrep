{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "BodySizeLimitMb": 10,
    "RequestTimeoutSeconds": 30
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/auth"
          }
        ]
      },
      "document-route": {
        "ClusterId": "document-cluster",
        "Match": {
          "Path": "/api/document/{**catch-all}"
        }
      },
      "interview-route": {
        "ClusterId": "interview-cluster",
        "Match": {
          "Path": "/api/interview/{**catch-all}"
        }
      },
      "evaluation-route": {
        "ClusterId": "evaluation-cluster",
        "Match": {
          "Path": "/api/evaluation/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        }
      },
      "admin-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": {
            "Address": "http://localhost:7001/"
          }
        }
      },
      "document-cluster": {
        "Destinations": {
          "document": {
            "Address": "http://localhost:7002/"
          }
        }
      },
      "interview-cluster": {
        "Destinations": {
          "interview": {
            "Address": "http://localhost:7003/"
          }
        }
      },
      "evaluation-cluster": {
        "Destinations": {
          "evaluation": {
            "Address": "http://localhost:7004/"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment": {
            "Address": "http://localhost:7005/"
          }
        }
      },
      "admin-cluster": {
        "Destinations": {
          "admin": {
            "Address": "http://localhost:7006/"
          }
        }
      }
    }
  }
}
